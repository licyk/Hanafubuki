ags":[],"type":"text","url":"/en/docs/instance-paths","content":"Path","locale":"en"},"6568":{"id":"/en/docs/instance-paths-10","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths","content":"Purpose","locale":"en"},"6569":{"id":"/en/docs/instance-paths-11","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths","content":"Editable from “Component Paths”","locale":"en"},"6570":{"id":"/en/docs/instance-paths-12","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths","content":"Instance root","locale":"en"},"6571":{"id":"/en/docs/instance-paths-13","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths","content":"File boundary of the complete instance","locale":"en"},"6572":{"id":"/en/docs/instance-paths-14","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths","content":"No; use instance migration","locale":"en"},"6573":{"id":"/en/docs/instance-paths-15","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths","content":"Python directory","locale":"en"},"6574":{"id":"/en/docs/instance-paths-16","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths","content":"Standalone Python and installed packages","locale":"en"},"6575":{"id":"/en/docs/instance-paths-17","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths","content":"Yes","locale":"en"},"6576":{"id":"/en/docs/instance-paths-18","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths","content":"Core directory","locale":"en"},"6577":{"id":"/en/docs/instance-paths-19","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths","content":"WebUI code, extensions, and related resources","locale":"en"},"6578":{"id":"/en/docs/instance-paths-20","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths","content":"Yes","locale":"en"},"6579":{"id":"/en/docs/instance-paths-21","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths","content":"Some types offer **Installed by this instance** and **An existing one of yours** under Component Paths. Selecting the latter marks the component as external so deleting the instance preserves it. If the field asks for a program, select the specified executable. The app verifies it and records the corresponding component directory.","locale":"en"},"6580":{"id":"/en/docs/instance-paths-22","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths#stop-related-operations","content":"Stop the WebUI first, and wait for installation, version, extension, snapshot, and model tasks to finish. Updating paths requires exclusive access to the current instance. The app may also stop related runtime resources before the update.","locale":"en"},"6581":{"id":"/en/docs/instance-paths-23","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths#check-the-target-directories","content":"The Python directory must be a usable standalone Python environment. The Core directory must match the current WebUI type. Do not select a drive root, a user home directory, or a directory already used by another instance.","locale":"en"},"6582":{"id":"/en/docs/instance-paths-24","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths#select-and-apply","content":"Enter or choose the new directories under “Component Paths,” check the component paths listed for this type, and select “Apply.” The backend validates the paths, instance overlap, and component types.","locale":"en"},"6583":{"id":"/en/docs/instance-paths-25","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths#handle-a-stale-configuration-warning","content":"If the page reports that the instance configuration has changed, select “Reload,” choose the directories again, and resubmit. Do not use a stale page to overwrite configuration just saved by another management operation.","locale":"en"},"6584":{"id":"/en/docs/instance-paths-26","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths#verify-the-new-environment","content":"Return to “Instance Information” and check the Python version and Core path. Then run version checks in the Instance Terminal, and finally launch the WebUI again.","locale":"en"},"6585":{"id":"/en/docs/instance-paths-27","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths#verify-the-new-environment","content":"The app only updates the component references in the instance record. It does not copy or move the\nold directory to the new location. To relocate the complete instance, use “Migrate Instance” in\nInstance Maintenance.","locale":"en"},"6586":{"id":"/en/docs/instance-paths-28","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths#which-feature-should-you-use","content":"Goal","locale":"en"},"6587":{"id":"/en/docs/instance-paths-29","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths#which-feature-should-you-use","content":"Correct operation","locale":"en"},"6588":{"id":"/en/docs/instance-paths-30","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths#which-feature-should-you-use","content":"Refer to another existing Python/Core","locale":"en"},"6589":{"id":"/en/docs/instance-paths-31","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths#which-feature-should-you-use","content":"Change component paths","locale":"en"},"6590":{"id":"/en/docs/instance-paths-32","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths#which-feature-should-you-use","content":"Move the complete instance root to another drive","locale":"en"},"6591":{"id":"/en/docs/instance-paths-33","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths#which-feature-should-you-use","content":"Migrate the instance","locale":"en"},"6592":{"id":"/en/docs/instance-paths-34","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths#which-feature-should-you-use","content":"Repair a missing or damaged Python/Core","locale":"en"},"6593":{"id":"/en/docs/instance-paths-35","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths#which-feature-should-you-use","content":"Reinstall the instance","locale":"en"},"6594":{"id":"/en/docs/instance-paths-36","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths#which-feature-should-you-use","content":"Restore a previously valid directory reference","locale":"en"},"6595":{"id":"/en/docs/instance-paths-37","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths#which-feature-should-you-use","content":"Change the component path back to the original directory","locale":"en"},"6596":{"id":"/en/docs/instance-paths-38","page_id":"/en/docs/instance-paths","tags":[],"type":"text","url":"/en/docs/instance-paths#which-feature-should-you-use","content":"Migration leaves components outside the root in place. Full deletion also removes owned components outside the root, and a forced rebuild can delete an owned Core there. Choose **Delete record only** when removing an instance if you want to preserve all of its files.","locale":"en"},"6597":{"id":"/en/docs/instance-pytorch","page_id":"/en/docs/instance-pytorch","type":"page","content":"PyTorch Management","breadcrumbs":["Hanafubuki Documentation","Instance Management"],"tags":[],"url":"/en/docs/instance-pytorch","locale":"en"},"6598":{"id":"/en/docs/instance-pytorch-0","page_id":"/en/docs/instance-pytorch","tags":[],"type":"text","url":"/en/docs/instance-pytorch","content":"Check compatibility between the current PyTorch build and device, then reinstall automatically or manually.","locale":"en"},"6599":{"id":"/en/docs/instance-pytorch-1","page_id":"/en/docs/instance-pytorch","type":"heading","tags":[],"url":"/en/docs/instance-pytorch#understand-the-check-result","content":"Understand the check result","locale":"en"},"6600":{"id":"/en/docs/instance-pytorch-2","page_id":"/en/docs/instance-pytorch","type":"heading","tags":[],"url":"/en/docs/instance-pytorch#reinstall-pytorch","content":"Reinstall PyTorch","locale":"en"},"6601":{"id":"/en/docs/instance-pytorch-3","page_id":"/en/docs/instance-pytorch","type":"heading","tags":[],"url":"/en/docs/instance-pytorch#stop-the-webui","content":"Stop the WebUI","locale":"en"},"6602":{"id":"/en/docs/instance-pytorch-4","page_id":"/en/docs/instance-pytorch","type":"heading","tags":[],"url":"/en/docs/instance-pytorch#choose-how-to-select-a-version","content":"Choose how to select a version","locale":"en"},"6603":{"id":"/en/docs/instance-pytorch-5","page_id":"/en/docs/instance-pytorch","type":"heading","tags":[],"url":"/en/docs/instance-pytorch#decide-whether-to-force-reinstallation","content":"Decide whether to force reinstallation","locale":"en"},"6604":{"id":"/en/docs/instance-pytorch-6","page_id":"/en/docs/instance-pytorch","type":"heading","tags":[],"url":"/en/docs/instance-pytorch#confirm-and-wait-for-the-task","content":"Confirm and wait for the task","locale":"en"},"6605":{"id":"/en/docs/instance-pytorch-7","page_id":"/en/docs/instance-pytorch","type":"heading","tags":[],"url":"/en/docs/instance-pytorch#verify-the-result","content":"Verify the result","locale":"en"},"6606":{"id":"/en/docs/instance-pytorch-8","page_id":"/en/docs/instance-pytorch","type":"heading","tags":[],"url":"/en/docs/instance-pytorch#handle-failures","content":"Handle failures","locale":"en"},"6607":{"id":"/en/docs/instance-pytorch-9","page_id":"/en/docs/instance-pytorch","tags":[],"type":"text","url":"/en/docs/instance-pytorch","content":"The “PyTorch” page inspects Torch components in the instance Python environment, detects the device type, and lists installation combinations supported by the current WebUI. Options vary by WebUI, operating system, and hardware.","locale":"en"},"6608":{"id":"/en/docs/instance-pytorch-10","page_id":"/en/docs/instance-pytorch","tags":[],"type":"text","url":"/en/docs/instance-pytorch#understand-the-check-result","content":"Status","locale":"en"},"6609":{"id":"/en/docs/instance-pytorch-11","page_id":"/en/docs/instance-pytorch","tags":[],"type":"text","url":"/en/docs/instance-pytorch#understand-the-check-result","content":"Meaning","locale":"en"},"6610":{"id":"/en/docs/instance-pytorch-12","page_id":"/en/docs/instance-pytorch","tags":[],"type":"text","url":"/en/docs/instance-pytorch#understand-the-check-result","content":"Compatible","locale":"en"},"6611":{"id":"/en/docs/instance-pytorch-13","page_id":"/en/docs/instance-pytorch","tags":[],"type":"text","url":"/en/docs/instance-pytorch#understand-the-check-result","content":"The current build matches the detected device and WebUI rules","locale":"en"},"6612":{"id":"/en/docs/instance-pytorch-14","page_id":"/en/docs/instance-pytorch","tags":[],"type":"text","url":"/en/docs/instance-pytorch#understand-the-check-result","content":"Incompatible","locale":"en"},"6613":{"id":"/en/docs/instance-pytorch-15","page_id":"/en/docs/instance-pytorch","tags":[],"type":"text","url":"/en/docs/instance-pytorch#understand-the-check-result","content":"The installed build does not match the device or supported combinations","locale":"en"},"6614":{"id":"/en/docs/instance-pytorch-16","page_id":"/en/docs/instance-pytorch","tags":[],"type":"text","url":"/en/docs/instance-pytorch#understand-the-check-result","content":"Not Installed","locale":"en"},"6615":{"id":"/en/docs/instance-pytorch-17","page_id":"/en/docs/instance-pytorch","tags":[],"type":"text","url":"/en/docs/instance-pytorch#understand-the-check-result","content":"Required PyTorch packages were not detected in the instance environment","locale":"en"},"6616":{"id":"/en/docs/instance-pytorch-18","page_id":"/en/docs/instance-pytorch","tags":[],"type":"text","url":"/en/docs/instance-pytorch#understand-the-check-result","content":"Unable to Check","locale":"en"},"6617":{"id":"/en/docs/instance-pytorch-19","page_id":"/en/docs/instance-pytorch","tags":[],"type":"text","url":"/en/docs/instance-pytorch#understand-the-check-result","content":"Python, the management API, or an environment query failed","locale":"en"},"6618":{"id":"/en/docs/instance-pytorch-20","page_id":"/en/docs/instance-pytorch","tags":[],"type":"text","url":"/en/docs/instance-pytorch#understand-the-check-result","content":"The page also shows detected versions of Torch, TorchVision, TorchAudio, xFormers, and other components, along with the recommended device build. Rely on the catalog currently shown on this page; do not copy installation commands from a guide for another WebUI.","locale":"en"},"6619":{"id":"/en/docs/instance-pytorch-21","page_id":"/en/docs/instance-pytorch","tags":[],"type":"text","url":"/en/docs/instance-pytorch#stop-the-webui","content":"Reinstalling PyTorch modifies the active Python environment, so stop the WebUI first. The app coordinates the management API; you do not need to terminate it manually.","locale":"en"},"6620":{"id":"/en/docs/instance-pytorch-22","page_id":"/en/docs/instance-pytorch","tags":[],"type":"text","url":"/en/docs/instance-pytorch#choose-how-to-select-a-version","content":"Use automatic selection when available to let the installer choose a build for your hardware. If it is unavailable, the page switches to manual selection. Search by build name or filter by device, then choose a supported build. The list marks recommended builds and disables unsupported ones.","locale":"en"},"6621":{"id":"/en/docs/instance-pytorch-23","page_id":"/en/docs/instance-pytorch","tags":[],"type":"text","url":"/en/docs/instance-pytorch#decide-whether-to-force-reinstallation","content":"When the current status is already compatible, normally leave “Reinstall Even If the Current Version Is Correct” disabled. Enable it only for damaged files, dependency problems, or redeploying the same build.","locale":"en"},"6622":{"id":"/en/docs/instance-pytorch-24","page_id":"/en/docs/instance-pytorch","tags":[],"type":"text","url":"/en/docs/instance-pytorch#confirm-and-wait-for-the-task","content":"Select “Reinstall PyTorch,” confirm the operation, and follow dependency download, installation, and environment-check output in the bottom-right status area or Task Center.","locale":"en"},"6623":{"id":"/en/docs/instance-pytorch-25","page_id":"/en/docs/instance-pytorch","tags":[],"type":"text","url":"/en/docs/instance-pytorch#verify-the-result","content":"Expand “Last reinstall” to check the selected build, executor status, and exit code. The app restarts the instance API and shows any restart error or post-restart compatibility result here. Refresh the page to confirm the installed build, then launch the WebUI to verify it in use.","locale":"en"},"6624":{"id":"/en/docs/instance-pytorch-26","page_id":"/en/docs/instance-pytorch","tags":[],"type":"text","url":"/en/docs/instance-pytorch#handle-failures","content":"If automatic selection fails, check the graphics driver, operating-system support, and detected device reported by the page. Do not try several CUDA/ROCm builds at random.","locale":"en"},"6625":{"id":"/en/docs/instance-pytorch-27","page_id":"/en/docs/instance-pytorch","tags":[],"type":"text","url":"/en/docs/instance-pytorch#handle-failures","content":"If package downloads or resolution fail, check Network & Proxy and Mirrors.","locale":"en"},"6626":{"id":"/en/docs/instance-pytorch-28","page_id":"/en/docs/instance-pytorch","tags":[],"type":"text","url":"/en/docs/instance-pytorch#handle-failures","content":"If the result remains incompatible after installation, open the latest task output and record the selected build, exit code, and environment-check result.","locale":"en"},"6627":{"id":"/en/docs/instance-pytorch-29","page_id":"/en/docs/instance-pytorch","tags":[],"type":"text","url":"/en/docs/instance-pytorch#handle-failures","content":"If a PyTorch decision dialog appears during launch, you can cancel and return here to fix the environment. Use “Ignore and Launch” only when you accept the risk for this run.","locale":"en"},"6628":{"id":"/en/docs/instance-pytorch-30","page_id":"/en/docs/instance-pytorch","tags":[],"type":"text","url":"/en/docs/instance-pytorch#handle-failures","content":"This operation modifies PyTorch and its supporting packages in the current instance Python\nenvironment. Do not install Torch manually in the Instance Terminal at the same time, and do not\nlaunch the WebUI before the task completes.","locale":"en"},"6629":{"id":"/en/docs/instance-snapshots","page_id":"/en/docs/instance-snapshots","type":"page","content":"Snapshot Management","breadcrumbs":["Hanafubuki Documentation","Instance Management"],"tags":[],"url":"/en/docs/instance-snapshots","locale":"en"},"6630":{"id":"/en/docs/instance-snapshots-0","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots","content":"Create environment snapshots, preview restoration effects, and safely restore or delete snapshots.","locale":"en"},"6631":{"id":"/en/docs/instance-snapshots-1","page_id":"/en/docs/instance-snapshots","type":"heading","tags":[],"url":"/en/docs/instance-snapshots#create-and-inspect-snapshots","content":"Create and inspect snapshots","locale":"en"},"6632":{"id":"/en/docs/instance-snapshots-2","page_id":"/en/docs/instance-snapshots","type":"heading","tags":[],"url":"/en/docs/instance-snapshots#restoration-options","content":"Restoration options","locale":"en"},"6633":{"id":"/en/docs/instance-snapshots-3","page_id":"/en/docs/instance-snapshots","type":"heading","tags":[],"url":"/en/docs/instance-snapshots#preview-and-restore","content":"Preview and restore","locale":"en"},"6634":{"id":"/en/docs/instance-snapshots-4","page_id":"/en/docs/instance-snapshots","type":"heading","tags":[],"url":"/en/docs/instance-snapshots#prepare-for-restoration","content":"Prepare for restoration","locale":"en"},"6635":{"id":"/en/docs/instance-snapshots-5","page_id":"/en/docs/instance-snapshots","type":"heading","tags":[],"url":"/en/docs/instance-snapshots#open-the-restore-dialog","content":"Open the restore dialog","locale":"en"},"6636":{"id":"/en/docs/instance-snapshots-6","page_id":"/en/docs/instance-snapshots","type":"heading","tags":[],"url":"/en/docs/instance-snapshots#read-the-blockers","content":"Read the blockers","locale":"en"},"6637":{"id":"/en/docs/instance-snapshots-7","page_id":"/en/docs/instance-snapshots","type":"heading","tags":[],"url":"/en/docs/instance-snapshots#review-planned-changes","content":"Review planned changes","locale":"en"},"6638":{"id":"/en/docs/instance-snapshots-8","page_id":"/en/docs/instance-snapshots","type":"heading","tags":[],"url":"/en/docs/instance-snapshots#confirm-restoration","content":"Confirm restoration","locale":"en"},"6639":{"id":"/en/docs/instance-snapshots-9","page_id":"/en/docs/instance-snapshots","type":"heading","tags":[],"url":"/en/docs/instance-snapshots#verify-after-completion","content":"Verify after completion","locale":"en"},"6640":{"id":"/en/docs/instance-snapshots-10","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots","content":"A snapshot records the WebUI type, Core commit, Python packages, and extension state so you can restore the environment after version, dependency, or extension changes. Package information is included by default when a snapshot is created.","locale":"en"},"6641":{"id":"/en/docs/instance-snapshots-11","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots","content":"With **Create instance snapshots daily** enabled, the app saves a daily snapshot of each ready built-in WebUI. Extension-provided instance types do not participate in automatic snapshots. When the daily update check is also enabled, the app takes the instance's snapshot first. See Automation.","locale":"en"},"6642":{"id":"/en/docs/instance-snapshots-12","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots","content":"Snapshots usually do not include models, generated images, arbitrary user files, or a complete\ncopy of uncommitted code. Back up this content separately before high-risk operations.","locale":"en"},"6643":{"id":"/en/docs/instance-snapshots-13","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#create-and-inspect-snapshots","content":"Wait for completion in the bottom-right status area or Task Center. Do not reinstall or restore\nthe environment while a snapshot is being created.","locale":"en"},"6644":{"id":"/en/docs/instance-snapshots-14","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#create-and-inspect-snapshots","content":"Refresh the list, expand the new snapshot, and check its creation time, package count, extension\ncount, and Core commit.","locale":"en"},"6645":{"id":"/en/docs/instance-snapshots-15","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#create-and-inspect-snapshots","content":"A malformed snapshot displays a parsing error and cannot be restored directly. Deleting a snapshot permanently deletes only the corresponding snapshot file; it does not change the current environment.","locale":"en"},"6646":{"id":"/en/docs/instance-snapshots-16","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#restoration-options","content":"Option","locale":"en"},"6647":{"id":"/en/docs/instance-snapshots-17","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#restoration-options","content":"When disabled","locale":"en"},"6648":{"id":"/en/docs/instance-snapshots-18","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#restoration-options","content":"When enabled","locale":"en"},"6649":{"id":"/en/docs/instance-snapshots-19","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#restoration-options","content":"Clean extra packages","locale":"en"},"6650":{"id":"/en/docs/instance-snapshots-20","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#restoration-options","content":"Restore recorded packages and keep packages added after the snapshot","locale":"en"},"6651":{"id":"/en/docs/instance-snapshots-21","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#restoration-options","content":"Uninstall packages not recorded in the snapshot","locale":"en"},"6652":{"id":"/en/docs/instance-snapshots-22","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#restoration-options","content":"Clean extra extensions","locale":"en"},"6653":{"id":"/en/docs/instance-snapshots-23","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#restoration-options","content":"Restore recorded extensions and keep extensions added after the snapshot","locale":"en"},"6654":{"id":"/en/docs/instance-snapshots-24","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#restoration-options","content":"Delete extensions not recorded in the snapshot","locale":"en"},"6655":{"id":"/en/docs/instance-snapshots-25","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#restoration-options","content":"Force Git reset","locale":"en"},"6656":{"id":"/en/docs/instance-snapshots-26","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#restoration-options","content":"Uncommitted changes may block restoration","locale":"en"},"6657":{"id":"/en/docs/instance-snapshots-27","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#restoration-options","content":"Discard uncommitted changes in the WebUI and extension repositories, then switch to the recorded commits","locale":"en"},"6658":{"id":"/en/docs/instance-snapshots-28","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#restoration-options","content":"Some snapshots mark an option as “Required.” Restoration cannot begin until every required option is enabled.","locale":"en"},"6659":{"id":"/en/docs/instance-snapshots-29","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#prepare-for-restoration","content":"Stop the WebUI, wait for version, extension, model, PyTorch, and other management tasks to finish, and back up uncommitted code and important files.","locale":"en"},"6660":{"id":"/en/docs/instance-snapshots-30","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#open-the-restore-dialog","content":"Select “Restore” on the target snapshot. After you choose cleanup and Git-reset options, the app automatically generates a restoration preview bound to the current instance state.","locale":"en"},"6661":{"id":"/en/docs/instance-snapshots-31","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#read-the-blockers","content":"A mismatched type, missing Core, uncommitted repository changes, or another unresolved problem blocks restoration. Follow the instructions or enable the required options, then wait for the preview to be analyzed again automatically.","locale":"en"},"6662":{"id":"/en/docs/instance-snapshots-32","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#review-planned-changes","content":"Read any blockers and warnings at the top of the list, then check the changes to repositories, Python packages, and extensions. Select “Show … unchanged” to include skipped and unchanged items. If preview generation fails, select “Retry analysis” in the same dialog.","locale":"en"},"6663":{"id":"/en/docs/instance-snapshots-33","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#confirm-restoration","content":"You can submit only while the current preview is restorable. After the task is accepted, the restore dialog closes. Follow subsequent phases and output in the bottom-right status area and Task Center.","locale":"en"},"6664":{"id":"/en/docs/instance-snapshots-34","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#verify-after-completion","content":"Refresh the Versions, Extensions, and PyTorch pages, then launch the WebUI. Verify models and user files against their separate backups.","locale":"en"},"6665":{"id":"/en/docs/instance-snapshots-35","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#verify-after-completion","content":"The preview is bound to the snapshot, restoration options, management API state, and instance configuration. If you change paths, launch configuration, or other instance settings after preview generation, the old preview becomes invalid. Close the dialog and generate a new one instead of attempting another submission.","locale":"en"},"6666":{"id":"/en/docs/instance-snapshots-36","page_id":"/en/docs/instance-snapshots","tags":[],"type":"text","url":"/en/docs/instance-snapshots#verify-after-completion","content":"“Clean Extra Packages,” “Clean Extra Extensions,” and “Force Git Reset” can all remove content\nfrom the current environment that the snapshot does not preserve. Restore only after checking both\nthe preview lists and your independent backups.","locale":"en"},"6667":{"id":"/en/docs/instance-terminal","page_id":"/en/docs/instance-terminal","type":"page","content":"Instance Terminal","breadcrumbs":["Hanafubuki Documentation","Instance Management"],"tags":[],"url":"/en/docs/instance-terminal","locale":"en"},"6668":{"id":"/en/docs/instance-terminal-0","page_id":"/en/docs/instance-terminal","tags":[],"type":"text","url":"/en/docs/instance-terminal","content":"Run inspection or maintenance commands with the current instance's Python, Git, and managed environment.","locale":"en"},"6669":{"id":"/en/docs/instance-terminal-1","page_id":"/en/docs/instance-terminal","type":"heading","tags":[],"url":"/en/docs/instance-terminal#open-and-inspect-the-environment","content":"Open and inspect the environment","locale":"en"},"6670":{"id":"/en/docs/instance-terminal-2","page_id":"/en/docs/instance-terminal","type":"heading","tags":[],"url":"/en/docs/instance-terminal#session-operations","content":"Session operations","locale":"en"},"6671":{"id":"/en/docs/instance-terminal-3","page_id":"/en/docs/instance-terminal","type":"heading","tags":[],"url":"/en/docs/instance-terminal#use-the-terminal-safely","content":"Use the terminal safely","locale":"en"},"6672":{"id":"/en/docs/instance-terminal-4","page_id":"/en/docs/instance-terminal","tags":[],"type":"text","url":"/en/docs/instance-terminal","content":"The Instance Terminal opens in the current instance's environment. For built-in WebUIs it usually starts in the Core directory with the instance's Python and managed Git on the path. Extension-provided types supply their own tools and may have no Python environment. The general application terminal is independent of the instance.","locale":"en"},"6673":{"id":"/en/docs/instance-terminal-5","page_id":"/en/docs/instance-terminal","tags":[],"type":"text","url":"/en/docs/instance-terminal#open-and-inspect-the-environment","content":"When you enter “Run → Terminal,” the app creates or resubscribes to the current instance's terminal session and restores retained output. You can enter commands after status becomes “Running.”","locale":"en"},"6674":{"id":"/en/docs/instance-terminal-6","page_id":"/en/docs/instance-terminal","tags":[],"type":"text","url":"/en/docs/instance-terminal#open-and-inspect-the-environment","content":"Drop files or folders from your system file manager onto a running terminal to insert their paths. The app quotes them for the current shell, and you can review the command before pressing `Enter`. While the terminal has focus, it receives `Tab` and `Esc` too. Press `Ctrl+Shift+Tab` to move focus back to the app.","locale":"en"},"6675":{"id":"/en/docs/instance-terminal-7","page_id":"/en/docs/instance-terminal","tags":[],"type":"text","url":"/en/docs/instance-terminal#open-and-inspect-the-environment","content":"If the terminal opens with a warning that managed environment variables could not be applied, check the cache paths and settings you need before running commands that depend on them. For an instance with Python, these commands inspect the environment:","locale":"en"},"6676":{"id":"/en/docs/instance-terminal-8","page_id":"/en/docs/instance-terminal","tags":[],"type":"text","url":"/en/docs/instance-terminal#open-and-inspect-the-environment","content":"You can also run `git status` in the Core repository to inspect uncommitted changes. Path presentation and directory-changing commands depend on the shell in use on Windows, macOS, or Linux.","locale":"en"},"6677":{"id":"/en/docs/instance-terminal-9","page_id":"/en/docs/instance-terminal","tags":[],"type":"text","url":"/en/docs/instance-terminal#session-operations","content":"Operation","locale":"en"},"6678":{"id":"/en/docs/instance-terminal-10","page_id":"/en/docs/instance-terminal","tags":[],"type":"text","url":"/en/docs/instance-terminal#session-operations","content":"Effect","locale":"en"},"6679":{"id":"/en/docs/instance-terminal-11","page_id":"/en/docs/instance-terminal","tags":[],"type":"text","url":"/en/docs/instance-terminal#session-operations","content":"Leave the section","locale":"en"},"6680":{"id":"/en/docs/instance-terminal-12","page_id":"/en/docs/instance-terminal","tags":[],"type":"text","url":"/en/docs/instance-terminal#session-operations","content":"Unsubscribe the current interface; this must not be treated as ending the process","locale":"en"},"6681":{"id":"/en/docs/instance-terminal-13","page_id":"/en/docs/instance-terminal","tags":[],"type":"text","url":"/en/docs/instance-terminal#session-operations","content":"Restart terminal","locale":"en"},"6682":{"id":"/en/docs/instance-terminal-14","page_id":"/en/docs/instance-terminal","tags":[],"type":"text","url":"/en/docs/instance-terminal#session-operations","content":"End the current PTY and create a new terminal session for the same instance","locale":"en"},"6683":{"id":"/en/docs/instance-terminal-15","page_id":"/en/docs/instance-terminal","tags":[],"type":"text","url":"/en/docs/instance-terminal#session-operations","content":"Close terminal","locale":"en"},"6684":{"id":"/en/docs/instance-terminal-16","page_id":"/en/docs/instance-terminal","tags":[],"type":"text","url":"/en/docs/instance-terminal#session-operations","content":"Confirm termination and release the current terminal process","locale":"en"},"6685":{"id":"/en/docs/instance-terminal-17","page_id":"/en/docs/instance-terminal","tags":[],"type":"text","url":"/en/docs/instance-terminal#session-operations","content":"Re-enter","locale":"en"},"6686":{"id":"/en/docs/instance-terminal-18","page_id":"/en/docs/instance-terminal","tags":[],"type":"text","url":"/en/docs/instance-terminal#session-operations","content":"Subscribe to the existing session, restore retained output, and continue receiving new output","locale":"en"},"6687":{"id":"/en/docs/instance-terminal-19","page_id":"/en/docs/instance-terminal","tags":[],"type":"text","url":"/en/docs/instance-terminal#session-operations","content":"You can restart a terminal whose status is “Exited.” When status is “Close Failed,” the backend still retains the cleanup obligation for the original session. Use “Close Terminal Process” again instead of creating replacement sessions repeatedly.","locale":"en"},"6688":{"id":"/en/docs/instance-terminal-20","page_id":"/en/docs/instance-terminal","tags":[],"type":"text","url":"/en/docs/instance-terminal#use-the-terminal-safely","content":"Before running install, delete, move, or Git commands, confirm the current directory and target path.","locale":"en"},"6689":{"id":"/en/docs/instance-terminal-21","page_id":"/en/docs/instance-terminal","tags":[],"type":"text","url":"/en/docs/instance-terminal#use-the-terminal-safely","content":"Do not manually install packages while the WebUI, a version update, snapshot restoration, or reinstallation task is changing the same environment.","locale":"en"},"6690":{"id":"/en/docs/instance-terminal-22","page_id":"/en/docs/instance-terminal","tags":[],"type":"text","url":"/en/docs/instance-terminal#use-the-terminal-safely","content":"Prefer `python -m <module>` so the command uses the module associated with the current instance's Python.","locale":"en"},"6691":{"id":"/en/docs/instance-terminal-23","page_id":"/en/docs/instance-terminal","tags":[],"type":"text","url":"/en/docs/instance-terminal#use-the-terminal-safely","content":"Manual terminal changes do not create a snapshot automatically and are not guaranteed to be reversible by Hanafubuki.","locale":"en"},"6692":{"id":"/en/docs/instance-terminal-24","page_id":"/en/docs/instance-terminal","tags":[],"type":"text","url":"/en/docs/instance-terminal#use-the-terminal-safely","content":"When changing supported extensions, models, versions, or PyTorch, prefer the corresponding management page so task status and error output are available.","locale":"en"},"6693":{"id":"/en/docs/instance-terminal-25","page_id":"/en/docs/instance-terminal","tags":[],"type":"text","url":"/en/docs/instance-terminal#use-the-terminal-safely","content":"The Instance Terminal is not a simulated environment. Deleting directories, resetting Git, or\nreinstalling packages changes the instance directly. Create a snapshot before important\noperations, and back up models, outputs, and custom code separately.","locale":"en"},"6694":{"id":"/en/docs/instance-variants","page_id":"/en/docs/instance-variants","type":"page","content":"WebUI Variants","breadcrumbs":["Hanafubuki Documentation","Instance Management"],"tags":[],"url":"/en/docs/instance-variants","locale":"en"},"6695":{"id":"/en/docs/instance-variants-0","page_id":"/en/docs/instance-variants","tags":[],"type":"text","url":"/en/docs/instance-variants","content":"Switch preset repositories and branches on supported instances, and synchronize reinstallation configuration.","locale":"en"},"6696":{"id":"/en/docs/instance-variants-1","page_id":"/en/docs/instance-variants","type":"heading","tags":[],"url":"/en/docs/instance-variants#switch-variants","content":"Switch variants","locale":"en"},"6697":{"id":"/en/docs/instance-variants-2","page_id":"/en/docs/instance-variants","type":"heading","tags":[],"url":"/en/docs/instance-variants#back-up-the-current-state","content":"Back up the current state","locale":"en"},"6698":{"id":"/en/docs/instance-variants-3","page_id":"/en/docs/instance-variants","type":"heading","tags":[],"url":"/en/docs/instance-variants#stop-the-webui","content":"Stop the WebUI","locale":"en"},"6699":{"id":"/en/docs/instance-variants-4","page_id":"/en/docs/instance-variants","type":"heading","tags":[],"url":"/en/docs/instance-variants#check-the-target-source","content":"Check the target source","locale":"en"},"6700":{"id":"/en/docs/instance-variants-5","page_id":"/en/docs/instance-variants","type":"heading","tags":[],"url":"/en/docs/instance-variants#select-switch-and-confirm","content":"Select “Switch” and confirm","locale":"en"},"6701":{"id":"/en/docs/instance-variants-6","page_id":"/en/docs/instance-variants","type":"heading","tags":[],"url":"/en/docs/instance-variants#verify-the-variant","content":"Verify the variant","locale":"en"},"6702":{"id":"/en/docs/instance-variants-7","page_id":"/en/docs/instance-variants","type":"heading","tags":[],"url":"/en/docs/instance-variants#synchronize-only-the-reinstallation-configuration","content":"Sync the reinstall setting to the current variant","locale":"en"},"6703":{"id":"/en/docs/instance-variants-8","page_id":"/en/docs/instance-variants","tags":[],"type":"text","url":"/en/docs/instance-variants","content":"A WebUI variant is a set of repository, branch, and submodule settings provided by the current WebUI. It differs from an ordinary branch switch: changing the variant can replace the Git remote and determines which source a later Core reinstallation uses.","locale":"en"},"6704":{"id":"/en/docs/instance-variants-9","page_id":"/en/docs/instance-variants","tags":[],"type":"text","url":"/en/docs/instance-variants","content":"Only Stable Diffusion WebUI, Fooocus, and SD Trainer offer variants. For the repositories and branches available to each type, see Supported variants.","locale":"en"},"6705":{"id":"/en/docs/instance-variants-10","page_id":"/en/docs/instance-variants","tags":[],"type":"text","url":"/en/docs/instance-variants","content":"The page marks two values separately:","locale":"en"},"6706":{"id":"/en/docs/instance-variants-11","page_id":"/en/docs/instance-variants","tags":[],"type":"text","url":"/en/docs/instance-variants","content":"“Current”: the variant that actually matches the Core repository now;","locale":"en"},"6707":{"id":"/en/docs/instance-variants-12","page_id":"/en/docs/instance-variants","tags":[],"type":"text","url":"/en/docs/instance-variants","content":"“Reinstallation”: the variant saved in the instance record and used for future reinstalls.","locale":"en"},"6708":{"id":"/en/docs/instance-variants-13","page_id":"/en/docs/instance-variants","tags":[],"type":"text","url":"/en/docs/instance-variants","content":"When the two values differ, the page offers to synchronize the reinstallation setting.","locale":"en"},"6709":{"id":"/en/docs/instance-variants-14","page_id":"/en/docs/instance-variants","tags":[],"type":"text","url":"/en/docs/instance-variants#back-up-the-current-state","content":"Create a snapshot, and separately back up uncommitted code, extension configuration, and important user files. Switching variants may forcibly change the working tree.","locale":"en"},"6710":{"id":"/en/docs/instance-variants-15","page_id":"/en/docs/instance-variants","tags":[],"type":"text","url":"/en/docs/instance-variants#stop-the-webui","content":"The WebUI must be stopped before switching variants. Wait until runtime status in “Instance Information” returns to “Not Running.”","locale":"en"},"6711":{"id":"/en/docs/instance-variants-16","page_id":"/en/docs/instance-variants","tags":[],"type":"text","url":"/en/docs/instance-variants#check-the-target-source","content":"Review the variant name, repository URL, branch, and whether it includes submodules. Do not assume from the name alone that it is compatible with your current extensions or model workflows.","locale":"en"},"6712":{"id":"/en/docs/instance-variants-17","page_id":"/en/docs/instance-variants","tags":[],"type":"text","url":"/en/docs/instance-variants#select-switch-and-confirm","content":"The confirmation dialog shows the repository and branch again. After you accept, the app starts a version-switch task and, on success, saves that variant as the reinstallation configuration.","locale":"en"},"6713":{"id":"/en/docs/instance-variants-18","page_id":"/en/docs/instance-variants","tags":[],"type":"text","url":"/en/docs/instance-variants#verify-the-variant","content":"Refresh the page and confirm that “Current” and “Reinstallation” both point to the target variant. Then check the branch and commit on the Versions page before launching the WebUI.","locale":"en"},"6714":{"id":"/en/docs/instance-variants-19","page_id":"/en/docs/instance-variants","tags":[],"type":"text","url":"/en/docs/instance-variants#synchronize-only-the-reinstallation-configuration","content":"If you changed Core outside the app and the “Current” and “Reinstall” labels point to different variants, select “Sync reinstall setting” on the current variant. Back up uncommitted edits and stop the WebUI first. Confirming checks out the target branch again from the displayed repository and forces the working tree back to that branch. Uncommitted edits can be lost. The app saves the variant for future reinstalls once the task succeeds.","locale":"en"},"6715":{"id":"/en/docs/instance-variants-20","page_id":"/en/docs/instance-variants","tags":[],"type":"text","url":"/en/docs/instance-variants#synchronize-only-the-reinstallation-configuration","content":"Switching variants may replace the remote repository and forcibly switch to the target branch.\nConfirmation in the interface is not a substitute for a backup. Commit changes you need to\npreserve to your own repository, or export them as a patch first.","locale":"en"},"6716":{"id":"/en/docs/instance-variants-21","page_id":"/en/docs/instance-variants","tags":[],"type":"text","url":"/en/docs/instance-variants#synchronize-only-the-reinstallation-configuration","content":"To update or locate a commit within the same repository, use WebUI Versions.","locale":"en"},"6717":{"id":"/en/docs/instance-versions","page_id":"/en/docs/instance-versions","type":"page","content":"WebUI Versions","breadcrumbs":["Hanafubuki Documentation","Instance Management"],"tags":[],"url":"/en/docs/instance-versions","locale":"en"},"6718":{"id":"/en/docs/instance-versions-0","page_id":"/en/docs/instance-versions","tags":[],"type":"text","url":"/en/docs/instance-versions","content":"Update a WebUI, or switch branches, commits, and package versions on supported instances.","locale":"en"},"6719":{"id":"/en/docs/instance-versions-1","page_id":"/en/docs/instance-versions","type":"heading","tags":[],"url":"/en/docs/instance-versions#git-based-webuis","content":"Git-based WebUIs","locale":"en"},"6720":{"id":"/en/docs/instance-versions-2","page_id":"/en/docs/instance-versions","type":"heading","tags":[],"url":"/en/docs/instance-versions#create-a-snapshot-and-back-up-code","content":"Create a snapshot and back up code","locale":"en"},"6721":{"id":"/en/docs/instance-versions-3","page_id":"/en/docs/instance-versions","type":"heading","tags":[],"url":"/en/docs/instance-versions#stop-the-webui","content":"Stop the WebUI","locale":"en"},"6722":{"id":"/en/docs/instance-versions-4","page_id":"/en/docs/instance-versions","type":"heading","tags":[],"url":"/en/docs/instance-versions#choose-an-operation","content":"Choose an operation","locale":"en"},"6723":{"id":"/en/docs/instance-versions-5","page_id":"/en/docs/instance-versions","type":"heading","tags":[],"url":"/en/docs/instance-versions#confirm-the-local-changes-warning","content":"Confirm the local-changes warning","locale":"en"},"6724":{"id":"/en/docs/instance-versions-6","page_id":"/en/docs/instance-versions","type":"heading","tags":[],"url":"/en/docs/instance-versions#track-and-verify","content":"Track and verify","locale":"en"},"6725":{"id":"/en/docs/instance-versions-7","page_id":"/en/docs/instance-versions","type":"heading","tags":[],"url":"/en/docs/instance-versions#invokeai-package-versions","content":"InvokeAI package versions","locale":"en"},"6726":{"id":"/en/docs/instance-versions-8","page_id":"/en/docs/instance-versions","tags":[],"type":"text","url":"/en/docs/instance-versions","content":"The “Versions” page varies by WebUI type. Git-based instances such as Stable Diffusion WebUI, ComfyUI, Fooocus, SD Trainer, Qwen TTS WebUI, RVC Next WebUI, and Mizuoto TTS WebUI show repository branches and commits. InvokeAI shows installed and available package versions.","locale":"en"},"6727":{"id":"/en/docs/instance-versions-9","page_id":"/en/docs/instance-versions","tags":[],"type":"text","url":"/en/docs/instance-versions#git-based-webuis","content":"The page shows the current branch, commit, commit date, and the number of commits ahead of or behind the remote branch. Update notices may also summarize available extension and PyTorch updates.","locale":"en"},"6728":{"id":"/en/docs/instance-versions-10","page_id":"/en/docs/instance-versions","tags":[],"type":"text","url":"/en/docs/instance-versions#git-based-webuis","content":"With daily instance update checks enabled, the app checks ready built-in WebUIs. Use the refresh button on an instance card to check that instance now. An extension-provided type may also offer Git version management here for switching branches and commits. Run the type's own update from Maintenance.","locale":"en"},"6729":{"id":"/en/docs/instance-versions-11","page_id":"/en/docs/instance-versions","tags":[],"type":"text","url":"/en/docs/instance-versions#create-a-snapshot-and-back-up-code","content":"Create an environment snapshot first. If you have modified Core files, also copy a patch, commit the changes to a personal branch, or back them up separately. Snapshot restoration and some switch operations can reset the Git working tree.","locale":"en"},"6730":{"id":"/en/docs/instance-versions-12","page_id":"/en/docs/instance-versions","tags":[],"type":"text","url":"/en/docs/instance-versions#stop-the-webui","content":"Ordinary version operations do not always require a stopped process, but changing code after stopping it makes it easier to ensure that the next launch uses one consistent set of files.","locale":"en"},"6731":{"id":"/en/docs/instance-versions-13","page_id":"/en/docs/instance-versions","tags":[],"type":"text","url":"/en/docs/instance-versions#choose-an-operation","content":"Use “Update Current Branch” to fetch and update the current branch, or select a specific commit from the history. “Switch Branch” lists references already on disk, then fetches remote branches. If the fetch fails, you can still select a listed branch or reload the list. Confirm the selected branch to start the switch.","locale":"en"},"6732":{"id":"/en/docs/instance-versions-14","page_id":"/en/docs/instance-versions","tags":[],"type":"text","url":"/en/docs/instance-versions#confirm-the-local-changes-warning","content":"If the repository contains uncommitted changes, the interface asks for confirmation. Continuing does not guarantee that those changes will be preserved. Cancel and back them up first if loss or conflicts would be unacceptable.","locale":"en"},"6733":{"id":"/en/docs/instance-versions-15","page_id":"/en/docs/instance-versions","tags":[],"type":"text","url":"/en/docs/instance-versions#track-and-verify","content":"Wait for the task to finish in the bottom-right status area or Task Center. Refresh the Versions page to confirm the new branch and commit, then launch the WebUI and check extension and dependency compatibility.","locale":"en"},"6734":{"id":"/en/docs/instance-versions-16","page_id":"/en/docs/instance-versions","tags":[],"type":"text","url":"/en/docs/instance-versions#invokeai-package-versions","content":"The InvokeAI Versions page shows the current version, latest stable version, available versions, and prerelease labels. Selecting a version installs that version. “Upgrade” installs the target version determined by the current rules.","locale":"en"},"6735":{"id":"/en/docs/instance-versions-17","page_id":"/en/docs/instance-versions","tags":[],"type":"text","url":"/en/docs/instance-versions#invokeai-package-versions","content":"Prefer the latest stable version unless you need to test new features. Do not select a version marked “Prerelease” otherwise.","locale":"en"},"6736":{"id":"/en/docs/instance-versions-18","page_id":"/en/docs/instance-versions","tags":[],"type":"text","url":"/en/docs/instance-versions#invokeai-package-versions","content":"Package installation modifies the instance Python environment. Stop the WebUI first, then check PyTorch and launch status after the task finishes.","locale":"en"},"6737":{"id":"/en/docs/instance-versions-19","page_id":"/en/docs/instance-versions","tags":[],"type":"text","url":"/en/docs/instance-versions#invokeai-package-versions","content":"If the list is empty or fails to refresh, check the network, PyPI mirror, and instance management API.","locale":"en"},"6738":{"id":"/en/docs/instance-versions-20","page_id":"/en/docs/instance-versions","tags":[],"type":"text","url":"/en/docs/instance-versions#invokeai-package-versions","content":"Git operations manage only the code repository. They do not protect models, outputs,\nconfiguration, or uncommitted code. Prepare both an environment snapshot and a separate file\nbackup before switching.","locale":"en"},"6739":{"id":"/en/docs/instance-versions-21","page_id":"/en/docs/instance-versions","tags":[],"type":"text","url":"/en/docs/instance-versions#invokeai-package-versions","content":"To change a preset repository-and-branch combination, read WebUI Variants.","locale":"en"},"6740":{"id":"/en/docs/quick-start","page_id":"/en/docs/quick-start","type":"page","content":"Quick start","breadcrumbs":["Hanafubuki Documentation","Getting Started"],"tags":[],"url":"/en/docs/quick-start","locale":"en"},"6741":{"id":"/en/docs/quick-start-0","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start","content":"Create and launch your first WebUI instance with the shortest workflow.","locale":"en"},"6742":{"id":"/en/docs/quick-start-1","page_id":"/en/docs/quick-start","type":"heading","tags":[],"url":"/en/docs/quick-start#wait-for-the-runtime-environment","content":"Wait for the runtime environment","locale":"en"},"6743":{"id":"/en/docs/quick-start-2","page_id":"/en/docs/quick-start","type":"heading","tags":[],"url":"/en/docs/quick-start#add-an-instance","content":"Add an instance","locale":"en"},"6744":{"id":"/en/docs/quick-start-3","page_id":"/en/docs/quick-start","type":"heading","tags":[],"url":"/en/docs/quick-start#complete-the-installation","content":"Complete the installation","locale":"en"},"6745":{"id":"/en/docs/quick-start-4","page_id":"/en/docs/quick-start","type":"heading","tags":[],"url":"/en/docs/quick-start#launch-the-webui","content":"Launch the WebUI","locale":"en"},"6746":{"id":"/en/docs/quick-start-5","page_id":"/en/docs/quick-start","type":"heading","tags":[],"url":"/en/docs/quick-start#manage-the-instance","content":"Manage the instance","locale":"en"},"6747":{"id":"/en/docs/quick-start-6","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#wait-for-the-runtime-environment","content":"On the first launch, wait for Python, Micromamba, and Git to finish preparing. If a runtime environment error appears at the top of the window or on Home, go to “Settings → Runtime Environment” first.","locale":"en"},"6748":{"id":"/en/docs/quick-start-7","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#add-an-instance","content":"Select “Add Instance” on Home. New users will usually choose “New Installation.” If you already have a WebUI, choose “Import Existing Instance” or “Scan System.”","locale":"en"},"6749":{"id":"/en/docs/quick-start-8","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#complete-the-installation","content":"Select the WebUI type and installation directory. Keep the default Python, PyTorch, and branch settings to get started. Installation progress takes over the instance workspace and provides task output, cancellation, and retry after failure.","locale":"en"},"6750":{"id":"/en/docs/quick-start-9","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#launch-the-webui","content":"Keep the workspace open after installation. It launches the WebUI automatically when the required services are ready. Opening the workspace of a ready instance later also starts it. If you see a PyTorch or dependency-conflict prompt, choose how to proceed. Once the workspace detects the address, you can open the WebUI. To adjust arguments, go to “Run → Launch.” Switch between running WebUIs from WebUI Tabs in the title bar.","locale":"en"},"6751":{"id":"/en/docs/quick-start-10","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#manage-the-instance","content":"Use Instance Management to maintain versions, extensions, models, snapshots, and paths. Long-running tasks are reported in the bottom-right status area. You can also open Task Center from the title bar to inspect their output.","locale":"en"},"6752":{"id":"/en/docs/quick-start-11","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#manage-the-instance","content":"<Card title=\"Installation methods\" href=\"/docs/webui-install\" description=\"Compare a new installation, import, system scan, and snapshot recovery.\" />","locale":"en"},"6753":{"id":"/en/docs/quick-start-12","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#manage-the-instance","content":"<Card title=\"Instance Management\" href=\"/docs/instance-management\" description=\"Learn about every management section available for an instance.\" />","locale":"en"},"6754":{"id":"/en/docs/settings-about-updates","page_id":"/en/docs/settings-about-updates","type":"page","content":"About and Updates","breadcrumbs":["Hanafubuki Documentation","Settings"],"tags":[],"url":"/en/docs/settings-about-updates","locale":"en"},"6755":{"id":"/en/docs/settings-about-updates-0","page_id":"/en/docs/settings-about-updates","tags":[],"type":"text","url":"/en/docs/settings-about-updates","content":"View the application version and project links, and check for updates.","locale":"en"},"6756":{"id":"/en/docs/settings-about-updates-1","page_id":"/en/docs/settings-about-updates","type":"heading","tags":[],"url":"/en/docs/settings-about-updates#checking-for-updates","content":"Checking for updates","locale":"en"},"6757":{"id":"/en/docs/settings-about-updates-2","page_id":"/en/docs/settings-about-updates","type":"heading","tags":[],"url":"/en/docs/settings-about-updates#installing-a-signed-update","content":"Installing a signed update","locale":"en"},"6758":{"id":"/en/docs/settings-about-updates-3","page_id":"/en/docs/settings-about-updates","type":"heading","tags":[],"url":"/en/docs/settings-about-updates#updating-the-portable-edition","content":"Updating the portable edition","locale":"en"},"6759":{"id":"/en/docs/settings-about-updates-4","page_id":"/en/docs/settings-about-updates","tags":[],"type":"text","url":"/en/docs/settings-about-updates","content":"The **About** page shows the current Hanafubuki version and links to the project repository, author, and related WebUI documentation. External links open in the system browser rather than replacing the application window.","locale":"en"},"6760":{"id":"/en/docs/settings-about-updates-5","page_id":"/en/docs/settings-about-updates","tags":[],"type":"text","url":"/en/docs/settings-about-updates#checking-for-updates","content":"In non-portable mode, the application checks for updates in the background about once an hour. Turn this off with **Check for application updates automatically** in Automation. Either way, you can click **Check for updates** on the About page to check immediately. Progress and results appear in the lower-right corner of the settings window.","locale":"en"},"6761":{"id":"/en/docs/settings-about-updates-6","page_id":"/en/docs/settings-about-updates","tags":[],"type":"text","url":"/en/docs/settings-about-updates#checking-for-updates","content":"An update check can have three outcomes:","locale":"en"},"6762":{"id":"/en/docs/settings-about-updates-7","page_id":"/en/docs/settings-about-updates","tags":[],"type":"text","url":"/en/docs/settings-about-updates#checking-for-updates","content":"Result","locale":"en"},"6763":{"id":"/en/docs/settings-about-updates-8","page_id":"/en/docs/settings-about-updates","tags":[],"type":"text","url":"/en/docs/settings-about-updates#checking-for-updates","content":"Next step","locale":"en"},"6764":{"id":"/en/docs/settings-about-updates-9","page_id":"/en/docs/settings-about-updates","tags":[],"type":"text","url":"/en/docs/settings-about-updates#checking-for-updates","content":"Signed update available","locale":"en"},"6765":{"id":"/en/docs/settings-about-updates-10","page_id":"/en/docs/settings-about-updates","tags":[],"type":"text","url":"/en/docs/settings-about-updates#checking-for-updates","content":"The application has downloaded and verified an update for the current installation type; confirm installation and restart","locale":"en"},"6766":{"id":"/en/docs/settings-about-updates-11","page_id":"/en/docs/settings-about-updates","tags":[],"type":"text","url":"/en/docs/settings-about-updates#checking-for-updates","content":"Manual installer available","locale":"en"},"6767":{"id":"/en/docs/settings-about-updates-12","page_id":"/en/docs/settings-about-updates","tags":[],"type":"text","url":"/en/docs/settings-about-updates#checking-for-updates","content":"Automatic updating is unavailable or verification failed; choose an installer for the current platform and download it in the browser","locale":"en"},"6768":{"id":"/en/docs/settings-about-updates-13","page_id":"/en/docs/settings-about-updates","tags":[],"type":"text","url":"/en/docs/settings-about-updates#checking-for-updates","content":"Up to date or unavailable","locale":"en"},"6769":{"id":"/en/docs/settings-about-updates-14","page_id":"/en/docs/settings-about-updates","tags":[],"type":"text","url":"/en/docs/settings-about-updates#checking-for-updates","content":"No action is needed, or inspect the network, proxy, and update source according to the error","locale":"en"},"6770":{"id":"/en/docs/settings-about-updates-15","page_id":"/en/docs/settings-about-updates","tags":[],"type":"text","url":"/en/docs/settings-about-updates#checking-for-updates","content":"Signed updates are supported for Windows NSIS installations, Linux AppImages, and macOS app bundles. Other installation formats use the manual installer list. The list shows packages for your platform and marks the recommended option. Clicking Download opens the release address in your system browser.","locale":"en"},"6771":{"id":"/en/docs/settings-about-updates-16","page_id":"/en/docs/settings-about-updates","tags":[],"type":"text","url":"/en/docs/settings-about-updates#installing-a-signed-update","content":"Click **Check for updates** and wait for the check, download, and signature verification to\nfinish.","locale":"en"},"6772":{"id":"/en/docs/settings-about-updates-17","page_id":"/en/docs/settings-about-updates","tags":[],"type":"text","url":"/en/docs/settings-about-updates#installing-a-signed-update","content":"Allow the application to shut down in order; do not force-terminate it while the installer is\nrunning.","locale":"en"},"6773":{"id":"/en/docs/settings-about-updates-18","page_id":"/en/docs/settings-about-updates","tags":[],"type":"text","url":"/en/docs/settings-about-updates#installing-a-signed-update","content":"After the application restarts, return to **About**, confirm the new version, and inspect the\nruntime state.","locale":"en"},"6774":{"id":"/en/docs/settings-about-updates-19","page_id":"/en/docs/settings-about-updates","tags":[],"type":"text","url":"/en/docs/settings-about-updates#installing-a-signed-update","content":"Once a signed update is ready, the main window also offers **Restart and update now**. If you keep working and quit normally, Hanafubuki defers the installation until the next launch. It checks again then and installs the signed update currently available.","locale":"en"},"6775":{"id":"/en/docs/settings-about-updates-20","page_id":"/en/docs/settings-about-updates","tags":[],"type":"text","url":"/en/docs/settings-about-updates#installing-a-signed-update","content":"If automatic installation fails, the application attempts to provide a manual installer. Exit the application completely before installing it normally for the current platform; do not run the old application and installer at the same time.","locale":"en"},"6776":{"id":"/en/docs/settings-about-updates-21","page_id":"/en/docs/settings-about-updates","tags":[],"type":"text","url":"/en/docs/settings-about-updates#updating-the-portable-edition","content":"The Launcher handles portable updates. Finish your tasks, quit the main application, and reopen the Launcher from its original directory with the adjacent `.hanafubuki-launcher` workspace in place. It checks both its own version and the application's, downloads or repairs program files as needed, and starts the application. If the release service is unavailable, the Launcher tries to start the existing local application. See the installation guide for the directory layout.","locale":"en"},"6777":{"id":"/en/docs/settings-agent","page_id":"/en/docs/settings-agent","type":"page","content":"Agent Settings","breadcrumbs":["Hanafubuki Documentation","Settings"],"tags":[],"url":"/en/docs/settings-agent","locale":"en"},"6778":{"id":"/en/docs/settings-agent-0","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent","content":"Configure models, permissions, memory, network tools, MCP, and Skills.","locale":"en"},"6779":{"id":"/en/docs/settings-agent-1","page_id":"/en/docs/settings-agent","type":"heading","tags":[],"url":"/en/docs/settings-agent#recommended-configuration-order","content":"Recommended configuration order","locale":"en"},"6780":{"id":"/en/docs/settings-agent-2","page_id":"/en/docs/settings-agent","type":"heading","tags":[],"url":"/en/docs/settings-agent#add-a-provider-and-choose-a-model","content":"Add a provider and choose a model","locale":"en"},"6781":{"id":"/en/docs/settings-agent-3","page_id":"/en/docs/settings-agent","type":"heading","tags":[],"url":"/en/docs/settings-agent#choose-a-permission-mode","content":"Choose a permission mode","locale":"en"},"6782":{"id":"/en/docs/settings-agent-4","page_id":"/en/docs/settings-agent","type":"heading","tags":[],"url":"/en/docs/settings-agent#decide-whether-to-use-memory","content":"Decide whether to use memory","locale":"en"},"6783":{"id":"/en/docs/settings-agent-5","page_id":"/en/docs/settings-agent","type":"heading","tags":[],"url":"/en/docs/settings-agent#configure-built-in-network-tools","content":"Configure built-in network tools","locale":"en"},"6784":{"id":"/en/docs/settings-agent-6","page_id":"/en/docs/settings-agent","type":"heading","tags":[],"url":"/en/docs/settings-agent#add-mcp-and-skills-as-needed","content":"Add MCP and Skills as needed","locale":"en"},"6785":{"id":"/en/docs/settings-agent-7","page_id":"/en/docs/settings-agent","type":"heading","tags":[],"url":"/en/docs/settings-agent#agent-plugins-and-hooks","content":"Agent plugins and hooks","locale":"en"},"6786":{"id":"/en/docs/settings-agent-8","page_id":"/en/docs/settings-agent","type":"heading","tags":[],"url":"/en/docs/settings-agent#conversation-roles","content":"Conversation roles","locale":"en"},"6787":{"id":"/en/docs/settings-agent-9","page_id":"/en/docs/settings-agent","type":"heading","tags":[],"url":"/en/docs/settings-agent#saving-and-scope-of-effect","content":"Saving and scope of effect","locale":"en"},"6788":{"id":"/en/docs/settings-agent-10","page_id":"/en/docs/settings-agent","type":"heading","tags":[],"url":"/en/docs/settings-agent#continue-reading","content":"Continue reading","locale":"en"},"6789":{"id":"/en/docs/settings-agent-11","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent","content":"Open **Settings → Agent**, or type `/config` in chat. Choose a category tab, then open an entry for its settings. The model category holds providers and the default model. The plugins category shows permissions requested by installed packages. The separate **Skills** tab lets you create, edit, or install Skills. To start a conversation, enable at least one provider and select a model. You can also choose a different model for an individual session.","locale":"en"},"6790":{"id":"/en/docs/settings-agent-12","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent","content":"The application continues to own its proxy, log level, appearance, module switches, and desktop workspaces. The standalone Agent's terminal interface and configuration layers are not part of the desktop host's catalog.","locale":"en"},"6791":{"id":"/en/docs/settings-agent-13","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent#add-a-provider-and-choose-a-model","content":"Add a provider matching the server protocol, enter its API address and credentials, and save. After enabling the provider, choose the default provider and model in the separate model policy, then configure reasoning effort, context window, image input, and compaction policy.","locale":"en"},"6792":{"id":"/en/docs/settings-agent-14","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent#choose-a-permission-mode","content":"Global settings control tool approvals and the command sandbox separately. In chat, open the permission menu beside the message box or type `/permissions` to see both and select a preset for the current session. **Read only** prevents commands from writing files. **Full access** disables the command sandbox and grants routine approvals. If the Windows sandbox needs setup, use the action in the menu or open its settings with `/setup-default-sandbox`.","locale":"en"},"6793":{"id":"/en/docs/settings-agent-15","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent#decide-whether-to-use-memory","content":"Cross-session memory is off by default. Turning it on enables both reading existing memory and generating memory from sessions unless you change their individual switches. **Exclude external context** is off by default. Turning it on excludes sessions that used web or MCP tool output from contributing memory. Resetting clears existing memory.","locale":"en"},"6794":{"id":"/en/docs/settings-agent-16","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent#configure-built-in-network-tools","content":"Choose a search policy in the network tools settings, then configure engines, service endpoints and keys, research, and extraction fallbacks in the plugin options. Reranking and embedding share the endpoint and key settings supplied by the Agent. Fields come from each plugin's registered configuration; their application timing is shown beside them.","locale":"en"},"6795":{"id":"/en/docs/settings-agent-17","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent#add-mcp-and-skills-as-needed","content":"Connect only trusted MCP servers and grant tools the minimum permissions. Review a Skill's instructions, scripts, and resources before installation. When finished, create a test session to verify the actual capabilities.","locale":"en"},"6796":{"id":"/en/docs/settings-agent-18","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent#agent-plugins-and-hooks","content":"Open **Plugins → Installed plugins**, or type `/plugins` in chat. Install from a local directory or enter `PLUGIN@MARKETPLACE` from a source you have added under **Marketplaces**. Open an installed entry to enable, disable, update, or retry loading it. **Delete** uninstalls the plugin and retains its data. **Purge** also deletes its data. **Plugin defaults** applies to packages without an explicit enablement setting. Disabling a marketplace disables its plugins.","locale":"en"},"6797":{"id":"/en/docs/settings-agent-19","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent#agent-plugins-and-hooks","content":"If a process plugin is waiting for a grant, open **Plugins → Package permissions**. Compare its requested network access, workspace access, and environment variable names with its grants. **Grant these permissions** asks you to confirm the displayed set. If hooks are waiting for trust, you can trust the package's hooks from its entry, or open `/hooks` to inspect each event, command, and timeout before enabling or trusting a hook individually.","locale":"en"},"6798":{"id":"/en/docs/settings-agent-20","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent#conversation-roles","content":"**Models → Roles** lists roles and any configuration problems. Create a role to choose a base role, append or replace inherited instructions, select a model, limit tools, or set a permission ceiling. The spawnable setting controls whether other agents can start a child in that role. When the conversation is idle, type `/role` to choose the role it will use.","locale":"en"},"6799":{"id":"/en/docs/settings-agent-21","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent#conversation-roles","content":"For a read-only role, select **Copy to a user role** in the role entry before editing the copy. Under **Models → Role source files**, you can inspect the source path, edit a writable user role file, or create your own.","locale":"en"},"6800":{"id":"/en/docs/settings-agent-22","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent#saving-and-scope-of-effect","content":"Use `/warnings` to check for configuration warnings. Save each settings section or collection record before closing it.","locale":"en"},"6801":{"id":"/en/docs/settings-agent-23","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent#saving-and-scope-of-effect","content":"Fields show their effective source, application timing, and configuration issues. Reset removes the user's override.","locale":"en"},"6802":{"id":"/en/docs/settings-agent-24","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent#saving-and-scope-of-effect","content":"Saved secrets are masked by default. Use the control beside a field to reveal its value. Editing other fields preserves the saved secret. A failed save keeps the draft.","locale":"en"},"6803":{"id":"/en/docs/settings-agent-25","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent#saving-and-scope-of-effect","content":"MCP servers, MCP credentials, and Skills have their own management operations and are not part of the ordinary **Restore defaults** action.","locale":"en"},"6804":{"id":"/en/docs/settings-agent-26","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent#saving-and-scope-of-effect","content":"A session retains its model selection. Each new turn reads the available Skills, and each model sampling step uses the tool list it started with.","locale":"en"},"6805":{"id":"/en/docs/settings-agent-27","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent#saving-and-scope-of-effect","content":"Provider tokens, custom authentication headers, and MCP credentials are sensitive. Do not place\nthem in prompts, project files, or screenshots. Diagnostics exclude known credential documents,\nbut do not redact every other collected item individually. Review a diagnostic bundle before\nsharing it.","locale":"en"},"6806":{"id":"/en/docs/settings-agent-28","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent#continue-reading","content":"<Card title=\"Agent Quick Start\" href=\"/docs/agent\" description=\"Complete the first configuration and session.\" />","locale":"en"},"6807":{"id":"/en/docs/settings-agent-29","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent#continue-reading","content":"<Card title=\"Providers and Models\" href=\"/docs/agent-providers-models\" description=\"Understand protocols, model capabilities, and context.\" />","locale":"en"},"6808":{"id":"/en/docs/settings-agent-30","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent#continue-reading","content":"<Card title=\"Session Management\" href=\"/docs/agent-conversations\" description=\"Manage history, archiving, deletion, and forks.\" />","locale":"en"},"6809":{"id":"/en/docs/settings-agent-31","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent#continue-reading","content":"<Card title=\"Permissions and Approvals\" href=\"/docs/agent-permissions\" description=\"Choose a permission mode and review operation targets.\" />","locale":"en"},"6810":{"id":"/en/docs/settings-agent-32","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent#continue-reading","content":"<Card title=\"MCP\" href=\"/docs/agent-mcp\" description=\"Configure external servers, connections, and tool policies.\" />","locale":"en"},"6811":{"id":"/en/docs/settings-agent-33","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent#continue-reading","content":"<Card title=\"Skills\" href=\"/docs/agent-skills\" description=\"Install reusable workflows and select them for sessions.\" />","locale":"en"},"6812":{"id":"/en/docs/settings-agent-34","page_id":"/en/docs/settings-agent","tags":[],"type":"text","url":"/en/docs/settings-agent#continue-reading","content":"<Card title=\"Memory\" href=\"/docs/agent-memory\" description=\"Manage retrieval, generation, contribution, and reset.\" />","locale":"en"},"6813":{"id":"/en/docs/settings-api-servers","page_id":"/en/docs/settings-api-servers","type":"page","content":"API Servers","breadcrumbs":["Hanafubuki Documentation","Settings"],"tags":[],"url":"/en/docs/settings-api-servers","locale":"en"},"6814":{"id":"/en/docs/settings-api-servers-0","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers","content":"Inspect the status, health checks, and automatic restarts of the app's and each instance's API server, and start, restart, or stop them manually.","locale":"en"},"6815":{"id":"/en/docs/settings-api-servers-1","page_id":"/en/docs/settings-api-servers","type":"heading","tags":[],"url":"/en/docs/settings-api-servers#server-list","content":"Server list","locale":"en"},"6816":{"id":"/en/docs/settings-api-servers-2","page_id":"/en/docs/settings-api-servers","type":"heading","tags":[],"url":"/en/docs/settings-api-servers#status-and-details","content":"Status and details","locale":"en"},"6817":{"id":"/en/docs/settings-api-servers-3","page_id":"/en/docs/settings-api-servers","type":"heading","tags":[],"url":"/en/docs/settings-api-servers#health-checks-and-automatic-restarts","content":"Health checks and automatic restarts","locale":"en"},"6818":{"id":"/en/docs/settings-api-servers-4","page_id":"/en/docs/settings-api-servers","type":"heading","tags":[],"url":"/en/docs/settings-api-servers#manual-operations","content":"Manual operations","locale":"en"},"6819":{"id":"/en/docs/settings-api-servers-5","page_id":"/en/docs/settings-api-servers","type":"heading","tags":[],"url":"/en/docs/settings-api-servers#management-mcp-server","content":"Management MCP server","locale":"en"},"6820":{"id":"/en/docs/settings-api-servers-6","page_id":"/en/docs/settings-api-servers","type":"heading","tags":[],"url":"/en/docs/settings-api-servers#troubleshooting","content":"Troubleshooting","locale":"en"},"6821":{"id":"/en/docs/settings-api-servers-7","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers","content":"The application and built-in instances use background API servers for operations such as installation, version switching, and plugin and model management. Open this page to inspect the services or run a health check when a task stops responding. Connection settings for the management MCP server appear below the list.","locale":"en"},"6822":{"id":"/en/docs/settings-api-servers-8","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#server-list","content":"The **App** server appears first, followed by instance servers known to the supervisor. An instance's control server uses its name. If its type declares more server roles, you can see multiple rows for the same instance, labelled **instance name · role**.","locale":"en"},"6823":{"id":"/en/docs/settings-api-servers-9","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#server-list","content":"Server","locale":"en"},"6824":{"id":"/en/docs/settings-api-servers-10","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#server-list","content":"When it runs","locale":"en"},"6825":{"id":"/en/docs/settings-api-servers-11","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#server-list","content":"App","locale":"en"},"6826":{"id":"/en/docs/settings-api-servers-12","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#server-list","content":"Runs while the application is open and never stops for being idle","locale":"en"},"6827":{"id":"/en/docs/settings-api-servers-13","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#server-list","content":"Instance control server","locale":"en"},"6828":{"id":"/en/docs/settings-api-servers-14","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#server-list","content":"Starts on demand, stays up while in use, and stops after about 3 minutes idle","locale":"en"},"6829":{"id":"/en/docs/settings-api-servers-15","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#server-list","content":"Other instance server role","locale":"en"},"6830":{"id":"/en/docs/settings-api-servers-16","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#server-list","content":"Runs as part of the type's launch process and stays up past the 3-minute idle threshold","locale":"en"},"6831":{"id":"/en/docs/settings-api-servers-17","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#server-list","content":"An instance server showing **Stopped** is normal. It starts automatically the next time it is needed, so you do not have to start it yourself.","locale":"en"},"6832":{"id":"/en/docs/settings-api-servers-18","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#status-and-details","content":"The badge beside each server shows its current state. A running server is labeled by its health checks:","locale":"en"},"6833":{"id":"/en/docs/settings-api-servers-19","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#status-and-details","content":"Badge","locale":"en"},"6834":{"id":"/en/docs/settings-api-servers-20","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#status-and-details","content":"Meaning","locale":"en"},"6835":{"id":"/en/docs/settings-api-servers-21","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#status-and-details","content":"Running","locale":"en"},"6836":{"id":"/en/docs/settings-api-servers-22","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#status-and-details","content":"The latest health check succeeded","locale":"en"},"6837":{"id":"/en/docs/settings-api-servers-23","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#status-and-details","content":"Checks failing","locale":"en"},"6838":{"id":"/en/docs/settings-api-servers-24","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-