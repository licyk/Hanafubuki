ge_id":"/docs/agent-mcp","tags":[],"type":"text","url":"/docs/agent-mcp#常见问题","content":"工具一直等待","locale":"zh-CN"},"136":{"id":"/docs/agent-mcp-44","page_id":"/docs/agent-mcp","tags":[],"type":"text","url":"/docs/agent-mcp#常见问题","content":"调用超时、并发上限、审批卡片和服务端响应","locale":"zh-CN"},"137":{"id":"/docs/agent-mcp-45","page_id":"/docs/agent-mcp","tags":[],"type":"text","url":"/docs/agent-mcp#常见问题","content":"停止后仍提示清理","locale":"zh-CN"},"138":{"id":"/docs/agent-mcp-46","page_id":"/docs/agent-mcp","tags":[],"type":"text","url":"/docs/agent-mcp#常见问题","content":"使用运行态面板重试断开，不要立即删除配置","locale":"zh-CN"},"139":{"id":"/docs/agent-mcp-47","page_id":"/docs/agent-mcp","tags":[],"type":"text","url":"/docs/agent-mcp#常见问题","content":"Web 或 MCP\n工具成功返回内容后，当前会话会被标记为包含外部内容，不能再贡献持久记忆。这样可以避免未经核实的外部数据进入项目记忆。","locale":"zh-CN"},"140":{"id":"/docs/agent-memory","page_id":"/docs/agent-memory","type":"page","content":"记忆","breadcrumbs":["Hanafubuki 文档","Agent"],"tags":[],"url":"/docs/agent-memory","locale":"zh-CN"},"141":{"id":"/docs/agent-memory-0","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory","content":"控制跨会话记忆的读取、生成、贡献和重置。","locale":"zh-CN"},"142":{"id":"/docs/agent-memory-1","page_id":"/docs/agent-memory","type":"heading","tags":[],"url":"/docs/agent-memory#全局设置","content":"全局设置","locale":"zh-CN"},"143":{"id":"/docs/agent-memory-2","page_id":"/docs/agent-memory","type":"heading","tags":[],"url":"/docs/agent-memory#当前会话的贡献状态","content":"当前会话的贡献状态","locale":"zh-CN"},"144":{"id":"/docs/agent-memory-3","page_id":"/docs/agent-memory","type":"heading","tags":[],"url":"/docs/agent-memory#使用与生成的区别","content":"使用与生成的区别","locale":"zh-CN"},"145":{"id":"/docs/agent-memory-4","page_id":"/docs/agent-memory","type":"heading","tags":[],"url":"/docs/agent-memory#agent-能对记忆做什么","content":"Agent 能对记忆做什么","locale":"zh-CN"},"146":{"id":"/docs/agent-memory-5","page_id":"/docs/agent-memory","type":"heading","tags":[],"url":"/docs/agent-memory#归档删除和分叉","content":"归档、删除和分叉","locale":"zh-CN"},"147":{"id":"/docs/agent-memory-6","page_id":"/docs/agent-memory","type":"heading","tags":[],"url":"/docs/agent-memory#重置记忆","content":"重置记忆","locale":"zh-CN"},"148":{"id":"/docs/agent-memory-7","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory","content":"记忆是从会话中整理出的项目知识，用于后续相关任务。它与会话历史不同：历史是原始消息和工具记录，记忆是派生上下文，也不会授予任何文件或工具权限。","locale":"zh-CN"},"149":{"id":"/docs/agent-memory-8","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#全局设置","content":"进入“设置 → Agent → 行为与记忆”，先启用记忆总开关，再配置：","locale":"zh-CN"},"150":{"id":"/docs/agent-memory-9","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#全局设置","content":"选项","locale":"zh-CN"},"151":{"id":"/docs/agent-memory-10","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#全局设置","content":"作用","locale":"zh-CN"},"152":{"id":"/docs/agent-memory-11","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#全局设置","content":"使用记忆","locale":"zh-CN"},"153":{"id":"/docs/agent-memory-12","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#全局设置","content":"在模型请求中加入检索到的相关知识","locale":"zh-CN"},"154":{"id":"/docs/agent-memory-13","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#全局设置","content":"生成记忆","locale":"zh-CN"},"155":{"id":"/docs/agent-memory-14","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#全局设置","content":"允许后台从符合条件的会话整理新记忆","locale":"zh-CN"},"156":{"id":"/docs/agent-memory-15","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#全局设置","content":"排除外部内容","locale":"zh-CN"},"157":{"id":"/docs/agent-memory-16","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#全局设置","content":"防止含 Web 或 MCP 外部内容的会话进入生成来源","locale":"zh-CN"},"158":{"id":"/docs/agent-memory-17","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#全局设置","content":"记忆默认可以保持关闭。开启前先确认项目内容适合长期保留，不要把 Token、私钥、个人数据或短期敏感信息写入希望被记住的消息。","locale":"zh-CN"},"159":{"id":"/docs/agent-memory-18","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#当前会话的贡献状态","content":"执行 `/memory` 可以查看当前会话是否允许贡献记忆，并在允许时切换状态。","locale":"zh-CN"},"160":{"id":"/docs/agent-memory-19","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#当前会话的贡献状态","content":"状态","locale":"zh-CN"},"161":{"id":"/docs/agent-memory-20","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#当前会话的贡献状态","content":"含义","locale":"zh-CN"},"162":{"id":"/docs/agent-memory-21","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#当前会话的贡献状态","content":"已启用","locale":"zh-CN"},"163":{"id":"/docs/agent-memory-22","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#当前会话的贡献状态","content":"会话满足其他条件时可以作为记忆来源","locale":"zh-CN"},"164":{"id":"/docs/agent-memory-23","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#当前会话的贡献状态","content":"已禁用","locale":"zh-CN"},"165":{"id":"/docs/agent-memory-24","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#当前会话的贡献状态","content":"保留会话历史，但不从它生成记忆","locale":"zh-CN"},"166":{"id":"/docs/agent-memory-25","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#当前会话的贡献状态","content":"已污染","locale":"zh-CN"},"167":{"id":"/docs/agent-memory-26","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#当前会话的贡献状态","content":"会话已接收 Web 或 MCP 工具内容，永久排除出记忆来源","locale":"zh-CN"},"168":{"id":"/docs/agent-memory-27","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#当前会话的贡献状态","content":"“已污染”由后端根据成功返回的外部工具结果判定，不是普通开关，不能重新启用。它只阻止该会话贡献记忆，不会删除会话，也不表示外部内容一定有害。","locale":"zh-CN"},"169":{"id":"/docs/agent-memory-28","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#当前会话的贡献状态","content":"会话创建或分叉时，会记录当时是否允许生成记忆。之后可以使用 `/memory` 管理当前会话，但全局关闭记忆时不会进行读取或生成。","locale":"zh-CN"},"170":{"id":"/docs/agent-memory-29","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#使用与生成的区别","content":"“使用记忆”控制当前模型能否读取已有记忆。","locale":"zh-CN"},"171":{"id":"/docs/agent-memory-30","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#使用与生成的区别","content":"“生成记忆”控制符合条件的会话能否成为新记忆来源。","locale":"zh-CN"},"172":{"id":"/docs/agent-memory-31","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#使用与生成的区别","content":"关闭当前会话贡献不会删除已经生成的旧记忆。","locale":"zh-CN"},"173":{"id":"/docs/agent-memory-32","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#使用与生成的区别","content":"压缩会话不会把动态检索到的记忆写入可见消息历史。","locale":"zh-CN"},"174":{"id":"/docs/agent-memory-33","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#使用与生成的区别","content":"Agent 会在每个模型采样步骤重新取得记忆，因此新生成或重置的结果从后续步骤开始生效。","locale":"zh-CN"},"175":{"id":"/docs/agent-memory-34","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#agent-能对记忆做什么","content":"检索分为两部分：每个采样步骤都会带上一份精简摘要作为索引，其余内容按需通过记忆自己的工具读取。","locale":"zh-CN"},"176":{"id":"/docs/agent-memory-35","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#agent-能对记忆做什么","content":"工具","locale":"zh-CN"},"177":{"id":"/docs/agent-memory-36","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#agent-能对记忆做什么","content":"作用","locale":"zh-CN"},"178":{"id":"/docs/agent-memory-37","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#agent-能对记忆做什么","content":"`list_agent_memories`","locale":"zh-CN"},"179":{"id":"/docs/agent-memory-38","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#agent-能对记忆做什么","content":"列出可读的记忆资源及其 id","locale":"zh-CN"},"180":{"id":"/docs/agent-memory-39","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#agent-能对记忆做什么","content":"`search_agent_memories`","locale":"zh-CN"},"181":{"id":"/docs/agent-memory-40","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#agent-能对记忆做什么","content":"按关键词检索，返回 id 和行号","locale":"zh-CN"},"182":{"id":"/docs/agent-memory-41","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#agent-能对记忆做什么","content":"`read_agent_memory`","locale":"zh-CN"},"183":{"id":"/docs/agent-memory-42","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#agent-能对记忆做什么","content":"读取某个资源的指定行范围","locale":"zh-CN"},"184":{"id":"/docs/agent-memory-43","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#agent-能对记忆做什么","content":"`append_agent_memory_note`","locale":"zh-CN"},"185":{"id":"/docs/agent-memory-44","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#agent-能对记忆做什么","content":"记录一条记住、忘记或更新的指令","locale":"zh-CN"},"186":{"id":"/docs/agent-memory-45","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#agent-能对记忆做什么","content":"记忆只能通过这些工具访问，它不在任何文件或命令工具可以打开的路径上，因此 Agent 无法直接读取或修改记忆文件。","locale":"zh-CN"},"187":{"id":"/docs/agent-memory-46","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#agent-能对记忆做什么","content":"读取以已发布的内容为准。即使还有新的会话等待整理，已有记忆仍然可读，所以让 Agent 记住新内容不会让你原本的记忆消失。新内容会先排队：Agent 记录一条笔记，由后续的整理流程合并。","locale":"zh-CN"},"188":{"id":"/docs/agent-memory-47","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#agent-能对记忆做什么","content":"只有在你明确要求记住、忘记或更新时，Agent 才会写入笔记，它不会自行判断某段对话值得保留。","locale":"zh-CN"},"189":{"id":"/docs/agent-memory-48","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#agent-能对记忆做什么","content":"当回答实质依赖记忆时，Agent 会引用它读取的资源。应用会核对这些引用与记忆实际记录的来源是否一致，并在该轮提交后从可见回答中移除引用块。","locale":"zh-CN"},"190":{"id":"/docs/agent-memory-49","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#归档删除和分叉","content":"会话操作","locale":"zh-CN"},"191":{"id":"/docs/agent-memory-50","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#归档删除和分叉","content":"对记忆来源的影响","locale":"zh-CN"},"192":{"id":"/docs/agent-memory-51","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#归档删除和分叉","content":"归档/恢复","locale":"zh-CN"},"193":{"id":"/docs/agent-memory-52","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#归档删除和分叉","content":"保留来源关系，只改变会话列表中的可见状态","locale":"zh-CN"},"194":{"id":"/docs/agent-memory-53","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#归档删除和分叉","content":"永久删除","locale":"zh-CN"},"195":{"id":"/docs/agent-memory-54","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#归档删除和分叉","content":"撤销该会话作为后续记忆来源的资格","locale":"zh-CN"},"196":{"id":"/docs/agent-memory-55","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#归档删除和分叉","content":"分叉","locale":"zh-CN"},"197":{"id":"/docs/agent-memory-56","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#归档删除和分叉","content":"子会话只贡献分叉后由自己产生的内容，父会话仍独立处理","locale":"zh-CN"},"198":{"id":"/docs/agent-memory-57","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#重置记忆","content":"设置页面会显示当前记忆条目数和来源数。重置需要再次确认，执行后会清除派生记忆并开始新的记忆代次。","locale":"zh-CN"},"199":{"id":"/docs/agent-memory-58","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#重置记忆","content":"重置不会删除 Agent 会话及其原始历史。以后如果继续启用生成，符合条件的会话仍可能产生新的记忆；如果希望某个会话不再贡献，应先通过 `/memory` 禁用或永久删除该会话。","locale":"zh-CN"},"200":{"id":"/docs/agent-memory-59","page_id":"/docs/agent-memory","tags":[],"type":"text","url":"/docs/agent-memory#重置记忆","content":"不要依靠“排除外部内容”或重置来保护凭据。敏感内容一开始就不应进入提示、附件和项目文档；需要分享诊断或会话记录时仍要人工检查并脱敏。","locale":"zh-CN"},"201":{"id":"/docs/agent-messages-attachments","page_id":"/docs/agent-messages-attachments","type":"page","content":"消息与附件","breadcrumbs":["Hanafubuki 文档","Agent"],"tags":[],"url":"/docs/agent-messages-attachments","locale":"zh-CN"},"202":{"id":"/docs/agent-messages-attachments-0","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments","content":"编写消息、引用项目文件、添加图片并引导正在进行的任务。","locale":"zh-CN"},"203":{"id":"/docs/agent-messages-attachments-1","page_id":"/docs/agent-messages-attachments","type":"heading","tags":[],"url":"/docs/agent-messages-attachments#编写和发送","content":"编写和发送","locale":"zh-CN"},"204":{"id":"/docs/agent-messages-attachments-2","page_id":"/docs/agent-messages-attachments","type":"heading","tags":[],"url":"/docs/agent-messages-attachments#当前界面上下文","content":"当前界面上下文","locale":"zh-CN"},"205":{"id":"/docs/agent-messages-attachments-3","page_id":"/docs/agent-messages-attachments","type":"heading","tags":[],"url":"/docs/agent-messages-attachments#引用文件和目录","content":"引用文件和目录","locale":"zh-CN"},"206":{"id":"/docs/agent-messages-attachments-4","page_id":"/docs/agent-messages-attachments","type":"heading","tags":[],"url":"/docs/agent-messages-attachments#添加图片","content":"添加图片","locale":"zh-CN"},"207":{"id":"/docs/agent-messages-attachments-5","page_id":"/docs/agent-messages-attachments","type":"heading","tags":[],"url":"/docs/agent-messages-attachments#agent-工作时追加消息","content":"Agent 工作时追加消息","locale":"zh-CN"},"208":{"id":"/docs/agent-messages-attachments-6","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments","content":"输入框可以发送文字、项目路径、图片和本轮 Skill 选择。应用还会自动附加当前界面位置，帮助 Agent 理解你正在查看哪个实例或设置区域。","locale":"zh-CN"},"209":{"id":"/docs/agent-messages-attachments-7","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#编写和发送","content":"`Enter` 发送消息，`Shift + Enter` 插入换行。","locale":"zh-CN"},"210":{"id":"/docs/agent-messages-attachments-8","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#编写和发送","content":"可以只发送图片；文字和图片也可以一起发送。","locale":"zh-CN"},"211":{"id":"/docs/agent-messages-attachments-9","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#编写和发送","content":"当前没有模型时，先点击模型按钮或执行 `/model`。","locale":"zh-CN"},"212":{"id":"/docs/agent-messages-attachments-10","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#编写和发送","content":"等待审批、回答 Agent 问题或确认提议计划时，输入区会切换为对应操作，必须先完成或跳过该决定。","locale":"zh-CN"},"213":{"id":"/docs/agent-messages-attachments-11","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#编写和发送","content":"提示中优先写清目标、范围和验收条件。路径、实例名称或命令参数容易混淆时，应给出准确文本，不要只写“这个”“上一个”或“默认的”。","locale":"zh-CN"},"214":{"id":"/docs/agent-messages-attachments-12","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#当前界面上下文","content":"输入框会显示当前上下文标签。根据所在位置，Agent 可以收到实例选择页、实例创建步骤、实例工作区、嵌入式 WebUI、设置分区或实例管理分区等界面信息。","locale":"zh-CN"},"215":{"id":"/docs/agent-messages-attachments-13","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#当前界面上下文","content":"这是辅助上下文，不是文件权限或执行授权。Agent 仍需要通过工具读取真实状态，并遵守当前权限模式和后端路径规则。","locale":"zh-CN"},"216":{"id":"/docs/agent-messages-attachments-14","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#引用文件和目录","content":"在输入框中键入 `@` 可以搜索当前项目上下文中的路径，也可以使用附件菜单打开系统选择器。选中后，路径会以适合包含空格的形式插入消息正文。","locale":"zh-CN"},"217":{"id":"/docs/agent-messages-attachments-15","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#引用文件和目录","content":"路径引用只是把位置告诉 Agent，不会自动授予读取或写入权限。搜索范围由应用管理，并会排除受保护的内部数据和被忽略的内容。","locale":"zh-CN"},"218":{"id":"/docs/agent-messages-attachments-16","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#添加图片","content":"单条消息最多添加 8 张图片，可以移除或调整顺序。后端会在发送前解码、校验并规范化图片：","locale":"zh-CN"},"219":{"id":"/docs/agent-messages-attachments-17","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#添加图片","content":"限制","locale":"zh-CN"},"220":{"id":"/docs/agent-messages-attachments-18","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#添加图片","content":"数值","locale":"zh-CN"},"221":{"id":"/docs/agent-messages-attachments-19","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#添加图片","content":"单个源文件","locale":"zh-CN"},"222":{"id":"/docs/agent-messages-attachments-20","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#添加图片","content":"最大 20 MiB","locale":"zh-CN"},"223":{"id":"/docs/agent-messages-attachments-21","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#添加图片","content":"所有源图片合计","locale":"zh-CN"},"224":{"id":"/docs/agent-messages-attachments-22","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#添加图片","content":"最大 64 MiB","locale":"zh-CN"},"225":{"id":"/docs/agent-messages-attachments-23","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#添加图片","content":"解码后像素","locale":"zh-CN"},"226":{"id":"/docs/agent-messages-attachments-24","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#添加图片","content":"最大 4000 万像素","locale":"zh-CN"},"227":{"id":"/docs/agent-messages-attachments-25","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#添加图片","content":"规范化最长边","locale":"zh-CN"},"228":{"id":"/docs/agent-messages-attachments-26","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#添加图片","content":"最大 2048 像素","locale":"zh-CN"},"229":{"id":"/docs/agent-messages-attachments-27","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#添加图片","content":"单张规范化结果","locale":"zh-CN"},"230":{"id":"/docs/agent-messages-attachments-28","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#添加图片","content":"最大 8 MiB","locale":"zh-CN"},"231":{"id":"/docs/agent-messages-attachments-29","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#添加图片","content":"图片会去除元数据，动画图片只使用静态画面。模型策略为“自动”时，应用会按已知能力发送图片；模型明确拒绝图片且尚未产生输出时，可以自动移除图片重试一次。模型策略为“禁用”时不能发送图片。","locale":"zh-CN"},"232":{"id":"/docs/agent-messages-attachments-30","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#添加图片","content":"如果图片读取、解码或请求准入失败，输入文字和附件草稿会保留，修正问题后可以再次发送。","locale":"zh-CN"},"233":{"id":"/docs/agent-messages-attachments-31","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#agent-工作时追加消息","content":"Agent 正在回答时，输入新内容并点击主按钮不会立即开始第二轮，而是把内容放入当前面板的消息队列。","locale":"zh-CN"},"234":{"id":"/docs/agent-messages-attachments-32","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#agent-工作时追加消息","content":"队列操作","locale":"zh-CN"},"235":{"id":"/docs/agent-messages-attachments-33","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#agent-工作时追加消息","content":"用途","locale":"zh-CN"},"236":{"id":"/docs/agent-messages-attachments-34","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#agent-工作时追加消息","content":"引导","locale":"zh-CN"},"237":{"id":"/docs/agent-messages-attachments-35","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#agent-工作时追加消息","content":"把消息发送到正在进行的同一轮，调整接下来的方向","locale":"zh-CN"},"238":{"id":"/docs/agent-messages-attachments-36","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#agent-工作时追加消息","content":"编辑","locale":"zh-CN"},"239":{"id":"/docs/agent-messages-attachments-37","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#agent-工作时追加消息","content":"把消息和图片恢复到输入框继续修改","locale":"zh-CN"},"240":{"id":"/docs/agent-messages-attachments-38","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#agent-工作时追加消息","content":"丢弃","locale":"zh-CN"},"241":{"id":"/docs/agent-messages-attachments-39","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#agent-工作时追加消息","content":"从本地队列移除，不发送给 Agent","locale":"zh-CN"},"242":{"id":"/docs/agent-messages-attachments-40","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#agent-工作时追加消息","content":"引导适合补充刚发现的约束，例如“不要修改数据库结构”。如果当前工作可以自然完成，保留为下一轮消息通常更清晰。队列仅属于当前打开面板的草稿状态，不应把它当作已经持久化的会话记录。","locale":"zh-CN"},"243":{"id":"/docs/agent-messages-attachments-41","page_id":"/docs/agent-messages-attachments","tags":[],"type":"text","url":"/docs/agent-messages-attachments#agent-工作时追加消息","content":"提交图片和文件前检查其中是否包含\nToken、私钥、Cookie、个人数据或内部地址。附件会进入模型上下文，不应依赖界面替你完成脱敏。","locale":"zh-CN"},"244":{"id":"/docs/agent-modes-plans","page_id":"/docs/agent-modes-plans","type":"page","content":"模式与计划","breadcrumbs":["Hanafubuki 文档","Agent"],"tags":[],"url":"/docs/agent-modes-plans","locale":"zh-CN"},"245":{"id":"/docs/agent-modes-plans-0","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans","content":"区分默认模式、Plan 模式、提议计划和执行任务计划。","locale":"zh-CN"},"246":{"id":"/docs/agent-modes-plans-1","page_id":"/docs/agent-modes-plans","type":"heading","tags":[],"url":"/docs/agent-modes-plans#默认模式和-plan-模式","content":"默认模式和 Plan 模式","locale":"zh-CN"},"247":{"id":"/docs/agent-modes-plans-2","page_id":"/docs/agent-modes-plans","type":"heading","tags":[],"url":"/docs/agent-modes-plans#在-plan-模式中工作","content":"在 Plan 模式中工作","locale":"zh-CN"},"248":{"id":"/docs/agent-modes-plans-3","page_id":"/docs/agent-modes-plans","type":"heading","tags":[],"url":"/docs/agent-modes-plans#两种计划不是同一件事","content":"两种“计划”不是同一件事","locale":"zh-CN"},"249":{"id":"/docs/agent-modes-plans-4","page_id":"/docs/agent-modes-plans","type":"heading","tags":[],"url":"/docs/agent-modes-plans#何时切换模式","content":"何时切换模式","locale":"zh-CN"},"250":{"id":"/docs/agent-modes-plans-5","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans","content":"会话模式决定 Agent 当前可以使用哪类工具。它与权限模式是两套不同控制：模式决定能力是否可用，权限决定可用操作需要怎样审批。","locale":"zh-CN"},"251":{"id":"/docs/agent-modes-plans-6","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#默认模式和-plan-模式","content":"模式","locale":"zh-CN"},"252":{"id":"/docs/agent-modes-plans-7","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#默认模式和-plan-模式","content":"适用场景","locale":"zh-CN"},"253":{"id":"/docs/agent-modes-plans-8","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#默认模式和-plan-模式","content":"主要行为","locale":"zh-CN"},"254":{"id":"/docs/agent-modes-plans-9","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#默认模式和-plan-模式","content":"默认","locale":"zh-CN"},"255":{"id":"/docs/agent-modes-plans-10","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#默认模式和-plan-模式","content":"目标和范围明确，希望直接完成任务","locale":"zh-CN"},"256":{"id":"/docs/agent-modes-plans-11","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#默认模式和-plan-模式","content":"可以在授权范围内运行命令、修改文件，并使用任务计划追踪执行","locale":"zh-CN"},"257":{"id":"/docs/agent-modes-plans-12","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#默认模式和-plan-模式","content":"Plan","locale":"zh-CN"},"258":{"id":"/docs/agent-modes-plans-13","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#默认模式和-plan-模式","content":"需求复杂，需要先调查和确认设计","locale":"zh-CN"},"259":{"id":"/docs/agent-modes-plans-14","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#默认模式和-plan-模式","content":"只允许调查、读取、提问和输出方案，不执行仓库修改","locale":"zh-CN"},"260":{"id":"/docs/agent-modes-plans-15","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#默认模式和-plan-模式","content":"Plan 模式会隐藏写入、补丁和其他变更工具。即使权限模式是“完全访问”，也不会把 Plan 模式变成执行模式。","locale":"zh-CN"},"261":{"id":"/docs/agent-modes-plans-16","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#在-plan-模式中工作","content":"Agent 提问时，问题卡片会暂时取代普通输入框。回答或跳过后才会继续当前规划轮次。","locale":"zh-CN"},"262":{"id":"/docs/agent-modes-plans-17","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#两种计划不是同一件事","content":"名称","locale":"zh-CN"},"263":{"id":"/docs/agent-modes-plans-18","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#两种计划不是同一件事","content":"作用","locale":"zh-CN"},"264":{"id":"/docs/agent-modes-plans-19","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#两种计划不是同一件事","content":"生命周期","locale":"zh-CN"},"265":{"id":"/docs/agent-modes-plans-20","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#两种计划不是同一件事","content":"提议计划","locale":"zh-CN"},"266":{"id":"/docs/agent-modes-plans-21","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#两种计划不是同一件事","content":"Plan 模式最终交付的、可审阅的完整实施方案","locale":"zh-CN"},"267":{"id":"/docs/agent-modes-plans-22","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#两种计划不是同一件事","content":"由用户决定实施或继续修改","locale":"zh-CN"},"268":{"id":"/docs/agent-modes-plans-23","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#两种计划不是同一件事","content":"任务计划","locale":"zh-CN"},"269":{"id":"/docs/agent-modes-plans-24","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#两种计划不是同一件事","content":"默认模式执行期间显示的步骤与状态","locale":"zh-CN"},"270":{"id":"/docs/agent-modes-plans-25","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#两种计划不是同一件事","content":"用于汇报进度，不构成授权","locale":"zh-CN"},"271":{"id":"/docs/agent-modes-plans-26","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#两种计划不是同一件事","content":"提议计划应当让执行者不再需要决定关键实现细节。任务计划只表示当前工作进度，即使某一步显示“进行中”，也不代表命令已成功或风险操作已获批准。","locale":"zh-CN"},"272":{"id":"/docs/agent-modes-plans-27","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#何时切换模式","content":"不清楚代码边界、数据结构或交互方式时，先使用 Plan 模式。","locale":"zh-CN"},"273":{"id":"/docs/agent-modes-plans-28","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#何时切换模式","content":"只是需要检查一个错误原因，而且不希望修改代码时，也适合 Plan 模式，并在任务中明确写“只分析”。","locale":"zh-CN"},"274":{"id":"/docs/agent-modes-plans-29","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#何时切换模式","content":"已有明确方案并希望落地时，切到默认模式或使用“实施计划”。","locale":"zh-CN"},"275":{"id":"/docs/agent-modes-plans-30","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#何时切换模式","content":"当前回答、压缩或阻塞决定尚未结束时，先处理当前状态再切换。","locale":"zh-CN"},"276":{"id":"/docs/agent-modes-plans-31","page_id":"/docs/agent-modes-plans","tags":[],"type":"text","url":"/docs/agent-modes-plans#何时切换模式","content":"接受方案只决定后续工作方向。执行阶段遇到需要审批的命令、写入、删除或外部操作时，仍按照当前权限模式处理。","locale":"zh-CN"},"277":{"id":"/docs/agent-permissions","page_id":"/docs/agent-permissions","type":"page","content":"权限与审批","breadcrumbs":["Hanafubuki 文档","Agent"],"tags":[],"url":"/docs/agent-permissions","locale":"zh-CN"},"278":{"id":"/docs/agent-permissions-0","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions","content":"选择 Agent 权限模式，并安全处理每一次工具审批。","locale":"zh-CN"},"279":{"id":"/docs/agent-permissions-1","page_id":"/docs/agent-permissions","type":"heading","tags":[],"url":"/docs/agent-permissions#权限模式","content":"权限模式","locale":"zh-CN"},"280":{"id":"/docs/agent-permissions-2","page_id":"/docs/agent-permissions","type":"heading","tags":[],"url":"/docs/agent-permissions#处理人工审批","content":"处理人工审批","locale":"zh-CN"},"281":{"id":"/docs/agent-permissions-3","page_id":"/docs/agent-permissions","type":"heading","tags":[],"url":"/docs/agent-permissions#自动审查怎么看","content":"自动审查怎么看","locale":"zh-CN"},"282":{"id":"/docs/agent-permissions-4","page_id":"/docs/agent-permissions","type":"heading","tags":[],"url":"/docs/agent-permissions#高风险操作","content":"高风险操作","locale":"zh-CN"},"283":{"id":"/docs/agent-permissions-5","page_id":"/docs/agent-permissions","type":"heading","tags":[],"url":"/docs/agent-permissions#权限模式与其他控制","content":"权限模式与其他控制","locale":"zh-CN"},"284":{"id":"/docs/agent-permissions-6","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions","content":"权限系统会根据操作类型、风险、来源和准确目标决定是否允许工具调用。权限模式是全局界面选择，但每次授权只针对审批卡片中显示的那一个操作。","locale":"zh-CN"},"285":{"id":"/docs/agent-permissions-7","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#权限模式","content":"模式","locale":"zh-CN"},"286":{"id":"/docs/agent-permissions-8","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#权限模式","content":"行为","locale":"zh-CN"},"287":{"id":"/docs/agent-permissions-9","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#权限模式","content":"建议用途","locale":"zh-CN"},"288":{"id":"/docs/agent-permissions-10","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#权限模式","content":"手动","locale":"zh-CN"},"289":{"id":"/docs/agent-permissions-11","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#权限模式","content":"需要审批的操作等待用户选择“允许一次”或“拒绝”","locale":"zh-CN"},"290":{"id":"/docs/agent-permissions-12","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#权限模式","content":"陌生项目、高风险任务和首次使用","locale":"zh-CN"},"291":{"id":"/docs/agent-permissions-13","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#权限模式","content":"自动审查","locale":"zh-CN"},"292":{"id":"/docs/agent-permissions-14","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#权限模式","content":"应用对需要审查的调用进行自动评估，并显示结论和理由","locale":"zh-CN"},"293":{"id":"/docs/agent-permissions-15","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#权限模式","content":"日常开发、文档和可回滚修改","locale":"zh-CN"},"294":{"id":"/docs/agent-permissions-16","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#权限模式","content":"完全访问","locale":"zh-CN"},"295":{"id":"/docs/agent-permissions-17","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#权限模式","content":"自动允许原本需要审查的操作，不再弹出逐项确认","locale":"zh-CN"},"296":{"id":"/docs/agent-permissions-18","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#权限模式","content":"只用于可信环境、明确范围和可恢复任务","locale":"zh-CN"},"297":{"id":"/docs/agent-permissions-19","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#权限模式","content":"有些操作会被后端直接禁止，不能通过切换权限模式覆盖。路径规则、实例生命周期、进程所有权、操作系统账号权限等约束也始终有效。","locale":"zh-CN"},"298":{"id":"/docs/agent-permissions-20","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#权限模式","content":"完全访问下，工具以应用进程实际拥有的系统权限工作。它不是临时目录或模拟环境，错误命令可能直接修改项目、实例或外部服务。","locale":"zh-CN"},"299":{"id":"/docs/agent-permissions-21","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#处理人工审批","content":"审批出现时，普通输入框会切换为审批卡片。批准前逐项核对：","locale":"zh-CN"},"300":{"id":"/docs/agent-permissions-22","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#处理人工审批","content":"操作类型：命令、文件写入、删除、MCP 管理或外部工具调用。","locale":"zh-CN"},"301":{"id":"/docs/agent-permissions-23","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#处理人工审批","content":"风险等级：低、中、高或严重。","locale":"zh-CN"},"302":{"id":"/docs/agent-permissions-24","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#处理人工审批","content":"操作摘要和来源：用户请求、模型判断或某个 Skill。","locale":"zh-CN"},"303":{"id":"/docs/agent-permissions-25","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#处理人工审批","content":"准确目标：程序、参数、工作目录、文件路径或服务标识。","locale":"zh-CN"},"304":{"id":"/docs/agent-permissions-26","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#处理人工审批","content":"这项操作是否确实是完成当前任务所必需。","locale":"zh-CN"},"305":{"id":"/docs/agent-permissions-27","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#处理人工审批","content":"选择“允许一次”只授权当前请求，不会把同类操作永久加入白名单。选择“拒绝”后，Agent 会收到拒绝结果，可以调整方案或向你解释为何需要该操作。","locale":"zh-CN"},"306":{"id":"/docs/agent-permissions-28","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#自动审查怎么看","content":"自动审查会在工具记录中显示审查状态、风险判断、用户授权线索和理由。它仍然只针对当前调用，不代表整个任务已经被授权。","locale":"zh-CN"},"307":{"id":"/docs/agent-permissions-29","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#自动审查怎么看","content":"如果自动审查失败、超时或判断为拒绝，操作不会执行。此时应查看工具卡片中的理由，而不是反复提交相同调用。","locale":"zh-CN"},"308":{"id":"/docs/agent-permissions-30","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#高风险操作","content":"以下操作即使目标看起来合理，也应人工确认范围和可恢复方式：","locale":"zh-CN"},"309":{"id":"/docs/agent-permissions-31","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#高风险操作","content":"删除、覆盖或移动项目和实例数据。","locale":"zh-CN"},"310":{"id":"/docs/agent-permissions-32","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#高风险操作","content":"重置 Git、发布版本、推送代码或触发远程工作流。","locale":"zh-CN"},"311":{"id":"/docs/agent-permissions-33","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#高风险操作","content":"安装来源不明的 Skill、执行其脚本或修改 MCP 配置。","locale":"zh-CN"},"312":{"id":"/docs/agent-permissions-34","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#高风险操作","content":"使用 MCP 操作账号、数据库、消息、支付或其他外部系统。","locale":"zh-CN"},"313":{"id":"/docs/agent-permissions-35","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#高风险操作","content":"读取或发送凭据、隐私数据和未公开内容。","locale":"zh-CN"},"314":{"id":"/docs/agent-permissions-36","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#高风险操作","content":"涉及删除时先确认备份或快照；涉及外部系统时确认账号、环境和目标对象；涉及命令时确认工作目录和完整参数。","locale":"zh-CN"},"315":{"id":"/docs/agent-permissions-37","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#权限模式与其他控制","content":"Plan 模式仍会隐藏变更工具，完全访问不会绕过它。","locale":"zh-CN"},"316":{"id":"/docs/agent-permissions-38","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#权限模式与其他控制","content":"MCP 工具还有自己的“允许、询问、拒绝”策略，两层规则都会生效。","locale":"zh-CN"},"317":{"id":"/docs/agent-permissions-39","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#权限模式与其他控制","content":"Skill 可以建议或调用工具，但不会继承超出当前权限的能力。","locale":"zh-CN"},"318":{"id":"/docs/agent-permissions-40","page_id":"/docs/agent-permissions","tags":[],"type":"text","url":"/docs/agent-permissions#权限模式与其他控制","content":"记忆只提供上下文，不授予文件、命令或外部服务权限。","locale":"zh-CN"},"319":{"id":"/docs/agent-providers-models","page_id":"/docs/agent-providers-models","type":"page","content":"提供商与模型","breadcrumbs":["Hanafubuki 文档","Agent"],"tags":[],"url":"/docs/agent-providers-models","locale":"zh-CN"},"320":{"id":"/docs/agent-providers-models-0","page_id":"/docs/agent-providers-models","tags":[],"type":"text","url":"/docs/agent-providers-models","content":"配置 Agent 的服务端连接、模型能力和上下文策略。","locale":"zh-CN"},"321":{"id":"/docs/agent-providers-models-1","page_id":"/docs/agent-providers-models","type":"heading","tags":[],"url":"/docs/agent-providers-models#添加-provider","content":"添加 Provider","locale":"zh-CN"},"322":{"id":"/docs/agent-providers-models-2","page_id":"/docs/agent-providers-models","type":"heading","tags":[],"url":"/docs/agent-providers-models#选择默认模型","content":"选择默认模型","locale":"zh-CN"},"323":{"id":"/docs/agent-providers-models-3","page_id":"/docs/agent-providers-models","type":"heading","tags":[],"url":"/docs/agent-providers-models#模型能力","content":"模型能力","locale":"zh-CN"},"324":{"id":"/docs/agent-providers-models-4","page_id":"/docs/agent-providers-models","type":"heading","tags":[],"url":"/docs/agent-providers-models#当前会话的模型","content":"当前会话的模型","locale":"zh-CN"},"325":{"id":"/docs/agent-providers-models-5","page_id":"/docs/agent-providers-models","type":"heading","tags":[],"url":"/docs/agent-providers-models#验证与排查","content":"验证与排查","locale":"zh-CN"},"326":{"id":"/docs/agent-providers-models-6","page_id":"/docs/agent-providers-models","tags":[],"type":"text","url":"/docs/agent-providers-models","content":"Agent 将“如何连接服务端”和“如何使用模型”分开配置：Provider 保存协议、API 地址和凭据；模型策略保存默认模型、推理强度、图片输入和上下文规则。","locale":"zh-CN