"7741":{"id":"/en/docs/troubleshooting-instance-start-8","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start","content":"Startup issues span three distinct stages: whether the process was created, whether WebUI finished initializing, and whether the application captured a reachable address. Seeing **Starting** does not mean WebUI is ready.","locale":"en"},"7742":{"id":"/en/docs/troubleshooting-instance-start-9","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#read-the-startup-status","content":"Open the instance workspace for startup progress, or check the live stage, warnings, and recent failures under **Instance information**. The table below applies to WebUIs that report a browser address. For an extension type that provides a page through a service, check that service's status and endpoint under **Services**. Some types can run without a web page. Instance information and runtime status","locale":"en"},"7743":{"id":"/en/docs/troubleshooting-instance-start-10","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#read-the-startup-status","content":"Symptom","locale":"en"},"7744":{"id":"/en/docs/troubleshooting-instance-start-11","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#read-the-startup-status","content":"Meaning","locale":"en"},"7745":{"id":"/en/docs/troubleshooting-instance-start-12","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#read-the-startup-status","content":"Startup task fails immediately","locale":"en"},"7746":{"id":"/en/docs/troubleshooting-instance-start-13","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#read-the-startup-status","content":"Argument validation, Python, Core, dependencies, or process creation failed","locale":"en"},"7747":{"id":"/en/docs/troubleshooting-instance-start-14","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#read-the-startup-status","content":"Logs continue but no address appears","locale":"en"},"7748":{"id":"/en/docs/troubleshooting-instance-start-15","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#read-the-startup-status","content":"WebUI is still loading models or extensions, or it has not printed a recognizable listening address","locale":"en"},"7749":{"id":"/en/docs/troubleshooting-instance-start-16","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#read-the-startup-status","content":"Process exits with a Python traceback","locale":"en"},"7750":{"id":"/en/docs/troubleshooting-instance-start-17","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#read-the-startup-status","content":"Core, an extension, a dependency, or PyTorch failed during initialization","locale":"en"},"7751":{"id":"/en/docs/troubleshooting-instance-start-18","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#read-the-startup-status","content":"An address was captured but the embedded page will not open","locale":"en"},"7752":{"id":"/en/docs/troubleshooting-instance-start-19","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#read-the-startup-status","content":"Listening address, browser rendering, proxy, or WebView issue","locale":"en"},"7753":{"id":"/en/docs/troubleshooting-instance-start-20","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#read-the-startup-status","content":"The page opens in an external browser","locale":"en"},"7754":{"id":"/en/docs/troubleshooting-instance-start-21","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#read-the-startup-status","content":"WebUI itself is running; investigate embedded rendering rather than reinstalling the instance","locale":"en"},"7755":{"id":"/en/docs/troubleshooting-instance-start-22","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#launch-decisions","content":"The main window shows one launch decision at a time. If several instances are starting, check the instance ID in the dialog. A note at the bottom counts the decisions still waiting. Selecting **Cancel** or pressing `Esc` in the dialog cancels this launch.","locale":"en"},"7756":{"id":"/en/docs/troubleshooting-instance-start-23","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#launch-decisions","content":"Prompt","locale":"en"},"7757":{"id":"/en/docs/troubleshooting-instance-start-24","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#launch-decisions","content":"What you can do","locale":"en"},"7758":{"id":"/en/docs/troubleshooting-instance-start-25","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#launch-decisions","content":"Environment check failed","locale":"en"},"7759":{"id":"/en/docs/troubleshooting-instance-start-26","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#launch-decisions","content":"Read the exit code and continue to try starting the WebUI, or cancel to inspect the environment.","locale":"en"},"7760":{"id":"/en/docs/troubleshooting-instance-start-27","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#launch-decisions","content":"Incompatible PyTorch","locale":"en"},"7761":{"id":"/en/docs/troubleshooting-instance-start-28","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#launch-decisions","content":"Compare the installed build, detected GPUs and compatible types. Ignore the issue for this launch, or open PyTorch management from the dialog. Opening management cancels this launch.","locale":"en"},"7762":{"id":"/en/docs/troubleshooting-instance-start-29","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#launch-decisions","content":"ComfyUI dependency conflict","locale":"en"},"7763":{"id":"/en/docs/troubleshooting-instance-start-30","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#launch-decisions","content":"Review the packages and components involved. If a disable plan is listed, you can disable those components and continue. You can also install dependencies in sequence or skip conflicts. Sequential installation can still leave incompatible versions. Opening extension management cancels this launch so you can make your own changes.","locale":"en"},"7764":{"id":"/en/docs/troubleshooting-instance-start-31","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#launch-decisions","content":"Invalid launch arguments","locale":"en"},"7765":{"id":"/en/docs/troubleshooting-instance-start-32","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#launch-decisions","content":"Review the reported arguments. You can ignore the problems for this launch or remove incompatible arguments and launch. Removing them saves the edited arguments. See Launch configuration.","locale":"en"},"7766":{"id":"/en/docs/troubleshooting-instance-start-33","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#exits-immediately-after-startup","content":"Expand the startup log and find the first complete exception before the process exited.","locale":"en"},"7767":{"id":"/en/docs/troubleshooting-instance-start-34","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#exits-immediately-after-startup","content":"Determine whether the traceback path belongs to WebUI Core, an extension, or a Python package.","locale":"en"},"7768":{"id":"/en/docs/troubleshooting-instance-start-35","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#exits-immediately-after-startup","content":"Review recent changes to launch arguments, environment variables, Core version, extensions, and\nPyTorch.","locale":"en"},"7769":{"id":"/en/docs/troubleshooting-instance-start-36","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#exits-immediately-after-startup","content":"If it still fails, collect an instance diagnostic bundle and retain the failed startup activity.","locale":"en"},"7770":{"id":"/en/docs/troubleshooting-instance-start-37","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#exits-immediately-after-startup","content":"If the log clearly points to an extension, disable, update, or roll back that extension first. If Core and the extension interface are incompatible, check both versions together. Do not uninstall every Python package first; doing so destroys the environment needed for further diagnosis.","locale":"en"},"7771":{"id":"/en/docs/troubleshooting-instance-start-38","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#launch-arguments-and-environment-variables","content":"Check the **Launch** page for raw-argument parsing errors, unknown arguments, and mutually exclusive options.","locale":"en"},"7772":{"id":"/en/docs/troubleshooting-instance-start-39","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#launch-arguments-and-environment-variables","content":"Raw arguments contain only values passed to WebUI; do not include Python or the startup script.","locale":"en"},"7773":{"id":"/en/docs/troubleshooting-instance-start-40","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#launch-arguments-and-environment-variables","content":"**Ignore this time** is suitable only for confirming that the current branch still accepts an argument. Do not use it to bypass the same warning indefinitely.","locale":"en"},"7774":{"id":"/en/docs/troubleshooting-instance-start-41","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#launch-arguments-and-environment-variables","content":"Restart WebUI after changing arguments or environment variables. Refreshing the page does not change a running process.","locale":"en"},"7775":{"id":"/en/docs/troubleshooting-instance-start-42","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#launch-arguments-and-environment-variables","content":"Do not use a custom `PATH`, `PYTHONPATH`, `MAMBA_*`, or `CONDA_*` value to override the managed environment.","locale":"en"},"7776":{"id":"/en/docs/troubleshooting-instance-start-43","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#ports-and-addresses","content":"For a port conflict or connection failure:","locale":"en"},"7777":{"id":"/en/docs/troubleshooting-instance-start-44","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#ports-and-addresses","content":"Confirm the actual listening address and port in the startup log; do not assume it is `7860`.","locale":"en"},"7778":{"id":"/en/docs/troubleshooting-instance-start-45","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#ports-and-addresses","content":"Use Task Center and system tools to determine whether an old WebUI or another service occupies the port.","locale":"en"},"7779":{"id":"/en/docs/troubleshooting-instance-start-46","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#ports-and-addresses","content":"If the old task belongs to Hanafubuki, finish stopping and cleaning up that task before restarting; do not kill the process directly and immediately restart it.","locale":"en"},"7780":{"id":"/en/docs/troubleshooting-instance-start-47","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#ports-and-addresses","content":"To change the port, use the port option supported by the current WebUI in the instance launch arguments.","locale":"en"},"7781":{"id":"/en/docs/troubleshooting-instance-start-48","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#ports-and-addresses","content":"After restarting, confirm that the log, captured address, and browser port agree.","locale":"en"},"7782":{"id":"/en/docs/troubleshooting-instance-start-49","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#ports-and-addresses","content":"Listening on `127.0.0.1` normally permits access only from the local machine. Listening on every network interface or enabling remote connections expands the security boundary. Do not enable remote access unconditionally merely to troubleshoot a local page.","locale":"en"},"7783":{"id":"/en/docs/troubleshooting-instance-start-50","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#an-address-exists-but-the-page-will-not-open","content":"Check these points in order:","locale":"en"},"7784":{"id":"/en/docs/troubleshooting-instance-start-51","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#an-address-exists-but-the-page-will-not-open","content":"The WebUI process is still running and did not exit immediately after startup.","locale":"en"},"7785":{"id":"/en/docs/troubleshooting-instance-start-52","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#an-address-exists-but-the-page-will-not-open","content":"The protocol, host, and port in the address match the log.","locale":"en"},"7786":{"id":"/en/docs/troubleshooting-instance-start-53","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#an-address-exists-but-the-page-will-not-open","content":"Open the captured address in the system browser to distinguish the WebUI service from the embedded WebView.","locale":"en"},"7787":{"id":"/en/docs/troubleshooting-instance-start-54","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#an-address-exists-but-the-page-will-not-open","content":"Browser proxy settings, translation extensions, cache, or security software are not modifying local page requests.","locale":"en"},"7788":{"id":"/en/docs/troubleshooting-instance-start-55","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#an-address-exists-but-the-page-will-not-open","content":"WebUI is not configured for authentication, a subpath, or access from specific hosts only.","locale":"en"},"7789":{"id":"/en/docs/troubleshooting-instance-start-56","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#an-address-exists-but-the-page-will-not-open","content":"If the page opens but generation, model, or node operations fail, startup succeeded. Continue with Upstream WebUI issues.","locale":"en"},"7790":{"id":"/en/docs/troubleshooting-instance-start-57","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#management-features-are-temporarily-unavailable","content":"Instance management may be temporarily unavailable while WebUI is not ready, the management API is recovering, a maintenance operation holds the instance, or an old task has not been cleaned up. Check the management API and runtime state under **Instance information**, then wait for recovery or use the retry offered by the interface. The maintenance page remains available for inspecting and recovering instance lifecycle operations.","locale":"en"},"7791":{"id":"/en/docs/troubleshooting-instance-start-58","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#management-features-are-temporarily-unavailable","content":"<Card title=\"Launch configuration\" href=\"/docs/instance-launch\" description=\"Check arguments, environment variables, and pre-launch validation.\" />","locale":"en"},"7792":{"id":"/en/docs/troubleshooting-instance-start-59","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#management-features-are-temporarily-unavailable","content":"<Card title=\"PyTorch\" href=\"/docs/instance-pytorch\" description=\"Check the GPU platform and instance PyTorch.\" />","locale":"en"},"7793":{"id":"/en/docs/troubleshooting-instance-start-60","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#management-features-are-temporarily-unavailable","content":"<Card title=\"Extensions\" href=\"/docs/instance-extensions\" description=\"Update, disable, or roll back a problematic extension.\" />","locale":"en"},"7794":{"id":"/en/docs/troubleshooting-instance-start-61","page_id":"/en/docs/troubleshooting-instance-start","tags":[],"type":"text","url":"/en/docs/troubleshooting-instance-start#management-features-are-temporarily-unavailable","content":"<Card title=\"Instance information\" href=\"/docs/instance-overview\" description=\"View live services, addresses, and failure history.\" />","locale":"en"},"7795":{"id":"/en/docs/troubleshooting-reporting","page_id":"/en/docs/troubleshooting-reporting","type":"page","content":"Logs, Diagnostics, and Getting Help","breadcrumbs":["Hanafubuki Documentation","Troubleshooting"],"tags":[],"url":"/en/docs/troubleshooting-reporting","locale":"en"},"7796":{"id":"/en/docs/troubleshooting-reporting-0","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting","content":"Preserve complete errors, generate diagnostic bundles, and submit reproducible issue reports.","locale":"en"},"7797":{"id":"/en/docs/troubleshooting-reporting-1","page_id":"/en/docs/troubleshooting-reporting","type":"heading","tags":[],"url":"/en/docs/troubleshooting-reporting#preserve-the-original-information-first","content":"Preserve the original information first","locale":"en"},"7798":{"id":"/en/docs/troubleshooting-reporting-2","page_id":"/en/docs/troubleshooting-reporting","type":"heading","tags":[],"url":"/en/docs/troubleshooting-reporting#read-a-python-traceback","content":"Read a Python traceback","locale":"en"},"7799":{"id":"/en/docs/troubleshooting-reporting-3","page_id":"/en/docs/troubleshooting-reporting","type":"heading","tags":[],"url":"/en/docs/troubleshooting-reporting#choose-a-diagnostic-bundle","content":"Choose a diagnostic bundle","locale":"en"},"7800":{"id":"/en/docs/troubleshooting-reporting-4","page_id":"/en/docs/troubleshooting-reporting","type":"heading","tags":[],"url":"/en/docs/troubleshooting-reporting#help-request-template","content":"Help request template","locale":"en"},"7801":{"id":"/en/docs/troubleshooting-reporting-5","page_id":"/en/docs/troubleshooting-reporting","type":"heading","tags":[],"url":"/en/docs/troubleshooting-reporting#choose-the-right-support-channel","content":"Choose the right support channel","locale":"en"},"7802":{"id":"/en/docs/troubleshooting-reporting-6","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting","content":"A high-quality issue report should let someone who cannot see your screen reconstruct what happened. A single sentence such as “It won't start” or a screenshot of only the final dialog is rarely enough to determine whether the issue comes from the application, an instance, or WebUI.","locale":"en"},"7803":{"id":"/en/docs/troubleshooting-reporting-7","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#preserve-the-original-information-first","content":"Collect the following as soon as the issue occurs:","locale":"en"},"7804":{"id":"/en/docs/troubleshooting-reporting-8","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#preserve-the-original-information-first","content":"The date and time of the operation.","locale":"en"},"7805":{"id":"/en/docs/troubleshooting-reporting-9","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#preserve-the-original-information-first","content":"Hanafubuki version, operating system, and hardware platform.","locale":"en"},"7806":{"id":"/en/docs/troubleshooting-reporting-10","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#preserve-the-original-information-first","content":"WebUI type, Core version, and instance name.","locale":"en"},"7807":{"id":"/en/docs/troubleshooting-reporting-11","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#preserve-the-original-information-first","content":"Versions, extensions, models, arguments, or environment variables changed before reproduction.","locale":"en"},"7808":{"id":"/en/docs/troubleshooting-reporting-12","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#preserve-the-original-information-first","content":"The failure state on the current page and complete activity output in Task Center.","locale":"en"},"7809":{"id":"/en/docs/troubleshooting-reporting-13","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#preserve-the-original-information-first","content":"The Python traceback, command exit code, and logs immediately before and after the error.","locale":"en"},"7810":{"id":"/en/docs/troubleshooting-reporting-14","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#preserve-the-original-information-first","content":"Long-retained task output may be truncated or evicted. When you see a truncation marker, copy the current log or generate a diagnostic bundle. Do not assume the same content will remain available later.","locale":"en"},"7811":{"id":"/en/docs/troubleshooting-reporting-15","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#read-a-python-traceback","content":"Follow the call path and determine whether each file belongs to Core, an extension, a custom\nnode, or a Python package.","locale":"en"},"7812":{"id":"/en/docs/troubleshooting-reporting-16","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#read-a-python-traceback","content":"Record the final exception type and description, such as `ImportError` or `RuntimeError`.","locale":"en"},"7813":{"id":"/en/docs/troubleshooting-reporting-17","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#read-a-python-traceback","content":"When searching, combine the exception description, WebUI name, extension name, and version.\nPreserve the complete traceback when asking for help.","locale":"en"},"7814":{"id":"/en/docs/troubleshooting-reporting-18","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#read-a-python-traceback","content":"The first red line is not necessarily the root cause. Startup may log warnings before the exception that actually terminates the process. Conversely, one extension may fail while WebUI still starts successfully.","locale":"en"},"7815":{"id":"/en/docs/troubleshooting-reporting-19","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#choose-a-diagnostic-bundle","content":"Type","locale":"en"},"7816":{"id":"/en/docs/troubleshooting-reporting-20","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#choose-a-diagnostic-bundle","content":"Use when","locale":"en"},"7817":{"id":"/en/docs/troubleshooting-reporting-21","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#choose-a-diagnostic-bundle","content":"Location","locale":"en"},"7818":{"id":"/en/docs/troubleshooting-reporting-22","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#choose-a-diagnostic-bundle","content":"Instance diagnostics","locale":"en"},"7819":{"id":"/en/docs/troubleshooting-reporting-23","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#choose-a-diagnostic-bundle","content":"One instance has installation, startup, extension, hotpatch, or environment problems","locale":"en"},"7820":{"id":"/en/docs/troubleshooting-reporting-24","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#choose-a-diagnostic-bundle","content":"**Instance Management → Maintenance → Diagnostics**","locale":"en"},"7821":{"id":"/en/docs/troubleshooting-reporting-25","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#choose-a-diagnostic-bundle","content":"Application diagnostics","locale":"en"},"7822":{"id":"/en/docs/troubleshooting-reporting-26","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#choose-a-diagnostic-bundle","content":"The application runtime, settings, platform, global tasks, or several instances fail together","locale":"en"},"7823":{"id":"/en/docs/troubleshooting-reporting-27","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#choose-a-diagnostic-bundle","content":"**Settings → Diagnostics**","locale":"en"},"7824":{"id":"/en/docs/troubleshooting-reporting-28","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#choose-a-diagnostic-bundle","content":"Launcher log","locale":"en"},"7825":{"id":"/en/docs/troubleshooting-reporting-29","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#choose-a-diagnostic-bundle","content":"The portable Launcher reports an error before the app opens","locale":"en"},"7826":{"id":"/en/docs/troubleshooting-reporting-30","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#choose-a-diagnostic-bundle","content":"**Open log** on the Launcher's error screen. See Launcher troubleshooting.","locale":"en"},"7827":{"id":"/en/docs/troubleshooting-reporting-31","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#choose-a-diagnostic-bundle","content":"Instance diagnostics focus on the current instance. Application diagnostics can include all instances if configured. Do not collect every instance by default merely to obtain “more information”; choose the smallest scope that covers the issue.","locale":"en"},"7828":{"id":"/en/docs/troubleshooting-reporting-32","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#help-request-template","content":"Under **Actions already attempted**, state what changed and whether the error changed. Do not write only “I tried everything online.” If you deleted anything, reinstalled dependencies, or ran a Git reset, disclose that too; otherwise maintainers may draw the wrong conclusion from an environment that has already changed.","locale":"en"},"7829":{"id":"/en/docs/troubleshooting-reporting-33","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#choose-the-right-support-channel","content":"Hanafubuki cannot prepare the runtime, manage tasks, persist settings, or render a window: report it to Hanafubuki maintainers.","locale":"en"},"7830":{"id":"/en/docs/troubleshooting-reporting-34","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#choose-the-right-support-channel","content":"WebUI Core reports an error in an instance that has already started: report it to the corresponding WebUI project.","locale":"en"},"7831":{"id":"/en/docs/troubleshooting-reporting-35","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#choose-the-right-support-channel","content":"Only one extension or custom node fails: read its documentation first, then report it to the extension author.","locale":"en"},"7832":{"id":"/en/docs/troubleshooting-reporting-36","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#choose-the-right-support-channel","content":"A model or workflow has missing components or incompatible versions: contact the publisher and include the required dependency information.","locale":"en"},"7833":{"id":"/en/docs/troubleshooting-reporting-37","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#choose-the-right-support-channel","content":"Once you confirm the issue comes from Hanafubuki, search Hanafubuki GitHub\nIssues for an existing report. For a new issue, use\nthe template above and include reproducible steps, the complete error, and necessary logs. Never\nupload a diagnostic bundle containing credentials or private data publicly.","locale":"en"},"7834":{"id":"/en/docs/troubleshooting-reporting-38","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#choose-the-right-support-channel","content":"<Card title=\"Report a Hanafubuki issue\" href=\"https://github.com/licyk/Hanafubuki/issues\" description=\"Search existing issues or submit a new bug report.\" />","locale":"en"},"7835":{"id":"/en/docs/troubleshooting-reporting-39","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#choose-the-right-support-channel","content":"<Card title=\"Instance diagnostics\" href=\"/docs/instance-diagnostics\" description=\"Collect and export an instance diagnostic bundle.\" />","locale":"en"},"7836":{"id":"/en/docs/troubleshooting-reporting-40","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#choose-the-right-support-channel","content":"<Card title=\"Application diagnostics\" href=\"/docs/settings-diagnostics\" description=\"Configure the application-level diagnostic scope.\" />","locale":"en"},"7837":{"id":"/en/docs/troubleshooting-reporting-41","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#choose-the-right-support-channel","content":"<Card title=\"Log settings\" href=\"/docs/settings-logs\" description=\"Adjust log level, files, and retention.\" />","locale":"en"},"7838":{"id":"/en/docs/troubleshooting-reporting-42","page_id":"/en/docs/troubleshooting-reporting","tags":[],"type":"text","url":"/en/docs/troubleshooting-reporting#choose-the-right-support-channel","content":"<Card title=\"Upstream WebUI issues\" href=\"/docs/troubleshooting-webui\" description=\"Determine which project should receive an error report.\" />","locale":"en"},"7839":{"id":"/en/docs/troubleshooting-task-cleanup","page_id":"/en/docs/troubleshooting-task-cleanup","type":"page","content":"Task Contention and Cleanup","breadcrumbs":["Hanafubuki Documentation","Troubleshooting"],"tags":[],"url":"/en/docs/troubleshooting-task-cleanup","locale":"en"},"7840":{"id":"/en/docs/troubleshooting-task-cleanup-0","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup","content":"Handle cancellation, pending cleanup, maintenance locks, lingering terminals, and duplicate tasks.","locale":"en"},"7841":{"id":"/en/docs/troubleshooting-task-cleanup-1","page_id":"/en/docs/troubleshooting-task-cleanup","type":"heading","tags":[],"url":"/en/docs/troubleshooting-task-cleanup#understand-task-states","content":"Understand task states","locale":"en"},"7842":{"id":"/en/docs/troubleshooting-task-cleanup-2","page_id":"/en/docs/troubleshooting-task-cleanup","type":"heading","tags":[],"url":"/en/docs/troubleshooting-task-cleanup#cancel-a-task-correctly","content":"Cancel a task correctly","locale":"en"},"7843":{"id":"/en/docs/troubleshooting-task-cleanup-3","page_id":"/en/docs/troubleshooting-task-cleanup","type":"heading","tags":[],"url":"/en/docs/troubleshooting-task-cleanup#the-instance-reports-that-it-is-in-use","content":"The instance reports that it is in use","locale":"en"},"7844":{"id":"/en/docs/troubleshooting-task-cleanup-4","page_id":"/en/docs/troubleshooting-task-cleanup","type":"heading","tags":[],"url":"/en/docs/troubleshooting-task-cleanup#background-terminals-and-long-running-commands","content":"Background terminals and long-running commands","locale":"en"},"7845":{"id":"/en/docs/troubleshooting-task-cleanup-5","page_id":"/en/docs/troubleshooting-task-cleanup","type":"heading","tags":[],"url":"/en/docs/troubleshooting-task-cleanup#when-a-business-operation-can-be-retried","content":"When a business operation can be retried","locale":"en"},"7846":{"id":"/en/docs/troubleshooting-task-cleanup-6","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup","content":"Hanafubuki retains ownership of tasks and processes until it confirms that the process has ended and its resources have been released. Therefore, **Cancellation requested**, a command producing no new output, and a closed window do not mean that task cleanup has completed.","locale":"en"},"7847":{"id":"/en/docs/troubleshooting-task-cleanup-7","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#understand-task-states","content":"State","locale":"en"},"7848":{"id":"/en/docs/troubleshooting-task-cleanup-8","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#understand-task-states","content":"Meaning","locale":"en"},"7849":{"id":"/en/docs/troubleshooting-task-cleanup-9","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#understand-task-states","content":"What to do","locale":"en"},"7850":{"id":"/en/docs/troubleshooting-task-cleanup-10","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#understand-task-states","content":"Running","locale":"en"},"7851":{"id":"/en/docs/troubleshooting-task-cleanup-11","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#understand-task-states","content":"A backend task or child process is still working","locale":"en"},"7852":{"id":"/en/docs/troubleshooting-task-cleanup-12","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#understand-task-states","content":"Inspect output, wait, or request cancellation","locale":"en"},"7853":{"id":"/en/docs/troubleshooting-task-cleanup-13","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#understand-task-states","content":"Canceling/Stopping","locale":"en"},"7854":{"id":"/en/docs/troubleshooting-task-cleanup-14","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#understand-task-states","content":"A request was sent, but a terminal state is not confirmed","locale":"en"},"7855":{"id":"/en/docs/troubleshooting-task-cleanup-15","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#understand-task-states","content":"Wait; do not create a replacement task","locale":"en"},"7856":{"id":"/en/docs/troubleshooting-task-cleanup-16","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#understand-task-states","content":"Failed","locale":"en"},"7857":{"id":"/en/docs/troubleshooting-task-cleanup-17","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#understand-task-states","content":"The business operation failed; its process may or may not be cleaned up","locale":"en"},"7858":{"id":"/en/docs/troubleshooting-task-cleanup-18","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#understand-task-states","content":"Expand the error and cleanup status","locale":"en"},"7859":{"id":"/en/docs/troubleshooting-task-cleanup-19","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#understand-task-states","content":"Awaiting cleanup","locale":"en"},"7860":{"id":"/en/docs/troubleshooting-task-cleanup-20","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#understand-task-states","content":"Termination, absence, or metadata release could not be confirmed","locale":"en"},"7861":{"id":"/en/docs/troubleshooting-task-cleanup-21","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#understand-task-states","content":"Use the cleanup retry provided by the original task","locale":"en"},"7862":{"id":"/en/docs/troubleshooting-task-cleanup-22","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#understand-task-states","content":"Canceled/Completed","locale":"en"},"7863":{"id":"/en/docs/troubleshooting-task-cleanup-23","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#understand-task-states","content":"The task reached a terminal state","locale":"en"},"7864":{"id":"/en/docs/troubleshooting-task-cleanup-24","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#understand-task-states","content":"Start the next operation afterward","locale":"en"},"7865":{"id":"/en/docs/troubleshooting-task-cleanup-25","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#understand-task-states","content":"Task Center lists running activities, activities requiring attention, failures, and recently completed activities. When a bottom-right status item on the current page and Task Center refer to the same backend task, do not cancel it separately in both places.","locale":"en"},"7866":{"id":"/en/docs/troubleshooting-task-cleanup-26","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#cancel-a-task-correctly","content":"Open the log and confirm whether the cancellation request arrived and the child process began\nexiting.","locale":"en"},"7867":{"id":"/en/docs/troubleshooting-task-cleanup-27","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#cancel-a-task-correctly","content":"Wait for the interface to show canceled, failed, or completed. Do not close the application as a\nsubstitute for cancellation.","locale":"en"},"7868":{"id":"/en/docs/troubleshooting-task-cleanup-28","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#cancel-a-task-correctly","content":"When **Retry process cleanup** appears, use it to continue the same cleanup obligation.","locale":"en"},"7869":{"id":"/en/docs/troubleshooting-task-cleanup-29","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#cancel-a-task-correctly","content":"Reinstall, start, move, or delete once the original task has ended and the instance workspace's\ncleanup notice has cleared. A cancelled task can remain under **Needs attention** in Task\nCenter.","locale":"en"},"7870":{"id":"/en/docs/troubleshooting-task-cleanup-30","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#cancel-a-task-correctly","content":"Force-ending a process from the system task manager may temporarily prevent Hanafubuki from confirming resource state. If force is unavoidable, save the logs first, then return to the original task and retry cleanup. Do not immediately delete the task record or instance directory.","locale":"en"},"7871":{"id":"/en/docs/troubleshooting-task-cleanup-31","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#the-instance-reports-that-it-is-in-use","content":"Installation, startup, management, terminal, and maintenance operations on one instance must be coordinated. If an in-use message or maintenance lock appears:","locale":"en"},"7872":{"id":"/en/docs/troubleshooting-task-cleanup-32","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#the-instance-reports-that-it-is-in-use","content":"Under **Running** in Task Center, check the instance shown on each row to find work that still uses this instance.","locale":"en"},"7873":{"id":"/en/docs/troubleshooting-task-cleanup-33","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#the-instance-reports-that-it-is-in-use","content":"Open **Instance information** and inspect startup and management state.","locale":"en"},"7874":{"id":"/en/docs/troubleshooting-task-cleanup-34","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#the-instance-reports-that-it-is-in-use","content":"Check whether an instance terminal is still running or failed to clean up.","locale":"en"},"7875":{"id":"/en/docs/troubleshooting-task-cleanup-35","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#the-instance-reports-that-it-is-in-use","content":"If migration, reinstallation, or deletion was interrupted, return to **Maintenance** and continue the same recovery operation.","locale":"en"},"7876":{"id":"/en/docs/troubleshooting-task-cleanup-36","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#the-instance-reports-that-it-is-in-use","content":"Do not create another instance at the same path or manually move a directory that is being recovered.","locale":"en"},"7877":{"id":"/en/docs/troubleshooting-task-cleanup-37","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#the-instance-reports-that-it-is-in-use","content":"Different instances can operate concurrently. If every instance is blocked, investigate the application runtime or shared runtime instead of attributing the issue to a lock on one instance.","locale":"en"},"7878":{"id":"/en/docs/troubleshooting-task-cleanup-38","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#background-terminals-and-long-running-commands","content":"An instance terminal may remain available after you leave the page; return to recover its output.","locale":"en"},"7879":{"id":"/en/docs/troubleshooting-task-cleanup-39","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#background-terminals-and-long-running-commands","content":"Agent background terminals use `/ps` for inspection and `/stop` for cleanup. This is distinct from stopping the current Agent response.","locale":"en"},"7880":{"id":"/en/docs/troubleshooting-task-cleanup-40","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#background-terminals-and-long-running-commands","content":"Development servers and file watchers may produce no new output while still occupying ports and files.","locale":"en"},"7881":{"id":"/en/docs/troubleshooting-task-cleanup-41","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#background-terminals-and-long-running-commands","content":"If a terminal reports **Cleanup failed**, retry closing the same session instead of repeatedly creating new terminals.","locale":"en"},"7882":{"id":"/en/docs/troubleshooting-task-cleanup-42","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#when-a-business-operation-can-be-retried","content":"Retry only when all of the following are true:","locale":"en"},"7883":{"id":"/en/docs/troubleshooting-task-cleanup-43","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#when-a-business-operation-can-be-retried","content":"The original task reached a completed, failed, or canceled terminal state.","locale":"en"},"7884":{"id":"/en/docs/troubleshooting-task-cleanup-44","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#when-a-business-operation-can-be-retried","content":"No **Awaiting cleanup** or **Recovery required** notice remains.","locale":"en"},"7885":{"id":"/en/docs/troubleshooting-task-cleanup-45","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#when-a-business-operation-can-be-retried","content":"Related processes and terminals are confirmed stopped.","locale":"en"},"7886":{"id":"/en/docs/troubleshooting-task-cleanup-46","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#when-a-business-operation-can-be-retried","content":"The instance maintenance lock has been released.","locale":"en"},"7887":{"id":"/en/docs/troubleshooting-task-cleanup-47","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#when-a-business-operation-can-be-retried","content":"The network, permission, path, or configuration cause of the first failure has changed.","locale":"en"},"7888":{"id":"/en/docs/troubleshooting-task-cleanup-48","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#when-a-business-operation-can-be-retried","content":"Submitting the same input repeatedly without addressing the cause usually produces the same error and adds cleanup work.","locale":"en"},"7889":{"id":"/en/docs/troubleshooting-task-cleanup-49","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#when-a-business-operation-can-be-retried","content":"<Card title=\"Installation troubleshooting\" href=\"/docs/webui-install-troubleshooting\" description=\"Handle installation cancellation, cleanup, and retries.\" />","locale":"en"},"7890":{"id":"/en/docs/troubleshooting-task-cleanup-50","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#when-a-business-operation-can-be-retried","content":"<Card title=\"Instance maintenance\" href=\"/docs/instance-maintenance\" description=\"Recover migration, reinstallation, and deletion operations.\" />","locale":"en"},"7891":{"id":"/en/docs/troubleshooting-task-cleanup-51","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#when-a-business-operation-can-be-retried","content":"<Card title=\"Instance terminal\" href=\"/docs/instance-terminal\" description=\"Close or recover instance terminal sessions.\" />","locale":"en"},"7892":{"id":"/en/docs/troubleshooting-task-cleanup-52","page_id":"/en/docs/troubleshooting-task-cleanup","tags":[],"type":"text","url":"/en/docs/troubleshooting-task-cleanup#when-a-business-operation-can-be-retried","content":"<Card title=\"Agent tools and terminals\" href=\"/docs/agent-tools-terminals\" description=\"Manage Agent background commands.\" />","locale":"en"},"7893":{"id":"/en/docs/troubleshooting-webui","page_id":"/en/docs/troubleshooting-webui","type":"page","content":"Upstream WebUI Issues","breadcrumbs":["Hanafubuki Documentation","Troubleshooting"],"tags":[],"url":"/en/docs/troubleshooting-webui","locale":"en"},"7894":{"id":"/en/docs/troubleshooting-webui-0","page_id":"/en/docs/troubleshooting-webui","tags":[],"type":"text","url":"/en/docs/troubleshooting-webui","content":"Identify model, extension, node, generation, and WebUI interface errors and find the appropriate issue tracker.","locale":"en"},"7895":{"id":"/en/docs/troubleshooting-webui-1","page_id":"/en/docs/troubleshooting-webui","type":"heading","tags":[],"url":"/en/docs/troubleshooting-webui#preserve-the-core-error-first","content":"Preserve the core error first","locale":"en"},"7896":{"id":"/en/docs/troubleshooting-webui-2","page_id":"/en/docs/troubleshooting-webui","type":"heading","tags":[],"url":"/en/docs/troubleshooting-webui#narrow-the-issue-by-symptom","content":"Narrow the issue by symptom","locale":"en"},"7897":{"id":"/en/docs/troubleshooting-webui-3","page_id":"/en/docs/troubleshooting-webui","type":"heading","tags":[],"url":"/en/docs/troubleshooting-webui#use-hanafubuki-for-minimal-diagnosis","content":"Use Hanafubuki for minimal diagnosis","locale":"en"},"7898":{"id":"/en/docs/troubleshooting-webui-4","page_id":"/en/docs/troubleshooting-webui","type":"heading","tags":[],"url":"/en/docs/troubleshooting-webui#sd-note-knowledge-base","content":"SD Note knowledge base","locale":"en"},"7899":{"id":"/e