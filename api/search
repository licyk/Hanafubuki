,"4997":{"id":"/en/docs/extension-dev-instance-types-13","page_id":"/en/docs/extension-dev-instance-types","type":"heading","tags":[],"url":"/en/docs/extension-dev-instance-types#read-only-model-component","content":"Read-only model component","locale":"en"},"4998":{"id":"/en/docs/extension-dev-instance-types-14","page_id":"/en/docs/extension-dev-instance-types","type":"heading","tags":[],"url":"/en/docs/extension-dev-instance-types#adopting-a-built-in-types-management","content":"Adopting a built-in type's management","locale":"en"},"4999":{"id":"/en/docs/extension-dev-instance-types-15","page_id":"/en/docs/extension-dev-instance-types","type":"heading","tags":[],"url":"/en/docs/extension-dev-instance-types#discovery","content":"Discovery","locale":"en"},"5000":{"id":"/en/docs/extension-dev-instance-types-16","page_id":"/en/docs/extension-dev-instance-types","type":"heading","tags":[],"url":"/en/docs/extension-dev-instance-types#types-a-backend-provides","content":"Types a backend provides","locale":"en"},"5001":{"id":"/en/docs/extension-dev-instance-types-17","page_id":"/en/docs/extension-dev-instance-types","type":"heading","tags":[],"url":"/en/docs/extension-dev-instance-types#presets","content":"Presets","locale":"en"},"5002":{"id":"/en/docs/extension-dev-instance-types-18","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types","content":"An extension adds instance types through descriptor files. Every `.toml` or `.json` file the manifest's `contributes.instanceTypes` glob matches is one type, whose id is `<extension id>:<name>`, such as `com.example.llama:llama-server`. Users choose these types in a new installation, and the application installs, starts, and manages their instances as the descriptor says.","locale":"en"},"5003":{"id":"/en/docs/extension-dev-instance-types-19","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types","content":"A descriptor decodes tolerantly: an unknown field is ignored, but an unknown step kind, readiness, or runtime is refused. Everything is checked at registration; each problem is reported with its place (such as `servers[1].command[0]`, or a line and column), the type is not registered, and the extension does not install.","locale":"en"},"5004":{"id":"/en/docs/extension-dev-instance-types-20","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types#a-complete-example","content":"A JSON descriptor uses the same keys, such as `\"displayName\"` and `\"install\": { \"parameters\": [...], \"steps\": [...] }`.","locale":"en"},"5005":{"id":"/en/docs/extension-dev-instance-types-21","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types#top-level-keys","content":"Key","locale":"en"},"5006":{"id":"/en/docs/extension-dev-instance-types-22","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types#top-level-keys","content":"Required","locale":"en"},"5007":{"id":"/en/docs/extension-dev-instance-types-23","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types#top-level-keys","content":"Description","locale":"en"},"5008":{"id":"/en/docs/extension-dev-instance-types-24","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types#top-level-keys","content":"`name`","locale":"en"},"5009":{"id":"/en/docs/extension-dev-instance-types-25","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types#top-level-keys","content":"Yes","locale":"en"},"5010":{"id":"/en/docs/extension-dev-instance-types-26","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types#top-level-keys","content":"The type name, of `a-z`, `0-9`, `.`, `-`; the type id is `<extension id>:<name>`","locale":"en"},"5011":{"id":"/en/docs/extension-dev-instance-types-27","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types#top-level-keys","content":"`provider`","locale":"en"},"5012":{"id":"/en/docs/extension-dev-instance-types-28","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types#top-level-keys","content":"No","locale":"en"},"5013":{"id":"/en/docs/extension-dev-instance-types-29","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types#top-level-keys","content":"`declarative` (the default) or `backend` (see Types a backend provides)","locale":"en"},"5014":{"id":"/en/docs/extension-dev-instance-types-30","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types#top-level-keys","content":"`displayName`","locale":"en"},"5015":{"id":"/en/docs/extension-dev-instance-types-31","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types#top-level-keys","content":"Yes","locale":"en"},"5016":{"id":"/en/docs/extension-dev-instance-types-32","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types#top-level-keys","content":"The display name; see Text","locale":"en"},"5017":{"id":"/en/docs/extension-dev-instance-types-33","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types#top-level-keys","content":"`defaultName`","locale":"en"},"5018":{"id":"/en/docs/extension-dev-instance-types-34","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types#top-level-keys","content":"No","locale":"en"},"5019":{"id":"/en/docs/extension-dev-instance-types-35","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types#top-level-keys","content":"Plain-text prefix for generated instance names, for example `\"llama.cpp\"`. When the user leaves the name empty, the host adds a random suffix. It trims the prefix and ignores a blank value.","locale":"en"},"5020":{"id":"/en/docs/extension-dev-instance-types-36","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types#top-level-keys","content":"`description`","locale":"en"},"5021":{"id":"/en/docs/extension-dev-instance-types-37","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types#top-level-keys","content":"No","locale":"en"},"5022":{"id":"/en/docs/extension-dev-instance-types-38","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types#top-level-keys","content":"A description; see Text","locale":"en"},"5023":{"id":"/en/docs/extension-dev-instance-types-39","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types#top-level-keys","content":"`preview`","locale":"en"},"5024":{"id":"/en/docs/extension-dev-instance-types-40","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types#top-level-keys","content":"No","locale":"en"},"5025":{"id":"/en/docs/extension-dev-instance-types-41","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/docs/extension-dev-instance-types#top-level-keys","content":"The preview image: a file of the package, such as `images/preview.png`","locale":"en"},"5026":{"id":"/en/docs/extension-dev-instance-types-42","page_id":"/en/docs/extension-dev-instance-types","tags":[],"type":"text","url":"/en/do