llation#安装包格式","content":"平台","locale":"zh-CN"},"521":{"id":"/docs/installation-30","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#安装包格式","content":"格式","locale":"zh-CN"},"522":{"id":"/docs/installation-31","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#安装包格式","content":"说明","locale":"zh-CN"},"523":{"id":"/docs/installation-32","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#安装包格式","content":"Windows","locale":"zh-CN"},"524":{"id":"/docs/installation-33","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#安装包格式","content":"安装程序（`.exe`）","locale":"zh-CN"},"525":{"id":"/docs/installation-34","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#安装包格式","content":"推荐。常规安装流程，支持应用内更新","locale":"zh-CN"},"526":{"id":"/docs/installation-35","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#安装包格式","content":"Windows","locale":"zh-CN"},"527":{"id":"/docs/installation-36","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#安装包格式","content":"MSI 安装包","locale":"zh-CN"},"528":{"id":"/docs/installation-37","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#安装包格式","content":"适合批量部署；不参与应用内更新","locale":"zh-CN"},"529":{"id":"/docs/installation-38","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#安装包格式","content":"Windows","locale":"zh-CN"},"530":{"id":"/docs/installation-39","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#安装包格式","content":"免安装压缩包","locale":"zh-CN"},"531":{"id":"/docs/installation-40","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#安装包格式","content":"解压即用；不参与应用内更新","locale":"zh-CN"},"532":{"id":"/docs/installation-41","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#安装包格式","content":"macOS","locale":"