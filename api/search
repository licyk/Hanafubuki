mand-list","content":"`/new`","locale":"en"},"2073":{"id":"/en/docs/agent-commands-context-10","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"Create a new session","locale":"en"},"2074":{"id":"/en/docs/agent-commands-context-11","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"`/fork`","locale":"en"},"2075":{"id":"/en/docs/agent-commands-context-12","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"Fork from the end of the currently committed session","locale":"en"},"2076":{"id":"/en/docs/agent-commands-context-13","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"`/model`","locale":"en"},"2077":{"id":"/en/docs/agent-commands-context-14","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"Choose a provider and model for the current idle session","locale":"en"},"2078":{"id":"/en/docs/agent-commands-context-15","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"`/effort`","locale":"en"},"2079":{"id":"/en/docs/agent-commands-context-16","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"Adjust the reasoning effort for the current session","locale":"en"},"2080":{"id":"/en/docs/agent-commands-context-17","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"`/status`","locale":"en"},"2081":{"id":"/en/docs/agent-commands-context-18","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"View the session ID, context, token usage, and working time","locale":"en"},"2082":{"id":"/en/docs/agent-commands-context-19","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"`/compress`","locale":"en"},"2083":{"id":"/en/docs/agent-commands-context-20","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"Manually compact the current session's model context","locale":"en"},"2084":{"id":"/en/docs/agent-commands-context-21","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"`/memory`","locale":"en"},"2085":{"id":"/en/docs/agent-commands-context-22","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"View or change whether the current session contributes memory","locale":"en"},"2086":{"id":"/en/docs/agent-commands-context-23","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"`/mcp`","locale":"en"},"2087":{"id":"/en/docs/agent-commands-context-24","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"Open the MCP server runtime status panel","locale":"en"},"2088":{"id":"/en/docs/agent-commands-context-25","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"`/mcp verbose`","locale":"en"},"2089":{"id":"/en/docs/agent-commands-context-26","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"View MCP capabilities, policies, tool plans, and diagnostics","locale":"en"},"2090":{"id":"/en/docs/agent-commands-context-27","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"`/skills`","locale":"en"},"2091":{"id":"/en/docs/agent-commands-context-28","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"Select Skills available to the current session for the next message","locale":"en"},"2092":{"id":"/en/docs/agent-commands-context-29","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"`/ps`","locale":"en"},"2093":{"id":"/en/docs/agent-commands-context-30","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"List the current session's background terminals","locale":"en"},"2094":{"id":"/en/docs/agent-commands-context-31","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"`/stop`","locale":"en"},"2095":{"id":"/en/docs/agent-commands-context-32","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"Stop and clean up the current session's background terminals","locale":"en"},"2096":{"id":"/en/docs/agent-commands-context-33","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-list","content":"Commands must match exactly. If you enter an unknown command, the interface reports an error instead of sending it as a normal prompt. Once the command list is open, you can navigate it with the keyboard. If you genuinely need to send ordinary text that begins with `/`, close the command list first, then submit the content as a multiline or regular message.","locale":"en"},"2097":{"id":"/en/docs/agent-commands-context-34","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#models-and-reasoning-effort","content":"`/model` opens the same selector as the model button beside the input. The selector queries every enabled provider and displays loading errors separately. If the desired model is absent from the catalog, you can enter a custom model ID.","locale":"en"},"2098":{"id":"/en/docs/agent-commands-context-35","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#models-and-reasoning-effort","content":"`/effort` applies only to Responses sessions that support reasoning effort. You can select the provider default, a known preset, or a custom value. Changing either the model or reasoning effort requires the session to be idle.","locale":"en"},"2099":{"id":"/en/docs/agent-commands-context-36","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#viewing-status","content":"Run `/status` to view:","locale":"en"},"2100":{"id":"/en/docs/agent-commands-context-37","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#viewing-status","content":"The current session identifier.","locale":"en"},"2101":{"id":"/en/docs/agent-commands-context-38","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#viewing-status","content":"The proportion of context consumed and remaining; it may be shown as unknown when the provider does not report it.","locale":"en"},"2102":{"id":"/en/docs/agent-commands-context-39","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#viewing-status","content":"Input, output, and total token usage, including whether the data is provider-reported or estimated.","locale":"en"},"2103":{"id":"/en/docs/agent-commands-context-40","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#viewing-status","content":"Working time for the current turn and for the whole session.","locale":"en"},"2104":{"id":"/en/docs/agent-commands-context-41","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#viewing-status","content":"Context windows already traversed by a long session and its compaction information.","locale":"en"},"2105":{"id":"/en/docs/agent-commands-context-42","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#viewing-status","content":"Use this information to decide whether to split a task or compact the context. It does not represent billing; actual charges are determined by the model provider.","locale":"en"},"2106":{"id":"/en/docs/agent-commands-context-43","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#automatic-and-manual-compaction","content":"When automatic compaction is enabled, the application organizes the history sent to the model as it approaches the configured threshold or triggers the runtime budget. You can also run `/compress` to compact proactively when the session permits it.","locale":"en"},"2107":{"id":"/en/docs/agent-commands-context-44","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#automatic-and-manual-compaction","content":"Compaction may use a local summary or remote Responses compaction declared as supported by the provider. The session's model protocol and frozen capabilities determine the implementation; the application does not guess the server API while a run is in progress.","locale":"en"},"2108":{"id":"/en/docs/agent-commands-context-45","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#automatic-and-manual-compaction","content":"Messages and tool records remain visible in the interface. Compaction changes the context used by\nthe next model request. Repeated compaction gradually summarizes older content, so restate\nimportant constraints in a new message.","locale":"en"},"2109":{"id":"/en/docs/agent-commands-context-46","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#automatic-and-manual-compaction","content":"If the model explicitly reports insufficient context before producing any output, the application may compact and retry. Once output has been produced, it does not automatically replay the entire turn, avoiding duplicate tool calls or external actions.","locale":"en"},"2110":{"id":"/en/docs/agent-commands-context-47","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-restrictions","content":"`/model`, `/effort`, and `/fork` require the current session to be idle.","locale":"en"},"2111":{"id":"/en/docs/agent-commands-context-48","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-restrictions","content":"`/compress` is available only when the session has content that can be compacted and no conflicting operation is running.","locale":"en"},"2112":{"id":"/en/docs/agent-commands-context-49","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-restrictions","content":"A `/memory` state marked as contaminated cannot be re-enabled.","locale":"en"},"2113":{"id":"/en/docs/agent-commands-context-50","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-restrictions","content":"`/ps` and `/stop` operate only on background terminals owned by the current Agent session.","locale":"en"},"2114":{"id":"/en/docs/agent-commands-context-51","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-restrictions","content":"`/mcp` displays runtime state; complete server configuration remains under **Settings → Agent → MCP**.","locale":"en"},"2115":{"id":"/en/docs/agent-conversations","page_id":"/en/docs/agent-conversations","type":"page","content":"Session Management","breadcrumbs":["Hanafubuki Documentation","Agent"],"tags":[],"url":"/en/docs/agent-conversations","locale":"en"},"2116":{"id":"/en/docs/agent-conversations-0","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations","content":"Create, switch, archive, restore, delete, and fork Agent sessions.","locale":"en"},"2117":{"id":"/en/docs/agent-conversations-1","page_id":"/en/docs/agent-conversations","type":"heading","tags":[],"url":"/en/docs/agent-conversations#creating-and-switching-sessions","content":"Creating and switching sessions","locale":"en"},"2118":{"id":"/en/docs/agent-conversations-2","page_id":"/en/docs/agent-conversations","type":"heading","tags":[],"url":"/en/docs/agent-conversations#conversation-titles","content":"Conversation titles","locale":"en"},"2119":{"id":"/en/docs/agent-conversations-3","page_id":"/en/docs/agent-conversations","type":"heading","tags":[],"url":"/en/docs/agent-conversations#archiving-and-restoring","content":"Archiving and restoring","locale":"en"},"2120":{"id":"/en/docs/agent-conversations-4","page_id":"/en/docs/agent-conversations","type":"heading","tags":[],"url":"/en/docs/agent-conversations#permanent-deletion","content":"Permanent deletion","locale":"en"},"2121":{"id":"/en/docs/agent-conversations-5","page_id":"/en/docs/agent-conversations","type":"heading","tags":[],"url":"/en/docs/agent-conversations#forking-a-session","content":"Forking a session","locale":"en"},"2122":{"id":"/en/docs/agent-conversations-6","page_id":"/en/docs/agent-conversations","type":"heading","tags":[],"url":"/en/docs/agent-conversations#scope-of-session-configuration","content":"Scope of session configuration","locale":"en"},"2123":{"id":"/en/docs/agent-conversations-7","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations","content":"An Agent session stores messages, tool calls, approvals, model selection, and context state. After switching pages or reopening the application, you can continue reviewing persisted records.","locale":"en"},"2124":{"id":"/en/docs/agent-conversations-8","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#creating-and-switching-sessions","content":"Click **New** at the top of the session list, or run `/new`, to create a session. The application attaches context relevant to the current interface and uses the default model policy and capabilities available at that time.","locale":"en"},"2125":{"id":"/en/docs/agent-conversations-9","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#creating-and-switching-sessions","content":"The session list marks running sessions and sessions in Plan mode. Selecting another session does not automatically stop the current task. Before switching, check whether a response, compaction, or background terminal is still running.","locale":"en"},"2126":{"id":"/en/docs/agent-conversations-10","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#creating-and-switching-sessions","content":"The list loads in pages. Use **Load more** when there are many sessions. After entering a long session, you can also load earlier messages from the top of its history.","locale":"en"},"2127":{"id":"/en/docs/agent-conversations-11","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#conversation-titles","content":"After the first message is accepted, the application immediately shows a short title from that message and asks the current session model to refine it in the background. Title generation does not add a message or tool call to the conversation. If generation fails, the initial short title remains available.","locale":"en"},"2128":{"id":"/en/docs/agent-conversations-12","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#conversation-titles","content":"Select the pencil beside the title to rename the conversation. Press Enter or select the check button to save; press Escape or select the cancel button to discard the edit. A title you rename manually is authoritative and is not replaced by a late automatic result. Titles are persisted with the session and remain after restarting the application.","locale":"en"},"2129":{"id":"/en/docs/agent-conversations-13","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#archiving-and-restoring","content":"Archiving hides a session you do not currently need while preserving it:","locale":"en"},"2130":{"id":"/en/docs/agent-conversations-14","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#archiving-and-restoring","content":"Archiving does not delete messages, tool history, or memory-source relationships, and it does not treat background processes that are still running as stopped.","locale":"en"},"2131":{"id":"/en/docs/agent-conversations-15","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#permanent-deletion","content":"Permanent deletion cannot be undone. The delete button requires an additional confirmation to prevent accidental use.","locale":"en"},"2132":{"id":"/en/docs/agent-conversations-16","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#permanent-deletion","content":"Before deleting, check that:","locale":"en"},"2133":{"id":"/en/docs/agent-conversations-17","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#permanent-deletion","content":"The current response and compaction have finished.","locale":"en"},"2134":{"id":"/en/docs/agent-conversations-18","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#permanent-deletion","content":"`/ps` no longer shows background terminals for the session.","locale":"en"},"2135":{"id":"/en/docs/agent-conversations-19","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#permanent-deletion","content":"You no longer need its messages, tool output, or memory sources.","locale":"en"},"2136":{"id":"/en/docs/agent-conversations-20","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#permanent-deletion","content":"No fork relationships or resources awaiting cleanup depend on the session history.","locale":"en"},"2137":{"id":"/en/docs/agent-conversations-21","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#permanent-deletion","content":"If process cleanup or session relationships still have unmet requirements, the backend rejects the deletion and preserves the data. Resolve the cleanup obligation in the message and retry. Do not interpret a failed deletion as meaning that records were partially removed.","locale":"en"},"2138":{"id":"/en/docs/agent-conversations-22","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#forking-a-session","content":"Forking is useful when you want to preserve the current approach while trying another solution from a point in history.","locale":"en"},"2139":{"id":"/en/docs/agent-conversations-23","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#forking-a-session","content":"Action","locale":"en"},"2140":{"id":"/en/docs/agent-conversations-24","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#forking-a-session","content":"Result","locale":"en"},"2141":{"id":"/en/docs/agent-conversations-25","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#forking-a-session","content":"`/fork`","locale":"en"},"2142":{"id":"/en/docs/agent-conversations-26","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#forking-a-session","content":"Fork from the end of the currently committed session","locale":"en"},"2143":{"id":"/en/docs/agent-conversations-27","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#forking-a-session","content":"Edit a past user message","locale":"en"},"2144":{"id":"/en/docs/agent-conversations-28","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#forking-a-session","content":"Fork before that message and restore it to the input for editing","locale":"en"},"2145":{"id":"/en/docs/agent-conversations-29","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#forking-a-session","content":"A fork does not overwrite or rewrite the original session. Editing a past message also does not submit a new request immediately: review the content restored to the input before sending the revised task.","locale":"en"},"2146":{"id":"/en/docs/agent-conversations-30","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#forking-a-session","content":"The child session can reuse history before the fork point, but later messages are stored separately. Memory contribution is also handled per session; the child does not copy later parent-session content as its own source.","locale":"en"},"2147":{"id":"/en/docs/agent-conversations-31","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#scope-of-session-configuration","content":"Each session records its own model and reasoning effort; changing global defaults does not replace them automatically.","locale":"en"},"2148":{"id":"/en/docs/agent-conversations-32","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#scope-of-session-configuration","content":"Each user turn captures a fresh enabled, available Skill catalog. Pending changes for a selected session take effect from its next turn as indicated by the interface.","locale":"en"},"2149":{"id":"/en/docs/agent-conversations-33","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#scope-of-session-configuration","content":"MCP connections and the tool catalog can change, but each model sampling step uses the tool plan frozen when that step began.","locale":"en"},"2150":{"id":"/en/docs/agent-conversations-34","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#scope-of-session-configuration","content":"Whether a session may generate memory is determined by the setting at creation or fork time and can be inspected with `/memory`.","locale":"en"},"2151":{"id":"/en/docs/agent-conversations-35","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#scope-of-session-configuration","content":"Archive a session when you only want to organize the list. Delete it permanently only when you are\ncertain that you no longer need its history, output, or memory sources.","locale":"en"},"2152":{"id":"/en/docs/agent-mcp","page_id":"/en/docs/agent-mcp","type":"page","content":"MCP","breadcrumbs":["Hanafubuki Documentation","Agent"],"tags":[],"url":"/en/docs/agent-mcp","locale":"en"},"2153":{"id":"/en/docs/agent-mcp-0","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp","content":"Configure MCP servers, connect runtimes, and control tool exposure and approval policies.","locale":"en"},"2154":{"id":"/en/docs/agent-mcp-1","page_id":"/en/docs/agent-mcp","type":"heading","tags":[],"url":"/en/docs/agent-mcp#choosing-a-transport","content":"Choosing a transport","locale":"en"},"2155":{"id":"/en/docs/agent-mcp-2","page_id":"/en/docs/agent-mcp","type":"heading","tags":[],"url":"/en/docs/agent-mcp#adding-and-connecting-a-server","content":"Adding and connecting a server","locale":"en"},"2156":{"id":"/en/docs/agent-mcp-3","page_id":"/en/docs/agent-mcp","type":"heading","tags":[],"url":"/en/docs/agent-mcp#tool-policies","content":"Tool policies","locale":"en"},"2157":{"id":"/en/docs/agent-mcp-4","page_id":"/en/docs/agent-mcp","type":"heading","tags":[],"url":"/en/docs/agent-mcp#inspecting-mcp-in-a-session","content":"Inspecting MCP in a session","locale":"en"},"2158":{"id":"/en/docs/agent-mcp-5","page_id":"/en/docs/agent-mcp","type":"heading","tags":[],"url":"/en/docs/agent-mcp#common-problems","content":"Common problems","locale":"en"},"2159":{"id":"/en/docs/agent-mcp-6","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp","content":"MCP lets local programs or remote services provide tools to the Agent. A server may access files, networks, databases, and third-party accounts, so both the connection configuration and the permissions granted to its tools require review.","locale":"en"},"2160":{"id":"/en/docs/agent-mcp-7","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#choosing-a-transport","content":"Use this for a local MCP program launched by the application. Configure its executable, arguments, working directory, public environment variables, and credential environment-variable references.","locale":"en"},"2161":{"id":"/en/docs/agent-mcp-8","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#choosing-a-transport","content":"The program must be discoverable and able to start on the current system. Relative commands, missing runtimes, and an incorrect working directory commonly cause startup failures.","locale":"en"},"2162":{"id":"/en/docs/agent-mcp-9","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#choosing-a-transport","content":"Use this for an already-running remote or local HTTP service. Configure its `http`/`https` URL, public request headers, credential-header references, and OAuth policy.","locale":"en"},"2163":{"id":"/en/docs/agent-mcp-10","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#choosing-a-transport","content":"OAuth can be disabled, optional, or required. When sign-in is needed, open the browser from the interface and complete the callback.","locale":"en"},"2164":{"id":"/en/docs/agent-mcp-11","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#choosing-a-transport","content":"MCP credential values are stored exactly as entered. Runtime status, diagnostics, and `/mcp verbose` should only show whether a credential exists, never its value. Even so, do not publicly share MCP settings files or screenshots containing credential input fields.","locale":"en"},"2165":{"id":"/en/docs/agent-mcp-12","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#adding-and-connecting-a-server","content":"Enter the target, environment variables, or request headers, then create credential references\nas needed.","locale":"en"},"2166":{"id":"/en/docs/agent-mcp-13","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#adding-and-connecting-a-server","content":"Configure whether the server is enabled and required, along with connection and invocation\ntimeouts.","locale":"en"},"2167":{"id":"/en/docs/agent-mcp-14","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#adding-and-connecting-a-server","content":"Refresh the tool catalog and review tool names, descriptions, risk notices, and policies.","locale":"en"},"2168":{"id":"/en/docs/agent-mcp-15","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#adding-and-connecting-a-server","content":"**Enabled** is persistent configuration; **Connected** is current runtime state. A server can be disabled, starting, ready, refreshing, stopping, or failed. After editing its configuration, check that the runtime is using the new connection and catalog version.","locale":"en"},"2169":{"id":"/en/docs/agent-mcp-16","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Policy","locale":"en"},"2170":{"id":"/en/docs/agent-mcp-17","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Options","locale":"en"},"2171":{"id":"/en/docs/agent-mcp-18","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Purpose","locale":"en"},"2172":{"id":"/en/docs/agent-mcp-19","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Approval","locale":"en"},"2173":{"id":"/en/docs/agent-mcp-20","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Allow, Ask, Deny","locale":"en"},"2174":{"id":"/en/docs/agent-mcp-21","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Decide whether a tool call proceeds directly, requires approval, or is prohibited","locale":"en"},"2175":{"id":"/en/docs/agent-mcp-22","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Exposure","locale":"en"},"2176":{"id":"/en/docs/agent-mcp-23","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Direct, Deferred, Hidden","locale":"en"},"2177":{"id":"/en/docs/agent-mcp-24","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Decide whether the model sees the tool immediately, on demand, or not at all","locale":"en"},"2178":{"id":"/en/docs/agent-mcp-25","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Enable filter","locale":"en"},"2179":{"id":"/en/docs/agent-mcp-26","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Enabled/disabled tool lists","locale":"en"},"2180":{"id":"/en/docs/agent-mcp-27","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Expose only selected tools from the server","locale":"en"},"2181":{"id":"/en/docs/agent-mcp-28","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Concurrency","locale":"en"},"2182":{"id":"/en/docs/agent-mcp-29","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Server and per-tool limits","locale":"en"},"2183":{"id":"/en/docs/agent-mcp-30","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Limit the number of simultaneous MCP calls","locale":"en"},"2184":{"id":"/en/docs/agent-mcp-31","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"You can set server defaults and override them for individual tools. Keep **Ask** for tools that write, delete, send messages, or modify external systems. Hide or disable tools you do not use.","locale":"en"},"2185":{"id":"/en/docs/agent-mcp-32","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Each model sampling step freezes the tool plan that existed when the step began. Refreshing a connection or changing policy may update runtime state immediately, but an in-progress sampling step continues using the old plan. The change appears in the next step.","locale":"en"},"2186":{"id":"/en/docs/agent-mcp-33","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#inspecting-mcp-in-a-session","content":"`/mcp`: View the server count, connection state, errors, and current tool count, and connect, refresh, or disconnect servers.","locale":"en"},"2187":{"id":"/en/docs/agent-mcp-34","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#inspecting-mcp-in-a-session","content":"`/mcp verbose`: View transport targets, connection generations, capabilities, tool policies, the current frozen plan, credential-presence state, and bounded diagnostics.","locale":"en"},"2188":{"id":"/en/docs/agent-mcp-35","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#inspecting-mcp-in-a-session","content":"Use the runtime panel to troubleshoot and reconnect. Add, remove, or edit servers and credentials from the settings page.","locale":"en"},"2189":{"id":"/en/docs/agent-mcp-36","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"Symptom","locale":"en"},"2190":{"id":"/en/docs/agent-mcp-37","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"Check","locale":"en"},"2191":{"id":"/en/docs/agent-mcp-38","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"stdio does not start","locale":"en"},"2192":{"id":"/en/docs/agent-mcp-39","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"Program path, arguments, working directory, runtime, and environment variables","locale":"en"},"2193":{"id":"/en/docs/agent-mcp-40","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"HTTP does not connect","locale":"en"},"2194":{"id":"/en/docs/agent-mcp-41","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"URL, proxy, certificate, request headers, and server status","locale":"en"},"2195":{"id":"/en/docs/agent-mcp-42","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"OAuth fails","locale":"en"},"2196":{"id":"/en/docs/agent-mcp-43","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"OAuth policy, browser callback, account authorization, and server configuration","locale":"en"},"2197":{"id":"/en/docs/agent-mcp-44","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"Connected but no tools","locale":"en"},"2198":{"id":"/en/docs/agent-mcp-45","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"Catalog refresh, enable filters, exposure policy, and server capabilities","locale":"en"},"2199":{"id":"/en/docs/agent-mcp-46","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"Tool waits indefinitely","locale":"en"},"2200":{"id":"/en/docs/agent-mcp-47","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"Invocation timeout, concurrency limits, approval card, and server response","locale":"en"},"2201":{"id":"/en/docs/agent-mcp-48","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"Cleanup remains after stop","locale":"en"},"2202":{"id":"/en/docs/agent-mcp-49","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"Retry disconnect from the runtime panel; do not immediately delete the configuration","locale":"en"},"2203":{"id":"/en/docs/agent-mcp-50","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"After a Web or MCP tool successfully returns content, the current session is marked as containing\nexternal content and can no longer contribute persistent memory. This prevents unverified external\ndata from entering project memory.","locale":"en"},"2204":{"id":"/en/docs/agent-memory","page_id":"/en/docs/agent-memory","type":"page","content":"Memory","breadcrumbs":["Hanafubuki Documentation","Agent"],"tags":[],"url":"/en/docs/agent-memory","locale":"en"},"2205":{"id":"/en/docs/agent-memory-0","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory","content":"Control memory retrieval, generation, contribution, and reset across sessions.","locale":"en"},"2206":{"id":"/en/docs/agent-memory-1","page_id":"/en/docs/agent-memory","type":"heading","tags":[],"url":"/en/docs/agent-memory#global-settings","content":"Global settings","locale":"en"},"2207":{"id":"/en/docs/agent-memory-2","page_id":"/en/docs/agent-memory","type":"heading","tags":[],"url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"Contribution state of the current session","locale":"en"},"2208":{"id":"/en/docs/agent-memory-3","page_id":"/en/docs/agent-memory","type":"heading","tags":[],"url":"/en/docs/agent-memory#using-versus-generating-memory","content":"Using versus generating memory","locale":"en"},"2209":{"id":"/en/docs/agent-memory-4","page_id":"/en/docs/agent-memory","type":"heading","tags":[],"url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"What the Agent can do with memory","locale":"en"},"2210":{"id":"/en/docs/agent-memory-5","page_id":"/en/docs/agent-memory","type":"heading","tags":[],"url":"/en/docs/agent-memory#archiving-deleting-and-forking","content":"Archiving, deleting, and forking","locale":"en"},"2211":{"id":"/en/docs/agent-memory-6","page_id":"/en/docs/agent-memory","type":"heading","tags":[],"url":"/en/docs/agent-memory#resetting-memory","content":"Resetting memory","locale":"en"},"2212":{"id":"/en/docs/agent-memory-7","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory","content":"Memory is project knowledge distilled from sessions for use in later, relevant tasks. It differs from session history: history contains the original messages and tool records, while memory is derived context and grants no file or tool permissions.","locale":"en"},"2213":{"id":"/en/docs/agent-memory-8","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#global-settings","content":"Go to **Settings → Agent → Behavior and Memory**. Enable the master memory switch, then configure:","locale":"en"},"2214":{"id":"/en/docs/agent-memory-9","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#global-settings","content":"Option","locale":"en"},"2215":{"id":"/en/docs/agent-memory-10","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#global-settings","content":"Purpose","locale":"en"},"2216":{"id":"/en/docs/agent-memory-11","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#global-settings","content":"Use memory","locale":"en"},"2217":{"id":"/en/docs/agent-memory-12","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#global-settings","content":"Add retrieved relevant knowledge to model requests","locale":"en"},"2218":{"id":"/en/docs/agent-memory-13","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#global-settings","content":"Generate memory","locale":"en"},"2219":{"id":"/en/docs/agent-memory-14","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#global-settings","content":"Allow the background process to derive new memory from eligible sessions","locale":"en"},"2220":{"id":"/en/docs/agent-memory-15","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#global-settings","content":"Exclude external content","locale":"en"},"2221":{"id":"/en/docs/agent-memory-16","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#global-settings","content":"Prevent sessions containing external Web or MCP content from becoming sources","locale":"en"},"2222":{"id":"/en/docs/agent-memory-17","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#global-settings","content":"Memory can remain disabled by default. Before enabling it, make sure the project's content is suitable for long-term retention. Do not place tokens, private keys, personal data, or short-lived sensitive information in messages you want remembered.","locale":"en"},"2223":{"id":"/en/docs/agent-memory-18","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"Run `/memory` to see whether the current session is allowed to contribute memory and, when permitted, change its state.","locale":"en"},"2224":{"id":"/en/docs/agent-memory-19","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"State","locale":"en"},"2225":{"id":"/en/docs/agent-memory-20","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"Meaning","locale":"en"},"2226":{"id":"/en/docs/agent-memory-21","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"Enabled","locale":"en"},"2227":{"id":"/en/docs/agent-memory-22","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"The session may be used as a memory source when it meets the other conditions","locale":"en"},"2228":{"id":"/en/docs/agent-memory-23","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"Disabled","locale":"en"},"2229":{"id":"/en/docs/agent-memory-24","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"Preserve session history but do not generate memory from it","locale":"en"},"2230":{"id":"/en/docs/agent-memory-25","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"Contaminated","locale":"en"},"2231":{"id":"/en/docs/agent-memory-26","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"The session received Web or MCP tool content and is permanently excluded as a source","locale":"en"},"2232":{"id":"/en/docs/agent-memory-27","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"The backend marks a session as **Contaminated** after a successful external tool result. This is not an ordinary toggle and cannot be re-enabled. It only prevents that session from contributing memory; it does not delete the session or imply that the external content is necessarily harmful.","locale":"en"},"2233":{"id":"/en/docs/agent-memory-28","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"When a session is created or forked, it records whether memory generation was allowed at that time. You can later manage the current session with `/memory`, but no memory is retrieved or generated while memory is globally disabled.","locale":"en"},"2234":{"id":"/en/docs/agent-memory-29","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#using-versus-generating-memory","content":"**Use memory** controls whether the current model can read existing memory.","locale":"en"},"2235":{"id":"/en/docs/agent-memory-30","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#using-versus-generating-memory","content":"**Generate memory** controls whether eligible sessions can become sources of new memory.","locale":"en"},"2236":{"id":"/en/docs/agent-memory-31","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#using-versus-generating-memory","content":"Disabling contribution for the current session does not delete memory that has already been generated.","locale":"en"},"2237":{"id":"/en/docs/agent-memory-32","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#using-versus-generating-memory","content":"Compacting a session does not write dynamically retrieved memory into visible message history.","locale":"en"},"2238":{"id":"/en/docs/agent-memory-33","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#using-versus-generating-memory","content":"The Agent retrieves memory again for every model sampling step, so newly generated or reset results take effect in subsequent steps.","locale":"en"},"2239":{"id":"/en/docs/agent-memory-34","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"Retrieval is a two-part arrangement. Every sampling step carries a compact summary that acts as a routing index, and the rest of memory is read on demand through its own tools:","locale":"en"},"2240":{"id":"/en/docs/agent-memory-35","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"Tool","locale":"en"},"2241":{"id":"/en/docs/agent-memory-36","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"Purpose","locale":"en"},"2242":{"id":"/en/docs/agent-memory-37","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"`list_agent_memories`","locale":"en"},"2243":{"id":"/en/docs/agent-memory-38","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"Report the readable resources and their ids","locale":"en"},"2244":{"id":"/en/docs/agent-memory-39","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"`search_agent_memories`","locale":"en"},"2245":{"id":"/en/docs/agent-memory-40","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"Find a keyword and return ids with line numbers","locale":"en"},"2246":{"id":"/en/docs/agent-memory-41","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"`read_agent_memory`","locale":"en"},"2247":{"id":"/en/docs/agent-memory-42","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"Read a line range from one resource","locale":"en"},"2248":{"id":"/en/docs/agent-memory-43","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"`append_agent_memory_note`","locale":"en"},"2249":{"id":"/en/docs/agent-memory-44","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"Record one instruction to remember, forget, or update","locale":"en"},"2250":{"id":"/en/docs/agent-memory-45","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"Memory is reachable only through these tools. It is not on a path any filesystem or command tool can open, so the Agent cannot read or edit memory files directly.","locale":"en"},"2251":{"id":"/en/docs/agent-memory-46","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"Reading follows what is published. A memory stays readable while newer sessions are still waiting to be consolidated, so asking the Agent to remember something never hides the memory you already have. The written note is queued instead: the Agent records it, and a later consolidation pass merges it in.","locale":"en"},"2252":{"id":"/en/docs/agent-memory-47","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"The Agent may only write a note when you have asked it to remember, forget, or update something. It does not decide on its own that a conversation was worth keeping.","locale":"en"},"2253":{"id":"/en/docs/agent-memory-48","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"When an answer materially relies on memory, the Agent cites the resources it read. The application validates those citations against what memory actually attributes the fact to, and removes the citation block from the visible answer once the turn commits.","locale":"en"},"2254":{"id":"/en/docs/agent-memory-49","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#archiving-deleting-and-forking","content":"Session action","locale":"en"},"2255":{"id":"/en/docs/agent-memory-50","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#archiving-deleting-and-forking","content":"Effect on memory sources","locale":"en"},"2256":{"id":"/en/docs/agent-memory-51","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#archiving-deleting-and-forking","content":"Archive/restore","locale":"en"},"2257":{"id":"/en/docs/agent-memory-52","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#archiving-deleting-and-forking","content":"Preserves source relationships; only changes visibility in the session list","locale":"en"},"2258":{"id":"/en/docs/agent-memory-53","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#archiving-deleting-and-forking","content":"Permanently delete","locale":"en"},"2259":{"id":"/en/docs/agent-memory-54","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#archiving-deleting-and-forking","content":"Revokes the session's eligibility as a future memory source","locale":"en"},"2260":{"id":"/en/docs/agent-memory-55","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#archiving-deleting-and-forking","content":"Fork","locale":"en"},"2261":{"id":"/en/docs/agent-memory-56","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#archiving-deleting-and-forking","content":"The child contributes only content it produces after the fork; the parent remains independent","locale":"en"},"2262":{"id":"/en/docs/agent-memory-57","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#resetting-memory","content":"The settings page shows the current number of memory entries and sources. Reset requires a second confirmation. It clears derived memory and begins a new memory generation.","locale":"en"},"2263":{"id":"/en/docs/agent-memory-58","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#resetting-memory","content":"Resetting does not delete Agent sessions or their original histories. If generation remains enabled, eligible sessions may produce new memory later. If you no longer want a particular session to contribute, disable it first with `/memory` or permanently delete that session.","locale":"en"},"2264":{"id":"/en/docs/agent-memory-59","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#resetting-memory","content":"Do not rely on external-content exclusion or reset to protect credentials. Sensitive information\nshould never enter prompts, attachments, or project documents in the first place. Manually review\nand redact diagnostics or session records before sharing them.","locale":"en"},"2265":{"id":"/en/docs/agent-messages-attachments","page_id":"/en/docs/agent-messages-attachments","type":"page","content":"Messages and Attachments","breadcrumbs":["Hanafubuki Documentation","Agent"],"tags":[],"url":"/en/docs/agent-messages-attachments","locale":"en"},"2266":{"id":"/en/docs/agent-messages-attachments-0","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments","content":"Write messages, reference project files, add images, and steer work in progress.","locale":"en"},"2267":{"id":"/en/docs/agent-messages-attachments-1","page_id":"/en/docs/agent-messages-attachments","type":"heading","tags":[],"url":"/en/docs/agent-messages-attachments#writing-and-sending","content":"Writing and sending","locale":"en"},"2268":{"id":"/en/docs/agent-messages-attachments-2","page_id":"/en/docs/agent-messages-attachments","type":"heading","tags":[],"url":"/en/docs/agent-messages-attachments#current-interface-context","content":"Current interface context","locale":"en"},"2269":{"id":"/en/docs/agent-messages-attachments-3","page_id":"/en/docs/agent-messages-attachments","type":"heading","tags":[],"url":"/en/docs/agent-messages-attachments#referencing-files-and-directories","content":"Referencing files and directories","locale":"en"},"2270":{"id":"/en/docs/agent-messages-attachments-4","page_id":"/en/docs/agent-messages-attachments","type":"heading","tags":[],"url":"/en/docs/agent-messages-attachments#adding-images","content":"Adding images","locale":"en"},"2271":{"id":"/en/docs/agent-messages-attachments-5","page_id":"/en/docs/agent-messages-attachments","type":"heading","tags":[],"url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"Adding messages while the Agent is working","locale":"en"},"2272":{"id":"/en/docs/agent-messages-attachments-6","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments","content":"The input can send text, project paths, images, and the Skill selection for the current turn. The application also attaches the current interface location automatically, helping the Agent understand which instance or settings area you are viewing.","locale":"en"},"2273":{"id":"/en/docs/agent-messages-attachments-7","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#writing-and-sending","content":"Press `Enter` to send a message and `Shift + Enter` to insert a line break.","locale":"en"},"2274":{"id":"/en/docs/agent-messages-attachments-8","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#writing-and-sending","content":"You can send images without text, or send text and images together.","locale":"en"},"2275":{"id":"/en/docs/agent-messages-attachments-9","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#writing-and-sending","content":"If no model is currently selected, click the model button or run `/model` first.","locale":"en"},"2276":{"id":"/en/docs/agent-messages-attachments-10","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#writing-and-sending","content":"While an approval, an Agent question, or confirmation of a proposed plan is pending, the input area changes to the corresponding action. You must resolve or skip that decision first.","locale":"en"},"2277":{"id":"/en/docs/agent-messages-attachments-11","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#writing-and-sending","content":"State the objective, scope, and acceptance criteria clearly in the prompt. When paths, instance names, or command arguments could be ambiguous, provide their exact text instead of saying only \"this,\" \"the previous one,\" or \"the default.\"","locale":"en"},"2278":{"id":"/en/docs/agent-messages-attachments-12","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#current-interface-context","content":"The input displays a label for the current context. Depending on your location, the Agent may receive interface context for the instance chooser, an instance-creation step, an instance workspace, an embedded WebUI, a settings section, or an instance-management section.","locale":"en"},"2279":{"id":"/en/docs/agent-messages-attachments-13","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#current-interface-context","content":"This is supporting context, not file permission or authorization to execute. The Agent must still inspect the real state through tools and follow the current permission mode and backend path rules.","locale":"en"},"2280":{"id":"/en/docs/agent-messages-attachments-14","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#referencing-files-and-directories","content":"Type `@` in the input to search paths in the current project context, or use the attachment menu to open the system picker. After selection, the path is inserted into the message in a form that handles spaces safely.","locale":"en"},"2281":{"id":"/en/docs/agent-messages-attachments-15","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#referencing-files-and-directories","content":"Type `@` and choose a search result, or select a file or directory from the attachment menu.","locale":"en"},"2282":{"id":"/en/docs/agent-messages-attachments-16","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#referencing-files-and-directories","content":"After sending, use the tool cards to verify which path the Agent actually read or modified.","locale":"en"},"2283":{"id":"/en/docs/agent-messages-attachments-17","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#referencing-files-and-directories","content":"A path reference only tells the Agent where something is; it does not automatically grant read or write access. The application manages the search scope and excludes protected internal data and ignored content.","locale":"en"},"2284":{"id":"/en/docs/agent-messages-attachments-18","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"A message can contain up to 8 images, which you can remove or reorder. Before sending, the backend decodes, validates, and normalizes them:","locale":"en"},"2285":{"id":"/en/docs/agent-messages-attachments-19","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Limit","locale":"en"},"2286":{"id":"/en/docs/agent-messages-attachments-20","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Value","locale":"en"},"2287":{"id":"/en/docs/agent-messages-attachments-21","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Individual source file","locale":"en"},"2288":{"id":"/en/docs/agent-messages-attachments-22","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Up to 20 MiB","locale":"en"},"2289":{"id":"/en/docs/agent-messages-attachments-23","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"All source images combined","locale":"en"},"2290":{"id":"/en/docs/agent-messages-attachments-24","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Up to 64 MiB","locale":"en"},"2291":{"id":"/en/docs/agent-messages-attachments-25","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Decoded pixels","locale":"en"},"2292":{"id":"/en/docs/agent-messages-attachments-26","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Up to 40 million","locale":"en"},"2293":{"id":"/en/docs/agent-messages-attachments-27","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Longest normalized edge","locale":"en"},"2294":{"id":"/en/docs/agent-messages-attachments-28","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Up to 2048 pixels","locale":"en"},"2295":{"id":"/en/docs/agent-messages-attachments-29","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Individual normalized result","locale":"en"},"2296":{"id":"/en/docs/agent-messages-attachments-30","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Up to 8 MiB","locale":"en"},"2297":{"id":"/en/docs/agent-messages-attachments-31","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Metadata is removed from images, and animated images use only a still frame. When the model policy is **Auto**, the application sends images according to known capabilities. If the model explicitly rejects images before producing any output, the application may remove them and retry once. Images cannot be sent when the model policy is **Disabled**.","locale":"en"},"2298":{"id":"/en/docs/agent-messages-attachments-32","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"If image reading, decoding, or request admission fails, the text and attachment draft remain available so you can fix the problem and send again.","locale":"en"},"2299":{"id":"/en/docs/agent-messages-attachments-33","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"If you enter new content and click the primary button while the Agent is responding, the application does not immediately begin a second turn. Instead, it places the content in the current panel's message queue.","locale":"en"},"2300":{"id":"/en/docs/agent-messages-attachments-34","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"Queue action","locale":"en"},"2301":{"id":"/en/docs/agent-messages-attachments-35","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"Purpose","locale":"en"},"2302":{"id":"/en/docs/agent-messages-attachments-36","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"Steer","locale":"en"},"2303":{"id":"/en/docs/agent-messages-attachments-37","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"Send the message into the current turn to adjust its direction","locale":"en"},"2304":{"id":"/en/docs/agent-messages-attachments-38","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"Edit","locale":"en"},"2305":{"id":"/en/docs/agent-messages-attachments-39","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"Restore the message and images to the input for further editing","locale":"en"},"2306":{"id":"/en/docs/agent-messages-attachments-40","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"Discard","locale":"en"},"2307":{"id":"/en/docs/agent-messages-attachments-41","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"Remove the item from the local queue without sending it to the Agent","locale":"en"},"2308":{"id":"/en/docs/agent-messages-attachments-42","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"Use steering to add a newly discovered constraint, such as \"Do not change the database schema.\" If the current work can finish naturally, keeping it as a message for the next turn is often clearer. The queue is draft state belonging only to the currently open panel; do not treat it as persisted session history.","locale":"en"},"2309":{"id":"/en/docs/agent-messages-attachments-43","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"Before submitting images or files, check for tokens, private keys, cookies, personal data, and\ninternal addresses. Attachments enter the model context; do not rely on the interface to redact\nthem for you.","locale":"en"},"2310":{"id":"/en/docs/agent-modes-plans","page_id":"/en/docs/agent-modes-plans","type":"page","content":"Modes and Plans","breadcrumbs":["Hanafubuki Documentation","Agent"],"tags":[],"url":"/en/docs/agent-modes-plans","locale":"en"},"2311":{"id":"/en/docs/agent-modes-plans-0","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans","content":"Distinguish Default mode, Plan mode, proposed plans, and execution task plans.","locale":"en"},"2312":{"id":"/en/docs/agent-modes-plans-1","page_id":"/en/docs/agent-modes-plans","type":"heading","tags":[],"url":"/en/docs/agent-modes-plans#default-mode-and-plan-mode","content":"Default mode and Plan mode","locale":"en"},"2313":{"id":"/en/docs/agent-modes-plans-2","page_id":"/en/docs/agent-modes-plans","type":"heading","tags":[],"url":"/en/docs/agent-modes-plans#working-in-plan-mode","content":"Working in Plan mode","locale":"en"},"2314":{"id":"/en/docs/agent-modes-plans-3","page_id":"/en/docs/agent-modes-plans","type":"heading","tags":[],"url":"/en/docs/agent-modes-plans#the-two-kinds-of-plan-are-different","content":"The two kinds of \"plan\" are different","locale":"en"},"2315":{"id":"/en/docs/agent-modes-plans-4","page_id":"/en/docs/agent-modes-plans","type":"heading","tags":[],"url":"/en/docs/agent-modes-plans#when-to-switch-modes","content":"When to switch modes","locale":"en"},"2316":{"id":"/en/docs/agent-modes-plans-5","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans","content":"The session mode determines which kinds of tools the Agent can currently use. It is separate from the permission mode: the session mode decides whether a capability is available, while the permission mode decides how an available operation is approved.","locale":"en"},"2317":{"id":"/en/docs/agent-modes-plans-6","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#default-mode-and-plan-mode","content":"Mode","locale":"en"},"2318":{"id":"/en/docs/agent-modes-plans-7","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#default-mode-and-plan-mode","content":"Best for","locale":"en"},"2319":{"id":"/en/docs/agent-modes-plans-8","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#default-mode-and-plan-mode","content":"Main behavior","locale":"en"},"2320":{"id":"/en/docs/agent-modes-plans-9","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#default-mode-and-plan-mode","content":"Default","locale":"en"},"2321":{"id":"/en/docs/agent-modes-plans-10","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#default-mode-and-plan-mode","content":"The objective and scope are clear and you want the task completed directly","locale":"en"},"2322":{"id":"/en/docs/agent-modes-plans-11","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#default-mode-and-plan-mode","content":"Can run commands, modify files within authorization, and track execution with a task plan","locale":"en"},"2323":{"id":"/en/docs/agent-modes-plans-12","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#default-mode-and-plan-mode","content":"Plan","locale":"en"},"2324":{"id":"/en/docs/agent-modes-plans-13","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#default-mode-and-plan-mode","content":"The requirement is complex and needs investigation and design confirmation first","locale":"en"},"2325":{"id":"/en/docs/agent-modes-plans-14","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#default-mode-and-plan-mode","content":"Allows investigation, reading, questions, and a proposed solution, but does not modify the repository","locale":"en"},"2326":{"id":"/en/docs/agent-modes-plans-15","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#default-mode-and-plan-mode","content":"Plan mode hides write, patch, and other mutation tools. Even if the permission mode is **Full access**, Plan mode does not become an execution mode.","locale":"en"},"2327":{"id":"/en/docs/agent-modes-plans-16","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#working-in-plan-mode","content":"Let the Agent read the existing code and documentation to confirm the current implementation.","locale":"en"},"2328":{"id":"/en/docs/agent-modes-plans-17","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#working-in-plan-mode","content":"Answer choices that affect the implementation. If uncertain, you can skip one and let the Agent\nuse its recommended default.","locale":"en"},"2329":{"id":"/en/docs/agent-modes-plans-18","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#working-in-plan-mode","content":"When the Agent asks a question, the question card temporarily replaces the ordinary input. The current planning turn continues only after you answer or skip it.","locale":"en"},"2330":{"id":"/en/docs/agent-modes-plans-19","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#the-two-kinds-of-plan-are-different","content":"Name","locale":"en"},"2331":{"id":"/en/docs/agent-modes-plans-20","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#the-two-kinds-of-plan-are-different","content":"Purpose","locale":"en"},"2332":{"id":"/en/docs/agent-modes-plans-21","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#the-two-kinds-of-plan-are-different","content":"Lifecycle","locale":"en"},"2333":{"id":"/en/docs/agent-modes-plans-22","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#the-two-kinds-of-plan-are-different","content":"Proposed plan","locale":"en"},"2334":{"id":"/en/docs/agent-modes-plans-23","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#the-two-kinds-of-plan-are-different","content":"A complete, reviewable implementation plan delivered at the end of Plan mode","locale":"en"},"2335":{"id":"/en/docs/agent-modes-plans-24","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#the-two-kinds-of-plan-are-different","content":"The user decides whether to implement or revise it","locale":"en"},"2336":{"id":"/en/docs/agent-modes-plans-25","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#the-two-kinds-of-plan-are-different","content":"Task plan","locale":"en"},"2337":{"id":"/en/docs/agent-modes-plans-26","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#the-two-kinds-of-plan-are-different","content":"Steps and status shown while executing in Default mode","locale":"en"},"2338":{"id":"/en/docs/agent-modes-plans-27","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#the-two-kinds-of-plan-are-different","content":"Reports progress; it does not grant authorization","locale":"en"},"2339":{"id":"/en/docs/agent-modes-plans-28","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#the-two-kinds-of-plan-are-different","content":"A proposed plan should leave no key implementation decisions unresolved for the executor. A task plan only describes the progress of current work. Even if a step is marked **In progress**, that does not mean its command succeeded or a risky operation was approved.","locale":"en"},"2340":{"id":"/en/docs/agent-modes-plans-29","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#when-to-switch-modes","content":"Use Plan mode first when code boundaries, data structures, or interactions are unclear.","locale":"en"},"2341":{"id":"/en/docs/agent-modes-plans-30","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#when-to-switch-modes","content":"Plan mode is also suitable when you only want the cause of an error investigated without modifying code; explicitly state \"analysis only\" in the task.","locale":"en"},"2342":{"id":"/en/docs/agent-modes-plans-31","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#when-to-switch-modes","content":"Switch to Default mode or use **Implement plan** when the solution is clear and you want it carried out.","locale":"en"},"2343":{"id":"/en/docs/agent-modes-plans-32","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#when-to-switch-modes","content":"If the current response, compaction, or blocking decision has not finished, resolve that state before switching.","locale":"en"},"2344":{"id":"/en/docs/agent-modes-plans-33","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#when-to-switch-modes","content":"Accepting a solution only chooses the direction of subsequent work. Commands, writes, deletions,\nor external actions that require approval during execution are still handled according to the\ncurrent permission mode.","locale":"en"},"2345":{"id":"/en/docs/agent-permissions","page_id":"/en/docs/agent-permissions","type":"page","content":"Permissions and Approvals","breadcrumbs":["Hanafubuki Documentation","Agent"],"tags":[],"url":"/en/docs/agent-permissions","locale":"en"},"2346":{"id":"/en/docs/agent-permissions-0","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions","content":"Choose an Agent permission mode and safely handle each tool approval.","locale":"en"},"2347":{"id":"/en/docs/agent-permissions-1","page_id":"/en/docs/agent-permissions","type":"heading","tags":[],"url":"/en/docs/agent-permissions#permission-modes","content":"Permission modes","locale":"en"},"2348":{"id":"/en/docs/agent-permissions-2","page_id":"/en/docs/agent-permissions","type":"heading","tags":[],"url":"/en/docs/agent-permissions#handling-manual-approval","content":"Handling manual approval","locale":"en"},"2349":{"id":"/en/docs/agent-permissions-3","page_id":"/en/docs/agent-permissions","type":"heading","tags":[],"url":"/en/docs/agent-permissions#reading-an-automatic-review","content":"Reading an automatic review","locale":"en"},"2350":{"id":"/en/docs/agent-permissions-4","page_id":"/en/docs/agent-permissions","type":"heading","tags":[],"url":"/en/docs/agent-permissions#high-risk-operations","content":"High-risk operations","locale":"en"},"2351":{"id":"/en/docs/agent-permissions-5","page_id":"/en/docs/agent-permissions","type":"heading","tags":[],"url":"/en/docs/agent-permissions#permission-modes-and-other-controls","content":"Permission modes and other controls","locale":"en"},"2352":{"id":"/en/docs/agent-permissions-6","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions","content":"The permission system decides whether to allow a tool call based on the operation type, risk, source, and exact target. The permission mode is a global interface selection, but each approval applies only to the single operation shown on that approval card.","locale":"en"},"2353":{"id":"/en/docs/agent-permissions-7","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"Mode","locale":"en"},"2354":{"id":"/en/docs/agent-permissions-8","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"Behavior","locale":"en"},"2355":{"id":"/en/docs/agent-permissions-9","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"Recommended use","locale":"en"},"2356":{"id":"/en/docs/agent-permissions-10","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"Manual","locale":"en"},"2357":{"id":"/en/docs/agent-permissions-11","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"Operations requiring approval wait for **Allow once** or **Deny**","locale":"en"},"2358":{"id":"/en/docs/agent-permissions-12","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"Unfamiliar projects, high-risk tasks, and first use","locale":"en"},"2359":{"id":"/en/docs/agent-permissions-13","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"Auto review","locale":"en"},"2360":{"id":"/en/docs/agent-permissions-14","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"The application automatically evaluates calls that require review and shows its decision and reasons","locale":"en"},"2361":{"id":"/en/docs/agent-permissions-15","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"Everyday development, documentation, and reversible edits","locale":"en"},"2362":{"id":"/en/docs/agent-permissions-16","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"Full access","locale":"en"},"2363":{"id":"/en/docs/agent-permissions-17","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"Automatically allows operations that would otherwise require review, with no per-operation prompt","locale":"en"},"2364":{"id":"/en/docs/agent-permissions-18","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"Only trusted environments, clearly scoped work, and recoverable tasks","locale":"en"},"2365":{"id":"/en/docs/agent-permissions-19","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"The backend prohibits some operations outright, and changing the permission mode cannot override those rules. Path policy, instance lifecycle, process ownership, and operating-system account permissions also remain in force at all times.","locale":"en"},"2366":{"id":"/en/docs/agent-permissions-20","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"In Full access mode, tools run with the real system permissions of the application process. It is\nnot a temporary directory or simulated environment, and a mistaken command can directly modify\nprojects, instances, or external services.","locale":"en"},"2367":{"id":"/en/docs/agent-permissions-21","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#handling-manual-approval","content":"When approval is required, an approval card replaces the ordinary input. Before approving, check each item:","locale":"en"},"2368":{"id":"/en/docs/agent-permissions-22","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#handling-manual-approval","content":"Operation type: command, file write, deletion, MCP administration, or external tool call.","locale":"en"},"2369":{"id":"/en/docs/agent-permissions-23","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#handling-manual-approval","content":"Risk level: low, medium, high, or critical.","locale":"en"},"2370":{"id":"/en/docs/agent-permissions-24","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#handling-manual-approval","content":"Operation summary and source: user request, model decision, or a particular Skill.","locale":"en"},"2371":{"id":"/en/docs/agent-permissions-25","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#handling-manual-approval","content":"Exact target: program, arguments, working directory, file path, or service identifier.","locale":"en"},"2372":{"id":"/en/docs/agent-permissions-26","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#handling-manual-approval","content":"Whether the operation is genuinely necessary to complete the current task.","locale":"en"},"2373":{"id":"/en/docs/agent-permissions-27","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#handling-manual-approval","content":"**Allow once** authorizes only the current request; it does not permanently allowlist similar operations. After **Deny**, the Agent receives the denial result and can adjust its approach or explain why the operation is needed.","locale":"en"},"2374":{"id":"/en/docs/agent-permissions-28","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#reading-an-automatic-review","content":"Automatic review displays the review state, risk assessment, evidence of user authorization, and reasoning in the tool record. It still applies only to the current call and does not authorize the entire task.","locale":"en"},"2375":{"id":"/en/docs/agent-permissions-29","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#reading-an-automatic-review","content":"If automatic review fails, times out, or returns a denial, the operation is not executed. Read the reason in the tool card instead of repeatedly submitting the same call.","locale":"en"},"2376":{"id":"/en/docs/agent-permissions-30","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#high-risk-operations","content":"Even when their targets look reasonable, manually confirm the scope and recovery method for:","locale":"en"},"2377":{"id":"/en/docs/agent-permissions-31","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#high-risk-operations","content":"Deleting, overwriting, or moving project and instance data.","locale":"en"},"2378":{"id":"/en/docs/agent-permissions-32","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#high-risk-operations","content":"Resetting Git, publishing a release, pushing code, or triggering a remote workflow.","locale":"en"},"2379":{"id":"/en/docs/agent-permissions-33","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#high-risk-operations","content":"Installing a Skill from an unknown source, running its scripts, or changing MCP configuration.","locale":"en"},"2380":{"id":"/en/docs/agent-permissions-34","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#high-risk-operations","content":"Using MCP to operate accounts, databases, messages, payments, or other external systems.","locale":"en"},"2381":{"id":"/en/docs/agent-permissions-35","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#high-risk-operations","content":"Reading or sending credentials, private data, or unreleased content.","locale":"en"},"2382":{"id":"/en/docs/agent-permissions-36","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#high-risk-operations","content":"For deletions, confirm a backup or snapshot first. For external systems, verify the account, environment, and target object. For commands, verify the working directory and complete arguments.","locale":"en"},"2383":{"id":"/en/docs/agent-permissions-37","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes-and-other-controls","content":"Plan mode still hides mutation tools; Full access does not bypass it.","locale":"en"},"2384":{"id":"/en/docs/agent-permissions-38","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes-and-other-controls","content":"MCP tools have their own **Allow**, **Ask**, and **Deny** policies, and both layers apply.","locale":"en"},"2385":{"id":"/en/docs/agent-permissions-39","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes-and-other-controls","content":"A Skill can recommend or call tools, but it does not inherit capabilities beyond the current permissions.","locale":"en"},"2386":{"id":"/en/docs/agent-permissions-40","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes-and-other-controls","content":"Memory provides context only; it grants no permission to files, commands, or external services.","locale":"en"},"2387":{"id":"/en/docs/agent-providers-models","page_id":"/en/docs/agent-providers-models","type":"page","content":"Providers and Models","breadcrumbs":["Hanafubuki Documentation","Agent"],"tags":[],"url":"/en/docs/agent-providers-models","locale":"en"},"2388":{"id":"/en/docs/agent-providers-models-0","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models","content":"Configure Agent server connections, model capabilities, and context policies.","locale":"en"},"2389":{"id":"/en/docs/agent-providers-models-1","page_id":"/en/docs/agent-providers-models","type":"heading","tags":[],"url":"/en/docs/agent-providers-models#adding-a-provider","content":"Adding a provider","locale":"en"},"2390":{"id":"/en/docs/agent-providers-models-2","page_id":"/en/docs/agent-providers-models","type":"heading","tags":[],"url":"/en/docs/agent-providers-models#choosing-the-default-model","content":"Choosing the default model","locale":"en"},"2391":{"id":"/en/docs/agent-providers-models-3","page_id":"/en/docs/agent-providers-models","type":"heading","tags":[],"url":"/en/docs/agent-providers-models#model-capabilities","content":"Model capabilities","locale":"en"},"2392":{"id":"/en/docs/agent-providers-models-4","page_id":"/en/docs/agent-providers-models","type":"heading","tags":[],"url":"/en/docs/agent-providers-models#the-current-sessions-model","content":"The current session's model","locale":"en"},"2393":{"id":"/en/docs/agent-providers-models-5","page_id":"/en/docs/agent-providers-models","type":"heading","tags":[],"url":"/en/docs/agent-providers-models#verification-and-troubleshooting","content":"Verification and troubleshooting","locale":"en"},"2394":{"id":"/en/docs/agent-providers-models-6","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models","content":"The Agent configures \"how to connect to the server\" separately from \"how to use the model.\" A provider stores the protocol, API address, and credentials; the model policy stores the default model, reasoning effort, image input, and context rules.","locale":"en"},"2395":{"id":"/en/docs/agent-providers-models-7","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Go to **Settings → Agent** and add a provider in the model providers section.","locale":"en"},"2396":{"id":"/en/docs/agent-providers-models-8","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Setting","locale":"en"},"2397":{"id":"/en/docs/agent-providers-models-9","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Description","locale":"en"},"2398":{"id":"/en/docs/agent-providers-models-10","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Name","locale":"en"},"2399":{"id":"/en/docs/agent-providers-models-11","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Used only to distinguish the provider in the interface","locale":"en"},"2400":{"id":"/en/docs/agent-providers-models-12","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Protocol","locale":"en"},"2401":{"id":"/en/docs/agent-providers-models-13","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"OpenAI Responses, OpenAI Chat Completions, or Anthropic Messages","locale":"en"},"2402":{"id":"/en/docs/agent-providers-models-14","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"API address","locale":"en"},"2403":{"id":"/en/docs/agent-providers-models-15","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Root address of the server API; must use `http` or `https`","locale":"en"},"2404":{"id":"/en/docs/agent-providers-models-16","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"API token","locale":"en"},"2405":{"id":"/en/docs/agent-providers-models-17","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Authentication token required by the server; leave blank when not needed","locale":"en"},"2406":{"id":"/en/docs/agent-providers-models-18","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Custom headers","locale":"en"},"2407":{"id":"/en/docs/agent-providers-models-19","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Additional headers required by a gateway or compatible service","locale":"en"},"2408":{"id":"/en/docs/agent-providers-models-20","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Enabled","locale":"en"},"2409":{"id":"/en/docs/agent-providers-models-21","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Determines whether the provider can be selected and used for model requests","locale":"en"},"2410":{"id":"/en/docs/agent-providers-models-22","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"The protocol must match the server's actual implementation. Changing the API address does not turn a Chat Completions service into a Responses service, and a compatible service may implement only part of a protocol.","locale":"en"},"2411":{"id":"/en/docs/agent-providers-models-23","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Provider tokens and custom request-header values are not password placeholders. The application\nstores and displays the entered values. Do not publicly share settings files, screenshots\ncontaining credentials, or interface recordings.","locale":"en"},"2412":{"id":"/en/docs/agent-providers-models-24","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#choosing-the-default-model","content":"After saving and enabling a provider, select the default provider and model in the model policy. The model list is a convenience catalog returned by the server; you can also enter a custom model ID accepted by that server.","locale":"en"},"2413":{"id":"/en/docs/agent-providers-models-25","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#choosing-the-default-model","content":"Configure reasoning effort, image input, and the context window according to the model's\ncapabilities.","locale":"en"},"2414":{"id":"/en/docs/agent-providers-models-26","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#choosing-the-default-model","content":"After saving, create a short session and send a simple question to verify the connection.","locale":"en"},"2415":{"id":"/en/docs/agent-providers-models-27","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#choosing-the-default-model","content":"You can create an idle session without a default model, but cannot send a model request. Click the model name beside the input or run `/model` to select a model for the current idle session. Existing sessions are not silently switched when global defaults change.","locale":"en"},"2416":{"id":"/en/docs/agent-providers-models-28","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"Setting","locale":"en"},"2417":{"id":"/en/docs/agent-providers-models-29","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"Recommendation","locale":"en"},"2418":{"id":"/en/docs/agent-providers-models-30","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"Reasoning effort","locale":"en"},"2419":{"id":"/en/docs/agent-providers-models-31","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"A Responses provider can use presets, the provider default, or a custom value; other protocols do not offer this setting","locale":"en"},"2420":{"id":"/en/docs/agent-providers-models-32","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"Image input","locale":"en"},"2421":{"id":"/en/docs/agent-providers-models-33","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"**Auto** sends images when the model supports them; **Disabled** blocks image input","locale":"en"},"2422":{"id":"/en/docs/agent-providers-models-34","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"Context window","locale":"en"},"2423":{"id":"/en/docs/agent-providers-models-35","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"Enter the number of tokens actually available to the model; when blank, the provider and runtime information are used","locale":"en"},"2424":{"id":"/en/docs/agent-providers-models-36","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"Auto compaction","locale":"en"},"2425":{"id":"/en/docs/agent-providers-models-37","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"Organizes model context near the threshold, which defaults to 80% of the window","locale":"en"},"2426":{"id":"/en/docs/agent-providers-models-38","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"Remote compaction","locale":"en"},"2427":{"id":"/en/docs/agent-providers-models-39","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"Available only for Responses providers that declare the corresponding capability","locale":"en"},"2428":{"id":"/en/docs/agent-providers-models-40","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"If the configured context window is too high, the server may reject a request first. If it is too low, compaction begins earlier. Compaction changes only the context sent to the model on the next turn; it does not delete messages or tool records saved in the interface.","locale":"en"},"2429":{"id":"/en/docs/agent-providers-models-41","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#the-current-sessions-model","content":"A session records its own provider, protocol, model, and reasoning effort. To change them temporarily:","locale":"en"},"2430":{"id":"/en/docs/agent-providers-models-42","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#the-current-sessions-model","content":"Wait for the current response and compaction to finish.","locale":"en"},"2431":{"id":"/en/docs/agent-providers-models-43","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#the-current-sessions-model","content":"Click the model button beside the input, or run `/model`.","locale":"en"},"2432":{"id":"/en/docs/agent-providers-models-44","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#the-current-sessions-model","content":"Select an enabled provider and model.","locale":"en"},"2433":{"id":"/en/docs/agent-providers-models-45","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#the-current-sessions-model","content":"Run `/effort` afterward if you also need to adjust reasoning effort.","locale":"en"},"2434":{"id":"/en/docs/agent-providers-models-46","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#the-current-sessions-model","content":"After changing models, reasoning effort returns to the target provider's default. You cannot perform the corresponding change while a response is running, a task awaits cleanup, or the protocol does not support reasoning effort.","locale":"en"},"2435":{"id":"/en/docs/agent-providers-models-47","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#verification-and-troubleshooting","content":"If a test message fails, check in this order:","locale":"en"},"2436":{"id":"/en/docs/agent-providers-models-48","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#verification-and-troubleshooting","content":"Whether the provider is enabled and its protocol matches the server.","locale":"en"},"2437":{"id":"/en/docs/agent-providers-models-49","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#verification-and-troubleshooting","content":"Whether the API address includes the correct version path and contains no embedded credential.","locale":"en"},"2438":{"id":"/en/docs/agent-providers-models-50","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#verification-and-troubleshooting","content":"Whether the model ID exists and is available to the current account.","locale":"en"},"2439":{"id":"/en/docs/agent-providers-models-51","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#verification-and-troubleshooting","content":"Whether the token and custom request headers are correct.","locale":"en"},"2440":{"id":"/en/docs/agent-providers-models-52","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#verification-and-troubleshooting","content":"Whether the application proxy and server network are reachable.","locale":"en"},"2441":{"id":"/en/docs/agent-providers-models-53","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#verification-and-troubleshooting","content":"Whether the context window, image input, or remote compaction exceeds the compatible service's capabilities.","locale":"en"},"2442":{"id":"/en/docs/agent-providers-models-54","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#verification-and-troubleshooting","content":"After a provider is disabled or deleted, historical sessions remain readable. To continue interacting with a model, explicitly choose another available model for the session. Deleting a provider also deletes its stored credentials.","locale":"en"},"2443":{"id":"/en/docs/agent-skills","page_id":"/en/docs/agent-skills","type":"page","content":"Skills","breadcrumbs":["Hanafubuki Documentation","Agent"],"tags":[],"url":"/en/docs/agent-skills","locale":"en"},"2444":{"id":"/en/docs/agent-skills-0","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills","content":"Install, enable, and select reusable Agent workflows.","locale":"en"},"2445":{"id":"/en/docs/agent-skills-1","page_id":"/en/docs/agent-skills","type":"heading","tags":[],"url":"/en/docs/agent-skills#where-skills-come-from","content":"Where Skills come from","locale":"en"},"2446":{"id":"/en/docs/agent-skills-2","page_id":"/en/docs/agent-skills","type":"heading","tags":[],"url":"/en/docs/agent-skills#installing-and-reviewing","content":"Installing and reviewing","locale":"en"},"2447":{"id":"/en/docs/agent-skills-3","page_id":"/en/docs/agent-skills","type":"heading","tags":[],"url":"/en/docs/agent-skills#enablement-and-the-current-turn","content":"Enablement and the current turn","locale":"en"},"2448":{"id":"/en/docs/agent-skills-4","page_id":"/en/docs/agent-skills","type":"heading","tags":[],"url":"/en/docs/agent-skills#selecting-a-skill-for-the-next-message","content":"Selecting a Skill for the next message","locale":"en"},"2449":{"id":"/en/docs/agent-skills-5","page_id":"/en/docs/agent-skills","type":"heading","tags":[],"url":"/en/docs/agent-skills#what-the-agent-can-do-with-skills","content":"What the Agent can do with Skills","locale":"en"},"2450":{"id":"/en/docs/agent-skills-6","page_id":"/en/docs/agent-skills","type":"heading","tags":[],"url":"/en/docs/agent-skills#removing","content":"Removing","locale":"en"},"2451":{"id":"/en/docs/agent-skills-7","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills","content":"A Skill is a directory containing a `SKILL.md` whose YAML frontmatter names it and describes when to use it. Everything else in the directory — references, scripts, assets, a licence — is supporting material. That is the whole format, and it is the same one Claude and Codex read, so a package that installs there installs here.","locale":"en"},"2452":{"id":"/en/docs/agent-skills-8","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills","content":"A Skill guides the Agent through a particular task. It cannot bypass the session mode, tool policies, or permission approvals.","locale":"en"},"2453":{"id":"/en/docs/agent-skills-9","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"Skills are discovered under three roots, searched nearest first:","locale":"en"},"2454":{"id":"/en/docs/agent-skills-10","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"Authority","locale":"en"},"2455":{"id":"/en/docs/agent-skills-11","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"Where","locale":"en"},"2456":{"id":"/en/docs/agent-skills-12","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"Editable","locale":"en"},"2457":{"id":"/en/docs/agent-skills-13","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"Repo","locale":"en"},"2458":{"id":"/en/docs/agent-skills-14","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"`.agents/skills` beside a workspace root","locale":"en"},"2459":{"id":"/en/docs/agent-skills-15","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"No","locale":"en"},"2460":{"id":"/en/docs/agent-skills-16","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"User","locale":"en"},"2461":{"id":"/en/docs/agent-skills-17","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"The managed Skills root","locale":"en"},"2462":{"id":"/en/docs/agent-skills-18","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"Yes","locale":"en"},"2463":{"id":"/en/docs/agent-skills-19","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"System","locale":"en"},"2464":{"id":"/en/docs/agent-skills-20","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"Bundled with the application","locale":"en"},"2465":{"id":"/en/docs/agent-skills-21","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"No","locale":"en"},"2466":{"id":"/en/docs/agent-skills-22","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"A directory that fails to load is reported beside the catalogue and skipped, so one malformed package never costs you the rest.","locale":"en"},"2467":{"id":"/en/docs/agent-skills-23","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#installing-and-reviewing","content":"Under **Settings → Agent → Skills**, you can install a Skill from a folder, write one, duplicate one, edit its files, and remove it. Only Skills in the managed user root can be changed; a repository or bundled Skill is read-only, so duplicate it first.","locale":"en"},"2468":{"id":"/en/docs/agent-skills-24","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#installing-and-reviewing","content":"Before installing, review:","locale":"en"},"2469":{"id":"/en/docs/agent-skills-25","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#installing-and-reviewing","content":"Whether the package name, purpose, version, and source are what you expect.","locale":"en"},"2470":{"id":"/en/docs/agent-skills-26","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#installing-and-reviewing","content":"The steps and trigger conditions declared in `SKILL.md`.","locale":"en"},"2471":{"id":"/en/docs/agent-skills-27","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#installing-and-reviewing","content":"Referenced documentation, resource files, and script contents.","locale":"en"},"2472":{"id":"/en/docs/agent-skills-28","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#installing-and-reviewing","content":"Required MCP services, transports, and external addresses.","locale":"en"},"2473":{"id":"/en/docs/agent-skills-29","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#installing-and-reviewing","content":"Whether the Agent may use the Skill implicitly when you did not name it.","locale":"en"},"2474":{"id":"/en/docs/agent-skills-30","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#installing-and-reviewing","content":"A Skill's instructions and scripts can direct the Agent to run commands, modify files, or invoke\nexternal tools. Install only trusted sources, and review changes and dependencies again after an\nupdate.","locale":"en"},"2475":{"id":"/en/docs/agent-skills-31","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#enablement-and-the-current-turn","content":"A discovered Skill is on until you turn it off. The enabled state decides whether a Skill is offered to each newly admitted user turn. A session does not retain its own catalogue: turn admission captures a fresh read-only one, and an already running turn keeps the catalogue and Skill contexts it was frozen with.","locale":"en"},"2476":{"id":"/en/docs/agent-skills-32","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#enablement-and-the-current-turn","content":"A Skill therefore has exactly two states worth reading, and the settings page reports both:","locale":"en"},"2477":{"id":"/en/docs/agent-skills-33","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#enablement-and-the-current-turn","content":"**Available now** — enabled, and offered to the next turn.","locale":"en"},"2478":{"id":"/en/docs/agent-skills-34","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#enablement-and-the-current-turn","content":"**Adopted this turn** — the running turn read it and is following it.","locale":"en"},"2479":{"id":"/en/docs/agent-skills-35","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#enablement-and-the-current-turn","content":"Turning a Skill on or off takes effect from the next turn. Nothing changes a model request that is already running.","locale":"en"},"2480":{"id":"/en/docs/agent-skills-36","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#selecting-a-skill-for-the-next-message","content":"Run `/skills`, or use the Skill selector in the input, to select an enabled Skill for the next message. The selection is submitted with that message only and does not enable the Skill permanently.","locale":"en"},"2481":{"id":"/en/docs/agent-skills-37","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#selecting-a-skill-for-the-next-message","content":"Naming a Skill explicitly in the prompt reduces ambiguity, for example:","locale":"en"},"2482":{"id":"/en/docs/agent-skills-38","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#selecting-a-skill-for-the-next-message","content":"If a Skill allows implicit invocation, its name and description appear in the model's catalogue and the Agent must use it when the task clearly matches. An explicit-only Skill stays out of that catalogue but can still be chosen by name.","locale":"en"},"2483":{"id":"/en/docs/agent-skills-39","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#what-the-agent-can-do-with-skills","content":"The Agent reads Skills through `skills_list` and `skills_read`, and can turn one on or off with `enable_skill` and `disable_skill` after you approve it. Writing, installing, and removing a Skill package uses the ordinary filesystem and command tools — a Skill directory is just a directory — which is why those actions go through the same approvals as any other file write.","locale":"en"},"2484":{"id":"/en/docs/agent-skills-40","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#what-the-agent-can-do-with-skills","content":"The bundled **Skill Creator** and **Skill Manager** Skills describe those workflows to the Agent.","locale":"en"},"2485":{"id":"/en/docs/agent-skills-41","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#removing","content":"Removing a Skill deletes only the installed package. History retains the Skill context that earlier turns actually adopted, and removal never rewrites a running turn. Wait for the current task to finish before reorganizing capabilities.","locale":"en"},"2486":{"id":"/en/docs/agent-tools-terminals","page_id":"/en/docs/agent-tools-terminals","type":"page","content":"Tools and Background Terminals","breadcrumbs":["Hanafubuki Documentation","Agent"],"tags":[],"url":"/en/docs/agent-tools-terminals","locale":"en"},"2487":{"id":"/en/docs/agent-tools-terminals-0","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals","content":"Read tool calls, inspect output, and manage background commands started by the Agent.","locale":"en"},"2488":{"id":"/en/docs/agent-tools-terminals-1","page_id":"/en/docs/agent-tools-terminals","type":"heading","tags":[],"url":"/en/docs/agent-tools-terminals#reading-tool-cards","content":"Reading tool cards","locale":"en"},"2489":{"id":"/en/docs/agent-tools-terminals-2","page_id":"/en/docs/agent-tools-terminals","type":"heading","tags":[],"url":"/en/docs/agent-tools-terminals#stopping-the-current-response","content":"Stopping the current response","locale":"en"},"2490":{"id":"/en/docs/agent-tools-terminals-3","page_id":"/en/docs/agent-tools-terminals","type":"heading","tags":[],"url":"/en/docs/agent-tools-terminals#background-terminals","content":"Background terminals","locale":"en"},"2491":{"id":"/en/docs/agent-tools-terminals-4","page_id":"/en/docs/agent-tools-terminals","type":"heading","tags":[],"url":"/en/docs/agent-tools-terminals#safely-cleaning-up-background-commands","content":"Safely cleaning up background commands","locale":"en"},"2492":{"id":"/en/docs/agent-tools-terminals-5","page_id":"/en/docs/agent-tools-terminals","type":"heading","tags":[],"url":"/en/docs/agent-tools-terminals#determining-whether-a-task-is-complete","content":"Determining whether a task is complete","locale":"en"},"2493":{"id":"/en/docs/agent-tools-terminals-6","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals","content":"The Agent uses tools to read files, modify code, run commands, and invoke application functions. Every call creates a tool card in the message history. Together, the tool state and final response describe the task result.","locale":"en"},"2494":{"id":"/en/docs/agent-tools-terminals-7","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#reading-tool-cards","content":"While a tool is running, its card shows the current state and live output. Completed cards are usually collapsed to keep the session readable. Expand one to inspect:","locale":"en"},"2495":{"id":"/en/docs/agent-tools-terminals-8","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#reading-tool-cards","content":"The tool name and arguments submitted by the model.","locale":"en"},"2496":{"id":"/en/docs/agent-tools-terminals-9","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#reading-tool-cards","content":"The command, working directory, and exit status.","locale":"en"},"2497":{"id":"/en/docs/agent-tools-terminals-10","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#reading-tool-cards","content":"File patches and summaries of added, modified, or deleted files.","locale":"en"},"2498":{"id":"/en/docs/agent-tools-terminals-11","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#reading-tool-cards","content":"The automatic permission review's decision and reasoning.","locale":"en"},"2499":{"id":"/en/docs/agent-tools-terminals-12","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#reading-tool-cards","content":"Standard output, standard error, and notices of truncation or omission.","locale":"en"},"2500":{"id":"/en/docs/agent-tools-terminals-13","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#reading-tool-cards","content":"A tool can be running, awaiting approval, awaiting the user, awaiting cleanup, successful, failed, canceled, or interrupted. You can determine that a call has ended only after it reaches an explicit terminal state.","locale":"en"},"2501":{"id":"/en/docs/agent-tools-terminals-14","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#reading-tool-cards","content":"Both live output and persisted history have size limits. When you see a truncation marker, ask the\nAgent to use a more precise filter or read a specific section instead of assuming that omitted\ncontent does not exist.","locale":"en"},"2502":{"id":"/en/docs/agent-tools-terminals-15","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#stopping-the-current-response","content":"When the input is empty and the current response can be canceled, the primary button becomes a stop button. It cancels the current Agent response or standalone compaction.","locale":"en"},"2503":{"id":"/en/docs/agent-tools-terminals-16","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#stopping-the-current-response","content":"After you request a stop, the application must still confirm that tools and processes reached terminal states. If the interface shows that it is awaiting cleanup, do not immediately create a replacement task. Wait, or retry cleanup as directed by the error.","locale":"en"},"2504":{"id":"/en/docs/agent-tools-terminals-17","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#background-terminals","content":"A long-running command can be moved to the background and assigned a terminal session identifier. It belongs to the Agent session that created it and does not end automatically when you collapse its tool card, switch sessions, or close the Agent window.","locale":"en"},"2505":{"id":"/en/docs/agent-tools-terminals-18","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#background-terminals","content":"Command","locale":"en"},"2506":{"id":"/en/docs/agent-tools-terminals-19","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#background-terminals","content":"Purpose","locale":"en"},"2507":{"id":"/en/docs/agent-tools-terminals-20","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#background-terminals","content":"`/ps`","locale":"en"},"2508":{"id":"/en/docs/agent-tools-terminals-21","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#background-terminals","content":"List retained background terminals and their states for the current Agent session","locale":"en"},"2509":{"id":"/en/docs/agent-tools-terminals-22","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#background-terminals","content":"`/stop`","locale":"en"},"2510":{"id":"/en/docs/agent-tools-terminals-23","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#background-terminals","content":"Request that all background terminals in the current session be stopped and cleaned up","locale":"en"},"2511":{"id":"/en/docs/agent-tools-terminals-24","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#background-terminals","content":"`/stop` is not the same operation as stopping the current response. The former handles background terminals; the latter cancels the current model turn or compaction.","locale":"en"},"2512":{"id":"/en/docs/agent-tools-terminals-25","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#safely-cleaning-up-background-commands","content":"If a service must remain running, first ask the Agent to read incremental output and verify that\nit is healthy.","locale":"en"},"2513":{"id":"/en/docs/agent-tools-terminals-26","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#safely-cleaning-up-background-commands","content":"If cleanup fails, run `/stop` again as directed by the card; do not merely delete the session.","locale":"en"},"2514":{"id":"/en/docs/agent-tools-terminals-27","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#safely-cleaning-up-background-commands","content":"Background development servers, file watchers, and interactive commands may continue occupying ports or files. Before finishing the task, explicitly state which processes remain and which have been stopped.","locale":"en"},"2515":{"id":"/en/docs/agent-tools-terminals-28","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#determining-whether-a-task-is-complete","content":"A successful tool call proves only that the individual operation succeeded, not that the whole objective is complete.","locale":"en"},"2516":{"id":"/en/docs/agent-tools-terminals-29","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#determining-whether-a-task-is-complete","content":"For a test command, inspect the exit status and failed cases instead of relying on partial output.","locale":"en"},"2517":{"id":"/en/docs/agent-tools-terminals-30","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#determining-whether-a-task-is-complete","content":"The Agent's final response should state what changed, what was verified, and what remains incomplete.","locale":"en"},"2518":{"id":"/en/docs/agent-tools-terminals-31","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#determining-whether-a-task-is-complete","content":"If the final response claims completion while a tool is still running or awaiting cleanup, trust the backend state.","locale":"en"},"2519":{"id":"/en/docs/agent","page_id":"/en/docs/agent","type":"page","content":"Agent Quick Start","breadcrumbs":["Hanafubuki Documentation","Agent"],"tags":[],"url":"/en/docs/agent","locale":"en"},"2520":{"id":"/en/docs/agent-0","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent","content":"Configure a model and complete your first Agent session.","locale":"en"},"2521":{"id":"/en/docs/agent-1","page_id":"/en/docs/agent","type":"heading","tags":[],"url":"/en/docs/agent#first-use","content":"First use","locale":"en"},"2522":{"id":"/en/docs/agent-2","page_id":"/en/docs/agent","type":"heading","tags":[],"url":"/en/docs/agent#configure-a-provider","content":"Configure a provider","locale":"en"},"2523":{"id":"/en/docs/agent-3","page_id":"/en/docs/agent","type":"heading","tags":[],"url":"/en/docs/agent#open-agent","content":"Open Agent","locale":"en"},"2524":{"id":"/en/docs/agent-4","page_id":"/en/docs/agent","type":"heading","tags":[],"url":"/en/docs/agent#create-a-session","content":"Create a session","locale":"en"},"2525":{"id":"/en/docs/agent-5","page_id":"/en/docs/agent","type":"heading","tags":[],"url":"/en/docs/agent#choose-a-mode-and-permissions","content":"Choose a mode and permissions","locale":"en"},"2526":{"id":"/en/docs/agent-6","page_id":"/en/docs/agent","type":"heading","tags":[],"url":"/en/docs/agent#send-a-task","content":"Send a task","locale":"en"},"2527":{"id":"/en/docs/agent-7","page_id":"/en/docs/agent","type":"heading","tags":[],"url":"/en/docs/agent#a-recommended-task-format","content":"A recommended task format","locale":"en"},"2528":{"id":"/en/docs/agent-8","page_id":"/en/docs/agent","type":"heading","tags":[],"url":"/en/docs/agent#what-to-watch-during-execution","content":"What to watch during execution","locale":"en"},"2529":{"id":"/en/docs/agent-9","page_id":"/en/docs/agent","type":"heading","tags":[],"url":"/en/docs/agent#continue-reading","content":"Continue reading","locale":"en"},"2530":{"id":"/en/docs/agent-10","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent","content":"The Agent can read project context, invoke application tools, run commands, and help modify files. What it can do depends on the current model, permission mode, MCP, Skills, and session state. Before starting, configure at least one enabled model provider.","locale":"en"},"2531":{"id":"/en/docs/agent-11","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#configure-a-provider","content":"Open **Settings → Agent** and add a provider in the model providers section. Choose the protocol actually supported by the server, enter the API address and credentials, and save.","locale":"en"},"2532":{"id":"/en/docs/agent-12","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#configure-a-provider","content":"A provider describes only the server connection. The model is selected separately in the model policy. After saving the provider, select the default provider and model.","locale":"en"},"2533":{"id":"/en/docs/agent-13","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#open-agent","content":"Click the Agent button in the title bar. Agent opens as a floating panel by default; you can also detach it into a separate window with the window controls.","locale":"en"},"2534":{"id":"/en/docs/agent-14","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#open-agent","content":"The session list is on the left. The right side displays the current session, message history, tool calls, and input in order.","locale":"en"},"2535":{"id":"/en/docs/agent-15","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#create-a-session","content":"Click **New** above the session list, or run `/new` in the input. If you have not configured a default model, you can still create a session, but must click the model button beside the input or run `/model` before sending a message.","locale":"en"},"2536":{"id":"/en/docs/agent-16","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#create-a-session","content":"The application determines the available project context from the current page and existing instances. You do not need to choose an arbitrary working directory when creating the session.","locale":"en"},"2537":{"id":"/en/docs/agent-17","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#choose-a-mode-and-permissions","content":"**Default** mode is for direct analysis and execution. **Plan** mode is limited to investigation, questions, and solution design. The permission mode determines whether tool operations run directly, receive automatic review, or await manual approval.","locale":"en"},"2538":{"id":"/en/docs/agent-18","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#choose-a-mode-and-permissions","content":"**Manual** or **Auto review** is recommended for first use.","locale":"en"},"2539":{"id":"/en/docs/agent-19","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#send-a-task","content":"State the objective, allowed scope of changes, and acceptance criteria, then press `Enter` to send. Use `Shift + Enter` for a line break. You can also attach images, reference files, or select a Skill for the current turn.","locale":"en"},"2540":{"id":"/en/docs/agent-20","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#a-recommended-task-format","content":"An easily verifiable task usually includes the objective, scope constraints, behavior that must remain unchanged, and validation commands. For releases, deletion, external messages, or account operations, also state the exact target.","locale":"en"},"2541":{"id":"/en/docs/agent-21","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#what-to-watch-during-execution","content":"Agent commentary reports its current assessment and next action.","locale":"en"},"2542":{"id":"/en/docs/agent-22","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#what-to-watch-during-execution","content":"Tool cards show commands, file operations, approval results, and output. Expand a card to inspect details.","locale":"en"},"2543":{"id":"/en/docs/agent-23","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#what-to-watch-during-execution","content":"When the input is empty, the primary button can stop the current response. When you have entered new content, it is queued first and does not automatically interrupt the response in progress.","locale":"en"},"2544":{"id":"/en/docs/agent-24","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#what-to-watch-during-execution","content":"Long-running commands may become background terminals. Closing the Agent panel does not mean the process stopped; use `/ps` to inspect and `/stop` to clean up.","locale":"en"},"2545":{"id":"/en/docs/agent-25","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#what-to-watch-during-execution","content":"The final response and terminal tool states together indicate whether the task is complete. Do not treat \"the tool has started\" as success.","locale":"en"},"2546":{"id":"/en/docs/agent-26","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#what-to-watch-during-execution","content":"Higher permission only reduces approval steps; it does not make commands, file changes, or\nexternal actions inherently safe. Review the target, arguments, and risk notice before allowing an\noperation, then inspect the diff and test results afterward.","locale":"en"},"2547":{"id":"/en/docs/agent-27","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#continue-reading","content":"<Card title=\"Providers and Models\" href=\"/docs/agent-providers-models\" description=\"Configure connections, model capabilities, and context policies.\" />","locale":"en"},"2548":{"id":"/en/docs/agent-28","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#continue-reading","content":"<Card title=\"Session Management\" href=\"/docs/agent-conversations\" description=\"Manage history, archiving, deletion, and forks.\" />","locale":"en"},"2549":{"id":"/en/docs/agent-29","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#continue-reading","content":"<Card title=\"Messages and Attachments\" href=\"/docs/agent-messages-attachments\" description=\"Reference files, add images, and steer work in progress.\" />","locale":"en"},"2550":{"id":"/en/docs/agent-30","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#continue-reading","content":"<Card title=\"Modes and Plans\" href=\"/docs/agent-modes-plans\" description=\"Understand Default mode, Plan mode, and the two kinds of plans.\" />","locale":"en"},"2551":{"id":"/en/docs/agent-31","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#continue-reading","content":"<Card title=\"Permissions and Approvals\" href=\"/docs/agent-permissions\" description=\"Review approval details and choose an appropriate permission mode.\" />","locale":"en"},"2552":{"id":"/en/docs/agent-32","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#continue-reading","content":"<Card title=\"Commands and Context\" href=\"/docs/agent-commands-context\" description=\"Use slash commands, inspect usage, and compact sessions.\" />","locale":"en"},"2553":{"id":"/en/docs","page_id":"/en/docs","type":"page","content":"Hanafubuki","breadcrumbs":["Hanafubuki Documentation","Getting Started"],"tags":[],"url":"/en/docs","locale":"en"},"2554":{"id":"/en/docs-0","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs","content":"Install, run, and manage local generative AI WebUIs in one place.","locale":"en"},"2555":{"id":"/en/docs-1","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs","content":"Hanafubuki is a Tauri-based desktop manager for installing, importing, running, and maintaining local generative AI WebUIs. It brings Python, Git, launch arguments, models, extensions, snapshots, and diagnostics together in one place, and includes an Agent that can connect to local tools.","locale":"en"},"2556":{"id":"/en/docs-2","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs","content":"It currently supports Stable Diffusion WebUI, ComfyUI, InvokeAI, Fooocus, SD Trainer, and Qwen TTS WebUI. Management features vary by WebUI type, and the interface only shows the capabilities available for the current instance.","locale":"en"},"2557":{"id":"/en/docs-3","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs","content":"<Card title=\"First-time setup\" href=\"/docs/quick-start\" description=\"Install the app and launch your first WebUI.\" />","locale":"en"},"2558":{"id":"/en/docs-4","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs","content":"<Card title=\"Install the app\" href=\"/docs/installation\" description=\"Choose an installer or portable package and complete the first launch.\" />","locale":"en"},"2559":{"id":"/en/docs-5","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs","content":"<Card title=\"Use the Agent\" href=\"/docs/agent\" description=\"Configure a model and start a session in the project environment.\" />","locale":"en"},"2560":{"id":"/en/docs-6","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs","content":"<Card title=\"Troubleshooting\" href=\"/docs/troubleshooting\" description=\"Diagnose problems using task output, logs, and diagnostic bundles.\" />","locale":"en"},"2561":{"id":"/en/docs-7","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs","content":"Hanafubuki is still under development and testing. Create snapshots or your own backups of\nimportant instances and configuration regularly.","locale":"en"},"2562":{"id":"/en/docs/installation","page_id":"/en/docs/installation","type":"page","content":"Install Hanafubuki","breadcrumbs":["Hanafubuki Documentation","Getting Started"],"tags":[],"url":"/en/docs/installation","locale":"en"},"2563":{"id":"/en/docs/installation-0","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation","content":"Choose an installer or portable package on the download page, then complete the first launch.","locale":"en"},"2564":{"id":"/en/docs/installation-1","page_id":"/en/docs/installation","type":"heading","tags":[],"url":"/en/docs/installation#choose-one-first","content":"Choose one first","locale":"en"},"2565":{"id":"/en/docs/installation-2","page_id":"/en/docs/installation","type":"heading","tags":[],"url":"/en/docs/installation#download-from-the-website","content":"Download from the website","locale":"en"},"2566":{"id":"/en/docs/installation-3","page_id":"/en/docs/installation","type":"heading","tags":[],"url":"/en/docs/installation#installer-formats","content":"Installer formats","locale":"en"},"2567":{"id":"/en/docs/installation-4","page_id":"/en/docs/installation","type":"heading","tags":[],"url":"/en/docs/installation#install-by-platform","content":"Install by platform","locale":"en"},"2568":{"id":"/en/docs/installation-5","page_id":"/en/docs/installation","type":"heading","tags":[],"url":"/en/docs/installation#portable-package","content":"Portable package","locale":"en"},"2569":{"id":"/en/docs/installation-6","page_id":"/en/docs/installation","type":"heading","tags":[],"url":"/en/docs/installation#first-launch","content":"First launch","locale":"en"},"2570":{"id":"/en/docs/installation-7","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation","content":"Hanafubuki is available in two forms: an **installer** installs the app into your system, while the **portable package** is a Launcher that runs after extraction. Both are available from the download page, which automatically detects your current system.","locale":"en"},"2571":{"id":"/en/docs/installation-8","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#choose-one-first","content":"Installer","locale":"en"},"2572":{"id":"/en/docs/installation-9","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#choose-one-first","content":"Portable package","locale":"en"},"2573":{"id":"/en/docs/installation-10","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#choose-one-first","content":"How to use","locale":"en"},"2574":{"id":"/en/docs/installation-11","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#choose-one-first","content":"Install it, then launch from the desktop or Start menu","locale":"en"},"2575":{"id":"/en/docs/installation-12","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#choose-one-first","content":"Extract it and run the Launcher directly","locale":"en"},"2576":{"id":"/en/docs/installation-13","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#choose-one-first","content":"Application files","locale":"en"},"2577":{"id":"/en/docs/installation-14","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#choose-one-first","content":"Included in the installer","locale":"en"},"2578":{"id":"/en/docs/installation-15","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#choose-one-first","content":"Downloaded and verified by the Launcher, and repaired if damaged","locale":"en"},"2579":{"id":"/en/docs/installation-16","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#choose-one-first","content":"Data location","locale":"en"},"2580":{"id":"/en/docs/installation-17","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#choose-one-first","content":"The system application-data directory","locale":"en"},"2581":{"id":"/en/docs/installation-18","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#choose-one-first","content":"The `.hanafubuki-launcher` directory beside the program","locale":"en"},"2582":{"id":"/en/docs/installation-19","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#choose-one-first","content":"Updates","locale":"en"},"2583":{"id":"/en/docs/installation-20","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#choose-one-first","content":"Recommended formats support checking and installing updates in the app","locale":"en"},"2584":{"id":"/en/docs/installation-21","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#choose-one-first","content":"See About & Updates","locale":"en"},"2585":{"id":"/en/docs/installation-22","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#choose-one-first","content":"Best for","locale":"en"},"2586":{"id":"/en/docs/installation-23","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#choose-one-first","content":"Long-term use on one computer","locale":"en"},"2587":{"id":"/en/docs/installation-24","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#choose-one-first","content":"Removable drives, or multiple independent environments","locale":"en"},"2588":{"id":"/en/docs/installation-25","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#choose-one-first","content":"Every link on the download page points to the project's release repositories on ModelScope and\nHugging Face. The page automatically selects the source that responds first. Do not download\ninstallers from third-party mirrors or reposts.","locale":"en"},"2589":{"id":"/en/docs/installation-26","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#download-from-the-website","content":"The page has separate Installer and Portable screens. The indicator on the right shows your\ncurrent position, and the version switcher at the top lets you move between them.","locale":"en"},"2590":{"id":"/en/docs/installation-27","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#download-from-the-website","content":"Select “Download Now.” The page detects your current system and starts downloading the\ncorresponding file.","locale":"en"},"2591":{"id":"/en/docs/installation-28","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#download-from-the-website","content":"For another platform or format, select “Choose Manually” to open the full list, which includes\nfile names and sizes.","locale":"en"},"2592":{"id":"/en/docs/installation-29","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#download-from-the-website","content":"Windows is available only for x86\\_64. macOS and Linux are available for both x86\\_64 and ARM64. Choose “macOS (Apple Silicon)” for a Mac with Apple silicon.","locale":"en"},"2593":{"id":"/en/docs/installation-30","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"Each release includes several formats. If you are unsure, choose the one marked Recommended.","locale":"en"},"2594":{"id":"/en/docs/installation-31","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"Platform","locale":"en"},"2595":{"id":"/en/docs/installation-32","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"Format","locale":"en"},"2596":{"id":"/en/docs/installation-33","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"Description","locale":"en"},"2597":{"id":"/en/docs/installation-34","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"Windows","locale":"en"},"2598":{"id":"/en/docs/installation-35","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"Installer (`.exe`)","locale":"en"},"2599":{"id":"/en/docs/installation-36","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"Recommended. Standard installation workflow with in-app updates","locale":"en"},"2600":{"id":"/en/docs/installation-37","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"Windows","locale":"en"},"2601":{"id":"/en/docs/installation-38","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"MSI package","locale":"en"},"2602":{"id":"/en/docs/installation-39","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"Suitable for managed deployment; does not participate in in-app updates","locale":"en"},"2603":{"id":"/en/docs/installation-40","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"Windows","locale":"en"},"2604":{"id":"/en/docs/installation-41","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"Standalone archive","locale":"en"},"2605":{"id":"/en/docs/installation-42","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"Extract and run; does not participate in in-app updates","locale":"en"},"2606":{"id":"/en/docs/installation-43","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"macOS","locale":"en"},"2607":{"id":"/en/docs/installation-44","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"Disk image (`.dmg`)","locale":"en"},"2608":{"id":"/en/docs/installation-45","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"Recommended. Open it and drag the app to Applications; supports in-app updates","locale":"en"},"2609":{"id":"/en/docs/installation-46","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"macOS","locale":"en"},"2610":{"id":"/en/docs/installation-47","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"App archive (`.app.tar.gz`)","locale":"en"},"2611":{"id":"/en/docs/installation-48","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"A compressed copy of the same `.app`","locale":"en"},"2612":{"id":"/en/docs/installation-49","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"Linux","locale":"en"},"2613":{"id":"/en/docs/installation-50","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"AppImage","locale":"en"},"2614":{"id":"/en/docs/installation-51","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"Recommended. Runs as a single file and supports in-app updates","locale":"en"},"2615":{"id":"/en/docs/installation-52","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"Linux","locale":"en"},"2616":{"id":"/en/docs/installation-53","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"Debian package (`.deb`)","locale":"en"},"2617":{"id":"/en/docs/installation-54","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"Installed through the system package manager; does not participate in in-app updates","locale":"en"},"2618":{"id":"/en/docs/installation-55","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"Linux","locale":"en"},"2619":{"id":"/en/docs/installation-56","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"RPM package (`.rpm`)","locale":"en"},"2620":{"id":"/en/docs/installation-57","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"Installed through the system package manager; does not participate in in-app updates","locale":"en"},"2621":{"id":"/en/docs/installation-58","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#installer-formats","content":"Formats that do not participate in in-app updates can still check for updates. The app will offer a manual installer for the current platform instead.","locale":"en"},"2622":{"id":"/en/docs/installation-59","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#install-by-platform","content":"Download the installer and follow its prompts, then launch Hanafubuki from the desktop or Start menu.","locale":"en"},"2623":{"id":"/en/docs/installation-60","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#install-by-platform","content":"If you choose the standalone archive, extract it to a writable directory before running the executable inside.","locale":"en"},"2624":{"id":"/en/docs/installation-61","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#install-by-platform","content":"The current Windows package is unsigned. If the installer or standalone build opens a **Windows protected your PC** prompt saying that Microsoft Defender SmartScreen prevented an unrecognized app from starting, first confirm that the file came from this site. Select **More info**, then select **Run anyway**.","locale":"en"},"2625":{"id":"/en/docs/installation-62","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#install-by-platform","content":"Open the disk image and drag Hanafubuki to Applications. Extracting the app archive produces the same `.app`; place it in Applications as well.","locale":"en"},"2626":{"id":"/en/docs/installation-63","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#install-by-platform","content":"The current macOS package is unsigned. If the first launch says `“Hanafubuki” is damaged and can't be opened. You should move it to the Trash.`, confirm that the package came from this site, then open Terminal and remove the quarantine attribute from the app:","locale":"en"},"2627":{"id":"/en/docs/installation-64","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#install-by-platform","content":"Terminal does not display characters while you enter your macOS password. When the command finishes, open Hanafubuki again. For other security prompts, use **System Settings → Privacy & Security** to confirm that you want to open the app.","locale":"en"},"2628":{"id":"/en/docs/installation-65","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#install-by-platform","content":"Make the AppImage executable, then run it directly:","locale":"en"},"2629":{"id":"/en/docs/installation-66","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#install-by-platform","content":"You can also install the `.deb` or `.rpm` with your system package manager, then launch Hanafubuki from the application menu:","locale":"en"},"2630":{"id":"/en/docs/installation-67","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#install-by-platform","content":"The Windows standalone archive only skips the installation step. Data is still written to the\nsystem application-data directory. If the data must travel with the program, use the portable\nLauncher described below.","locale":"en"},"2631":{"id":"/en/docs/installation-68","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#portable-package","content":"The portable package is a standalone Launcher. Settings, logs, application files, and instance data are all stored in the `.hanafubuki-launcher` directory beside it, without writing system installation information.","locale":"en"},"2632":{"id":"/en/docs/installation-69","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#portable-package","content":"Download the Launcher archive for your platform and extract it to a writable directory. Do not\nplace it on read-only media or in a system directory.","locale":"en"},"2633":{"id":"/en/docs/installation-70","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#portable-package","content":"Run the Launcher. On its first launch, it downloads and verifies Hanafubuki according to the\nmanifest, then opens the app automatically.","locale":"en"},"2634":{"id":"/en/docs/installation-71","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#portable-package","content":"To move the entire environment, copy the `.hanafubuki-launcher` directory along with the\nLauncher to the new location.","locale":"en"},"2635":{"id":"/en/docs/installation-72","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#portable-package","content":"The current Windows portable package is also unsigned. If Microsoft Defender SmartScreen shows\n**Windows protected your PC** when you first run the Launcher, confirm that the archive came from\nthis site, select **More info**, and then select **Run anyway**. The **Run anyway** button appears\nonly after you expand **More info**.","locale":"en"},"2636":{"id":"/en/docs/installation-73","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#portable-package","content":"The current macOS portable package is also unsigned. After confirming that the archive came from\nthis site, type `xattr -dr com.apple.quarantine` followed by a space in Terminal, drag the extracted\n`Hanafubuki Launcher.app` from Finder into the Terminal window, and press Return. The complete\ncommand will look like this:","locale":"en"},"2637":{"id":"/en/docs/installation-74","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#portable-package","content":"Open the Launcher again when the command finishes. The command must point to the actual `.app`;\ndo not copy the example path literally.","locale":"en"},"2638":{"id":"/en/docs/installation-75","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#portable-package","content":"The Launcher also handles the following cases:","locale":"en"},"2639":{"id":"/en/docs/installation-76","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#portable-package","content":"On its first run, it scans its own directory and adopts WebUI directories placed beside it as instances.","locale":"en"},"2640":{"id":"/en/docs/installation-77","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#portable-package","content":"If application files are missing or damaged, it downloads them again and repairs them according to the manifest.","locale":"en"},"2641":{"id":"/en/docs/installation-78","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#portable-package","content":"If every update source is unavailable, it skips the remote check and launches the version already downloaded.","locale":"en"},"2642":{"id":"/en/docs/installation-79","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#portable-package","content":"It reads the system proxy configuration for its own download requests.","locale":"en"},"2643":{"id":"/en/docs/installation-80","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#portable-package","content":"On Windows, the Launcher requires long-path support and the Visual C++ Runtime. If either is\nmissing, it requests administrator permission once to update the registry or install the runtime.\nIt continues to run as a standard user afterward. Rejecting either request leaves the Launcher on\na retry screen.","locale":"en"},"2644":{"id":"/en/docs/installation-81","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#first-launch","content":"The app prepares runtime components including Python, Micromamba, and Git. Keep the network connected and wait for preparation to finish.","locale":"en"},"2645":{"id":"/en/docs/installation-82","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#first-launch","content":"If preparation fails, go to “Settings → Runtime Environment” to retry or change download sources. You can also read Runtime Environment Troubleshooting.","locale":"en"},"2646":{"id":"/en/docs/installation-83","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#first-launch","content":"After preparation completes, continue to Quick Start to install or import your first WebUI.","locale":"en"},"2647":{"id":"/en/docs/installation-84","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#first-launch","content":"<Card title=\"Quick start\" href=\"/docs/quick-start\" description=\"Create and launch your first WebUI instance.\" />","locale":"en"},"2648":{"id":"/en/docs/installation-85","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#first-launch","content":"<Card title=\"About & Updates\" href=\"/docs/settings-about-updates\" description=\"View the version, check for updates, and install a new release.\" />","locale":"en"},"2649":{"id":"/en/docs/installation-86","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#first-launch","content":"<Card title=\"Runtime environment\" href=\"/docs/settings-runtime\" description=\"Configure Python, Git, and download sources.\" />","locale":"en"},"2650":{"id":"/en/docs/installation-87","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#first-launch","content":"<Card title=\"Runtime environment troubleshooting\" href=\"/docs/troubleshooting-app-runtime\" description=\"Resolve preparation failures or missing components.\" />","locale":"en"},"2651":{"id":"/en/docs/instance-diagnostics","page_id":"/en/docs/instance-diagnostics","type":"page","content":"Instance Diagnostics","breadcrumbs":["Hanafubuki Documentation","Instance Management"],"tags":[],"url":"/en/docs/instance-diagnostics","locale":"en"},"2652":{"id":"/en/docs/instance-diagnostics-0","page_id":"/en/docs/instance-diagnostics","tags":[],"type":"text","url":"/en/docs/instance-diagnostics","content":"Collect the current instance's environment, tasks, logs, and configuration, then safely export a diagnostic bundle.","locale":"en"},"2653":{"id":"/en/docs/instance-diagnostics-1","page_id":"/en/docs/instance-diagnostics","type":"heading","tags":[],"url":"/en/docs/instance-diagnostics#collect-a-diagnostic-bundle","content":"Collect a diagnostic bundle","locale":"en"},"2654":{"id":"/en/docs/instance-diagnostics-2","page_id":"/en/docs/instance-diagnostics","type":"heading","tags":[],"url":"/en/docs/instance-diagnostics#reproduce-and-record-the-problem","content":"Reproduce and record the problem","locale":"en"},"2655":{"id":"/en/docs/instance-diagnostics-3","page_id":"/en/docs/instance-diagnostics","type":"heading","tags":[],"url":"/en/docs/instance-diagnostics#start-collection","content":"Start collection","locale":"en"},"2656":{"id":"/en/docs/instance-diagnostics-4","page_id":"/en/docs/instance-diagnostics","type":"heading","tags":[],"url":"/en/docs/instance-diagnostics#check-completion-status","content":"Check completion status","locale":"en"},"2657":{"id":"/en/docs/instance-diagnostics-5","page_id":"/en/docs/instance-diagnostics","type":"heading","tags":[],"url":"/en/docs/instance-diagnostics#inspect-and-export","content":"Inspect and export","locale":"en"},"2658":{"id":"/en/docs/instance-diagnostics-6","page_id":"/en/docs/instance-diagnostics","type":"heading","tags":[],"url":"/en/docs/instance-diagnostics#what-a-diagnostic-bundle-may-contain","content":"What a diagnostic bundle may contain","locale":"en"},"2659":{"id":"/en/docs/instance-diagnostics-7","page_id":"/en/docs/instance-diagnostics","type":"heading","tags":[],"url":"/en/docs/instance-diagnostics#inspect-before-sharing","content":"Inspect before sharing","locale":"en"},"2660":{"id":"/en/docs/instance-diagnostics-8","page_id":"/en/docs/instance-diagnostics","tags":[],"type":"text","url":"/en/docs/instance-diagnostics","content":"Instance Diagnostics collects environment and runtime information related to a problem into a ZIP archive. It does not repair the instance automatically. Use it after reproducing a launch, extension, hotpatch, or environment problem to provide troubleshooting material.","locale":"en"},"2661":{"id":"/en/docs/instance-diagnostics-9","page_id":"/en/docs/instance-diagnostics","tags":[],"type":"text","url":"/en/docs/instance-diagnostics#reproduce-and-record-the-problem","content":"Record the steps, approximate time, and visible error. Do not retry continuously until new task output obscures the old task.","locale":"en"},"2662":{"id":"/en/docs/instance-diagnostics-10","page_id":"/en/docs/instance-diagnostics","tags":[],"type":"text","url":"/en/docs/instance-diagnostics#start-collection","content":"Open “Maintenance → Diagnostics” and select “Collect Diagnostic Information.” Progress appears in the bottom-right corner of Instance Manager. Leaving the Diagnostics page does not cancel collection.","locale":"en"},"2663":{"id":"/en/docs/instance-diagnostics-11","page_id":"/en/docs/instance-diagnostics","tags":[],"type":"text","url":"/en/docs/instance-diagnostics#check-completion-status","content":"Refresh the diagnostic-bundle list after collection finishes. It shows the file name, creation time, size, and number of collection issues. If an individual source cannot be read, other content may still be written to the archive successfully.","locale":"en"},"2664":{"id":"/en/docs/instance-diagnostics-12","page_id":"/en/docs/instance-diagnostics","tags":[],"type":"text","url":"/en/docs/instance-diagnostics#inspect-and-export","content":"Select “Open Diagnostic Bundle Directory” to locate the original, or use “Save a Copy” to save it elsewhere. Extract and inspect it yourself before sending it to a trusted maintainer.","locale":"en"},"2665":{"id":"/en/docs/instance-diagnostics-13","page_id":"/en/docs/instance-diagnostics","tags":[],"type":"text","url":"/en/docs/instance-diagnostics#what-a-diagnostic-bundle-may-contain","content":"Environment-collection results for the current WebUI;","locale":"en"},"2666":{"id":"/en/docs/instance-diagnostics-14","page_id":"/en/docs/instance-diagnostics","tags":[],"type":"text","url":"/en/docs/instance-diagnostics#what-a-diagnostic-bundle-may-contain","content":"instance snapshots, persisted records, and component paths;","locale":"en"},"2667":{"id":"/en/docs/instance-diagnostics-15","page_id":"/en/docs/instance-diagnostics","tags":[],"type":"text","url":"/en/docs/instance-diagnostics#what-a-diagnostic-bundle-may-contain","content":"currently retained instance tasks, launch phases, and task output;","locale":"en"},"2668":{"id":"/en/docs/instance-diagnostics-16","page_id":"/en/docs/instance-diagnostics","tags":[],"type":"text","url":"/en/docs/instance-diagnostics#what-a-diagnostic-bundle-may-contain","content":"persisted and effective hotpatch configuration, status, events, and logs;","locale":"en"},"2669":{"id":"/en/docs/instance-diagnostics-17","page_id":"/en/docs/instance-diagnostics","tags":[],"type":"text","url":"/en/docs/instance-diagnostics#what-a-diagnostic-bundle-may-contain","content":"application settings, identity, and diagnostic information required for troubleshooting;","locale":"en"},"2670":{"id":"/en/docs/instance-diagnostics-18","page_id":"/en/docs/instance-diagnostics","tags":[],"type":"text","url":"/en/docs/instance-diagnostics#what-a-diagnostic-bundle-may-contain","content":"collection scope, issues, file sizes, and SHA-256 values in `manifest.json`.","locale":"en"},"2671":{"id":"/en/docs/instance-diagnostics-19","page_id":"/en/docs/instance-diagnostics","tags":[],"type":"text","url":"/en/docs/instance-diagnostics#what-a-diagnostic-bundle-may-contain","content":"Instance Diagnostics differs from the application diagnostics under “Settings → Logs & Diagnostics.” Instance Diagnostics primarily targets the current instance. Application diagnostics can collect all instances into one archive according to its settings.","locale":"en"},"2672":{"id":"/en/docs/instance-diagnostics-20","page_id":"/en/docs/instance-diagnostics","tags":[],"type":"text","url":"/en/docs/instance-diagnostics#what-a-diagnostic-bundle-may-contain","content":"Collected content is retained as-is and may contain credentials, tokens, environment variables,\nlocal paths, command arguments, and task output. Although some dedicated credential files are\nexcluded in their entirety, that does not make the archive safe to share publicly.","locale":"en"},"2673":{"id":"/en/docs/instance-diagnostics-21","page_id":"/en/docs/instance-diagnostics","tags":[],"type":"text","url":"/en/docs/instance-diagnostics#inspect-before-sharing","content":"Copy the ZIP to a temporary location and extract it. Do not modify the original bundle saved by\nthe app.","locale":"en"},"2674":{"id":"/en/docs/instance-diagnostics-22","page_id":"/en/docs/instance-diagnostics","tags":[],"type":"text","url":"/en/docs/instance-diagnostics#inspect-before-sharing","content":"Search for user names, home directories, tokens, proxy addresses, remote-repository credentials,\nand custom environment variables.","locale":"en"},"2675":{"id":"/en/docs/instance-diagnostics-23","page_id":"/en/docs/instance-diagnostics","tags":[],"type":"text","url":"/en/docs/instance-diagnostics#inspect-before-sharing","content":"Check the scope and collection issues in `manifest.json`, then remove files you do not intend to\nshare or create a redacted copy.","locale":"en"},"2676":{"id":"/en/docs/instance-diagnostics-24","page_id":"/en/docs/instance-diagnostics","tags":[],"type":"text","url":"/en/docs/instance-diagnostics#inspect-before-sharing","content":"Send it only through a trusted channel, and delete originals and copies you no longer need after\nthe issue is resolved.","locale":"en"},"2677":{"id":"/en/docs/instance-diagnostics-25","page_id":"/en/docs/instance-diagnostics","tags":[],"type":"text","url":"/en/docs/instance-diagnostics#inspect-before-sharing","content":"Diagnostic bundles have no automatic expiration or deletion policy. The page currently has no Delete button. Use “Open Diagnostic Bundle Directory” to manage the files yourself.","locale":"en"},"2678":{"id":"/en/docs/instance-diagnostics-26","page_id":"/en/docs/instance-diagnostics","tags":[],"type":"text","url":"/en/docs/instance-diagnostics#inspect-before-sharing","content":"<Card title=\"Logs, diagnostics, and getting help\" href=\"/docs/troubleshooting-reporting\" description=\"Choose a diagnostic scope and submit a reproducible issue report.\" />","locale":"en"},"2679":{"id":"/en/docs/instance-extensions","page_id":"/en/docs/instance-extensions","type":"page","content":"Extension Management","breadcrumbs":["Hanafubuki Documentation","Instance Management"],"tags":[],"url":"/en/docs/instance-extensions","locale":"en"},"2680":{"id":"/en/docs/instance-extensions-0","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions","content":"Install, update, enable, disable, switch versions, or uninstall extensions supported by the current WebUI.","locale":"en"},"2681":{"id":"/en/docs/instance-extensions-1","page_id":"/en/docs/instance-extensions","type":"heading","tags":[],"url":"/en/docs/instance-extensions#install-an-extension","content":"Install an extension","locale":"en"},"2682":{"id":"/en/docs/instance-extensions-2","page_id":"/en/docs/instance-extensions","type":"heading","tags":[],"url":"/en/docs/instance-extensions#manage-local-extensions","content":"Manage local extensions","locale":"en"},"2683":{"id":"/en/docs/instance-extensions-3","page_id":"/en/docs/instance-extensions","type":"heading","tags":[],"url":"/en/docs/instance-extensions#update-or-switch-versions","content":"Update or switch versions","locale":"en"},"2684":{"id":"/en/docs/instance-extensions-4","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions","content":"Whether the “Extensions” page is available, and which actions it offers, depends on the management capabilities of the current WebUI. The page usually has “Local Extensions” and “Extension Marketplace” views. An instance without marketplace support may still be able to manage extensions already installed.","locale":"en"},"2685":{"id":"/en/docs/instance-extensions-5","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#install-an-extension","content":"Open “Extension Marketplace” and use the search box to filter the index already loaded.","locale":"en"},"2686":{"id":"/en/docs/instance-extensions-6","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#install-an-extension","content":"Review the extension name, author, source, and installation status. An entry marked “Cannot\nInstall” cannot be forcibly installed.","locale":"en"},"2687":{"id":"/en/docs/instance-extensions-7","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#install-an-extension","content":"Select Install, wait for the task in Task Center to complete, then switch to “Local\nExtensions” and confirm that the entry appears.","locale":"en"},"2688":{"id":"/en/docs/instance-extensions-8","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#install-an-extension","content":"Confirm that the repository is compatible with the current WebUI type and version, then copy\nthe complete Git repository URL.","locale":"en"},"2689":{"id":"/en/docs/instance-extensions-9","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#install-an-extension","content":"Wait for the task to finish. If it fails, check repository access, the GitHub mirror, and\ntask output.","locale":"en"},"2690":{"id":"/en/docs/instance-extensions-10","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#install-an-extension","content":"The Extension Marketplace uses an index cached by the backend. Select Refresh when you need new entries or current installation status. Entering a search term only filters the data already loaded.","locale":"en"},"2691":{"id":"/en/docs/instance-extensions-11","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#manage-local-extensions","content":"Operation","locale":"en"},"2692":{"id":"/en/docs/instance-extensions-12","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#manage-local-extensions","content":"Description","locale":"en"},"2693":{"id":"/en/docs/instance-extensions-13","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#manage-local-extensions","content":"Enable / Disable","locale":"en"},"2694":{"id":"/en/docs/instance-extensions-14","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#manage-local-extensions","content":"Change extension status, usually taking effect the next time the WebUI launches","locale":"en"},"2695":{"id":"/en/docs/instance-extensions-15","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#manage-local-extensions","content":"Update","locale":"en"},"2696":{"id":"/en/docs/instance-extensions-16","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#manage-local-extensions","content":"Update one Git-based extension","locale":"en"},"2697":{"id":"/en/docs/instance-extensions-17","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#manage-local-extensions","content":"Update All","locale":"en"},"2698":{"id":"/en/docs/instance-extensions-18","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#manage-local-extensions","content":"Process each currently updatable extension in sequence; inspect failed items in Task Center","locale":"en"},"2699":{"id":"/en/docs/instance-extensions-19","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#manage-local-extensions","content":"Branch / Commit","locale":"en"},"2700":{"id":"/en/docs/instance-extensions-20","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#manage-local-extensions","content":"Switch a Git-based extension to a specified branch or commit","locale":"en"},"2701":{"id":"/en/docs/instance-extensions-21","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#manage-local-extensions","content":"Registry Version","locale":"en"},"2702":{"id":"/en/docs/instance-extensions-22","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#manage-local-extensions","content":"Select a published version for ComfyUI nodes that support the Registry","locale":"en"},"2703":{"id":"/en/docs/instance-extensions-23","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#manage-local-extensions","content":"Uninstall","locale":"en"},"2704":{"id":"/en/docs/instance-extensions-24","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#manage-local-extensions","content":"Delete the extension directory or have the current WebUI perform its corresponding uninstall operation","locale":"en"},"2705":{"id":"/en/docs/instance-extensions-25","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#manage-local-extensions","content":"Source labels in the list help identify available operations. Git sources usually support branches and commits. Registry sources may support published versions. Local sources are not necessarily updatable automatically.","locale":"en"},"2706":{"id":"/en/docs/instance-extensions-26","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#update-or-switch-versions","content":"Create a snapshot and record the current branch, commit, or Registry version of important\nextensions.","locale":"en"},"2707":{"id":"/en/docs/instance-extensions-27","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#update-or-switch-versions","content":"Update or switch one extension at a time. Use “Update All” only when a batch update is needed.","locale":"en"},"2708":{"id":"/en/docs/instance-extensions-28","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#update-or-switch-versions","content":"Wait for the task to finish, refresh the Local Extensions list, and launch the WebUI again.","locale":"en"},"2709":{"id":"/en/docs/instance-extensions-29","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#update-or-switch-versions","content":"If launch fails, disable the most recently changed extension first, then inspect its task output\nand compatibility notes.","locale":"en"},"2710":{"id":"/en/docs/instance-extensions-30","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#update-or-switch-versions","content":"The uninstall confirmation explicitly states that extension files will be deleted from the\ninstance. Whether the extension's own configuration, models, or outputs are also removed depends\non where they are actually stored. Inspect and back them up before uninstalling.","locale":"en"},"2711":{"id":"/en/docs/instance-extensions-31","page_id":"/en/docs/instance-extensions","tags":[],"type":"text","url":"/en/docs/instance-extensions#update-or-switch-versions","content":"If an extension download fails, check Network & Proxy and Mirrors. To roll back the environment as a whole, use Snapshot Management.","locale":"en"},"2712":{"id":"/en/docs/instance-hotpatch","page_id":"/en/docs/instance-hotpatch","type":"page","content":"Hotpatch","breadcrumbs":["Hanafubuki Documentation","Instance Management"],"tags":[],"url":"/en/docs/instance-hotpatch","locale":"en"},"2713":{"id":"/en/docs/instance-hotpatch-0","page_id":"/en/docs/instance-hotpatch","tags":[],"type":"text","url":"/en/docs/instance-hotpatch","content":"Edit and apply hotpatch configuration supported by the current WebUI, and inspect runtime logs.","locale":"en"},"2714":{"id":"/en/docs/instance-hotpatch-1","page_id":"/en/docs/instance-hotpatch","type":"heading","tags":[],"url":"/en/docs/instance-hotpatch#configuration-editors","content":"Configuration editors","locale":"en"},"2715":{"id":"/en/docs/instance-hotpatch-2","page_id":"/en/docs/instance-hotpatch","type":"heading","tags":[],"url":"/en/docs/instance-hotpatch#save-versus-apply","content":"Save versus apply","locale":"en"},"2716":{"id":"/en/docs/instance-hotpatch-3","page_id":"/en/docs/instance-hotpatch","type":"heading","tags":[],"url":"/en/docs/instance-hotpatch#change-hotpatch-configuration","content":"Change hotpatch configuration","locale":"en"},"2717":{"id":"/en/docs/instance-hotpatch-4","page_id":"/en/docs/instance-hotpatch","tags":[],"type":"text","url":"/en/docs/instance-hotpatch","content":"Hotpatch capabilities are supplied by the current WebUI and appear only when the backend detects a configuration or runtime capability. The “Hotpatch” page edits configuration and displays logs. Live runtime status appears under “Hotpatch Runtime” in Instance Information.","locale":"en"},"2718":{"id":"/en/docs/instance-hotpatch-5","page_id":"/en/docs/instance-hotpatch","tags":[],"type":"text","url":"/en/docs/instance-hotpatch#configuration-editors","content":"The form is generated from the current hotpatch catalog. After you change a Boolean, integer,\noption, list, or object, it saves the complete configuration automatically after briefly\ncombining consecutive input. “Restore Defaults” also saves automatically in form mode.","locale":"en"},"2719":{"id":"/en/docs/instance-hotpatch-6","page_id":"/en/docs/instance-hotpatch","tags":[],"type":"text","url":"/en/docs/instance-hotpatch#configuration-editors","content":"The raw editor provides precise control over the complete configuration object. Input must be a\nvalid JSON object. Changes create only a draft until you select Save. Incomplete or malformed\nJSON is not written to the instance.","locale":"en"},"2720":{"id":"/en/docs/instance-hotpatch-7","page_id":"/en/docs/instance-hotpatch","tags":[],"type":"text","url":"/en/docs/instance-hotpatch#configuration-editors","content":"“Normalize” asks the backend to reconcile the draft with the current catalog, such as filling in, converting, or rejecting values that violate field constraints. It is not the same as applying the configuration to a running WebUI.","locale":"en"},"2721":{"id":"/en/docs/instance-hotpatch-8","page_id":"/en/docs/instance-hotpatch","tags":[],"type":"text","url":"/en/docs/instance-hotpatch#save-versus-apply","content":"Operation","locale":"en"},"2722":{"id":"/en/docs/instance-hotpatch-9","page_id":"/en/docs/instance-hotpatch","tags":[],"type":"text","url":"/en/docs/instance-hotpatch#save-versus-apply","content":"Result","locale":"en"},"2723":{"id":"/en/docs/instance-hotpatch-10","page_id":"/en/docs/instance-hotpatch","tags":[],"type":"text","url":"/en/docs/instance-hotpatch#save-versus-apply","content":"Save Configuration","locale":"en"},"2724":{"id":"/en/docs/instance-hotpatch-11","page_id":"/en/docs/instance-hotpatch","tags":[],"type":"text","url":"/en/docs/instance-hotpatch#save-versus-apply","content":"Persist the current instance's hotpatch configuration","locale":"en"},"2725":{"id":"/en/docs/instance-hotpatch-12","page_id":"/en/docs/instance-hotpatch","tags":[],"type":"text","url":"/en/docs/instance-hotpatch#save-versus-apply","content":"Apply to Local Configuration","locale":"en"},"2726":{"id":"/en/docs/instance-hotpatch-13","page_id":"/en/docs/instance-hotpatch","tags":[],"type":"text","url":"/en/docs/instance-hotpatch#save-versus-apply","content":"Ask a WebUI that supports this operation to update its local patch configuration","locale":"en"},"2727":{"id":"/en/docs/instance-hotpatch-14","page_id":"/en/docs/instance-hotpatch","tags":[],"type":"text","url":"/en/docs/instance-hotpatch#save-versus-apply","content":"Apply to Runtime","locale":"en"},"2728":{"id":"/en/docs/instance-hotpatch-15","page_id":"/en/docs/instance-hotpatch","tags":[],"type":"text","url":"/en/docs/instance-hotpatch#save-versus-apply","content":"Send the normalized configuration to the currently running hotpatch session","locale":"en"},"2729":{"id":"/en/docs/instance-hotpatch-16","page_id":"/en/docs/instance-hotpatch","tags":[],"type":"text","url":"/en/docs/instance-hotpatch#save-versus-apply","content":"“Apply to Runtime” is unavailable while the runtime is not running. Save the configuration first and then launch the WebUI. Confirm runtime status in “Instance Information.”","locale":"en"},"2730":{"id":"/en/docs/instance-hotpatch-17","page_id":"/en/docs/instance-hotpatch","tags":[],"type":"text","url":"/en/docs/instance-hotpatch#change-hotpatch-configuration","content":"Find the target feature in the form. Keep the default when you are unsure what a field means.","locale":"en"},"2731":{"id":"/en/docs/instance-hotpatch-18","page_id":"/en/docs/instance-hotpatch","tags":[],"type":"text","url":"/en/docs/instance-hotpatch#change-hotpatch-configuration","content":"After making a change, wait for the bottom-right status area to report that the configuration\nwas saved. In JSON mode, correct every formatting error before saving manually.","locale":"en"},"2732":{"id":"/en/docs/instance-hotpatch-19","page_id":"/en/docs/instance-hotpatch","tags":[],"type":"text","url":"/en/docs/instance-hotpatch#change-hotpatch-configuration","content":"Select “Apply to Local Configuration” or “Apply to Runtime,” depending on what the current WebUI\nsupports.","locale":"en"},"2733":{"id":"/en/docs/instance-hotpatch-20","page_id":"/en/docs/instance-hotpatch","tags":[],"type":"text","url":"/en/docs/instance-hotpatch#change-hotpatch-configuration","content":"Open “Logs,” filter runtime feedback by level and source, and confirm that there are no loading\nor execution errors.","locale":"en"},"2734":{"id":"/en/docs/instance-hotpatch-21","page_id":"/en/docs/instance-hotpatch","tags":[],"type":"text","url":"/en/docs/instance-hotpatch#change-hotpatch-configuration","content":"If online application is unavailable, stop and relaunch the WebUI, then inspect hotpatch runtime\nstatus under “Instance Information.”","locale":"en"},"2735":{"id":"/en/docs/instance-hotpatch-22","page_id":"/en/docs/instance-hotpatch","tags":[],"type":"text","url":"/en/docs/instance-hotpatch#change-hotpatch-configuration","content":"The Logs page continuously reads retained records from the current runtime session. “Clear View” clears only the logs already displayed on the current page. It does not change configuration and must not be treated as resolving a problem.","locale":"en"},"2736":{"id":"/en/docs/instance-hotpatch-23","page_id":"/en/docs/instance-hotpatch","tags":[],"type":"text","url":"/en/docs/instance-hotpatch#change-hotpatch-configuration","content":"Hotpatch fields are supplied dynamically by the current WebUI and version. Pasting complete JSON\nfrom another type or an older version can fail validation. Save a copy of the current\nconfiguration before making changes.","locale":"en"},"2737":{"id":"/en/docs/instance-launch","page_id":"/en/docs/instance-launch","type":"page","content":"Launch Configuration","breadcrumbs":["Hanafubuki Documentation","Instance Management"],"tags":[],"url":"/en/docs/instance-launch","locale":"en"},"2738":{"id":"/en/docs/instance-launch-0","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch","content":"Configure WebUI launch arguments and instance environment variables, and handle pre-launch argument checks.","locale":"en"},"2739":{"id":"/en/docs/instance-launch-1","page_id":"/en/docs/instance-launch","type":"heading","tags":[],"url":"/en/docs/instance-launch#two-ways-to-edit-arguments","content":"Two ways to edit arguments","locale":"en"},"2740":{"id":"/en/docs/instance-launch-2","page_id":"/en/docs/instance-launch","type":"heading","tags":[],"url":"/en/docs/instance-launch#configure-launch-arguments","content":"Configure launch arguments","locale":"en"},"2741":{"id":"/en/docs/instance-launch-3","page_id":"/en/docs/instance-launch","type":"heading","tags":[],"url":"/en/docs/instance-launch#stop-the-webui","content":"Stop the WebUI","locale":"en"},"2742":{"id":"/en/docs/instance-launch-4","page_id":"/en/docs/instance-launch","type":"heading","tags":[],"url":"/en/docs/instance-launch#edit-the-raw-string","content":"Edit the raw string","locale":"en"},"2743":{"id":"/en/docs/instance-launch-5","page_id":"/en/docs/instance-launch","type":"heading","tags":[],"url":"/en/docs/instance-launch#open-the-structured-editor-when-needed","content":"Open the structured editor when needed","locale":"en"},"2744":{"id":"/en/docs/instance-launch-6","page_id":"/en/docs/instance-launch","type":"heading","tags":[],"url":"/en/docs/instance-launch#check-for-a-restart-notice","content":"Check for a restart notice","locale":"en"},"2745":{"id":"/en/docs/instance-launch-7","page_id":"/en/docs/instance-launch","type":"heading","tags":[],"url":"/en/docs/instance-launch#environment-variables","content":"Environment variables","locale":"en"},"2746":{"id":"/en/docs/instance-launch-8","page_id":"/en/docs/instance-launch","type":"heading","tags":[],"url":"/en/docs/instance-launch#incompatible-arguments-discovered-at-launch","content":"Incompatible arguments discovered at launch","locale":"en"},"2747":{"id":"/en/docs/instance-launch-9","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch","content":"The “Launch” page saves the command-line arguments and environment variables used for the next launch of the current instance. The backend validates and persists the configuration. You must restart the WebUI before the new values enter its launch plan.","locale":"en"},"2748":{"id":"/en/docs/instance-launch-10","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#two-ways-to-edit-arguments","content":"Editor","locale":"en"},"2749":{"id":"/en/docs/instance-launch-11","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#two-ways-to-edit-arguments","content":"Best for","locale":"en"},"2750":{"id":"/en/docs/instance-launch-12","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#two-ways-to-edit-arguments","content":"Saving and validation","locale":"en"},"2751":{"id":"/en/docs/instance-launch-13","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#two-ways-to-edit-arguments","content":"Raw argument string","locale":"en"},"2752":{"id":"/en/docs/instance-launch-14","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#two-ways-to-edit-arguments","content":"You already know the syntax and want to paste a complete command line quickly","locale":"en"},"2753":{"id":"/en/docs/instance-launch-15","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#two-ways-to-edit-arguments","content":"Parsed according to command-line syntax; unknown arguments produce warnings but are not silently removed","locale":"en"},"2754":{"id":"/en/docs/instance-launch-16","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#two-ways-to-edit-arguments","content":"Structured editor","locale":"en"},"2755":{"id":"/en/docs/instance-launch-17","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#two-ways-to-edit-arguments","content":"You want to choose from arguments actually supported by the current WebUI","locale":"en"},"2756":{"id":"/en/docs/instance-launch-18","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#two-ways-to-edit-arguments","content":"Checks argument counts, values, duplicates, required items, and mutually exclusive groups","locale":"en"},"2757":{"id":"/en/docs/instance-launch-19","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#two-ways-to-edit-arguments","content":"Enter only the arguments passed to the WebUI in the raw field. Do not include the Python executable or launch script. For example:","locale":"en"},"2758":{"id":"/en/docs/instance-launch-20","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#two-ways-to-edit-arguments","content":"This is only an example of command-line syntax. Whether an argument exists, requires a value, or accepts particular values depends on the catalog loaded by the structured editor for the current instance.","locale":"en"},"2759":{"id":"/en/docs/instance-launch-21","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#stop-the-webui","content":"A running WebUI does not restart automatically when its configuration changes. Stop the instance first so you do not forget to restart it and mistakenly assume the arguments are already active.","locale":"en"},"2760":{"id":"/en/docs/instance-launch-22","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#edit-the-raw-string","content":"Enter arguments using command-line syntax. A single value containing spaces must be quoted. After submitting, inspect the parsing errors and unknown-argument warnings shown on the page.","locale":"en"},"2761":{"id":"/en/docs/instance-launch-23","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#open-the-structured-editor-when-needed","content":"Select “Configure Launch Arguments,” enable options from the argument catalog, and fill in their values. The editor saves as you make changes. If it reports that the configuration is stale, reload it before continuing to edit.","locale":"en"},"2762":{"id":"/en/docs/instance-launch-24","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#check-for-a-restart-notice","content":"When the page shows “Restart Required,” return to “Instance Information,” launch the WebUI, and confirm in the launch task that the final argument check passed.","locale":"en"},"2763":{"id":"/en/docs/instance-launch-25","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#check-for-a-restart-notice","content":"If the structured catalog cannot be loaded, the page falls back to the raw editor. You can keep and save arguments in that mode, but automatic validation is more limited. Check the management API and Core environment, then use “Retry Discovery.”","locale":"en"},"2764":{"id":"/en/docs/instance-launch-26","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#environment-variables","content":"Environment variables apply only to managed processes for the current instance. They are saved after you provide complete names and values. Duplicate variable names or blank names prevent submission.","locale":"en"},"2765":{"id":"/en/docs/instance-launch-27","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#environment-variables","content":"Add only variables explicitly required by the current WebUI, extension, or script.","locale":"en"},"2766":{"id":"/en/docs/instance-launch-28","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#environment-variables","content":"Managed environment values such as `PATH`, `PYTHONPATH`, `MAMBA_*`, and `CONDA_*` may be reserved or recomposed by the app. Do not rely on them to override the desktop runtime environment.","locale":"en"},"2767":{"id":"/en/docs/instance-launch-29","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#environment-variables","content":"Environment-variable values are shown normally and may also appear in task output or diagnostic bundles. Check for tokens and other sensitive values before sharing screenshots or diagnostics.","locale":"en"},"2768":{"id":"/en/docs/instance-launch-30","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#incompatible-arguments-discovered-at-launch","content":"The save step allows options not yet recognized by the current argument catalog to remain, accommodating branches, extensions, or future versions. At the actual launch, the backend checks the raw arguments again against the current catalog for unknown arguments, orphaned values, and other constraints, then offers these choices:","locale":"en"},"2769":{"id":"/en/docs/instance-launch-31","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#incompatible-arguments-discovered-at-launch","content":"Choice","locale":"en"},"2770":{"id":"/en/docs/instance-launch-32","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#incompatible-arguments-discovered-at-launch","content":"Result","locale":"en"},"2771":{"id":"/en/docs/instance-launch-33","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#incompatible-arguments-discovered-at-launch","content":"Cancel","locale":"en"},"2772":{"id":"/en/docs/instance-launch-34","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#incompatible-arguments-discovered-at-launch","content":"Do not create WebUI runtime resources; return to the configuration page and make changes","locale":"en"},"2773":{"id":"/en/docs/instance-launch-35","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#incompatible-arguments-discovered-at-launch","content":"Ignore Once","locale":"en"},"2774":{"id":"/en/docs/instance-launch-36","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#incompatible-arguments-discovered-at-launch","content":"Continue this launch with the raw arguments; do not change the saved configuration","locale":"en"},"2775":{"id":"/en/docs/instance-launch-37","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#incompatible-arguments-discovered-at-launch","content":"Remove Incompatible Items and Launch","locale":"en"},"2776":{"id":"/en/docs/instance-launch-38","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#incompatible-arguments-discovered-at-launch","content":"Remove the invalid fragments precisely identified by the backend, save the complete cleaned argument string, and continue launching","locale":"en"},"2777":{"id":"/en/docs/instance-launch-39","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#incompatible-arguments-discovered-at-launch","content":"“Ignore Once” is appropriate when you have confirmed that a branch-specific argument is still\nvalid. If the launch still fails, return to this page and correct the arguments instead of\nrepeatedly ignoring the same warning.","locale":"en"},"2778":{"id":"/en/docs/instance-launch-40","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#incompatible-arguments-discovered-at-launch","content":"<Card title=\"Instance launch and access troubleshooting\" href=\"/docs/troubleshooting-instance-start\" description=\"Resolve process exits, port conflicts, missing addresses, and inaccessible pages.\" />","locale":"en"},"2779":{"id":"/en/docs/instance-launch-41","page_id":"/en/docs/instance-launch","tags":[],"type":"text","url":"/en/docs/instance-launch#incompatible-arguments-discovered-at-launch","content":"<Card title=\"Upstream WebUI problems\" href=\"/docs/troubleshooting-webui\" description=\"Resolve model, extension, node, and generation-stage errors.\" />","locale":"en"},"2780":{"id":"/en/docs/instance-maintenance","page_id":"/en/docs/instance-maintenance","type":"page","content":"Instance Maintenance","breadcrumbs":["Hanafubuki Documentation","Instance Management"],"tags":[],"url":"/en/docs/instance-maintenance","locale":"en"},"2781":{"id":"/en/docs/instance-maintenance-0","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance","content":"Understand the file effects of renaming, migration, reinstallation, record-only deletion, and full deletion.","locale":"en"},"2782":{"id":"/en/docs/instance-maintenance-1","page_id":"/en/docs/instance-maintenance","type":"heading","tags":[],"url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Prepare before an operation","locale":"en"},"2783":{"id":"/en/docs/instance-maintenance-2","page_id":"/en/docs/instance-maintenance","type":"heading","tags":[],"url":"/en/docs/instance-maintenance#rename","content":"Rename","locale":"en"},"2784":{"id":"/en/docs/instance-maintenance-3","page_id":"/en/docs/instance-maintenance","type":"heading","tags":[],"url":"/en/docs/instance-maintenance#migrate-an-instance","content":"Migrate an instance","locale":"en"},"2785":{"id":"/en/docs/instance-maintenance-4","page_id":"/en/docs/instance-maintenance","type":"heading","tags":[],"url":"/en/docs/instance-maintenance#select-the-destination-parent","content":"Select the destination parent","locale":"en"},"2786":{"id":"/en/docs/instance-maintenance-5","page_id":"/en/docs/instance-maintenance","type":"heading","tags":[],"url":"/en/docs/instance-maintenance#read-the-migration-preview","content":"Read the migration preview","locale":"en"},"2787":{"id":"/en/docs/instance-maintenance-6","page_id":"/en/docs/instance-maintenance","type":"heading","tags":[],"url":"/en/docs/instance-maintenance#start-and-wait-for-migration","content":"Start and wait for migration","locale":"en"},"2788":{"id":"/en/docs/instance-maintenance-7","page_id":"/en/docs/instance-maintenance","type":"heading","tags":[],"url":"/en/docs/instance-maintenance#verify-the-migration","content":"Verify the migration","locale":"en"},"2789":{"id":"/en/docs/instance-maintenance-8","page_id":"/en/docs/instance-maintenance","type":"heading","tags":[],"url":"/en/docs/instance-maintenance#reinstall-an-instance","content":"Reinstall an instance","locale":"en"},"2790":{"id":"/en/docs/instance-maintenance-9","page_id":"/en/docs/instance-maintenance","type":"heading","tags":[],"url":"/en/docs/instance-maintenance#delete-an-instance-or-only-its-record","content":"Delete an instance or only its record","locale":"en"},"2791":{"id":"/en/docs/instance-maintenance-10","page_id":"/en/docs/instance-maintenance","type":"heading","tags":[],"url":"/en/docs/instance-maintenance#failures-and-recovery","content":"Failures and recovery","locale":"en"},"2792":{"id":"/en/docs/instance-maintenance-11","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance","content":"The “Maintenance” page does not depend on the WebUI management API and remains available when management features fail. Migration, reinstallation, and deletion are instance-lifecycle operations: the app first stops and confirms related runtime resources, then modifies files or records.","locale":"en"},"2793":{"id":"/en/docs/instance-maintenance-12","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Stop the WebUI under “Instance Information,” and wait for current installation, management, and\nterminal tasks to finish.","locale":"en"},"2794":{"id":"/en/docs/instance-maintenance-13","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Create an environment snapshot, and separately back up models, outputs, configuration, and\ncustom code.","locale":"en"},"2795":{"id":"/en/docs/instance-maintenance-14","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Check the instance root, Python path, and Core path shown on the page. Pay particular attention\nto components outside the root.","locale":"en"},"2796":{"id":"/en/docs/instance-maintenance-15","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"After starting an operation, continue watching the bottom-right status area and Task Center\nuntil the task explicitly completes or fails.","locale":"en"},"2797":{"id":"/en/docs/instance-maintenance-16","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Operation","locale":"en"},"2798":{"id":"/en/docs/instance-maintenance-17","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Configuration record","locale":"en"},"2799":{"id":"/en/docs/instance-maintenance-18","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Instance root","locale":"en"},"2800":{"id":"/en/docs/instance-maintenance-19","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"External component directories","locale":"en"},"2801":{"id":"/en/docs/instance-maintenance-20","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Rename","locale":"en"},"2802":{"id":"/en/docs/instance-maintenance-21","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Update the name","locale":"en"},"2803":{"id":"/en/docs/instance-maintenance-22","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Do not move","locale":"en"},"2804":{"id":"/en/docs/instance-maintenance-23","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Unchanged","locale":"en"},"2805":{"id":"/en/docs/instance-maintenance-24","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Migrate instance","locale":"en"},"2806":{"id":"/en/docs/instance-maintenance-25","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Update paths","locale":"en"},"2807":{"id":"/en/docs/instance-maintenance-26","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Move the complete root to a new parent directory","locale":"en"},"2808":{"id":"/en/docs/instance-maintenance-27","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Remain in place","locale":"en"},"2809":{"id":"/en/docs/instance-maintenance-28","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Reinstall","locale":"en"},"2810":{"id":"/en/docs/instance-maintenance-29","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Preserve the instance","locale":"en"},"2811":{"id":"/en/docs/instance-maintenance-30","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Rebuild components according to the selected options","locale":"en"},"2812":{"id":"/en/docs/instance-maintenance-31","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Process only explicitly selected components","locale":"en"},"2813":{"id":"/en/docs/instance-maintenance-32","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Delete record only","locale":"en"},"2814":{"id":"/en/docs/instance-maintenance-33","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Delete","locale":"en"},"2815":{"id":"/en/docs/instance-maintenance-34","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Preserve completely","locale":"en"},"2816":{"id":"/en/docs/instance-maintenance-35","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Preserve completely","locale":"en"},"2817":{"id":"/en/docs/instance-maintenance-36","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Delete instance","locale":"en"},"2818":{"id":"/en/docs/instance-maintenance-37","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Delete","locale":"en"},"2819":{"id":"/en/docs/instance-maintenance-38","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Delete the exact instance root","locale":"en"},"2820":{"id":"/en/docs/instance-maintenance-39","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#prepare-before-an-operation","content":"Do not delete","locale":"en"},"2821":{"id":"/en/docs/instance-maintenance-40","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#rename","content":"Renaming changes only the instance name displayed in Hanafubuki. The instance ID, identity, instance root, and all component paths remain unchanged. Submitting the same name does not create another configuration change.","locale":"en"},"2822":{"id":"/en/docs/instance-maintenance-41","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#migrate-an-instance","content":"Migration moves the complete instance root; it does not merely update a path setting. The page requires an existing destination parent directory. The backend appends the current instance directory name and requires the final directory not to exist yet.","locale":"en"},"2823":{"id":"/en/docs/instance-maintenance-42","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#migrate-an-instance","content":"Python, Core, models, and other files inside the instance root move with the complete directory. Component paths outside the root remain in place and are not copied, moved, or deleted.","locale":"en"},"2824":{"id":"/en/docs/instance-maintenance-43","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#select-the-destination-parent","content":"The destination parent must exist, and the final instance directory must not. Migration does not merge with or overwrite an existing directory.","locale":"en"},"2825":{"id":"/en/docs/instance-maintenance-44","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#read-the-migration-preview","content":"The app revalidates instance identity, configuration, path overlap, and external components, then shows the final directory and warnings in the confirmation dialog.","locale":"en"},"2826":{"id":"/en/docs/instance-maintenance-45","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#start-and-wait-for-migration","content":"After confirmation, the app stops the WebUI, management service, WebView, and instance terminal in sequence. It then moves the files and updates configuration atomically. A migration between drives may require a complete copy, so its duration depends on the size of the instance.","locale":"en"},"2827":{"id":"/en/docs/instance-maintenance-46","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#verify-the-migration","content":"Reopen the instance after completion and check the root and managed component paths. Then verify the environment using the Instance Terminal and one real launch.","locale":"en"},"2828":{"id":"/en/docs/instance-maintenance-47","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#verify-the-migration","content":"Migration does not scan for or rewrite absolute paths inside `.pth` files, scripts, environment variables, or other files. If a third-party component recorded the old location, correct it after migration using that component's own procedure.","locale":"en"},"2829":{"id":"/en/docs/instance-maintenance-48","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#verify-the-migration","content":"If “Migration Requires Recovery” appears, the instance remains closed to protect file consistency.\nDo not manually move or delete the source, destination, or temporary directory. Select the\noriginal destination parent and choose “Migrate Instance” again to continue recovery.","locale":"en"},"2830":{"id":"/en/docs/instance-maintenance-49","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#reinstall-an-instance","content":"Reinstallation preserves the instance record and current configuration, then runs the complete Python and WebUI installation workflow again. Existing components are reused where possible by default. “Force Rebuild Python” and “Force Rebuild Core” permanently delete the selected component directories before installation.","locale":"en"},"2831":{"id":"/en/docs/instance-maintenance-50","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#reinstall-an-instance","content":"Use this to restore missing dependencies or rerun the installation workflow. Existing Python and\nCore components are reused where possible, although the installer may still update dependencies\nor code state. When Core is outside the instance root, standard reinstallation may still reuse\nand update it as long as it remains the same existing directory recorded for the instance.","locale":"en"},"2832":{"id":"/en/docs/instance-maintenance-51","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#reinstall-an-instance","content":"Use this when a component is damaged beyond repair. Select only the components that genuinely\nneed rebuilding. External Python/Core directories outside the instance root cannot be forcibly\ndeleted; the task rejects the operation before changing files.","locale":"en"},"2833":{"id":"/en/docs/instance-maintenance-52","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#reinstall-an-instance","content":"Check the exact paths that will be deleted in the confirmation dialog, then select “Reinstall.”","locale":"en"},"2834":{"id":"/en/docs/instance-maintenance-53","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#reinstall-an-instance","content":"After the instance enters the installation workspace, follow the task through its installation\nphases and logs.","locale":"en"},"2835":{"id":"/en/docs/instance-maintenance-54","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#reinstall-an-instance","content":"When it finishes, check launch arguments, versions, extensions, and PyTorch before launching the\nWebUI.","locale":"en"},"2836":{"id":"/en/docs/instance-maintenance-55","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#delete-an-instance-or-only-its-record","content":"Delete only the records bound to the current instance identity in Hanafubuki. No files are\ninspected, moved, or deleted. The instance root, external Python/Core, and every other\nconfigured path remain intact and can be imported again later.","locale":"en"},"2837":{"id":"/en/docs/instance-maintenance-56","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#delete-an-instance-or-only-its-record","content":"Delete the exact, validated instance root first, then delete the instance record. Python, Core,\nmodels, outputs, and everything else inside the root are deleted with it. Components outside the\nroot are not deleted.","locale":"en"},"2838":{"id":"/en/docs/instance-maintenance-57","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#delete-an-instance-or-only-its-record","content":"If you only want to hide the instance from the app while preserving every file, choose “Delete\nRecord Only.”","locale":"en"},"2839":{"id":"/en/docs/instance-maintenance-58","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#delete-an-instance-or-only-its-record","content":"To reclaim the entire instance root, choose “Delete Instance” and check the exact path in the\nconfirmation dialog again.","locale":"en"},"2840":{"id":"/en/docs/instance-maintenance-59","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#delete-an-instance-or-only-its-record","content":"Do not close the app or manually delete the directory after submission. Deletion progress\nremains visible in the bottom-right corner of Instance Manager.","locale":"en"},"2841":{"id":"/en/docs/instance-maintenance-60","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#delete-an-instance-or-only-its-record","content":"After full deletion succeeds, the instance details disappear. The final success or failure\nstatus remains available in Instance Manager and Task Center.","locale":"en"},"2842":{"id":"/en/docs/instance-maintenance-61","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#delete-an-instance-or-only-its-record","content":"File deletion cannot be undone through Hanafubuki. Check the instance root and confirm that\nimportant models, outputs, configuration, and custom code have independent backups. External\ncomponents are preserved, but equivalent files inside the root disappear with a full deletion.","locale":"en"},"2843":{"id":"/en/docs/instance-maintenance-62","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#failures-and-recovery","content":"When a maintenance operation cannot confirm process shutdown, file state, or a configuration commit, it retains the original task and recovery obligation instead of pretending to have completed. In that situation:","locale":"en"},"2844":{"id":"/en/docs/instance-maintenance-63","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#failures-and-recovery","content":"Open the failed item in the bottom-right corner or Task Center to inspect the exact phase and error;","locale":"en"},"2845":{"id":"/en/docs/instance-maintenance-64","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#failures-and-recovery","content":"do not complete the remaining steps manually in a file manager;","locale":"en"},"2846":{"id":"/en/docs/instance-maintenance-65","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#failures-and-recovery","content":"after fixing permissions, disk, or file-in-use problems, retry the same operation through the interface;","locale":"en"},"2847":{"id":"/en/docs/instance-maintenance-66","page_id":"/en/docs/instance-maintenance","tags":[],"type":"text","url":"/en/docs/instance-maintenance#failures-and-recovery","content":"while the instance remains locked for maintenance, do not create a replacement instance at the same path.","locale":"en"},"2848":{"id":"/en/docs/instance-management","page_id":"/en/docs/instance-management","type":"page","content":"Instance Management","breadcrumbs":["Hanafubuki Documentation","Instance Management"],"tags":[],"url":"/en/docs/instance-management","locale":"en"},"2849":{"id":"/en/docs/instance-management-0","page_id":"/en/docs/instance-management","tags":[],"type":"text","url":"/en/docs/instance-management","content":"Learn about the Instance Management entry point, feature sections, and task status, and find the corresponding guides.","locale":"en"},"2850":{"id":"/en/docs/instance-management-1","page_id":"/en/docs/instance-management","type":"heading","tags":[],"url":"/en/docs/instance-management#management-sections","content":"Management sections","locale":"en"},"2851":{"id":"/en/docs/instance-management-2","page_id":"/en/docs/instance-management"