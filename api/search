-and-details","content":"Running and queued tasks","locale":"en"},"6856":{"id":"/en/docs/settings-api-servers-42","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#status-and-details","content":"Workers","locale":"en"},"6857":{"id":"/en/docs/settings-api-servers-43","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#status-and-details","content":"Busy and total worker threads","locale":"en"},"6858":{"id":"/en/docs/settings-api-servers-44","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#status-and-details","content":"Process ID","locale":"en"},"6859":{"id":"/en/docs/settings-api-servers-45","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#status-and-details","content":"The server process's PID, for comparison with the system task manager","locale":"en"},"6860":{"id":"/en/docs/settings-api-servers-46","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#status-and-details","content":"Last health check","locale":"en"},"6861":{"id":"/en/docs/settings-api-servers-47","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#status-and-details","content":"Time since the last check and its latency, or the number of consecutive failures","locale":"en"},"6862":{"id":"/en/docs/settings-api-servers-48","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#status-and-details","content":"Automatic restarts","locale":"en"},"6863":{"id":"/en/docs/settings-api-servers-49","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#status-and-details","content":"Automatic restarts in the last 10 minutes against the limit, and the last reason","locale":"en"},"6864":{"id":"/en/docs/settings-api-servers-50","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#health-checks-and-automatic-restarts","content":"The application and instance control servers follow these rules:","locale":"en"},"6865":{"id":"/en/docs/settings-api-servers-51","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#health-checks-and-automatic-restarts","content":"It checks every 15 seconds; a check that takes longer than 5 seconds fails.","locale":"en"},"6866":{"id":"/en/docs/settings-api-servers-52","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#health-checks-and-automatic-restarts","content":"After a failed check it rechecks every 3 seconds, and confirms **Not responding** only after 3 more consecutive failures.","locale":"en"},"6867":{"id":"/en/docs/settings-api-servers-53","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#health-checks-and-automatic-restarts","content":"A server confirmed stuck, or whose process exits unexpectedly, restarts automatically.","locale":"en"},"6868":{"id":"/en/docs/settings-api-servers-54","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#health-checks-and-automatic-restarts","content":"Each server restarts automatically at most 3 times in 10 minutes, waiting 0, 10, and 30 seconds before successive restarts.","locale":"en"},"6869":{"id":"/en/docs/settings-api-servers-55","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#health-checks-and-automatic-restarts","content":"After that limit the server stays **Failed** and is not restarted again, so it cannot keep interrupting work. When this happens to the App server, Home shows a **The app's API server stopped** banner at the bottom, from which you can restart it or open this section.","locale":"en"},"6870":{"id":"/en/docs/settings-api-servers-56","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#health-checks-and-automatic-restarts","content":"Other roles use their type's health checks and restart policy. Roles that check readiness over HTTP or TCP continue to be probed. For roles that detect readiness from process output or a reported address, the supervisor watches for process exit after startup. Use the task output to investigate those roles.","locale":"en"},"6871":{"id":"/en/docs/settings-api-servers-57","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#manual-operations","content":"Operation","locale":"en"},"6872":{"id":"/en/docs/settings-api-servers-58","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#manual-operations","content":"Available when","locale":"en"},"6873":{"id":"/en/docs/settings-api-servers-59","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#manual-operations","content":"Behavior","locale":"en"},"6874":{"id":"/en/docs/settings-api-servers-60","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#manual-operations","content":"Start","locale":"en"},"6875":{"id":"/en/docs/settings-api-servers-61","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#manual-operations","content":"Stopped or failed","locale":"en"},"6876":{"id":"/en/docs/settings-api-servers-62","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#manual-operations","content":"Starts the server","locale":"en"},"6877":{"id":"/en/docs/settings-api-servers-63","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#manual-operations","content":"Restart","locale":"en"},"6878":{"id":"/en/docs/settings-api-servers-64","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#manual-operations","content":"Running","locale":"en"},"6879":{"id":"/en/docs/settings-api-servers-65","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#manual-operations","content":"Restarts immediately when idle; otherwise waits for work in progress to finish first","locale":"en"},"6880":{"id":"/en/docs/settings-api-servers-66","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#manual-operations","content":"Restart now","locale":"en"},"6881":{"id":"/en/docs/settings-api-servers-67","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#manual-operations","content":"Restart pending","locale":"en"},"6882":{"id":"/en/docs/settings-api-servers-68","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#manual-operations","content":"Stops waiting and restarts immediately","locale":"en"},"6883":{"id":"/en/docs/settings-api-servers-69","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#manual-operations","content":"Cancel pending restart","locale":"en"},"6884":{"id":"/en/docs/settings-api-servers-70","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#manual-operations","content":"Restart pending","locale":"en"},"6885":{"id":"/en/docs/settings-api-servers-71","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#manual-operations","content":"Withdraws the pending restart; the server keeps running","locale":"en"},"6886":{"id":"/en/docs/settings-api-servers-72","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#manual-operations","content":"Check health","locale":"en"},"6887":{"id":"/en/docs/settings-api-servers-73","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#manual-operations","content":"Running","locale":"en"},"6888":{"id":"/en/docs/settings-api-servers-74","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#manual-operations","content":"Runs one health check now and reports the latency or error in the lower-right corner","locale":"en"},"6889":{"id":"/en/docs/settings-api-servers-75","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#manual-operations","content":"Stop","locale":"en"},"6890":{"id":"/en/docs/settings-api-servers-76","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#manual-operations","content":"Not stopped","locale":"en"},"6891":{"id":"/en/docs/settings-api-servers-77","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#manual-operations","content":"Stops the server","locale":"en"},"6892":{"id":"/en/docs/settings-api-servers-78","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#manual-operations","content":"When you click **Restart** on a server that still has work, it shows a **Restart pending** badge and restarts automatically once that work finishes. While a restart is pending, new background tasks are rejected and must be retried after the restart; work already in progress is unaffected.","locale":"en"},"6893":{"id":"/en/docs/settings-api-servers-79","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#manual-operations","content":"When a server has work in progress, **Restart now** and **Stop** ask for confirmation first.\nInterrupted tasks cannot resume and must be run again after the restart. Without a specific\nreason, prefer **Restart**, which waits for the work to finish.","locale":"en"},"6894":{"id":"/en/docs/settings-api-servers-80","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#management-mcp-server","content":"Below the API servers, the **Management MCP server** card shows whether the app's MCP server runs and its address, and the **External MCP clients** card lets other AI tools connect to it. See MCP Server.","locale":"en"},"6895":{"id":"/en/docs/settings-api-servers-81","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#troubleshooting","content":"Read the badge and the **Last check error** or **Error** detail to tell a temporary stall from a\nstartup failure.","locale":"en"},"6896":{"id":"/en/docs/settings-api-servers-82","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#troubleshooting","content":"For a **Failed** server, rule out runtime-environment or port problems first, then click\n**Start**.","locale":"en"},"6897":{"id":"/en/docs/settings-api-servers-83","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#troubleshooting","content":"<Card title=\"Application and Runtime Environment\" href=\"/docs/troubleshooting-app-runtime\" description=\"Troubleshoot application startup, Python, Micromamba, and Git.\" />","locale":"en"},"6898":{"id":"/en/docs/settings-api-servers-84","page_id":"/en/docs/settings-api-servers","tags":[],"type":"text","url":"/en/docs/settings-api-servers#troubleshooting","content":"<Card title=\"Logs, Diagnostics, and Getting Help\" href=\"/docs/troubleshooting-reporting\" description=\"Extract the core error and prepare material maintainers can analyze.\" />","locale":"en"},"6899":{"id":"/en/docs/settings-appearance","page_id":"/en/docs/settings-appearance","type":"page","content":"Appearance","breadcrumbs":["Hanafubuki Documentation","Settings"],"tags":[],"url":"/en/docs/settings-appearance","locale":"en"},"6900":{"id":"/en/docs/settings-appearance-0","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance","content":"Configure the theme, accent color, wallpaper, and background effects.","locale":"en"},"6901":{"id":"/en/docs/settings-appearance-1","page_id":"/en/docs/settings-appearance","type":"heading","tags":[],"url":"/en/docs/settings-appearance#theme-and-accent-color","content":"Theme and accent color","locale":"en"},"6902":{"id":"/en/docs/settings-appearance-2","page_id":"/en/docs/settings-appearance","type":"heading","tags":[],"url":"/en/docs/settings-appearance#adding-and-selecting-wallpaper","content":"Adding and selecting wallpaper","locale":"en"},"6903":{"id":"/en/docs/settings-appearance-3","page_id":"/en/docs/settings-appearance","type":"heading","tags":[],"url":"/en/docs/settings-appearance#import-images","content":"Import images","locale":"en"},"6904":{"id":"/en/docs/settings-appearance-4","page_id":"/en/docs/settings-appearance","type":"heading","tags":[],"url":"/en/docs/settings-appearance#check-import-results","content":"Check import results","locale":"en"},"6905":{"id":"/en/docs/settings-appearance-5","page_id":"/en/docs/settings-appearance","type":"heading","tags":[],"url":"/en/docs/settings-appearance#select-wallpaper","content":"Select wallpaper","locale":"en"},"6906":{"id":"/en/docs/settings-appearance-6","page_id":"/en/docs/settings-appearance","type":"heading","tags":[],"url":"/en/docs/settings-appearance#choose-fixed-or-random-wallpaper","content":"Choose fixed or random wallpaper","locale":"en"},"6907":{"id":"/en/docs/settings-appearance-7","page_id":"/en/docs/settings-appearance","type":"heading","tags":[],"url":"/en/docs/settings-appearance#adjusting-background-effects","content":"Adjusting background effects","locale":"en"},"6908":{"id":"/en/docs/settings-appearance-8","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance","content":"Appearance settings affect only the interface. They do not modify instances, models, or the runtime. Theme and background changes apply immediately, so you can assess readability as you make adjustments.","locale":"en"},"6909":{"id":"/en/docs/settings-appearance-9","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#theme-and-accent-color","content":"The theme can **Follow system**, use **Light**, or use **Dark**. Follow system uses the operating system's current light or dark mode. A fixed theme is useful when the system theme changes often but you want the application to remain consistent.","locale":"en"},"6910":{"id":"/en/docs/settings-appearance-10","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#theme-and-accent-color","content":"The accent color is used for buttons, selections, and emphasis. Select a preset swatch or open **Custom colour** to adjust hue, saturation, and brightness. You can also enter a hex value such as `#4c8df6` and press `Enter`. **Reset appearance** at the bottom restores the default theme and background settings and keeps your wallpaper library.","locale":"en"},"6911":{"id":"/en/docs/settings-appearance-11","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#import-images","content":"Click **Add wallpapers…** and select one or more images. You can also drag images from the system file manager into the wallpaper area. The application copies usable images into its own appearance-resources directory.","locale":"en"},"6912":{"id":"/en/docs/settings-appearance-12","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#check-import-results","content":"Wait for the thumbnails and image dimensions to appear. If some files fail, the page lists their filenames and errors while preserving the other successfully imported images.","locale":"en"},"6913":{"id":"/en/docs/settings-appearance-13","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#select-wallpaper","content":"Click a thumbnail to select it, then enable **Show background image**. If a resource has been lost, its entry is marked as missing and cannot be used as a valid background.","locale":"en"},"6914":{"id":"/en/docs/settings-appearance-14","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#choose-fixed-or-random-wallpaper","content":"With the background image enabled and at least two available wallpapers, you can turn on **Random wallpaper**. The application picks an image at each startup. **Showing now** marks the one used this time. Turn random mode off to return to your selected wallpaper.","locale":"en"},"6915":{"id":"/en/docs/settings-appearance-15","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#choose-fixed-or-random-wallpaper","content":"Deleting an individual wallpaper or confirming **Remove all** removes the application's copies. The original images stay where you imported them from, and you can move the originals after import.","locale":"en"},"6916":{"id":"/en/docs/settings-appearance-16","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#adjusting-background-effects","content":"Opacity and blur work even without a wallpaper. The image fit and position controls become available when a background image is enabled and available to display.","locale":"en"},"6917":{"id":"/en/docs/settings-appearance-17","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#adjusting-background-effects","content":"Setting","locale":"en"},"6918":{"id":"/en/docs/settings-appearance-18","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#adjusting-background-effects","content":"Recommendation","locale":"en"},"6919":{"id":"/en/docs/settings-appearance-19","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#adjusting-background-effects","content":"Interface opacity","locale":"en"},"6920":{"id":"/en/docs/settings-appearance-20","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#adjusting-background-effects","content":"Range: 40%–100%; lower values reveal more wallpaper","locale":"en"},"6921":{"id":"/en/docs/settings-appearance-21","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#adjusting-background-effects","content":"Glass blur","locale":"en"},"6922":{"id":"/en/docs/settings-appearance-22","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#adjusting-background-effects","content":"Range: 0–32; set to 0 to disable blur","locale":"en"},"6923":{"id":"/en/docs/settings-appearance-23","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#adjusting-background-effects","content":"Cover","locale":"en"},"6924":{"id":"/en/docs/settings-appearance-24","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#adjusting-background-effects","content":"Fills the window and may crop image edges","locale":"en"},"6925":{"id":"/en/docs/settings-appearance-25","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#adjusting-background-effects","content":"Contain","locale":"en"},"6926":{"id":"/en/docs/settings-appearance-26","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#adjusting-background-effects","content":"Shows the complete image and may leave empty areas when aspect ratios differ","locale":"en"},"6927":{"id":"/en/docs/settings-appearance-27","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#adjusting-background-effects","content":"Stretch","locale":"en"},"6928":{"id":"/en/docs/settings-appearance-28","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#adjusting-background-effects","content":"Fills the window exactly and may distort the image; **Image position** has no effect","locale":"en"},"6929":{"id":"/en/docs/settings-appearance-29","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#adjusting-background-effects","content":"Image position","locale":"en"},"6930":{"id":"/en/docs/settings-appearance-30","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#adjusting-background-effects","content":"Determines which area is prioritized when Cover crops or Contain leaves empty space","locale":"en"},"6931":{"id":"/en/docs/settings-appearance-31","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#adjusting-background-effects","content":"Increase interface opacity or blur for high-contrast or visually detailed wallpaper. After\nconfiguring it, check text, errors, and status notices on at least the Home page, settings window,\ninstance management, and dialogs.","locale":"en"},"6932":{"id":"/en/docs/settings-appearance-32","page_id":"/en/docs/settings-appearance","tags":[],"type":"text","url":"/en/docs/settings-appearance#adjusting-background-effects","content":"If wallpaper fails to display, first confirm that the entry is not marked **Missing**, then try importing it again. Do not directly edit wallpaper files in the application data directory; the resource record may remain after the file becomes unusable.","locale":"en"},"6933":{"id":"/en/docs/settings-automation","page_id":"/en/docs/settings-automation","type":"page","content":"Automation","breadcrumbs":["Hanafubuki Documentation","Settings"],"tags":[],"url":"/en/docs/settings-automation","locale":"en"},"6934":{"id":"/en/docs/settings-automation-0","page_id":"/en/docs/settings-automation","tags":[],"type":"text","url":"/en/docs/settings-automation","content":"Choose which background jobs the application runs on its own.","locale":"en"},"6935":{"id":"/en/docs/settings-automation-1","page_id":"/en/docs/settings-automation","type":"heading","tags":[],"url":"/en/docs/settings-automation#when-the-daily-jobs-run","content":"When the daily jobs run","locale":"en"},"6936":{"id":"/en/docs/settings-automation-2","page_id":"/en/docs/settings-automation","type":"heading","tags":[],"url":"/en/docs/settings-automation#snapshots-and-update-checks-wait-for-each-other","content":"Snapshots and update checks wait for each other","locale":"en"},"6937":{"id":"/en/docs/settings-automation-3","page_id":"/en/docs/settings-automation","tags":[],"type":"text","url":"/en/docs/settings-automation","content":"**Settings → Automation** has one switch for each job the application runs on its own. All four are on by default. A switch stops only the automatic run: checking for updates or creating a snapshot yourself works the same either way. A change takes effect within about a minute, without restarting.","locale":"en"},"6938":{"id":"/en/docs/settings-automation-4","page_id":"/en/docs/settings-automation","tags":[],"type":"text","url":"/en/docs/settings-automation","content":"Switch","locale":"en"},"6939":{"id":"/en/docs/settings-automation-5","page_id":"/en/docs/settings-automation","tags":[],"type":"text","url":"/en/docs/settings-automation","content":"What runs automatically","locale":"en"},"6940":{"id":"/en/docs/settings-automation-6","page_id":"/en/docs/settings-automation","tags":[],"type":"text","url":"/en/docs/settings-automation","content":"Check for application updates automatically","locale":"en"},"6941":{"id":"/en/docs/settings-automation-7","page_id":"/en/docs/settings-automation","tags":[],"type":"text","url":"/en/docs/settings-automation","content":"About once an hour, the application checks for a newer version of itself. See About and Updates.","locale":"en"},"6942":{"id":"/en/docs/settings-automation-8","page_id":"/en/docs/settings-automation","tags":[],"type":"text","url":"/en/docs/settings-automation","content":"Check instances for updates daily","locale":"en"},"6943":{"id":"/en/docs/settings-automation-9","page_id":"/en/docs/settings-automation","tags":[],"type":"text","url":"/en/docs/settings-automation","content":"Checks ready built-in WebUIs for kernel, extension, and PyTorch updates. Results appear on the instance card and in Versions. Extension types that support update checks join once their backend is running. Their results appear beside **Update** in Maintenance.","locale":"en"},"6944":{"id":"/en/docs/settings-automation-10","page_id":"/en/docs/settings-automation","tags":[],"type":"text","url":"/en/docs/settings-automation","content":"Create instance snapshots daily","locale":"en"},"6945":{"id":"/en/docs/settings-automation-11","page_id":"/en/docs/settings-automation","tags":[],"type":"text","url":"/en/docs/settings-automation","content":"Saves one snapshot with packages per day for each ready built-in WebUI. Extension-provided types do not take part in automatic snapshots. See Snapshot Management.","locale":"en"},"6946":{"id":"/en/docs/settings-automation-12","page_id":"/en/docs/settings-automation","tags":[],"type":"text","url":"/en/docs/settings-automation","content":"Check extensions for updates daily","locale":"en"},"6947":{"id":"/en/docs/settings-automation-13","page_id":"/en/docs/settings-automation","tags":[],"type":"text","url":"/en/docs/settings-automation","content":"Once a day, every installed extension that publishes its versions is checked for a newer one; nothing is installed. See Extensions.","locale":"en"},"6948":{"id":"/en/docs/settings-automation-14","page_id":"/en/docs/settings-automation","tags":[],"type":"text","url":"/en/docs/settings-automation","content":"The portable application skips the hourly application update check. Its Launcher checks for updates at startup. Daily instance and extension jobs still run.","locale":"en"},"6949":{"id":"/en/docs/settings-automation-15","page_id":"/en/docs/settings-automation","tags":[],"type":"text","url":"/en/docs/settings-automation#when-the-daily-jobs-run","content":"The daily jobs start shortly after the application starts, once per calendar day. If the application stays open past midnight, the next day's jobs start on their own.","locale":"en"},"6950":{"id":"/en/docs/settings-automation-16","page_id":"/en/docs/settings-automation","tags":[],"type":"text","url":"/en/docs/settings-automation#when-the-daily-jobs-run","content":"Each job is tracked separately. A job that finished today does not run again until tomorrow, and a job you switch on during the day runs the same day. If you close the application while a daily job is running, it continues on the next start that day with the instances it had not reached.","locale":"en"},"6951":{"id":"/en/docs/settings-automation-17","page_id":"/en/docs/settings-automation","tags":[],"type":"text","url":"/en/docs/settings-automation#when-the-daily-jobs-run","content":"An automatic snapshot that fails appears in Task Center like any other snapshot task. That day's update check for the instance still runs.","locale":"en"},"6952":{"id":"/en/docs/settings-automation-18","page_id":"/en/docs/settings-automation","tags":[],"type":"text","url":"/en/docs/settings-automation#snapshots-and-update-checks-wait-for-each-other","content":"On one instance, an update check and a snapshot never run at the same time. Whichever is requested second waits until the first finishes:","locale":"en"},"6953":{"id":"/en/docs/settings-automation-19","page_id":"/en/docs/settings-automation","tags":[],"type":"text","url":"/en/docs/settings-automation#snapshots-and-update-checks-wait-for-each-other","content":"With both daily jobs on, each instance's snapshot is taken before its update check.","locale":"en"},"6954":{"id":"/en/docs/settings-automation-20","page_id":"/en/docs/settings-automation","tags":[],"type":"text","url":"/en/docs/settings-automation#snapshots-and-update-checks-wait-for-each-other","content":"A check you start from the instance card while that instance is being snapshotted waits for the snapshot. The card shows **Waiting for snapshot…** until the check begins.","locale":"en"},"6955":{"id":"/en/docs/settings-automation-21","page_id":"/en/docs/settings-automation","tags":[],"type":"text","url":"/en/docs/settings-automation#snapshots-and-update-checks-wait-for-each-other","content":"The daily jobs pass over an instance that is busy with a snapshot or a check, and come back to it once it is free.","locale":"en"},"6956":{"id":"/en/docs/settings-automation-22","page_id":"/en/docs/settings-automation","tags":[],"type":"text","url":"/en/docs/settings-automation#snapshots-and-update-checks-wait-for-each-other","content":"Different instances never wait for one another.","locale":"en"},"6957":{"id":"/en/docs/settings-automation-23","page_id":"/en/docs/settings-automation","tags":[],"type":"text","url":"/en/docs/settings-automation#snapshots-and-update-checks-wait-for-each-other","content":"A job already running on an instance finishes, and the instances it had not reached are skipped. A\nsnapshot is not stopped partway, so no incomplete snapshot is left behind.","locale":"en"},"6958":{"id":"/en/docs/settings-diagnostics","page_id":"/en/docs/settings-diagnostics","type":"page","content":"Diagnostics","breadcrumbs":["Hanafubuki Documentation","Settings"],"tags":[],"url":"/en/docs/settings-diagnostics","locale":"en"},"6959":{"id":"/en/docs/settings-diagnostics-0","page_id":"/en/docs/settings-diagnostics","tags":[],"type":"text","url":"/en/docs/settings-diagnostics","content":"Generate, inspect, and export application-level diagnostic bundles.","locale":"en"},"6960":{"id":"/en/docs/settings-diagnostics-1","page_id":"/en/docs/settings-diagnostics","type":"heading","tags":[],"url":"/en/docs/settings-diagnostics#generating-application-diagnostics","content":"Generating application diagnostics","locale":"en"},"6961":{"id":"/en/docs/settings-diagnostics-2","page_id":"/en/docs/settings-diagnostics","type":"heading","tags":[],"url":"/en/docs/settings-diagnostics#whether-to-include-all-instances","content":"Whether to include all instances","locale":"en"},"6962":{"id":"/en/docs/settings-diagnostics-3","page_id":"/en/docs/settings-diagnostics","type":"heading","tags":[],"url":"/en/docs/settings-diagnostics#what-a-diagnostic-bundle-contains","content":"What a diagnostic bundle contains","locale":"en"},"6963":{"id":"/en/docs/settings-diagnostics-4","page_id":"/en/docs/settings-diagnostics","tags":[],"type":"text","url":"/en/docs/settings-diagnostics","content":"Application diagnostics are suited to initial-startup, runtime-preparation, cross-instance task, Agent, and platform problems. For an environment or maintenance problem affecting one instance, first generate a smaller bundle from Instance Diagnostics in instance management.","locale":"en"},"6964":{"id":"/en/docs/settings-diagnostics-5","page_id":"/en/docs/settings-diagnostics","tags":[],"type":"text","url":"/en/docs/settings-diagnostics#generating-application-diagnostics","content":"Reproduce the problem first and record when it happened, the operation, and the related\ninstance.","locale":"en"},"6965":{"id":"/en/docs/settings-diagnostics-6","page_id":"/en/docs/settings-diagnostics","tags":[],"type":"text","url":"/en/docs/settings-diagnostics#generating-application-diagnostics","content":"Open **Settings → Diagnostics** and decide whether to enable **Include all instances in\napplication diagnostics**.","locale":"en"},"6966":{"id":"/en/docs/settings-diagnostics-7","page_id":"/en/docs/settings-diagnostics","tags":[],"type":"text","url":"/en/docs/settings-diagnostics#generating-application-diagnostics","content":"Click **Start collection** and watch progress in the lower-right corner of the settings window.\nSwitching sections does not cancel collection.","locale":"en"},"6967":{"id":"/en/docs/settings-diagnostics-8","page_id":"/en/docs/settings-diagnostics","tags":[],"type":"text","url":"/en/docs/settings-diagnostics#generating-application-diagnostics","content":"After the task finishes, refresh the list and inspect the filename, creation time, size, and\nissue count.","locale":"en"},"6968":{"id":"/en/docs/settings-diagnostics-9","page_id":"/en/docs/settings-diagnostics","tags":[],"type":"text","url":"/en/docs/settings-diagnostics#generating-application-diagnostics","content":"Click **Export** to save a copy to a chosen location, or **Open folder** to view the original\nZIP stored by the application.","locale":"en"},"6969":{"id":"/en/docs/settings-diagnostics-10","page_id":"/en/docs/settings-diagnostics","tags":[],"type":"text","url":"/en/docs/settings-diagnostics#whether-to-include-all-instances","content":"When enabled, the application freezes an instance list at the start of collection and processes each instance in order. Instances created during collection are not appended. If an instance is inaccessible, undergoing maintenance, or has been replaced, the diagnostic manifest records the issue without discarding other content already collected.","locale":"en"},"6970":{"id":"/en/docs/settings-diagnostics-11","page_id":"/en/docs/settings-diagnostics","tags":[],"type":"text","url":"/en/docs/settings-diagnostics#whether-to-include-all-instances","content":"When disabled, the application bundle collects only application-level configuration, logs, status, non-credential Agent data, application tasks, and similar content. It is faster to generate and smaller.","locale":"en"},"6971":{"id":"/en/docs/settings-diagnostics-12","page_id":"/en/docs/settings-diagnostics","tags":[],"type":"text","url":"/en/docs/settings-diagnostics#what-a-diagnostic-bundle-contains","content":"Application diagnostics usually include:","locale":"en"},"6972":{"id":"/en/docs/settings-diagnostics-13","page_id":"/en/docs/settings-diagnostics","tags":[],"type":"text","url":"/en/docs/settings-diagnostics#what-a-diagnostic-bundle-contains","content":"Current global settings and the configuration directory.","locale":"en"},"6973":{"id":"/en/docs/settings-diagnostics-14","page_id":"/en/docs/settings-diagnostics","tags":[],"type":"text","url":"/en/docs/settings-diagnostics#what-a-diagnostic-bundle-contains","content":"File logs and the in-memory log for the current run.","locale":"en"},"6974":{"id":"/en/docs/settings-diagnostics-15","page_id":"/en/docs/settings-diagnostics","tags":[],"type":"text","url":"/en/docs/settings-diagnostics#what-a-diagnostic-bundle-contains","content":"Application state, task activity, and diagnostics status.","locale":"en"},"6975":{"id":"/en/docs/settings-diagnostics-16","page_id":"/en/docs/settings-diagnostics","tags":[],"type":"text","url":"/en/docs/settings-diagnostics#what-a-diagnostic-bundle-contains","content":"Agent history, memory, and non-sensitive Skill state.","locale":"en"},"6976":{"id":"/en/docs/settings-diagnostics-17","page_id":"/en/docs/settings-diagnostics","tags":[],"type":"text","url":"/en/docs/settings-diagnostics#what-a-diagnostic-bundle-contains","content":"When instance collection is enabled, instance snapshots, environment reports, tasks, and runtime state.","locale":"en"},"6977":{"id":"/en/docs/settings-diagnostics-18","page_id":"/en/docs/settings-diagnostics","tags":[],"type":"text","url":"/en/docs/settings-diagnostics#what-a-diagnostic-bundle-contains","content":"For a module failure, compare the current state in `app/modules.json` with the fault history in `app/module-faults.json`. The Agent and its plugins report their status in `app/agent-status.json` and `app/agent-plugins.json`. An extension that provides diagnostics can include reports under `app/extensions/<extension-id>/`. If an item could not be collected, `manifest.json` records the reason. You can still inspect the files collected successfully.","locale":"en"},"6978":{"id":"/en/docs/settings-diagnostics-19","page_id":"/en/docs/settings-diagnostics","tags":[],"type":"text","url":"/en/docs/settings-diagnostics#what-a-diagnostic-bundle-contains","content":"Provider credential documents and MCP credential documents are excluded in their entirety, but other content is not automatically masked or rewritten. Paths, environment variables, commands, output, tokens, or user data may still appear in other raw sources.","locale":"en"},"6979":{"id":"/en/docs/settings-diagnostics-20","page_id":"/en/docs/settings-diagnostics","tags":[],"type":"text","url":"/en/docs/settings-diagnostics#what-a-diagnostic-bundle-contains","content":"Before sharing, extract the ZIP and inspect `manifest.json`, logs, environment reports, and task\noutput. Remove or mask anything that should not be public, and send the bundle only to a trusted\nrecipient.","locale":"en"},"6980":{"id":"/en/docs/settings-diagnostics-21","page_id":"/en/docs/settings-diagnostics","tags":[],"type":"text","url":"/en/docs/settings-diagnostics#what-a-diagnostic-bundle-contains","content":"Diagnostic ZIP files have no automatic retention period and are not deleted by the log-retention policy. Once they are no longer needed, remove old files from the application diagnostics directory with the system file manager.","locale":"en"},"6981":{"id":"/en/docs/settings-environment-tools","page_id":"/en/docs/settings-environment-tools","type":"page","content":"Environment Tools","breadcrumbs":["Hanafubuki Documentation","Settings"],"tags":[],"url":"/en/docs/settings-environment-tools","locale":"en"},"6982":{"id":"/en/docs/settings-environment-tools-0","page_id":"/en/docs/settings-environment-tools","tags":[],"type":"text","url":"/en/docs/settings-environment-tools","content":"Configure uv, pre-launch environment checks, and CUDA memory optimization.","locale":"en"},"6983":{"id":"/en/docs/settings-environment-tools-1","page_id":"/en/docs/settings-environment-tools","type":"heading","tags":[],"url":"/en/docs/settings-environment-tools#enabling-uv","content":"Enabling uv","locale":"en"},"6984":{"id":"/en/docs/settings-environment-tools-2","page_id":"/en/docs/settings-environment-tools","type":"heading","tags":[],"url":"/en/docs/settings-environment-tools#enabling-environment-checks","content":"Enabling environment checks","locale":"en"},"6985":{"id":"/en/docs/settings-environment-tools-3","page_id":"/en/docs/settings-environment-tools","type":"heading","tags":[],"url":"/en/docs/settings-environment-tools#enabling-cuda-memory-optimization","content":"Enabling CUDA memory optimization","locale":"en"},"6986":{"id":"/en/docs/settings-environment-tools-4","page_id":"/en/docs/settings-environment-tools","type":"heading","tags":[],"url":"/en/docs/settings-environment-tools#changing-and-verifying-settings","content":"Changing and verifying settings","locale":"en"},"6987":{"id":"/en/docs/settings-environment-tools-5","page_id":"/en/docs/settings-environment-tools","tags":[],"type":"text","url":"/en/docs/settings-environment-tools","content":"Environment tools determine how installation flows and WebUI startup use an instance's Python. They do not select the application Python version and do not replace PyTorch, extension, or version operations in instance management.","locale":"en"},"6988":{"id":"/en/docs/settings-environment-tools-6","page_id":"/en/docs/settings-environment-tools","tags":[],"type":"text","url":"/en/docs/settings-environment-tools#enabling-uv","content":"When enabled, supported Python package installations use uv instead of pip and are usually faster. If an installation script or non-standard package is incompatible with uv, temporarily disable it and retry the same operation.","locale":"en"},"6989":{"id":"/en/docs/settings-environment-tools-7","page_id":"/en/docs/settings-environment-tools","tags":[],"type":"text","url":"/en/docs/settings-environment-tools#enabling-uv","content":"Disabling uv does not uninstall installed packages or automatically restore a previous environment. It only changes the tool used by subsequent installation commands.","locale":"en"},"6990":{"id":"/en/docs/settings-environment-tools-8","page_id":"/en/docs/settings-environment-tools","tags":[],"type":"text","url":"/en/docs/settings-environment-tools#enabling-environment-checks","content":"When enabled, the application checks and repairs WebUI dependencies before launch. Keep it enabled after first launch, a Core update, snapshot restoration, or dependency changes.","locale":"en"},"6991":{"id":"/en/docs/settings-environment-tools-9","page_id":"/en/docs/settings-environment-tools","tags":[],"type":"text","url":"/en/docs/settings-environment-tools#enabling-environment-checks","content":"For built-in WebUIs, the PyTorch compatibility check runs before this step. Even with environment checks off, an incompatible result asks whether to continue. If compatibility cannot be determined, startup continues with a warning.","locale":"en"},"6992":{"id":"/en/docs/settings-environment-tools-10","page_id":"/en/docs/settings-environment-tools","tags":[],"type":"text","url":"/en/docs/settings-environment-tools#enabling-cuda-memory-optimization","content":"This option requests the CUDA asynchronous memory allocator when launching a WebUI:","locale":"en"},"6993":{"id":"/en/docs/settings-environment-tools-11","page_id":"/en/docs/settings-environment-tools","tags":[],"type":"text","url":"/en/docs/settings-environment-tools#enabling-cuda-memory-optimization","content":"It takes effect only in NVIDIA environments that support the capability.","locale":"en"},"6994":{"id":"/en/docs/settings-environment-tools-12","page_id":"/en/docs/settings-environment-tools","tags":[],"type":"text","url":"/en/docs/settings-environment-tools#enabling-cuda-memory-optimization","content":"AMD, Intel, Apple, and CPU environments ignore it.","locale":"en"},"6995":{"id":"/en/docs/settings-environment-tools-13","page_id":"/en/docs/settings-environment-tools","tags":[],"type":"text","url":"/en/docs/settings-environment-tools#enabling-cuda-memory-optimization","content":"Some older drivers, CUDA versions, or particular WebUI combinations may be incompatible.","locale":"en"},"6996":{"id":"/en/docs/settings-environment-tools-14","page_id":"/en/docs/settings-environment-tools","tags":[],"type":"text","url":"/en/docs/settings-environment-tools#enabling-cuda-memory-optimization","content":"If a CUDA allocator error occurs during startup, disable this option and relaunch the instance for comparison. Do not change PyTorch and several launch arguments at the same time.","locale":"en"},"6997":{"id":"/en/docs/settings-environment-tools-15","page_id":"/en/docs/settings-environment-tools","tags":[],"type":"text","url":"/en/docs/settings-environment-tools#changing-and-verifying-settings","content":"Change only one of uv, environment checks, or CUDA optimization at a time. Switches save\nautomatically.","locale":"en"},"6998":{"id":"/en/docs/settings-environment-tools-16","page_id":"/en/docs/settings-environment-tools","tags":[],"type":"text","url":"/en/docs/settings-environment-tools#changing-and-verifying-settings","content":"Stop and restart the relevant WebUI so the new startup or installation plan reads the setting.","locale":"en"},"6999":{"id":"/en/docs/settings-environment-tools-17","page_id":"/en/docs/settings-environment-tools","tags":[],"type":"text","url":"/en/docs/settings-environment-tools#changing-and-verifying-settings","content":"Check task output for a change in the installation tool, environment check, or CUDA error.","locale":"en"},"7000":{"id":"/en/docs/settings-environment-tools-18","page_id":"/en/docs/settings-environment-tools","tags":[],"type":"text","url":"/en/docs/settings-environment-tools#changing-and-verifying-settings","content":"If there is no improvement, restore the default and continue inspecting instance dependencies or\nthe GPU environment.","locale":"en"},"7001":{"id":"/en/docs/settings-environment-tools-19","page_id":"/en/docs/settings-environment-tools","tags":[],"type":"text","url":"/en/docs/settings-environment-tools#changing-and-verifying-settings","content":"Environment tools are application-level settings. A change can affect every instance that later\nruns a related flow, so do not leave a necessary check disabled indefinitely to solve a problem in\none instance.","locale":"en"},"7002":{"id":"/en/docs/settings-extensions","page_id":"/en/docs/settings-extensions","type":"page","content":"Extensions","breadcrumbs":["Hanafubuki Documentation","Settings"],"tags":[],"url":"/en/docs/settings-extensions","locale":"en"},"7003":{"id":"/en/docs/settings-extensions-0","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions","content":"Install, turn on, update, and uninstall Hanafubuki extensions, and understand their permissions, dependencies, backend states, and what happens to their instances when they are off.","locale":"en"},"7004":{"id":"/en/docs/settings-extensions-1","page_id":"/en/docs/settings-extensions","type":"heading","tags":[],"url":"/en/docs/settings-extensions#what-an-extension-can-add","content":"What an extension can add","locale":"en"},"7005":{"id":"/en/docs/settings-extensions-2","page_id":"/en/docs/settings-extensions","type":"heading","tags":[],"url":"/en/docs/settings-extensions#the-marketplace","content":"The marketplace","locale":"en"},"7006":{"id":"/en/docs/settings-extensions-3","page_id":"/en/docs/settings-extensions","type":"heading","tags":[],"url":"/en/docs/settings-extensions#installing-an-extension","content":"Installing an extension","locale":"en"},"7007":{"id":"/en/docs/settings-extensions-4","page_id":"/en/docs/settings-extensions","type":"heading","tags":[],"url":"/en/docs/settings-extensions#the-confirmation","content":"The confirmation","locale":"en"},"7008":{"id":"/en/docs/settings-extensions-5","page_id":"/en/docs/settings-extensions","type":"heading","tags":[],"url":"/en/docs/settings-extensions#permissions","content":"Permissions","locale":"en"},"7009":{"id":"/en/docs/settings-extensions-6","page_id":"/en/docs/settings-extensions","type":"heading","tags":[],"url":"/en/docs/settings-extensions#turning-extensions-on-and-off","content":"Turning extensions on and off","locale":"en"},"7010":{"id":"/en/docs/settings-extensions-7","page_id":"/en/docs/settings-extensions","type":"heading","tags":[],"url":"/en/docs/settings-extensions#states","content":"States","locale":"en"},"7011":{"id":"/en/docs/settings-extensions-8","page_id":"/en/docs/settings-extensions","type":"heading","tags":[],"url":"/en/docs/settings-extensions#dependencies-and-compatibility","content":"Dependencies and compatibility","locale":"en"},"7012":{"id":"/en/docs/settings-extensions-9","page_id":"/en/docs/settings-extensions","type":"heading","tags":[],"url":"/en/docs/settings-extensions#updating","content":"Updating","locale":"en"},"7013":{"id":"/en/docs/settings-extensions-10","page_id":"/en/docs/settings-extensions","type":"heading","tags":[],"url":"/en/docs/settings-extensions#checking-for-updates","content":"Checking for updates","locale":"en"},"7014":{"id":"/en/docs/settings-extensions-11","page_id":"/en/docs/settings-extensions","type":"heading","tags":[],"url":"/en/docs/settings-extensions#uninstalling","content":"Uninstalling","locale":"en"},"7015":{"id":"/en/docs/settings-extensions-12","page_id":"/en/docs/settings-extensions","type":"heading","tags":[],"url":"/en/docs/settings-extensions#extension-settings-panels-and-views","content":"Extension settings, panels, and views","locale":"en"},"7016":{"id":"/en/docs/settings-extensions-13","page_id":"/en/docs/settings-extensions","type":"heading","tags":[],"url":"/en/docs/settings-extensions#instances-of-an-extensions-types-when-it-is-off","content":"Instances of an extension's types when it is off","locale":"en"},"7017":{"id":"/en/docs/settings-extensions-14","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions","content":"Extensions are packages installed into Hanafubuki itself. They can add instance types, settings sections, interface panels, and translated text to the application, and some also run a program of their own beside it, called a **backend**. Install and manage them in the **Extensions** section of the Settings window. Its **Installed** tab lists the extensions installed here. The row at the top of the tab, the search box with **Check for Updates** and **Install extension** beside it, stays in place while the list scrolls; the search finds extensions by name, ID, publisher, or description.","locale":"en"},"7018":{"id":"/en/docs/settings-extensions-15","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions","content":"This page covers extensions of the Hanafubuki application. For plugins, nodes, and similar add-ons\ninstalled into a WebUI instance, see Extension Management.","locale":"en"},"7019":{"id":"/en/docs/settings-extensions-16","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#what-an-extension-can-add","content":"Contribution","locale":"en"},"7020":{"id":"/en/docs/settings-extensions-17","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#what-an-extension-can-add","content":"Where it appears","locale":"en"},"7021":{"id":"/en/docs/settings-extensions-18","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#what-an-extension-can-add","content":"Instance types","locale":"en"},"7022":{"id":"/en/docs/settings-extensions-19","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#what-an-extension-can-add","content":"WebUI types to choose from in a new installation; the extension describes how they install, start, and are managed","locale":"en"},"7023":{"id":"/en/docs/settings-extensions-20","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#what-an-extension-can-add","content":"Install presets","locale":"en"},"7024":{"id":"/en/docs/settings-extensions-21","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#what-an-extension-can-add","content":"Choose a preset under its type in a new installation to fill in values you can still edit","locale":"en"},"7025":{"id":"/en/docs/settings-extensions-22","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#what-an-extension-can-add","content":"Settings","locale":"en"},"7026":{"id":"/en/docs/settings-extensions-23","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#what-an-extension-can-add","content":"A section of the Settings window named after the extension, after the application's own sections","locale":"en"},"7027":{"id":"/en/docs/settings-extensions-24","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#what-an-extension-can-add","content":"Panels and views","locale":"en"},"7028":{"id":"/en/docs/settings-extensions-25","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#what-an-extension-can-add","content":"Sections in Settings or on the management pages of its types' instances, and standalone views in the title bar's extension pages menu","locale":"en"},"7029":{"id":"/en/docs/settings-extensions-26","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#what-an-extension-can-add","content":"Agent content","locale":"en"},"7030":{"id":"/en/docs/settings-extensions-27","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#what-an-extension-can-add","content":"Skills and MCP servers for the built-in Agent, subject to the Agent's tool approval settings","locale":"en"},"7031":{"id":"/en/docs/settings-extensions-28","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#what-an-extension-can-add","content":"Management tools","locale":"en"},"7032":{"id":"/en/docs/settings-extensions-29","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#what-an-extension-can-add","content":"Tools the extension publishes on Hanafubuki's management MCP server for the built-in Agent and authorized external clients to discover","locale":"en"},"7033":{"id":"/en/docs/settings-extensions-30","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#what-an-extension-can-add","content":"Text","locale":"en"},"7034":{"id":"/en/docs/settings-extensions-31","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#what-an-extension-can-add","content":"The extension's own English and Chinese text, following the application's language","locale":"en"},"7035":{"id":"/en/docs/settings-extensions-32","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#what-an-extension-can-add","content":"Backend (optional)","locale":"en"},"7036":{"id":"/en/docs/settings-extensions-33","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#what-an-extension-can-add","content":"A program that runs in the background while the extension is on and supplies data and actions for the above","locale":"en"},"7037":{"id":"/en/docs/settings-extensions-34","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#what-an-extension-can-add","content":"A **data-only** extension has no resident backend. When you use one of its instance types, the application can still run install commands or start servers from the descriptor. The Agent can also launch a stdio MCP server the extension contributes.","locale":"en"},"7038":{"id":"/en/docs/settings-extensions-35","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#the-marketplace","content":"The **Marketplace** tab of the **Extensions** section lists extensions published in the extension registry, read through the application's network and proxy settings. If the GitHub registry cannot be fetched or decoded, the app tries the Gitee mirror. The page reports a load error only if both sources fail. The listing is kept for a while: opening the tab again within two minutes shows it without reading the registry again, and **Refresh** at the top of the page reads it now. The search box at the top of the tab, which stays in place while the list scrolls, finds entries by name, ID, author, or description. Each entry shows its ID, author, a link to its source, which opens in your browser, and its description, with how it stands here:","locale":"en"},"7039":{"id":"/en/docs/settings-extensions-36","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#the-marketplace","content":"Shown","locale":"en"},"7040":{"id":"/en/docs/settings-extensions-37","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#the-marketplace","content":"Meaning","locale":"en"},"7041":{"id":"/en/docs/settings-extensions-38","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#the-marketplace","content":"**Install**","locale":"en"},"7042":{"id":"/en/docs/settings-extensions-39","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#the-marketplace","content":"Not installed. Clicking it downloads the package and opens the same confirmation as any install (see below)","locale":"en"},"7043":{"id":"/en/docs/settings-extensions-40","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#the-marketplace","content":"**Installed v…**","locale":"en"},"7044":{"id":"/en/docs/settings-extensions-41","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#the-marketplace","content":"Installed, at that version; with **Update to …** when the last check found a newer one","locale":"en"},"7045":{"id":"/en/docs/settings-extensions-42","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#the-marketplace","content":"**Linked**","locale":"en"},"7046":{"id":"/en/docs/settings-extensions-43","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#the-marketplace","content":"Installed as a linked development folder","locale":"en"},"7047":{"id":"/en/docs/settings-extensions-44","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#the-marketplace","content":"Only the source link","locale":"en"},"7048":{"id":"/en/docs/settings-extensions-45","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#the-marketplace","content":"The registry names no package to install; see its source for how to get it","locale":"en"},"7049":{"id":"/en/docs/settings-extensions-46","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#the-marketplace","content":"When a marketplace entry names an update feed, the application selects the latest package for your OS and architecture and checks its SHA-256 if supplied. An unreadable feed or a feed with no compatible package produces an error. The application uses the entry's fixed download address only when the entry has no feed. The tab reports how many registry entries it skipped because it could not read them.","locale":"en"},"7050":{"id":"/en/docs/settings-extensions-47","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#installing-an-extension","content":"Choose a source and check the package before confirming installation.","locale":"en"},"7051":{"id":"/en/docs/settings-extensions-48","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#installing-an-extension","content":"Open the **Extensions** section of the Settings window and, on the **Installed** tab, click\n**Install extension**.","locale":"en"},"7052":{"id":"/en/docs/settings-extensions-49","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#installing-an-extension","content":"Under **Source**, choose one of the options below, then pick a local directory or archive file,\nor enter the archive URL.","locale":"en"},"7053":{"id":"/en/docs/settings-extensions-50","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#installing-an-extension","content":"Click **Check**. The application checks the staged package, or the source directory itself for a\nlinked folder. You can now review the package details before installing.","locale":"en"},"7054":{"id":"/en/docs/settings-extensions-51","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#installing-an-extension","content":"Read what the confirmation lists, then click **Install**. **Back** or closing the dialog\ndiscards the checked package.","locale":"en"},"7055":{"id":"/en/docs/settings-extensions-52","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#installing-an-extension","content":"Source","locale":"en"},"7056":{"id":"/en/docs/settings-extensions-53","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#installing-an-extension","content":"Notes","locale":"en"},"7057":{"id":"/en/docs/settings-extensions-54","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#installing-an-extension","content":"Folder","locale":"en"},"7058":{"id":"/en/docs/settings-extensions-55","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#installing-an-extension","content":"The folder's contents are copied, not linked; a folder that contains a symbolic link is refused","locale":"en"},"7059":{"id":"/en/docs/settings-extensions-56","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#installing-an-extension","content":"Linked folder","locale":"en"},"7060":{"id":"/en/docs/settings-extensions-57","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#installing-an-extension","content":"For local development. Choose the directory containing the manifest and check its path in the confirmation. The application reads it in place. Click **Reload** on the card after editing it. See Linking a folder while you work.","locale":"en"},"7061":{"id":"/en/docs/settings-extensions-58","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#installing-an-extension","content":"Archive","locale":"en"},"7062":{"id":"/en/docs/settings-extensions-59","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#installing-an-extension","content":"`.zip`, `.tar`, `.tar.gz`, `.tar.xz`, and `.tar.bz2`; the package may be wrapped in one directory","locale":"en"},"7063":{"id":"/en/docs/settings-extensions-60","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#installing-an-extension","content":"Link","locale":"en"},"7064":{"id":"/en/docs/settings-extensions-61","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#installing-an-extension","content":"`http` or `https` only, with no user name or password in it; the download goes through the application's network and proxy settings","locale":"en"},"7065":{"id":"/en/docs/settings-extensions-62","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#installing-an-extension","content":"A newly installed extension starts turned off; turn it on yourself. An extension that is already installed cannot be installed again: use **Update**. **Install** in the marketplace goes straight to the confirmation.","locale":"en"},"7066":{"id":"/en/docs/settings-extensions-63","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#the-confirmation","content":"The confirmation lists the extension's ID, version, publisher, SHA-256 digest (**None: installed from a folder** for a folder), the permissions it asks for, and why it cannot run here, if it cannot.","locale":"en"},"7067":{"id":"/en/docs/settings-extensions-64","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#the-confirmation","content":"The publisher name comes from the manifest. SHA-256 identifies the archive contents. The application does not verify the publisher's identity. For Agent contributions, the confirmation lists each Skill's ID and directory and each MCP server's ID, transport, and target (program path, runtime tool, or URL). It also shows if a Python backend requests access to the application's `sd_webui_all_in_one` library.","locale":"en"},"7068":{"id":"/en/docs/settings-extensions-65","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#permissions","content":"**Asks for** lists what an extension requests beyond the defaults:","locale":"en"},"7069":{"id":"/en/docs/settings-extensions-66","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#permissions","content":"Permission","locale":"en"},"7070":{"id":"/en/docs/settings-extensions-67","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#permissions","content":"Values","locale":"en"},"7071":{"id":"/en/docs/settings-extensions-68","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#permissions","content":"What the extension may ask the application for","locale":"en"},"7072":{"id":"/en/docs/settings-extensions-69","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#permissions","content":"Instances","locale":"en"},"7073":{"id":"/en/docs/settings-extensions-70","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#permissions","content":"`none` (default), `read`, `own-types`, `all`","locale":"en"},"7074":{"id":"/en/docs/settings-extensions-71","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#permissions","content":"`read` reads basic details of every instance; `own-types` reads and follows its own types' instances and their servers; `all` both","locale":"en"},"7075":{"id":"/en/docs/settings-extensions-72","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#permissions","content":"Processes","locale":"en"},"7076":{"id":"/en/docs/settings-extensions-73","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#permissions","content":"On or off","locale":"en"},"7077":{"id":"/en/docs/settings-extensions-74","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#permissions","content":"Running processes, preparing Python, and Git clone and pull through the application","locale":"en"},"7078":{"id":"/en/docs/settings-extensions-75","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#permissions","content":"Network","locale":"en"},"7079":{"id":"/en/docs/settings-extensions-76","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#permissions","content":"A list of host names (`*.example.com` matches subdomains)","locale":"en"},"7080":{"id":"/en/docs/settings-extensions-77","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#permissions","content":"Hosts for HTTP requests, downloads, and remote Git operations through the application. An Agent HTTP MCP server declared by the extension also needs a matching host.","locale":"en"},"7081":{"id":"/en/docs/settings-extensions-78","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#permissions","content":"Files","locale":"en"},"7082":{"id":"/en/docs/settings-extensions-79","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#permissions","content":"`extension-data` (default), `own-instances`","locale":"en"},"7083":{"id":"/en/docs/settings-extensions-80","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#permissions","content":"Directories for process working directories, Python installations, and Git operations. The latter grant also covers instances of the extension's own types. Host file downloads always go into extension data.","locale":"en"},"7084":{"id":"/en/docs/settings-extensions-81","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#permissions","content":"Add instances","locale":"en"},"7085":{"id":"/en/docs/settings-extensions-82","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#permissions","content":"On or off","locale":"en"},"7086":{"id":"/en/docs/settings-extensions-83","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#permissions","content":"Scan a directory and register discovered instances. Importing a particular type also requires `own-types` for the extension's types or `all` for any registered type.","locale":"en"},"7087":{"id":"/en/docs/settings-extensions-84","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#permissions","content":"Management tools","locale":"en"},"7088":{"id":"/en/docs/settings-extensions-85","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#permissions","content":"`none` (default), `read`, `confirm`","locale":"en"},"7089":{"id":"/en/docs/settings-extensions-86","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#permissions","content":"`read` permits read-only tools. With `confirm` the extension can also request changes, each of which requires your confirmation in the main window.","locale":"en"},"7090":{"id":"/en/docs/settings-extensions-87","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#permissions","content":"These permissions only limit what an extension can ask Hanafubuki to do. An extension with a\nbackend runs a program on your computer with your user's rights, and that program can use the\nnetwork and your files directly, whatever its permissions say. The confirmation shows this warning\nfor every extension with a backend. Install an extension only if you trust it.","locale":"en"},"7091":{"id":"/en/docs/settings-extensions-88","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#turning-extensions-on-and-off","content":"Each extension's card has a switch.","locale":"en"},"7092":{"id":"/en/docs/settings-extensions-89","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#turning-extensions-on-and-off","content":"**On**: the application registers the extension's instance types, settings, and panels, and starts its backend. If its dependencies are not met yet, the extension stays on but shows **Can't run**, and it runs by itself once they are.","locale":"en"},"7093":{"id":"/en/docs/settings-extensions-90","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#turning-extensions-on-and-off","content":"**Off**: the extensions that depend on it are turned off too, and running instances of its types are stopped first. In that case the card first asks **Turn off …?**, listing the extensions that will be turned off and the instances that will be stopped, and acts only after you click **Turn off**.","locale":"en"},"7094":{"id":"/en/docs/settings-extensions-91","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#states","content":"The badge on each card shows how the extension stands:","locale":"en"},"7095":{"id":"/en/docs/settings-extensions-92","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#states","content":"State","locale":"en"},"7096":{"id":"/en/docs/settings-extensions-93","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#states","content":"Meaning","locale":"en"},"7097":{"id":"/en/docs/settings-extensions-94","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#states","content":"Off","locale":"en"},"7098":{"id":"/en/docs/settings-extensions-95","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#states","content":"Installed but not turned on","locale":"en"},"7099":{"id":"/en/docs/settings-extensions-96","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#states","content":"Starting","locale":"en"},"7100":{"id":"/en/docs/settings-extensions-97","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#states","content":"Registering its contributions and starting its backend","locale":"en"},"7101":{"id":"/en/docs/settings-extensions-98","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#states","content":"On","locale":"en"},"7102":{"id":"/en/docs/settings-extensions-99","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#states","content":"Running normally","locale":"en"},"7103":{"id":"/en/docs/settings-extensions-100","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#states","content":"Failed","locale":"en"},"7104":{"id":"/en/docs/settings-extensions-101","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#states","content":"It failed to start or failed while running; the card shows why","locale":"en"},"7105":{"id":"/en/docs/settings-extensions-102","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#states","content":"Restarting","locale":"en"},"7106":{"id":"/en/docs/settings-extensions-103","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#states","content":"It failed and is waiting to restart automatically (after 2, 10, then 30 seconds; at most 3 times in 10 minutes)","locale":"en"},"7107":{"id":"/en/docs/settings-extensions-104","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#states","content":"Stopped after repeated crashes","locale":"en"},"7108":{"id":"/en/docs/settings-extensions-105","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#states","content":"Its backend failed to start, or exited before it had run for 30 seconds, 3 times in a row; it is not started automatically again, even after an app restart","locale":"en"},"7109":{"id":"/en/docs/settings-extensions-106","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#states","content":"Can't run","locale":"en"},"7110":{"id":"/en/docs/settings-extensions-107","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#states","content":"The extension or one of its dependencies does not meet what it needs to run; the card shows why (see Dependencies and compatibility)","locale":"en"},"7111":{"id":"/en/docs/settings-extensions-108","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#states","content":"Broken","locale":"en"},"7112":{"id":"/en/docs/settings-extensions-109","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#states","content":"The application cannot read its install record or its installed package; the card shows why. Usually uninstall it and install it again","locale":"en"},"7113":{"id":"/en/docs/settings-extensions-110","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#states","content":"If an extension shows **Restarting**, wait for the automatic restart. If it shows **Failed** or **Stopped after repeated crashes**, fix the cause and click **Retry** on its card. For a linked folder, use **Reload** to reread the source directory. For extensions with a backend, **View log** shows the most recent output (up to the last 256 KiB). Choose **Refresh** to read it again.","locale":"en"},"7114":{"id":"/en/docs/settings-extensions-111","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#dependencies-and-compatibility","content":"An extension may depend on other extensions. A turned-on extension shows **Can't run**, with the reason on its card, when:","locale":"en"},"7115":{"id":"/en/docs/settings-extensions-112","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#dependencies-and-compatibility","content":"the range of Hanafubuki versions it declares does not include this version;","locale":"en"},"7116":{"id":"/en/docs/settings-extensions-113","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#dependencies-and-compatibility","content":"it does not declare the extension API version it speaks, or declares one this version does not support;","locale":"en"},"7117":{"id":"/en/docs/settings-extensions-114","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#dependencies-and-compatibility","content":"its backend has no program for this operating system;","locale":"en"},"7118":{"id":"/en/docs/settings-extensions-115","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#dependencies-and-compatibility","content":"an extension it depends on is not installed, is of a version outside the required range, is turned off, or cannot run itself;","locale":"en"},"7119":{"id":"/en/docs/settings-extensions-116","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#dependencies-and-compatibility","content":"its dependencies and those of other extensions form a cycle.","locale":"en"},"7120":{"id":"/en/docs/settings-extensions-117","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#dependencies-and-compatibility","content":"Only the affected extension (and those that depend on it) cannot run; every other extension and the application carry on. A turned-off extension shows **Can't run** only for what is wrong with it alone.","locale":"en"},"7121":{"id":"/en/docs/settings-extensions-118","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#updating","content":"For an extension whose author publishes its versions, **Update** on its card is one click: the application checks that extension now and, when it finds a newer version, downloads it, checks it against the digest its author published, and opens the confirmation. When there is none, the card says it is up to date, or why the check failed. While it works, the card's buttons wait.","locale":"en"},"7122":{"id":"/en/docs/settings-extensions-119","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#updating","content":"To update from somewhere else, or for an extension that publishes no versions, use the folder button beside **Update**, **Update from a file or link…** (for an extension that publishes no versions, **Update** itself opens it):","locale":"en"},"7123":{"id":"/en/docs/settings-extensions-120","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#updating","content":"The confirmation shows the installed version and the new one. If instances of its types are\nrunning, it says **These instances are stopped before the update**.","locale":"en"},"7124":{"id":"/en/docs/settings-extensions-121","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#updating","content":"Click **Update**. The new version keeps whether the extension was on, and its settings and data.","locale":"en"},"7125":{"id":"/en/docs/settings-extensions-122","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#updating","content":"Updating to the version that is already installed is refused. If the extension was on and the new version does not turn on (it fails to start or cannot run), the application restores the previous version and runs it again, and the update fails with the reason.","locale":"en"},"7126":{"id":"/en/docs/settings-extensions-123","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#checking-for-updates","content":"An extension whose author publishes its versions (see Publishing updates) can be checked for a newer one:","locale":"en"},"7127":{"id":"/en/docs/settings-extensions-124","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#checking-for-updates","content":"Each card says when the extension was last checked and what was found: **Up to date**, a newer version, **Check failed** with the reason, or **No update source** for an extension that publishes none. A linked folder is never checked.","locale":"en"},"7128":{"id":"/en/docs/settings-extensions-125","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#checking-for-updates","content":"**Check for Updates**, on the **Installed** tab, checks every extension now. Its progress and result show in the bottom-right corner of the Settings window, as do downloads, installs and updates.","locale":"en"},"7129":{"id":"/en/docs/settings-extensions-126","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#checking-for-updates","content":"With **Check extensions for updates daily** on (Settings → Automation, on by default), the application checks once a day. When it finds a version it had not found before, Home shows **N extension updates available**; **View** opens this page. While updates are available, the navigation shows how many (its tooltip says so too), and the page's title has a marker beside it.","locale":"en"},"7130":{"id":"/en/docs/settings-extensions-127","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#checking-for-updates","content":"A card with an update shows **Update available**, and its Update button reads **Update to** that version; the marketplace entry shows the same button. Either one runs the one-click update above.","locale":"en"},"7131":{"id":"/en/docs/settings-extensions-128","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#checking-for-updates","content":"Nothing is ever updated without your confirmation.","locale":"en"},"7132":{"id":"/en/docs/settings-extensions-129","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#uninstalling","content":"Click **Uninstall** and confirm. Uninstalling first stops running instances of its types, turns the extension (and those that depend on it) off, then removes its files.","locale":"en"},"7133":{"id":"/en/docs/settings-extensions-130","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#uninstalling","content":"By default the extension's settings and data are kept, so a later reinstall picks them up again. Check **Also delete its settings and data** to remove them as well.","locale":"en"},"7134":{"id":"/en/docs/settings-extensions-131","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#extension-settings-panels-and-views","content":"Once an extension is on, what it contributes appears here:","locale":"en"},"7135":{"id":"/en/docs/settings-extensions-132","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#extension-settings-panels-and-views","content":"**Settings**: a section of the Settings window named after the extension. Its values are stored with the extension, not in the application's settings, and can be read and changed only while the extension runs.","locale":"en"},"7136":{"id":"/en/docs/settings-extensions-133","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#extension-settings-panels-and-views","content":"**Panels and views**: as the extension declares, in the Settings window, or under the **Extensions** group of the management page of its types' instances. A management section is listed only for instances of the extension's own types. A view that does not load or stops responding shows **Unavailable**; **Reload** tries again without affecting other sections.","locale":"en"},"7137":{"id":"/en/docs/settings-extensions-134","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#extension-settings-panels-and-views","content":"**Operations**: maintenance operations of the extension's own types appear in an **Operations** section of the instance's management page.","locale":"en"},"7138":{"id":"/en/docs/settings-extensions-135","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#extension-settings-panels-and-views","content":"When an extension provides a standalone page, the main window's title bar shows the **Extension pages** menu. Choose a page by name. Use the back button in the title bar to return to Home.","locale":"en"},"7139":{"id":"/en/docs/settings-extensions-136","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#extension-settings-panels-and-views","content":"For panels with forms or lists, fill in the fields or choose the action on the relevant row. Some actions ask for confirmation, and the panel refreshes its data after an action runs. An extension view in Instance Management can also request a reinstall of the current instance with different parameters. The confirmation names the instance and shows the changes. Once confirmed, the new values also apply to future installations.","locale":"en"},"7140":{"id":"/en/docs/settings-extensions-137","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#instances-of-an-extensions-types-when-it-is-off","content":"When an extension is turned off, fails, or is uninstalled, instances of its types stay in the instance list but are shown as unavailable, with the reason. Their records and files stay exactly as they are; nothing is changed or deleted. The only thing you can do with such an instance is delete its record: it cannot be installed, started, managed, or opened in a terminal. Once the extension is on and running again, the instances become available by themselves.","locale":"en"},"7141":{"id":"/en/docs/settings-extensions-138","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#instances-of-an-extensions-types-when-it-is-off","content":"Instance types provided by an extension's backend stay registered while that backend fails or\nrestarts. Their instances are still listed and available, but operations that need the backend,\nsuch as installing or starting, fail with a message that the extension backend is unavailable. Try\nagain once the backend is back.","locale":"en"},"7142":{"id":"/en/docs/settings-extensions-139","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#instances-of-an-extensions-types-when-it-is-off","content":"<Card title=\"Extension development\" href=\"/docs/extension-dev\" description=\"The package layout, manifest keys, and development workflow.\" />","locale":"en"},"7143":{"id":"/en/docs/settings-extensions-140","page_id":"/en/docs/settings-extensions","tags":[],"type":"text","url":"/en/docs/settings-extensions#instances-of-an-extensions-types-when-it-is-off","content":"<Card title=\"Logs, Diagnostics, and Getting Help\" href=\"/docs/troubleshooting-reporting\" description=\"Collect extension logs and errors before asking the publisher or maintainers.\" />","locale":"en"},"7144":{"id":"/en/docs/settings-language","page_id":"/en/docs/settings-language","type":"page","content":"Language","breadcrumbs":["Hanafubuki Documentation","Settings"],"tags":[],"url":"/en/docs/settings-language","locale":"en"},"7145":{"id":"/en/docs/settings-language-0","page_id":"/en/docs/settings-language","tags":[],"type":"text","url":"/en/docs/settings-language","content":"Follow the system language or choose a Chinese or English interface.","locale":"en"},"7146":{"id":"/en/docs/settings-language-1","page_id":"/en/docs/settings-language","type":"heading","tags":[],"url":"/en/docs/settings-language#switching-languages","content":"Switching languages","locale":"en"},"7147":{"id":"/en/docs/settings-language-2","page_id":"/en/docs/settings-language","tags":[],"type":"text","url":"/en/docs/settings-language","content":"**Settings → Language** controls the language of Hanafubuki's own interface. It does not change the language of the operating system, a WebUI, or a terminal.","locale":"en"},"7148":{"id":"/en/docs/settings-language-3","page_id":"/en/docs/settings-language","tags":[],"type":"text","url":"/en/docs/settings-language","content":"Option","locale":"en"},"7149":{"id":"/en/docs/settings-language-4","page_id":"/en/docs/settings-language","tags":[],"type":"text","url":"/en/docs/settings-language","content":"Behavior","locale":"en"},"7150":{"id":"/en/docs/settings-language-5","page_id":"/en/docs/settings-language","tags":[],"type":"text","url":"/en/docs/settings-language","content":"Auto (follow system)","locale":"en"},"7151":{"id":"/en/docs/settings-language-6","page_id":"/en/docs/settings-language","tags":[],"type":"text","url":"/en/docs/settings-language","content":"Use Chinese for a Chinese system language and English for every other language","locale":"en"},"7152":{"id":"/en/docs/settings-language-7","page_id":"/en/docs/settings-language","tags":[],"type":"text","url":"/en/docs/settings-language","content":"Chinese","locale":"en"},"7153":{"id":"/en/docs/settings-language-8","page_id":"/en/docs/settings-language","tags":[],"type":"text","url":"/en/docs/settings-language","content":"Always use Chinese, regardless of system-language changes","locale":"en"},"7154":{"id":"/en/docs/settings-language-9","page_id":"/en