ased on WebUI capabilities, and may additionally offer the “Built-in Model Library”:","locale":"en"},"6489":{"id":"/en/docs/instance-models-9","page_id":"/en/docs/instance-models","tags":[],"type":"text","url":"/en/docs/instance-models","content":"Mode","locale":"en"},"6490":{"id":"/en/docs/instance-models-10","page_id":"/en/docs/instance-models","tags":[],"type":"text","url":"/en/docs/instance-models","content":"Applicable interface","locale":"en"},"6491":{"id":"/en/docs/instance-models-11","page_id":"/en/docs/instance-models","tags":[],"type":"text","url":"/en/docs/instance-models","content":"Main operations","locale":"en"},"6492":{"id":"/en/docs/instance-models-12","page_id":"/en/docs/instance-models","tags":[],"type":"text","url":"/en/docs/instance-models","content":"File browser","locale":"en"},"6493":{"id":"/en/docs/instance-models-13","page_id":"/en/docs/instance-models","tags":[],"type":"text","url":"/en/docs/instance-models","content":"WebUIs that store models in directories","locale":"en"},"6494":{"id":"/en/docs/instance-models-14","page_id":"/en/docs/instance-models","tags":[],"type":"text","url":"/en/docs/instance-models","content":"Import, download, copy, move, rename, and delete files","locale":"en"},"6495":{"id":"/en/docs/instance-models-15","page_id":"/en/docs/instance-models","tags":[],"type":"text","url":"/en/docs/instance-models","content":"InvokeAI Registry","locale":"en"},"6496":{"id":"/en/docs/instance-models-16","page_id":"/en/docs/instance-models","tags":[],"type":"text","url":"/en/docs/instance-models","content":"InvokeAI, which manages models as registered records","locale":"en"},"6497":{"id":"/en/docs/instance-models-17","page_id":"/en/docs/instance-models","tags":[],"type":"text","url":"/en/docs/instance-models","content":"Install from URL, import locally, unregister, or delete files","locale":"en"},"6498":{"id":"/en/docs/instance-models-18","page_id":"/en/docs/instance-models","tags":[],"type":"text","url":"/en/docs/instance-models","con