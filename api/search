center-110","page_id":"/en/docs/task-center","tags":[],"type":"text","url":"/en/docs/task-center#task-center-and-the-bottom-right-status-area","content":"Read output, cancel tasks, investigate failures","locale":"en"},"7624":{"id":"/en/docs/task-center-111","page_id":"/en/docs/task-center","tags":[],"type":"text","url":"/en/docs/task-center#task-center-and-the-bottom-right-status-area","content":"Both show the same backend task, so cancel it in one place only.","locale":"en"},"7625":{"id":"/en/docs/task-center-112","page_id":"/en/docs/task-center","tags":[],"type":"text","url":"/en/docs/task-center#task-center-and-the-bottom-right-status-area","content":"<Card title=\"Task Contention and Cleanup\" href=\"/docs/troubleshooting-task-cleanup\" description=\"Handle cancellation, pending cleanup, and a busy instance.\" />","locale":"en"},"7626":{"id":"/en/docs/task-center-113","page_id":"/en/docs/task-center","tags":[],"type":"text","url":"/en/docs/task-center#task-center-and-the-bottom-right-status-area","content":"<Card title=\"Logs, Diagnostics, and Getting Help\" href=\"/docs/troubleshooting-reporting\" description=\"Gather logs and diagnostic information before reporting a problem.\" />","locale":"en"},"7627":{"id":"/en/docs/task-center-114","page_id":"/en/docs/task-center","tags":[],"type":"text","url":"/en/docs/task-center#task-center-and-the-bottom-right-status-area","content":"<Card title=\"WebUI Tabs\" href=\"/docs/webui-tabs\" description=\"Manage the WebUI pages that are open.\" />","locale":"en"},"7628":{"id":"/en/docs/task-center-115","page_id":"/en/docs/task-center","tags":[],"type":"text","url":"/en/docs/task-center#task-center-and-the-bottom-right-status-area","content":"<Card title=\"WebView settings\" href=\"/docs/settings-webview\" description=\"Download directory and page behaviour.\" />","locale":"en"},"7629":{"id":"/en/docs/troubleshooting-app-runtime","page_id":"/en/docs/troubleshooting-app-runtime","type":"page","content":"Application and Runtime Environment","breadcrumbs":["Hanafubuki Documentation","Troubleshooting"],"tags":[],"url":"/en/docs/troubleshooting-app-runtime","locale":"en"},"7630":{"id":"/en/docs/troubleshooting-app-runtime-0","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime","content":"Troubleshoot Hanafubuki startup, application Python, Micromamba, Git, and update issues.","locale":"en"},"7631":{"id":"/en/docs/troubleshooting-app-runtime-1","page_id":"/en/docs/troubleshooting-app-runtime","type":"heading","tags":[],"url":"/en/docs/troubleshooting-app-runtime#determine-whether-the-issue-is-at-the-application-level","content":"Determine whether the issue is at the application level","locale":"en"},"7632":{"id":"/en/docs/troubleshooting-app-runtime-2","page_id":"/en/docs/troubleshooting-app-runtime","type":"heading","tags":[],"url":"/en/docs/troubleshooting-app-runtime#launcher-errors","content":"The portable Launcher says “Hanafubuki could not be prepared”","locale":"en"},"7633":{"id":"/en/docs/troubleshooting-app-runtime-3","page_id":"/en/docs/troubleshooting-app-runtime","type":"heading","tags":[],"url":"/en/docs/troubleshooting-app-runtime#runtime-preparation-failure","content":"Runtime preparation failure","locale":"en"},"7634":{"id":"/en/docs/troubleshooting-app-runtime-4","page_id":"/en/docs/troubleshooting-app-runtime","type":"heading","tags":[],"url":"/en/docs/troubleshooting-app-runtime#no-change-after-switching-application-python-or-git","content":"No change after switching application Python or Git","locale":"en"},"7635":{"id":"/en/docs/troubleshooting-app-runtime-5","page_id":"/en/docs/troubleshooting-app-runtime","type":"heading","tags":[],"url":"/en/docs/troubleshooting-app-runtime#windows-smartscreen-blocks-the-app","content":"Windows SmartScreen blocks the app","locale":"en"},"7636":{"id":"/en/docs/troubleshooting-app-runtime-6","page_id":"/en/docs/troubleshooting-app-runtime","type":"heading","tags":[],"url":"/en/docs/troubleshooting-app-runtime#macos-says-the-app-is-damaged","content":"macOS says the app is damaged","locale":"en"},"7637":{"id":"/en/docs/troubleshooting-app-runtime-7","page_id":"/en/docs/troubleshooting-app-runtime","type":"heading","tags":[],"url":"/en/docs/troubleshooting-app-runtime#application-interface-or-window-issues","content":"Application interface or window issues","locale":"en"},"7638":{"id":"/en/docs/troubleshooting-app-runtime-8","page_id":"/en/docs/troubleshooting-app-runtime","type":"heading","tags":[],"url":"/en/docs/troubleshooting-app-runtime#update-failure","content":"Update failure","locale":"en"},"7639":{"id":"/en/docs/troubleshooting-app-runtime-9","page_id":"/en/docs/troubleshooting-app-runtime","type":"heading","tags":[],"url":"/en/docs/troubleshooting-app-runtime#if-recovery-still-fails","content":"If recovery still fails","locale":"en"},"7640":{"id":"/en/docs/troubleshooting-app-runtime-10","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime","content":"Hanafubuki's application runtime environment powers its management features and is independent of each WebUI instance's own Python and Core. First determine whether the failure is in the application-level runtime or in the dependencies of a specific instance.","locale":"en"},"7641":{"id":"/en/docs/troubleshooting-app-runtime-11","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#determine-whether-the-issue-is-at-the-application-level","content":"Symptoms that usually indicate an application-level issue:","locale":"en"},"7642":{"id":"/en/docs/troubleshooting-app-runtime-12","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#determine-whether-the-issue-is-at-the-application-level","content":"The application remains stuck at runtime preparation after opening.","locale":"en"},"7643":{"id":"/en/docs/troubleshooting-app-runtime-13","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#determine-whether-the-issue-is-at-the-application-level","content":"Home reports that application Python, Micromamba, or Git preparation failed.","locale":"en"},"7644":{"id":"/en/docs/troubleshooting-app-runtime-14","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#determine-whether-the-issue-is-at-the-application-level","content":"Installation and management features are unavailable for every instance at the same time.","locale":"en"},"7645":{"id":"/en/docs/troubleshooting-app-runtime-15","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#determine-whether-the-issue-is-at-the-application-level","content":"Settings or the instance list cannot be read before any specific WebUI task has started.","locale":"en"},"7646":{"id":"/en/docs/troubleshooting-app-runtime-16","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#determine-whether-the-issue-is-at-the-application-level","content":"Downloading or installing an application update, or restarting afterward, fails.","locale":"en"},"7647":{"id":"/en/docs/troubleshooting-app-runtime-17","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#determine-whether-the-issue-is-at-the-application-level","content":"If only one instance reports `ModuleNotFoundError`, CUDA, or extension errors when it starts, investigate the instance environment rather than application Python.","locale":"en"},"7648":{"id":"/en/docs/troubleshooting-app-runtime-18","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#launcher-errors","content":"If the main application has not opened, select **Open log** on the Launcher's error screen. It opens the file for this run in `.hanafubuki-launcher/logs/` beside the Launcher. If the failure occurred before the log was created, this button is disabled. Record the stage and full error shown in the window instead.","locale":"en"},"7649":{"id":"/en/docs/troubleshooting-app-runtime-19","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#launcher-errors","content":"After addressing the cause, select **Retry** to run preparation again. **Report issue** opens the project's GitHub Issues in your browser, where you choose which error details or log excerpts to attach.","locale":"en"},"7650":{"id":"/en/docs/troubleshooting-app-runtime-20","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#runtime-preparation-failure","content":"Open **Settings → Runtime**, then record the failed component, preparation stage, and complete\nerror.","locale":"en"},"7651":{"id":"/en/docs/troubleshooting-app-runtime-21","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#runtime-preparation-failure","content":"Confirm that there is enough disk space, the managed runtime directory is writable, and no other\nHanafubuki process is using it.","locale":"en"},"7652":{"id":"/en/docs/troubleshooting-app-runtime-22","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#runtime-preparation-failure","content":"If a download or verification fails, check the network, proxy, mirrors, and system time.","locale":"en"},"7653":{"id":"/en/docs/troubleshooting-app-runtime-23","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#runtime-preparation-failure","content":"If Micromamba is not ready, resolve that first. Git waiting for Micromamba does not mean Git\nitself is damaged.","locale":"en"},"7654":{"id":"/en/docs/troubleshooting-app-runtime-24","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#runtime-preparation-failure","content":"When the page offers a retry, retry only the failed component and wait until it becomes ready or\nreports a definite failure.","locale":"en"},"7655":{"id":"/en/docs/troubleshooting-app-runtime-25","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#runtime-preparation-failure","content":"Do not copy Python, Micromamba, Conda, or Launcher Code from another installation package over the managed directories. The application verifies its own component set, and manual replacement can cause additional integrity errors.","locale":"en"},"7656":{"id":"/en/docs/troubleshooting-app-runtime-26","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#no-change-after-switching-application-python-or-git","content":"The application Python version and Git source take effect on the next launch:","locale":"en"},"7657":{"id":"/en/docs/troubleshooting-app-runtime-27","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#no-change-after-switching-application-python-or-git","content":"Wait for any running installation, management, and Agent tasks to finish.","locale":"en"},"7658":{"id":"/en/docs/troubleshooting-app-runtime-28","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#no-change-after-switching-application-python-or-git","content":"Save the new version or source.","locale":"en"},"7659":{"id":"/en/docs/troubleshooting-app-runtime-29","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#no-change-after-switching-application-python-or-git","content":"Close all Hanafubuki windows normally.","locale":"en"},"7660":{"id":"/en/docs/troubleshooting-app-runtime-30","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#no-change-after-switching-application-python-or-git","content":"Restart the application, return to the runtime page, and verify the actual path and version.","locale":"en"},"7661":{"id":"/en/docs/troubleshooting-app-runtime-31","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#no-change-after-switching-application-python-or-git","content":"Changing these settings neither reinstalls an instance's Python nor repairs dependencies for a WebUI extension.","locale":"en"},"7662":{"id":"/en/docs/troubleshooting-app-runtime-32","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#windows-smartscreen-blocks-the-app","content":"The current Windows installer and portable package are unsigned. If the first launch of the installer, standalone build, or Launcher displays **Windows protected your PC** and says that Microsoft Defender SmartScreen prevented an unrecognized app from starting, confirm that the file came from this site, select **More info**, and then select **Run anyway**.","locale":"en"},"7663":{"id":"/en/docs/troubleshooting-app-runtime-33","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#windows-smartscreen-blocks-the-app","content":"The **Run anyway** button appears only after you expand **More info**. Do this only for a file downloaded from this site whose name and platform you have verified. Delete files from third-party reposts or unknown sources and download them again.","locale":"en"},"7664":{"id":"/en/docs/troubleshooting-app-runtime-34","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#macos-says-the-app-is-damaged","content":"The current macOS installer and portable package are unsigned. If the first launch says `“Hanafubuki” is damaged and can't be opened` or `“Hanafubuki Launcher” is damaged and can't be opened`, do not move it to the Trash. After confirming that the file came from this site, follow the macOS steps in Install Hanafubuki to run `xattr -dr com.apple.quarantine` on the corresponding `.app`, then open it again.","locale":"en"},"7665":{"id":"/en/docs/troubleshooting-app-runtime-35","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#macos-says-the-app-is-damaged","content":"Remove quarantine only from an app downloaded from this site whose name and platform you have verified. Delete files from third-party reposts or unknown sources and download them again.","locale":"en"},"7666":{"id":"/en/docs/troubleshooting-app-runtime-36","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#application-interface-or-window-issues","content":"If the application still responds, record which page is affected. If only the embedded WebUI is affected, select **Open in external browser** in the title bar while that page is showing and compare the result at the same address. On Linux, if the whole window goes blank or freezes and Settings is still accessible, turn off **Settings → WebView → GPU acceleration** and restart the application. WebView settings","locale":"en"},"7667":{"id":"/en/docs/troubleshooting-app-runtime-37","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#application-interface-or-window-issues","content":"If the window does not open, remains blank, or the application exits immediately:","locale":"en"},"7668":{"id":"/en/docs/troubleshooting-app-runtime-38","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#application-interface-or-window-issues","content":"Record the operating system, Hanafubuki version, and time of the incident.","locale":"en"},"7669":{"id":"/en/docs/troubleshooting-app-runtime-39","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#application-interface-or-window-issues","content":"Check the application logs and operating-system crash records.","locale":"en"},"7670":{"id":"/en/docs/troubleshooting-app-runtime-40","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#application-interface-or-window-issues","content":"Do not delete the application data directory first. It contains instance records, settings, and diagnostic material.","locale":"en"},"7671":{"id":"/en/docs/troubleshooting-app-runtime-41","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#application-interface-or-window-issues","content":"Use an application diagnostic bundle to report the issue to Hanafubuki maintainers, not to a WebUI extension author.","locale":"en"},"7672":{"id":"/en/docs/troubleshooting-app-runtime-42","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#update-failure","content":"Stage","locale":"en"},"7673":{"id":"/en/docs/troubleshooting-app-runtime-43","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#update-failure","content":"Check first","locale":"en"},"7674":{"id":"/en/docs/troubleshooting-app-runtime-44","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#update-failure","content":"Cannot check for updates","locale":"en"},"7675":{"id":"/en/docs/troubleshooting-app-runtime-45","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#update-failure","content":"Network, proxy, system time, and update-source reachability","locale":"en"},"7676":{"id":"/en/docs/troubleshooting-app-runtime-46","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#update-failure","content":"Download fails","locale":"en"},"7677":{"id":"/en/docs/troubleshooting-app-runtime-47","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#update-failure","content":"Task output, disk space, temporary directory, and security software","locale":"en"},"7678":{"id":"/en/docs/troubleshooting-app-runtime-48","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#update-failure","content":"Installer will not open","locale":"en"},"7679":{"id":"/en/docs/troubleshooting-app-runtime-49","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#update-failure","content":"Correct platform and architecture, file integrity, and system security prompts","locale":"en"},"7680":{"id":"/en/docs/troubleshooting-app-runtime-50","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#update-failure","content":"Still on the old version after restart","locale":"en"},"7681":{"id":"/en/docs/troubleshooting-app-runtime-51","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#update-failure","content":"Whether installation actually completed and whether an old copy from another location was launched","locale":"en"},"7682":{"id":"/en/docs/troubleshooting-app-runtime-52","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#update-failure","content":"Do not address an update failure by deleting instance directories. The application installation location and instance roots are separate scopes.","locale":"en"},"7683":{"id":"/en/docs/troubleshooting-app-runtime-53","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#if-recovery-still-fails","content":"Generate an application diagnostic bundle and include the startup failure stage, a screenshot of the runtime page, application logs, and recent changes. If the application cannot open the settings page at all, preserve the existing application data and avoid cleanup beyond reinstalling over the application until the maintainers confirm which files they need.","locale":"en"},"7684":{"id":"/en/docs/troubleshooting-app-runtime-54","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#if-recovery-still-fails","content":"<Card title=\"Runtime settings\" href=\"/docs/settings-runtime\" description=\"View the exact status of application Python, Micromamba, and Git.\" />","locale":"en"},"7685":{"id":"/en/docs/troubleshooting-app-runtime-55","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#if-recovery-still-fails","content":"<Card title=\"Application logs\" href=\"/docs/settings-logs\" description=\"Configure log level and persistence.\" />","locale":"en"},"7686":{"id":"/en/docs/troubleshooting-app-runtime-56","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/troubleshooting-app-runtime#if-recovery-still-fails","content":"<Card title=\"Application diagnostics\" href=\"/docs/settings-diagnostics\" description=\"Collect an application-level diagnostic bundle.\" />","locale":"en"},"7687":{"id":"/en/docs/troubleshooting-app-runtime-57","page_id":"/en/docs/troubleshooting-app-runtime","tags":[],"type":"text","url":"/en/docs/trouble