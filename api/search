ontext#common-commands","content":"Inspect or set the goal this session should keep working toward","locale":"en"},"4269":{"id":"/en/docs/agent-commands-context-32","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#common-commands","content":"`/export`","locale":"en"},"4270":{"id":"/en/docs/agent-commands-context-33","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#common-commands","content":"Copy the conversation as Markdown or save it to a file","locale":"en"},"4271":{"id":"/en/docs/agent-commands-context-34","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#common-commands","content":"`/compact`","locale":"en"},"4272":{"id":"/en/docs/agent-commands-context-35","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#common-commands","content":"Manually compact the current session's model context","locale":"en"},"4273":{"id":"/en/docs/agent-commands-context-36","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#common-commands","content":"`/memories`","locale":"en"},"4274":{"id":"/en/docs/agent-commands-context-37","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#common-commands","content":"View or change whether the current session contributes memory","locale":"en"},"4275":{"id":"/en/docs/agent-commands-context-38","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#common-commands","content":"`/mcp`","locale":"en"},"4276":{"id":"/en/docs/agent-commands-context-39","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#common-commands","content":"Open the MCP server runtime status panel","locale":"en"},"4277":{"id":"/en/docs/agent-commands-context-40","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#common-commands","content":"`/mcp verbose`","locale":"en"},"4278":{"id":"/en/docs/agent-commands-context-41","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#common-commands","content":"View MCP capabilities, policies, tool plans, and diagnostics","locale":"en"},"4279":{"id":"/en/docs/agent-commands-context-42","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#common-commands","content":"`/skills`","locale":"en"},"4280":{"id":"/en/docs/agent-commands-context-43","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#common-commands","content":"Select Skills available to the current session for the next message","locale":"en"},"4281":{"id":"/en/docs/agent-commands-context-44","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#common-commands","content":"`/ps`","locale":"en"},"4282":{"id":"/en/docs/agent-commands-context-45","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#common-commands","content":"List the current session's background terminals","locale":"en"},"4283":{"id":"/en/docs/agent-commands-context-46","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#common-commands","content":"`/stop`","locale":"en"},"4284":{"id":"/en/docs/agent-commands-context-47","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#common-commands","content":"Stop and clean up the current session's background terminals","locale":"en"},"4285":{"id":"/en/docs/agent-commands-context-48","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#common-commands","content":"Use the keyboard to choose a command from the palette. Unknown commands and unsupported arguments produce an error. To send a one-line message that starts with a path, put a few words first, for example, “Please check /tmp/result.txt.”","locale":"en"},"4286":{"id":"/en/docs/agent-commands-context-49","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#models-and-reasoning-effort","content":"`/providers` opens the provider list, and `/providers policy` opens the default model settings. Use `/role` to choose a role for an idle conversation. To get a second model's input, configure the advisor through `/advisor-settings`, then enable it for the current session with `/advisor` or disable it with `/advisor-off`. Use `/advisor-manual your question` for one consultation and `/advisor-stats` to view retained feedback statistics.","locale":"en"},"4287":{"id":"/en/docs/agent-commands-context-50","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#models-and-reasoning-effort","content":"`/model` opens the same selector as the model button beside the input. The selector queries every enabled provider and displays loading errors separately. If the desired model is absent from the catalog, you can enter a custom model ID.","locale":"en"},"4288":{"id":"/en/docs/agent-commands-context-51","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#models-and-reasoning-effort","content":"`/effort` opens the current session's reasoning effort picker. In Responses sessions, you can restore the default, pick a preset, or enter a custom level. For the default settings used by other protocols, see Providers and Models. Wait until the session is idle before using the picker.","locale":"en"},"4289":{"id":"/en/docs/agent-commands-context-52","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#viewing-status","content":"Run `/status` to view:","locale":"en"},"4290":{"id":"/en/docs/agent-commands-context-53","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#viewing-status","content":"The current session identifier.","locale":"en"},"4291":{"id":"/en/docs/agent-commands-context-54","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#viewing-status","content":"The proportion of context consumed and remaining; it may be shown as unknown when the provider does not report it.","locale":"en"},"4292":{"id":"/en/docs/agent-commands-context-55","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#viewing-status","content":"Input, output, and total token usage, including whether the data is provider-reported or estimated.","locale":"en"},"4293":{"id":"/en/docs/agent-commands-context-56","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#viewing-status","content":"Working time for the current turn and for the whole session.","locale":"en"},"4294":{"id":"/en/docs/agent-commands-context-57","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#viewing-status","content":"Context windows already traversed by a long session and its compaction information.","locale":"en"},"4295":{"id":"/en/docs/agent-commands-context-58","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#viewing-status","content":"Use this information to decide whether to split a task or compact the context. It does not represent billing; actual charges are determined by the model provider.","locale":"en"},"4296":{"id":"/en/docs/agent-commands-context-59","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#automatic-and-manual-compaction","content":"When automatic compaction is enabled, the application organizes the history sent to the model as it approaches the configured threshold or triggers the runtime budget. You can also run `/compact` to compact proactively when the session permits it.","locale":"en"},"4297":{"id":"/en/docs/agent-commands-context-60","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#automatic-and-manual-compaction","content":"Compaction may use a local summary or remote Responses compaction declared as supported by the provider. The session's model protocol and frozen capabilities determine the implementation; the application does not guess the server API while a run is in progress.","locale":"en"},"4298":{"id":"/en/docs/agent-commands-context-61","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#automatic-and-manual-compaction","content":"Messages and tool records remain visible in the interface. Compaction changes the context used by\nthe next model request. Repeated compaction gradually summarizes older content, so restate\nimportant constraints in a new message.","locale":"en"},"4299":{"id":"/en/docs/agent-commands-context-62","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#automatic-and-manual-compaction","content":"If the model explicitly reports insufficient context before producing any output, the application may compact and retry. Once output has been produced, it does not automatically replay the entire turn, avoiding duplicate tool calls or external actions.","locale":"en"},"4300":{"id":"/en/docs/agent-commands-context-63","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#workspaces-reviews-and-goals","content":"In a Git workspace, `/diff` shows the changes. Use `/review` to select uncommitted changes, changes against a base branch, or a specific commit. Read the review findings in the command card.","locale":"en"},"4301":{"id":"/en/docs/agent-commands-context-64","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#workspaces-reviews-and-goals","content":"To try changes in parallel, open `/worktree` and fork the conversation into a new worktree. The card can also open the conversation associated with an existing worktree or remove a selected worktree after confirmation.","locale":"en"},"4302":{"id":"/en/docs/agent-commands-context-65","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#workspaces-reviews-and-goals","content":"Type `/goal objective` to set a continuing goal. To set a token budget, for example, enter `/goal --tokens 50k Check the documentation links`. Open `/goal` again to inspect, edit, pause, resume, or clear it. Replacing an unfinished goal requires confirmation.","locale":"en"},"4303":{"id":"/en/docs/agent-commands-context-66","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#workspaces-reviews-and-goals","content":"Use `/recap` to catch up on a conversation. `/copy` copies the selected text or the latest assistant message if nothing is selected. `/raw` shows a copyable transcript. `/export` offers to copy or save Markdown.","locale":"en"},"4304":{"id":"/en/docs/agent-commands-context-67","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-restrictions","content":"`/model`, `/effort`, and `/fork` require the current session to be idle.","locale":"en"},"4305":{"id":"/en/docs/agent-commands-context-68","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-restrictions","content":"`/compact` is available only when the session has content that can be compacted and no conflicting operation is running.","locale":"en"},"4306":{"id":"/en/docs/agent-commands-context-69","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-restrictions","content":"A `/memories` state marked as contaminated cannot be re-enabled.","locale":"en"},"4307":{"id":"/en/docs/agent-commands-context-70","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-restrictions","content":"`/ps` and `/stop` operate only on background terminals owned by the current Agent session.","locale":"en"},"4308":{"id":"/en/docs/agent-commands-context-71","page_id":"/en/docs/agent-commands-context","tags":[],"type":"text","url":"/en/docs/agent-commands-context#command-restrictions","content":"`/mcp` displays runtime state; complete server configuration remains under **Settings → Agent → MCP**.","locale":"en"},"4309":{"id":"/en/docs/agent-conversations","page_id":"/en/docs/agent-conversations","type":"page","content":"Session Management","breadcrumbs":["Hanafubuki Documentation","Agent"],"tags":[],"url":"/en/docs/agent-conversations","locale":"en"},"4310":{"id":"/en/docs/agent-conversations-0","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations","content":"Create, switch, archive, restore, delete, and fork Agent sessions.","locale":"en"},"4311":{"id":"/en/docs/agent-conversations-1","page_id":"/en/docs/agent-conversations","type":"heading","tags":[],"url":"/en/docs/agent-conversations#creating-and-switching-sessions","content":"Creating and switching sessions","locale":"en"},"4312":{"id":"/en/docs/agent-conversations-2","page_id":"/en/docs/agent-conversations","type":"heading","tags":[],"url":"/en/docs/agent-conversations#projects-and-workspaces","content":"Projects and workspaces","locale":"en"},"4313":{"id":"/en/docs/agent-conversations-3","page_id":"/en/docs/agent-conversations","type":"heading","tags":[],"url":"/en/docs/agent-conversations#side-chats-and-subagents","content":"Side chats and subagents","locale":"en"},"4314":{"id":"/en/docs/agent-conversations-4","page_id":"/en/docs/agent-conversations","type":"heading","tags":[],"url":"/en/docs/agent-conversations#conversation-titles","content":"Conversation titles","locale":"en"},"4315":{"id":"/en/docs/agent-conversations-5","page_id":"/en/docs/agent-conversations","type":"heading","tags":[],"url":"/en/docs/agent-conversations#archiving-and-restoring","content":"Archiving and restoring","locale":"en"},"4316":{"id":"/en/docs/agent-conversations-6","page_id":"/en/docs/agent-conversations","type":"heading","tags":[],"url":"/en/docs/agent-conversations#permanent-deletion","content":"Permanent deletion","locale":"en"},"4317":{"id":"/en/docs/agent-conversations-7","page_id":"/en/docs/agent-conversations","type":"heading","tags":[],"url":"/en/docs/agent-conversations#forking-a-session","content":"Forking a session","locale":"en"},"4318":{"id":"/en/docs/agent-conversations-8","page_id":"/en/docs/agent-conversations","type":"heading","tags":[],"url":"/en/docs/agent-conversations#conversation-commands","content":"Conversation commands","locale":"en"},"4319":{"id":"/en/docs/agent-conversations-9","page_id":"/en/docs/agent-conversations","type":"heading","tags":[],"url":"/en/docs/agent-conversations#scope-of-session-configuration","content":"Scope of session configuration","locale":"en"},"4320":{"id":"/en/docs/agent-conversations-10","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations","content":"An Agent session stores messages, tool calls, approvals, model selection, and context state. After switching pages or reopening the application, you can continue reviewing persisted records.","locale":"en"},"4321":{"id":"/en/docs/agent-conversations-11","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#creating-and-switching-sessions","content":"Click **New** at the top of the session list, or run `/new`, to create a session. The application attaches context relevant to the current interface and uses the default model policy and capabilities available at that time.","locale":"en"},"4322":{"id":"/en/docs/agent-conversations-12","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#creating-and-switching-sessions","content":"The session list marks running sessions and sessions in Plan mode. Selecting another session does not automatically stop the current task. Before switching, check whether a response, compaction, or background terminal is still running.","locale":"en"},"4323":{"id":"/en/docs/agent-conversations-13","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#creating-and-switching-sessions","content":"Scroll to the bottom of the sidebar to load more conversations automatically. In a long conversation, scroll to the top of the transcript to load earlier messages. The **…** menu on a conversation lets you mark it as a favorite, view its workspaces, move it to another group, or rename it.","locale":"en"},"4324":{"id":"/en/docs/agent-conversations-14","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#projects-and-workspaces","content":"Choose **New project** in the sidebar to group the default workspace, instance directories, or folders you select. The first is the primary workspace. A new conversation in the project uses the folders selected when it was created. Use `/pwd` to see the current working directory. When the session is idle, use `/cd` to pick a directory or enter `/cd path`.","locale":"en"},"4325":{"id":"/en/docs/agent-conversations-15","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#projects-and-workspaces","content":"**Move to project…** changes where an existing conversation appears in the sidebar. Editing the project's folders affects conversations created afterward. Removing a project moves its conversations to **Recent** and preserves their individual workspaces and messages.","locale":"en"},"4326":{"id":"/en/docs/agent-conversations-16","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#projects-and-workspaces","content":"The **…** menu on a project lets you start a conversation there, pin the project, edit it, or archive it. Use **Archive project** to put the whole project aside. To restore it, expand the archived projects in the Projects section.","locale":"en"},"4327":{"id":"/en/docs/agent-conversations-17","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#side-chats-and-subagents","content":"Once the main conversation has a message, use `/side` to open a side chat or `/btw your question` to ask there directly. The side chat uses the main conversation as context and shows its replies in a separate pane while the main task continues. Use `/close` to close the side chat. To inspect work delegated by the main agent, use `/subagents` to switch to that subagent's conversation.","locale":"en"},"4328":{"id":"/en/docs/agent-conversations-18","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#conversation-titles","content":"After the first message is accepted, the application immediately shows a short title from that message and asks the current session model to refine it in the background. Title generation does not add a message or tool call to the conversation. If generation fails, the initial short title remains available.","locale":"en"},"4329":{"id":"/en/docs/agent-conversations-19","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#conversation-titles","content":"Choose **Rename** from the conversation's **…** menu. Press Enter or select the check button to save. Press Escape or select the cancel button to discard the edit. A title you rename manually takes precedence over a late automatic result and stays with the conversation after restarting the application.","locale":"en"},"4330":{"id":"/en/docs/agent-conversations-20","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#archiving-and-restoring","content":"Archiving hides a session you do not currently need while preserving it:","locale":"en"},"4331":{"id":"/en/docs/agent-conversations-21","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#archiving-and-restoring","content":"Archiving does not delete messages, tool history, or memory-source relationships, and it does not treat background processes that are still running as stopped.","locale":"en"},"4332":{"id":"/en/docs/agent-conversations-22","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#permanent-deletion","content":"Permanent deletion cannot be undone. The delete button requires an additional confirmation to prevent accidental use.","locale":"en"},"4333":{"id":"/en/docs/agent-conversations-23","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#permanent-deletion","content":"Before deleting, check that:","locale":"en"},"4334":{"id":"/en/docs/agent-conversations-24","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#permanent-deletion","content":"The current response and compaction have finished.","locale":"en"},"4335":{"id":"/en/docs/agent-conversations-25","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#permanent-deletion","content":"`/ps` no longer shows background terminals for the session.","locale":"en"},"4336":{"id":"/en/docs/agent-conversations-26","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#permanent-deletion","content":"You no longer need its messages, tool output, or memory sources.","locale":"en"},"4337":{"id":"/en/docs/agent-conversations-27","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#permanent-deletion","content":"No fork relationships or resources awaiting cleanup depend on the session history.","locale":"en"},"4338":{"id":"/en/docs/agent-conversations-28","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#permanent-deletion","content":"If process cleanup or session relationships still have unmet requirements, the backend rejects the deletion and preserves the data. Resolve the cleanup obligation in the message and retry. Do not interpret a failed deletion as meaning that records were partially removed.","locale":"en"},"4339":{"id":"/en/docs/agent-conversations-29","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#forking-a-session","content":"Forking is useful when you want to preserve the current approach while trying another solution from a point in history.","locale":"en"},"4340":{"id":"/en/docs/agent-conversations-30","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#forking-a-session","content":"Action","locale":"en"},"4341":{"id":"/en/docs/agent-conversations-31","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#forking-a-session","content":"Result","locale":"en"},"4342":{"id":"/en/docs/agent-conversations-32","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#forking-a-session","content":"`/fork`","locale":"en"},"4343":{"id":"/en/docs/agent-conversations-33","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#forking-a-session","content":"Fork from the end of the currently committed session","locale":"en"},"4344":{"id":"/en/docs/agent-conversations-34","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#forking-a-session","content":"Edit a past user message","locale":"en"},"4345":{"id":"/en/docs/agent-conversations-35","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#forking-a-session","content":"Fork before that message and restore it to the input for editing","locale":"en"},"4346":{"id":"/en/docs/agent-conversations-36","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#forking-a-session","content":"A fork does not overwrite or rewrite the original session. Editing a past message also does not submit a new request immediately: review the content restored to the input before sending the revised task.","locale":"en"},"4347":{"id":"/en/docs/agent-conversations-37","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#forking-a-session","content":"The child session can reuse history before the fork point, but later messages are stored separately. Memory contribution is also handled per session; the child does not copy later parent-session content as its own source.","locale":"en"},"4348":{"id":"/en/docs/agent-conversations-38","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#conversation-commands","content":"`/agents` or `/resume` reveals archived conversations. If you know the session ID, enter `/resume ID` to switch directly to it.","locale":"en"},"4349":{"id":"/en/docs/agent-conversations-39","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#conversation-commands","content":"`/rename NEW TITLE` renames the current conversation and `/archive` archives it. `/delete` asks for confirmation before permanently deleting it.","locale":"en"},"4350":{"id":"/en/docs/agent-conversations-40","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#conversation-commands","content":"`/clear` clears the messages currently displayed in the panel. The session retains their history. `/exit` closes the panel.","locale":"en"},"4351":{"id":"/en/docs/agent-conversations-41","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#scope-of-session-configuration","content":"Each session records its own model and reasoning effort; changing global defaults does not replace them automatically.","locale":"en"},"4352":{"id":"/en/docs/agent-conversations-42","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#scope-of-session-configuration","content":"Each user turn captures a fresh enabled, available Skill catalog. Pending changes for a selected session take effect from its next turn as indicated by the interface.","locale":"en"},"4353":{"id":"/en/docs/agent-conversations-43","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#scope-of-session-configuration","content":"MCP connections and the tool catalog can change, but each model sampling step uses the tool plan frozen when that step began.","locale":"en"},"4354":{"id":"/en/docs/agent-conversations-44","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#scope-of-session-configuration","content":"Whether a session may generate memory is determined by the setting at creation or fork time and can be inspected with `/memories`.","locale":"en"},"4355":{"id":"/en/docs/agent-conversations-45","page_id":"/en/docs/agent-conversations","tags":[],"type":"text","url":"/en/docs/agent-conversations#scope-of-session-configuration","content":"Archive a session when you only want to organize the list. Delete it permanently only when you are\ncertain that you no longer need its history, output, or memory sources.","locale":"en"},"4356":{"id":"/en/docs/agent-mcp","page_id":"/en/docs/agent-mcp","type":"page","content":"MCP","breadcrumbs":["Hanafubuki Documentation","Agent"],"tags":[],"url":"/en/docs/agent-mcp","locale":"en"},"4357":{"id":"/en/docs/agent-mcp-0","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp","content":"Configure MCP servers, connect runtimes, and control tool exposure and approval policies.","locale":"en"},"4358":{"id":"/en/docs/agent-mcp-1","page_id":"/en/docs/agent-mcp","type":"heading","tags":[],"url":"/en/docs/agent-mcp#choosing-a-transport","content":"Choosing a transport","locale":"en"},"4359":{"id":"/en/docs/agent-mcp-2","page_id":"/en/docs/agent-mcp","type":"heading","tags":[],"url":"/en/docs/agent-mcp#adding-and-connecting-a-server","content":"Adding and connecting a server","locale":"en"},"4360":{"id":"/en/docs/agent-mcp-3","page_id":"/en/docs/agent-mcp","type":"heading","tags":[],"url":"/en/docs/agent-mcp#the-applications-own-server","content":"The application's own server","locale":"en"},"4361":{"id":"/en/docs/agent-mcp-4","page_id":"/en/docs/agent-mcp","type":"heading","tags":[],"url":"/en/docs/agent-mcp#tool-policies","content":"Tool policies","locale":"en"},"4362":{"id":"/en/docs/agent-mcp-5","page_id":"/en/docs/agent-mcp","type":"heading","tags":[],"url":"/en/docs/agent-mcp#inspecting-mcp-in-a-session","content":"Inspecting MCP in a session","locale":"en"},"4363":{"id":"/en/docs/agent-mcp-6","page_id":"/en/docs/agent-mcp","type":"heading","tags":[],"url":"/en/docs/agent-mcp#common-problems","content":"Common problems","locale":"en"},"4364":{"id":"/en/docs/agent-mcp-7","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp","content":"MCP lets local programs or remote services provide tools to the Agent. A server may access files, networks, databases, and third-party accounts, so both the connection configuration and the permissions granted to its tools require review.","locale":"en"},"4365":{"id":"/en/docs/agent-mcp-8","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#choosing-a-transport","content":"Use this for a local MCP program launched by the application. Configure its executable, arguments, working directory, public environment variables, and credential environment-variable references.","locale":"en"},"4366":{"id":"/en/docs/agent-mcp-9","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#choosing-a-transport","content":"The program must be discoverable and able to start on the current system. Relative commands, missing runtimes, and an incorrect working directory commonly cause startup failures.","locale":"en"},"4367":{"id":"/en/docs/agent-mcp-10","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#choosing-a-transport","content":"Use this for an already-running remote or local HTTP service. Configure its `http`/`https` URL, public request headers, credential-header references, and OAuth policy.","locale":"en"},"4368":{"id":"/en/docs/agent-mcp-11","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#choosing-a-transport","content":"OAuth can be disabled, optional, or required. When sign-in is needed, open the browser from the interface and complete the callback.","locale":"en"},"4369":{"id":"/en/docs/agent-mcp-12","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#choosing-a-transport","content":"MCP credential values are stored exactly as entered. Runtime status, diagnostics, and `/mcp verbose` should only show whether a credential exists, never its value. Even so, do not publicly share MCP settings files or screenshots containing credential input fields.","locale":"en"},"4370":{"id":"/en/docs/agent-mcp-13","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#adding-and-connecting-a-server","content":"Enter the target, environment variables, or request headers, then create credential references\nas needed.","locale":"en"},"4371":{"id":"/en/docs/agent-mcp-14","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#adding-and-connecting-a-server","content":"Configure whether the server is enabled and required, along with connection and invocation\ntimeouts.","locale":"en"},"4372":{"id":"/en/docs/agent-mcp-15","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#adding-and-connecting-a-server","content":"Refresh the tool catalog and review tool names, descriptions, risk notices, and policies.","locale":"en"},"4373":{"id":"/en/docs/agent-mcp-16","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#adding-and-connecting-a-server","content":"**Enabled** is persistent configuration; **Connected** is current runtime state. A server can be disabled, starting, ready, refreshing, stopping, or failed. After editing its configuration, check that the runtime is using the new connection and catalog version.","locale":"en"},"4374":{"id":"/en/docs/agent-mcp-17","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#the-applications-own-server","content":"The list includes a server named `hanafubuki`, which the application adds itself. It connects the Agent to the application's management MCP server, whose tools install, start, stop, update and configure WebUI instances and read the Task Center: this is how the Agent manages your instances.","locale":"en"},"4375":{"id":"/en/docs/agent-mcp-18","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#the-applications-own-server","content":"**Names.** The Agent sees each tool as `mcp__hanafubuki__<tool>`, such as `mcp__hanafubuki__start_instance`.","locale":"en"},"4376":{"id":"/en/docs/agent-mcp-19","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#the-applications-own-server","content":"**Exposure.** Common tools such as `list_instances`, `list_tasks`, and `read_task_log`, plus the tools to start, stop, and restart an instance, are available directly by default. The model discovers the others through tool search as needed, including some read-only tools.","locale":"en"},"4377":{"id":"/en/docs/agent-mcp-20","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#the-applications-own-server","content":"**Approval.** The application sets read-only tools to **Allow** and tools that make changes to **Ask** by default. You can change individual policies in MCP settings. When approval is required, the card shows the tool name and arguments.","locale":"en"},"4378":{"id":"/en/docs/agent-mcp-21","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#the-applications-own-server","content":"**Memory.** Tools on the built-in server follow the same external-context setting as tools from other MCP servers.","locale":"en"},"4379":{"id":"/en/docs/agent-mcp-22","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#the-applications-own-server","content":"**What the application keeps up to date.** Whenever the Agent starts or the server restarts, the application rewrites the entry's address and credential, and gives a default policy to any tool that has none. Everything else is yours and stays as you set it: the **Enabled** switch, the per-tool policies you changed, the enabled and disabled tool lists, the timeouts and the concurrency limits.","locale":"en"},"4380":{"id":"/en/docs/agent-mcp-23","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#the-applications-own-server","content":"**Turning it off.** Turn the entry off with its **Enabled** switch. If you delete it instead, the application adds it again, with the default policies, the next time the Agent starts. Turning off the **management-mcp** module on the Modules page stops the server itself: the entry then shows as failed and reconnects once the module runs again.","locale":"en"},"4381":{"id":"/en/docs/agent-mcp-24","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#the-applications-own-server","content":"The `hanafubuki-webui-management` Skill, installed with the entry, explains how the Agent uses these tools (Skills).","locale":"en"},"4382":{"id":"/en/docs/agent-mcp-25","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Policy","locale":"en"},"4383":{"id":"/en/docs/agent-mcp-26","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Options","locale":"en"},"4384":{"id":"/en/docs/agent-mcp-27","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Purpose","locale":"en"},"4385":{"id":"/en/docs/agent-mcp-28","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Approval","locale":"en"},"4386":{"id":"/en/docs/agent-mcp-29","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Allow, Ask, Deny","locale":"en"},"4387":{"id":"/en/docs/agent-mcp-30","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Decide whether a tool call proceeds directly, requires approval, or is prohibited","locale":"en"},"4388":{"id":"/en/docs/agent-mcp-31","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Exposure","locale":"en"},"4389":{"id":"/en/docs/agent-mcp-32","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Direct, Deferred, Hidden","locale":"en"},"4390":{"id":"/en/docs/agent-mcp-33","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Decide whether the model sees the tool immediately, on demand, or not at all","locale":"en"},"4391":{"id":"/en/docs/agent-mcp-34","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Enable filter","locale":"en"},"4392":{"id":"/en/docs/agent-mcp-35","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Enabled/disabled tool lists","locale":"en"},"4393":{"id":"/en/docs/agent-mcp-36","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Expose only selected tools from the server","locale":"en"},"4394":{"id":"/en/docs/agent-mcp-37","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Concurrency","locale":"en"},"4395":{"id":"/en/docs/agent-mcp-38","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Server and per-tool limits","locale":"en"},"4396":{"id":"/en/docs/agent-mcp-39","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Limit the number of simultaneous MCP calls","locale":"en"},"4397":{"id":"/en/docs/agent-mcp-40","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"You can set server defaults and override them for individual tools. Keep **Ask** for tools that write, delete, send messages, or modify external systems. Hide or disable tools you do not use.","locale":"en"},"4398":{"id":"/en/docs/agent-mcp-41","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#tool-policies","content":"Each model sampling step freezes the tool plan that existed when the step began. Refreshing a connection or changing policy may update runtime state immediately, but an in-progress sampling step continues using the old plan. The change appears in the next step.","locale":"en"},"4399":{"id":"/en/docs/agent-mcp-42","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#inspecting-mcp-in-a-session","content":"`/mcp`: View the server count, connection state, errors, and current tool count, and connect, refresh, or disconnect servers.","locale":"en"},"4400":{"id":"/en/docs/agent-mcp-43","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#inspecting-mcp-in-a-session","content":"`/mcp verbose`: View transport targets, connection generations, capabilities, tool policies, the current frozen plan, credential-presence state, and bounded diagnostics.","locale":"en"},"4401":{"id":"/en/docs/agent-mcp-44","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#inspecting-mcp-in-a-session","content":"Use the runtime panel to troubleshoot and reconnect. Add, remove, or edit servers and credentials from the settings page.","locale":"en"},"4402":{"id":"/en/docs/agent-mcp-45","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"Symptom","locale":"en"},"4403":{"id":"/en/docs/agent-mcp-46","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"Check","locale":"en"},"4404":{"id":"/en/docs/agent-mcp-47","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"stdio does not start","locale":"en"},"4405":{"id":"/en/docs/agent-mcp-48","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"Program path, arguments, working directory, runtime, and environment variables","locale":"en"},"4406":{"id":"/en/docs/agent-mcp-49","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"HTTP does not connect","locale":"en"},"4407":{"id":"/en/docs/agent-mcp-50","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"URL, proxy, certificate, request headers, and server status","locale":"en"},"4408":{"id":"/en/docs/agent-mcp-51","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"OAuth fails","locale":"en"},"4409":{"id":"/en/docs/agent-mcp-52","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"OAuth policy, browser callback, account authorization, and server configuration","locale":"en"},"4410":{"id":"/en/docs/agent-mcp-53","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"Connected but no tools","locale":"en"},"4411":{"id":"/en/docs/agent-mcp-54","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"Catalog refresh, enable filters, exposure policy, and server capabilities","locale":"en"},"4412":{"id":"/en/docs/agent-mcp-55","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"Tool waits indefinitely","locale":"en"},"4413":{"id":"/en/docs/agent-mcp-56","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"Invocation timeout, concurrency limits, approval card, and server response","locale":"en"},"4414":{"id":"/en/docs/agent-mcp-57","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"Cleanup remains after stop","locale":"en"},"4415":{"id":"/en/docs/agent-mcp-58","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"Retry disconnect from the runtime panel; do not immediately delete the configuration","locale":"en"},"4416":{"id":"/en/docs/agent-mcp-59","page_id":"/en/docs/agent-mcp","tags":[],"type":"text","url":"/en/docs/agent-mcp#common-problems","content":"A session that used MCP can still contribute memory unless **Exclude external context** is enabled. Run `/memories` to check the current session's eligibility. See Memory.","locale":"en"},"4417":{"id":"/en/docs/agent-memory","page_id":"/en/docs/agent-memory","type":"page","content":"Memory","breadcrumbs":["Hanafubuki Documentation","Agent"],"tags":[],"url":"/en/docs/agent-memory","locale":"en"},"4418":{"id":"/en/docs/agent-memory-0","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory","content":"Control memory retrieval, generation, contribution, and reset across sessions.","locale":"en"},"4419":{"id":"/en/docs/agent-memory-1","page_id":"/en/docs/agent-memory","type":"heading","tags":[],"url":"/en/docs/agent-memory#global-settings","content":"Global settings","locale":"en"},"4420":{"id":"/en/docs/agent-memory-2","page_id":"/en/docs/agent-memory","type":"heading","tags":[],"url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"Contribution state of the current session","locale":"en"},"4421":{"id":"/en/docs/agent-memory-3","page_id":"/en/docs/agent-memory","type":"heading","tags":[],"url":"/en/docs/agent-memory#using-versus-generating-memory","content":"Using versus generating memory","locale":"en"},"4422":{"id":"/en/docs/agent-memory-4","page_id":"/en/docs/agent-memory","type":"heading","tags":[],"url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"What the Agent can do with memory","locale":"en"},"4423":{"id":"/en/docs/agent-memory-5","page_id":"/en/docs/agent-memory","type":"heading","tags":[],"url":"/en/docs/agent-memory#archiving-deleting-and-forking","content":"Archiving, deleting, and forking","locale":"en"},"4424":{"id":"/en/docs/agent-memory-6","page_id":"/en/docs/agent-memory","type":"heading","tags":[],"url":"/en/docs/agent-memory#resetting-memory","content":"Resetting memory","locale":"en"},"4425":{"id":"/en/docs/agent-memory-7","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory","content":"Memory is project knowledge distilled from sessions for use in later, relevant tasks. It differs from session history: history contains the original messages and tool records, while memory is derived context and grants no file or tool permissions.","locale":"en"},"4426":{"id":"/en/docs/agent-memory-8","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#global-settings","content":"Open **Memory** under **Settings → Agent**. Enable memory, then choose how to read, generate, and filter its sources.","locale":"en"},"4427":{"id":"/en/docs/agent-memory-9","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#global-settings","content":"Option","locale":"en"},"4428":{"id":"/en/docs/agent-memory-10","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#global-settings","content":"Purpose","locale":"en"},"4429":{"id":"/en/docs/agent-memory-11","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#global-settings","content":"Use memories","locale":"en"},"4430":{"id":"/en/docs/agent-memory-12","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#global-settings","content":"Add retrieved relevant knowledge to model requests","locale":"en"},"4431":{"id":"/en/docs/agent-memory-13","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#global-settings","content":"Generate memories","locale":"en"},"4432":{"id":"/en/docs/agent-memory-14","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#global-settings","content":"Allow the background process to derive new memory from eligible sessions","locale":"en"},"4433":{"id":"/en/docs/agent-memory-15","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#global-settings","content":"Exclude external context","locale":"en"},"4434":{"id":"/en/docs/agent-memory-16","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#global-settings","content":"When enabled, sessions that use external tool results lose eligibility as sources","locale":"en"},"4435":{"id":"/en/docs/agent-memory-17","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#global-settings","content":"Memory and **Exclude external context** are both off by default. When you enable memory, use and generation are on by default. Background extraction also requires an enabled default provider. By default a session must have been idle for at least six hours to be considered.","locale":"en"},"4436":{"id":"/en/docs/agent-memory-18","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"Run `/memories` to see whether the current session is allowed to contribute memory and, when permitted, change its state.","locale":"en"},"4437":{"id":"/en/docs/agent-memory-19","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"State","locale":"en"},"4438":{"id":"/en/docs/agent-memory-20","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"Meaning","locale":"en"},"4439":{"id":"/en/docs/agent-memory-21","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"Enabled","locale":"en"},"4440":{"id":"/en/docs/agent-memory-22","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"The session may be used as a memory source when it meets the other conditions","locale":"en"},"4441":{"id":"/en/docs/agent-memory-23","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"Disabled","locale":"en"},"4442":{"id":"/en/docs/agent-memory-24","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"Preserve session history but do not generate memory from it","locale":"en"},"4443":{"id":"/en/docs/agent-memory-25","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"Contaminated","locale":"en"},"4444":{"id":"/en/docs/agent-memory-26","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"The session triggered the external-context exclusion rule and permanently lost eligibility","locale":"en"},"4445":{"id":"/en/docs/agent-memory-27","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"With **Exclude external context** enabled, a contributing session permanently loses eligibility after a successful Web or MCP tool result. A tool search that selects such a tool also triggers exclusion, even before the tool is called. Connecting a server, a denied call, or an error alone does not trigger it. The session history remains available, and **Use memories** independently governs access to existing memory.","locale":"en"},"4446":{"id":"/en/docs/agent-memory-28","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#contribution-state-of-the-current-session","content":"When a session is created or forked, it records whether memory generation was allowed at that time. You can later manage the current session with `/memories`, but no memory is retrieved or generated while memory is globally disabled.","locale":"en"},"4447":{"id":"/en/docs/agent-memory-29","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#using-versus-generating-memory","content":"**Use memories** controls whether the current model can read existing memory.","locale":"en"},"4448":{"id":"/en/docs/agent-memory-30","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#using-versus-generating-memory","content":"**Generate memories** controls whether eligible sessions can become sources of new memory.","locale":"en"},"4449":{"id":"/en/docs/agent-memory-31","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#using-versus-generating-memory","content":"Disabling contribution for the current session does not delete memory that has already been generated.","locale":"en"},"4450":{"id":"/en/docs/agent-memory-32","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#using-versus-generating-memory","content":"Compacting a session does not write dynamically retrieved memory into visible message history.","locale":"en"},"4451":{"id":"/en/docs/agent-memory-33","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#using-versus-generating-memory","content":"The Agent retrieves memory again for every model sampling step, so newly generated or reset results take effect in subsequent steps.","locale":"en"},"4452":{"id":"/en/docs/agent-memory-34","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"Retrieval is a two-part arrangement. Every sampling step carries a compact summary that acts as a routing index, and the rest of memory is read on demand through its own tools:","locale":"en"},"4453":{"id":"/en/docs/agent-memory-35","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"Tool","locale":"en"},"4454":{"id":"/en/docs/agent-memory-36","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"Purpose","locale":"en"},"4455":{"id":"/en/docs/agent-memory-37","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"`list_agent_memories`","locale":"en"},"4456":{"id":"/en/docs/agent-memory-38","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"Report the readable resources and their ids","locale":"en"},"4457":{"id":"/en/docs/agent-memory-39","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"`search_agent_memories`","locale":"en"},"4458":{"id":"/en/docs/agent-memory-40","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"Find a keyword and return ids with line numbers","locale":"en"},"4459":{"id":"/en/docs/agent-memory-41","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"`read_agent_memory`","locale":"en"},"4460":{"id":"/en/docs/agent-memory-42","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"Read a line range from one resource","locale":"en"},"4461":{"id":"/en/docs/agent-memory-43","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"`append_agent_memory_note`","locale":"en"},"4462":{"id":"/en/docs/agent-memory-44","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"Record one instruction to remember, forget, or update","locale":"en"},"4463":{"id":"/en/docs/agent-memory-45","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"Memory is reachable only through these tools. It is not on a path any filesystem or command tool can open, so the Agent cannot read or edit memory files directly.","locale":"en"},"4464":{"id":"/en/docs/agent-memory-46","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"Reading follows what is published. A memory stays readable while newer sessions are still waiting to be consolidated, so asking the Agent to remember something never hides the memory you already have. The written note is queued instead: the Agent records it, and a later consolidation pass merges it in.","locale":"en"},"4465":{"id":"/en/docs/agent-memory-47","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"The Agent may only write a note when you have asked it to remember, forget, or update something. It does not decide on its own that a conversation was worth keeping.","locale":"en"},"4466":{"id":"/en/docs/agent-memory-48","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#what-the-agent-can-do-with-memory","content":"When an answer materially relies on memory, the Agent cites the resources it read. The application validates those citations against what memory actually attributes the fact to, and removes the citation block from the visible answer once the turn commits.","locale":"en"},"4467":{"id":"/en/docs/agent-memory-49","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#archiving-deleting-and-forking","content":"Session action","locale":"en"},"4468":{"id":"/en/docs/agent-memory-50","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#archiving-deleting-and-forking","content":"Effect on memory sources","locale":"en"},"4469":{"id":"/en/docs/agent-memory-51","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#archiving-deleting-and-forking","content":"Archive/restore","locale":"en"},"4470":{"id":"/en/docs/agent-memory-52","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#archiving-deleting-and-forking","content":"Preserves source relationships; only changes visibility in the session list","locale":"en"},"4471":{"id":"/en/docs/agent-memory-53","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#archiving-deleting-and-forking","content":"Permanently delete","locale":"en"},"4472":{"id":"/en/docs/agent-memory-54","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#archiving-deleting-and-forking","content":"Revokes the session's eligibility as a future memory source","locale":"en"},"4473":{"id":"/en/docs/agent-memory-55","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#archiving-deleting-and-forking","content":"Fork","locale":"en"},"4474":{"id":"/en/docs/agent-memory-56","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#archiving-deleting-and-forking","content":"The child contributes only content it produces after the fork; the parent remains independent","locale":"en"},"4475":{"id":"/en/docs/agent-memory-57","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#resetting-memory","content":"The settings page shows the current number of memory entries and sources. Reset requires a second confirmation. It clears derived memory and begins a new memory generation.","locale":"en"},"4476":{"id":"/en/docs/agent-memory-58","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#resetting-memory","content":"Resetting does not delete Agent sessions or their original histories. If generation remains enabled, eligible sessions may produce new memory later. If you no longer want a particular session to contribute, disable it first with `/memories` or permanently delete that session.","locale":"en"},"4477":{"id":"/en/docs/agent-memory-59","page_id":"/en/docs/agent-memory","tags":[],"type":"text","url":"/en/docs/agent-memory#resetting-memory","content":"Do not rely on external-content exclusion or reset to protect credentials. Sensitive information\nshould never enter prompts, attachments, or project documents in the first place. Manually review\nand redact diagnostics or session records before sharing them.","locale":"en"},"4478":{"id":"/en/docs/agent-messages-attachments","page_id":"/en/docs/agent-messages-attachments","type":"page","content":"Messages and Attachments","breadcrumbs":["Hanafubuki Documentation","Agent"],"tags":[],"url":"/en/docs/agent-messages-attachments","locale":"en"},"4479":{"id":"/en/docs/agent-messages-attachments-0","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments","content":"Write messages, reference project files, add images, and steer work in progress.","locale":"en"},"4480":{"id":"/en/docs/agent-messages-attachments-1","page_id":"/en/docs/agent-messages-attachments","type":"heading","tags":[],"url":"/en/docs/agent-messages-attachments#writing-and-sending","content":"Writing and sending","locale":"en"},"4481":{"id":"/en/docs/agent-messages-attachments-2","page_id":"/en/docs/agent-messages-attachments","type":"heading","tags":[],"url":"/en/docs/agent-messages-attachments#current-interface-context","content":"Current interface context","locale":"en"},"4482":{"id":"/en/docs/agent-messages-attachments-3","page_id":"/en/docs/agent-messages-attachments","type":"heading","tags":[],"url":"/en/docs/agent-messages-attachments#referencing-files-and-directories","content":"Referencing files and directories","locale":"en"},"4483":{"id":"/en/docs/agent-messages-attachments-4","page_id":"/en/docs/agent-messages-attachments","type":"heading","tags":[],"url":"/en/docs/agent-messages-attachments#adding-images","content":"Adding images","locale":"en"},"4484":{"id":"/en/docs/agent-messages-attachments-5","page_id":"/en/docs/agent-messages-attachments","type":"heading","tags":[],"url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"Adding messages while the Agent is working","locale":"en"},"4485":{"id":"/en/docs/agent-messages-attachments-6","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments","content":"The input can send text, project paths, images, and the Skill selection for the current turn. The application also attaches the current interface location automatically, helping the Agent understand which instance or settings area you are viewing.","locale":"en"},"4486":{"id":"/en/docs/agent-messages-attachments-7","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#writing-and-sending","content":"Press `Enter` to send a message and `Shift + Enter` to insert a line break.","locale":"en"},"4487":{"id":"/en/docs/agent-messages-attachments-8","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#writing-and-sending","content":"You can send images without text, or send text and images together.","locale":"en"},"4488":{"id":"/en/docs/agent-messages-attachments-9","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#writing-and-sending","content":"If no model is currently selected, click the model button or run `/model` first.","locale":"en"},"4489":{"id":"/en/docs/agent-messages-attachments-10","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#writing-and-sending","content":"Approvals, blocking questions, and proposed plans show their actions in the input area. When **Optional questions** appears, the Agent continues working. Expand it to choose an option or write your own answer. Submitting sends it as steering to the active turn. You can also skip the question.","locale":"en"},"4490":{"id":"/en/docs/agent-messages-attachments-11","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#writing-and-sending","content":"State the objective, scope, and acceptance criteria clearly in the prompt. When paths, instance names, or command arguments could be ambiguous, provide their exact text instead of saying only \"this,\" \"the previous one,\" or \"the default.\"","locale":"en"},"4491":{"id":"/en/docs/agent-messages-attachments-12","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#current-interface-context","content":"The input displays a label for the current context. Depending on your location, the Agent may receive interface context for the instance chooser, an instance-creation step, an instance workspace, an embedded WebUI, a settings section, or an instance-management section.","locale":"en"},"4492":{"id":"/en/docs/agent-messages-attachments-13","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#current-interface-context","content":"This is supporting context, not file permission or authorization to execute. The Agent must still inspect the real state through tools and follow the current permission mode and backend path rules.","locale":"en"},"4493":{"id":"/en/docs/agent-messages-attachments-14","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#referencing-files-and-directories","content":"Type `@` or use `/mention` to search files in the current conversation's workspaces. The search respects workspace ignore rules. **Add files…** in the attachment menu opens the system picker and can insert several file paths at once. To reference a directory, type or paste its path into the message.","locale":"en"},"4494":{"id":"/en/docs/agent-messages-attachments-15","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#referencing-files-and-directories","content":"After sending, use the tool cards to verify which path the Agent actually read or modified.","locale":"en"},"4495":{"id":"/en/docs/agent-messages-attachments-16","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#referencing-files-and-directories","content":"The Agent uses the current session's permissions to read or write at the referenced location.","locale":"en"},"4496":{"id":"/en/docs/agent-messages-attachments-17","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Choose **Attach images…** from the attachment menu or paste a clipboard image directly into the input. A message can contain up to 8 images, which you can remove or reorder. Before sending, the backend decodes, validates, and normalizes them:","locale":"en"},"4497":{"id":"/en/docs/agent-messages-attachments-18","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Limit","locale":"en"},"4498":{"id":"/en/docs/agent-messages-attachments-19","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Value","locale":"en"},"4499":{"id":"/en/docs/agent-messages-attachments-20","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Individual source file","locale":"en"},"4500":{"id":"/en/docs/agent-messages-attachments-21","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Up to 20 MiB","locale":"en"},"4501":{"id":"/en/docs/agent-messages-attachments-22","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"All source images combined","locale":"en"},"4502":{"id":"/en/docs/agent-messages-attachments-23","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Up to 64 MiB","locale":"en"},"4503":{"id":"/en/docs/agent-messages-attachments-24","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Decoded pixels","locale":"en"},"4504":{"id":"/en/docs/agent-messages-attachments-25","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Up to 40 million","locale":"en"},"4505":{"id":"/en/docs/agent-messages-attachments-26","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Longest normalized edge","locale":"en"},"4506":{"id":"/en/docs/agent-messages-attachments-27","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Up to 2048 pixels","locale":"en"},"4507":{"id":"/en/docs/agent-messages-attachments-28","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Individual normalized result","locale":"en"},"4508":{"id":"/en/docs/agent-messages-attachments-29","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Up to 8 MiB","locale":"en"},"4509":{"id":"/en/docs/agent-messages-attachments-30","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"Metadata is removed from images, and animated images use only a still frame. When the model policy is **Auto**, the application sends images according to known capabilities. If the model explicitly rejects images before producing any output, the application may remove them and retry once. Images cannot be sent when the model policy is **Disabled**.","locale":"en"},"4510":{"id":"/en/docs/agent-messages-attachments-31","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-images","content":"If image reading, decoding, or request admission fails, the text and attachment draft remain available so you can fix the problem and send again.","locale":"en"},"4511":{"id":"/en/docs/agent-messages-attachments-32","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"If you enter new content and click the primary button while the Agent is responding, the application does not immediately begin a second turn. Instead, it places the content in the current panel's message queue.","locale":"en"},"4512":{"id":"/en/docs/agent-messages-attachments-33","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"Queue action","locale":"en"},"4513":{"id":"/en/docs/agent-messages-attachments-34","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"Purpose","locale":"en"},"4514":{"id":"/en/docs/agent-messages-attachments-35","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"Steer","locale":"en"},"4515":{"id":"/en/docs/agent-messages-attachments-36","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"Send the message into the current turn to adjust its direction","locale":"en"},"4516":{"id":"/en/docs/agent-messages-attachments-37","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"Edit","locale":"en"},"4517":{"id":"/en/docs/agent-messages-attachments-38","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"Restore the message and images to the input for further editing","locale":"en"},"4518":{"id":"/en/docs/agent-messages-attachments-39","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"Discard","locale":"en"},"4519":{"id":"/en/docs/agent-messages-attachments-40","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"Remove the item from the local queue without sending it to the Agent","locale":"en"},"4520":{"id":"/en/docs/agent-messages-attachments-41","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"Use steering to add a newly discovered constraint, such as \"Do not change the database schema.\" If the current work can finish naturally, keeping it as a message for the next turn is often clearer. The queue is draft state belonging only to the currently open panel; do not treat it as persisted session history.","locale":"en"},"4521":{"id":"/en/docs/agent-messages-attachments-42","page_id":"/en/docs/agent-messages-attachments","tags":[],"type":"text","url":"/en/docs/agent-messages-attachments#adding-messages-while-the-agent-is-working","content":"Before submitting images or files, check for tokens, private keys, cookies, personal data, and\ninternal addresses. Attachments enter the model context; do not rely on the interface to redact\nthem for you.","locale":"en"},"4522":{"id":"/en/docs/agent-modes-plans","page_id":"/en/docs/agent-modes-plans","type":"page","content":"Modes and Plans","breadcrumbs":["Hanafubuki Documentation","Agent"],"tags":[],"url":"/en/docs/agent-modes-plans","locale":"en"},"4523":{"id":"/en/docs/agent-modes-plans-0","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans","content":"Distinguish Default mode, Plan mode, proposed plans, and execution task plans.","locale":"en"},"4524":{"id":"/en/docs/agent-modes-plans-1","page_id":"/en/docs/agent-modes-plans","type":"heading","tags":[],"url":"/en/docs/agent-modes-plans#default-mode-and-plan-mode","content":"Default mode and Plan mode","locale":"en"},"4525":{"id":"/en/docs/agent-modes-plans-2","page_id":"/en/docs/agent-modes-plans","type":"heading","tags":[],"url":"/en/docs/agent-modes-plans#working-in-plan-mode","content":"Working in Plan mode","locale":"en"},"4526":{"id":"/en/docs/agent-modes-plans-3","page_id":"/en/docs/agent-modes-plans","type":"heading","tags":[],"url":"/en/docs/agent-modes-plans#the-two-kinds-of-plan-are-different","content":"The two kinds of \"plan\" are different","locale":"en"},"4527":{"id":"/en/docs/agent-modes-plans-4","page_id":"/en/docs/agent-modes-plans","type":"heading","tags":[],"url":"/en/docs/agent-modes-plans#when-to-switch-modes","content":"When to switch modes","locale":"en"},"4528":{"id":"/en/docs/agent-modes-plans-5","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans","content":"The session mode determines which kinds of tools the Agent can currently use. It is separate from the permission mode: the session mode decides whether a capability is available, while the permission mode decides how an available operation is approved.","locale":"en"},"4529":{"id":"/en/docs/agent-modes-plans-6","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#default-mode-and-plan-mode","content":"Mode","locale":"en"},"4530":{"id":"/en/docs/agent-modes-plans-7","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#default-mode-and-plan-mode","content":"Best for","locale":"en"},"4531":{"id":"/en/docs/agent-modes-plans-8","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#default-mode-and-plan-mode","content":"Main behavior","locale":"en"},"4532":{"id":"/en/docs/agent-modes-plans-9","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#default-mode-and-plan-mode","content":"Default","locale":"en"},"4533":{"id":"/en/docs/agent-modes-plans-10","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#default-mode-and-plan-mode","content":"The objective and scope are clear and you want the task completed directly","locale":"en"},"4534":{"id":"/en/docs/agent-modes-plans-11","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#default-mode-and-plan-mode","content":"Can run commands, modify files within authorization, and track execution with a task plan","locale":"en"},"4535":{"id":"/en/docs/agent-modes-plans-12","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#default-mode-and-plan-mode","content":"Plan","locale":"en"},"4536":{"id":"/en/docs/agent-modes-plans-13","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#default-mode-and-plan-mode","content":"The requirement is complex and needs investigation and design confirmation first","locale":"en"},"4537":{"id":"/en/docs/agent-modes-plans-14","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#default-mode-and-plan-mode","content":"Allows investigation, reading, questions, and a proposed solution, but does not modify the repository","locale":"en"},"4538":{"id":"/en/docs/agent-modes-plans-15","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#default-mode-and-plan-mode","content":"Plan mode hides write, patch, and other mutation tools. Even if the permission mode is **Full access**, Plan mode does not become an execution mode.","locale":"en"},"4539":{"id":"/en/docs/agent-modes-plans-16","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#default-mode-and-plan-mode","content":"When the conversation is idle, open the **+** menu in the input and toggle **Plan**, or type `/mode` to choose between the two modes.","locale":"en"},"4540":{"id":"/en/docs/agent-modes-plans-17","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#working-in-plan-mode","content":"Let the Agent read the existing code and documentation to confirm the current implementation.","locale":"en"},"4541":{"id":"/en/docs/agent-modes-plans-18","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#working-in-plan-mode","content":"Answer choices that affect the implementation. If uncertain, you can skip one and let the Agent\nuse its recommended default.","locale":"en"},"4542":{"id":"/en/docs/agent-modes-plans-19","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#working-in-plan-mode","content":"A blocking question temporarily replaces the input. Choose an option, write your own answer, or skip it to continue the planning turn. A card labeled **Optional questions** can be answered later while the Agent continues working.","locale":"en"},"4543":{"id":"/en/docs/agent-modes-plans-20","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#the-two-kinds-of-plan-are-different","content":"Name","locale":"en"},"4544":{"id":"/en/docs/agent-modes-plans-21","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#the-two-kinds-of-plan-are-different","content":"Purpose","locale":"en"},"4545":{"id":"/en/docs/agent-modes-plans-22","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#the-two-kinds-of-plan-are-different","content":"Lifecycle","locale":"en"},"4546":{"id":"/en/docs/agent-modes-plans-23","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#the-two-kinds-of-plan-are-different","content":"Proposed plan","locale":"en"},"4547":{"id":"/en/docs/agent-modes-plans-24","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#the-two-kinds-of-plan-are-different","content":"A complete, reviewable implementation plan delivered at the end of Plan mode","locale":"en"},"4548":{"id":"/en/docs/agent-modes-plans-25","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#the-two-kinds-of-plan-are-different","content":"The user decides whether to implement or revise it","locale":"en"},"4549":{"id":"/en/docs/agent-modes-plans-26","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#the-two-kinds-of-plan-are-different","content":"Task plan","locale":"en"},"4550":{"id":"/en/docs/agent-modes-plans-27","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#the-two-kinds-of-plan-are-different","content":"Steps and status shown while executing in Default mode","locale":"en"},"4551":{"id":"/en/docs/agent-modes-plans-28","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#the-two-kinds-of-plan-are-different","content":"Reports progress; it does not grant authorization","locale":"en"},"4552":{"id":"/en/docs/agent-modes-plans-29","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#the-two-kinds-of-plan-are-different","content":"A proposed plan should leave no key implementation decisions unresolved for the executor. A task plan only describes the progress of current work. Even if a step is marked **In progress**, that does not mean its command succeeded or a risky operation was approved.","locale":"en"},"4553":{"id":"/en/docs/agent-modes-plans-30","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#when-to-switch-modes","content":"Use Plan mode first when code boundaries, data structures, or interactions are unclear.","locale":"en"},"4554":{"id":"/en/docs/agent-modes-plans-31","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#when-to-switch-modes","content":"Plan mode is also suitable when you only want the cause of an error investigated without modifying code; explicitly state \"analysis only\" in the task.","locale":"en"},"4555":{"id":"/en/docs/agent-modes-plans-32","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#when-to-switch-modes","content":"Switch to Default mode or use **Implement plan** when the solution is clear and you want it carried out.","locale":"en"},"4556":{"id":"/en/docs/agent-modes-plans-33","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#when-to-switch-modes","content":"If the current response, compaction, or blocking decision has not finished, resolve that state before switching.","locale":"en"},"4557":{"id":"/en/docs/agent-modes-plans-34","page_id":"/en/docs/agent-modes-plans","tags":[],"type":"text","url":"/en/docs/agent-modes-plans#when-to-switch-modes","content":"Accepting a solution only chooses the direction of subsequent work. Commands, writes, deletions,\nor external actions that require approval during execution are still handled according to the\ncurrent permission mode.","locale":"en"},"4558":{"id":"/en/docs/agent-permissions","page_id":"/en/docs/agent-permissions","type":"page","content":"Permissions and Approvals","breadcrumbs":["Hanafubuki Documentation","Agent"],"tags":[],"url":"/en/docs/agent-permissions","locale":"en"},"4559":{"id":"/en/docs/agent-permissions-0","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions","content":"Choose an Agent permission mode and safely handle each tool approval.","locale":"en"},"4560":{"id":"/en/docs/agent-permissions-1","page_id":"/en/docs/agent-permissions","type":"heading","tags":[],"url":"/en/docs/agent-permissions#permission-modes","content":"Permission modes","locale":"en"},"4561":{"id":"/en/docs/agent-permissions-2","page_id":"/en/docs/agent-permissions","type":"heading","tags":[],"url":"/en/docs/agent-permissions#handling-manual-approval","content":"Handling manual approval","locale":"en"},"4562":{"id":"/en/docs/agent-permissions-3","page_id":"/en/docs/agent-permissions","type":"heading","tags":[],"url":"/en/docs/agent-permissions#reading-an-automatic-review","content":"Reading an automatic review","locale":"en"},"4563":{"id":"/en/docs/agent-permissions-4","page_id":"/en/docs/agent-permissions","type":"heading","tags":[],"url":"/en/docs/agent-permissions#high-risk-operations","content":"High-risk operations","locale":"en"},"4564":{"id":"/en/docs/agent-permissions-5","page_id":"/en/docs/agent-permissions","type":"heading","tags":[],"url":"/en/docs/agent-permissions#permission-modes-and-other-controls","content":"Permission modes and other controls","locale":"en"},"4565":{"id":"/en/docs/agent-permissions-6","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions","content":"Use `/permissions` or the permissions menu beside the input to inspect the current session's approval policy and command sandbox. A session inherits the Agent settings until you choose a preset here. The selection applies only to that session.","locale":"en"},"4566":{"id":"/en/docs/agent-permissions-7","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"Session preset","locale":"en"},"4567":{"id":"/en/docs/agent-permissions-8","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"Command sandbox","locale":"en"},"4568":{"id":"/en/docs/agent-permissions-9","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"When approval is required","locale":"en"},"4569":{"id":"/en/docs/agent-permissions-10","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"Read only","locale":"en"},"4570":{"id":"/en/docs/agent-permissions-11","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"File reads, with writes and network access restricted","locale":"en"},"4571":{"id":"/en/docs/agent-permissions-12","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"You decide","locale":"en"},"4572":{"id":"/en/docs/agent-permissions-13","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"Default","locale":"en"},"4573":{"id":"/en/docs/agent-permissions-14","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"Workspace writes, with network access restricted by default","locale":"en"},"4574":{"id":"/en/docs/agent-permissions-15","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"You decide","locale":"en"},"4575":{"id":"/en/docs/agent-permissions-16","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"Auto-review","locale":"en"},"4576":{"id":"/en/docs/agent-permissions-17","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"Workspace-write sandbox","locale":"en"},"4577":{"id":"/en/docs/agent-permissions-18","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"The model reviews the operation and reports its reasoning","locale":"en"},"4578":{"id":"/en/docs/agent-permissions-19","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"Full access","locale":"en"},"4579":{"id":"/en/docs/agent-permissions-20","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"Runs with your OS user permissions","locale":"en"},"4580":{"id":"/en/docs/agent-permissions-21","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"Routine approvals are granted automatically","locale":"en"},"4581":{"id":"/en/docs/agent-permissions-22","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"If a sandboxed preset is unavailable, the menu explains why. On Windows, choose **Set up the Windows sandbox** when offered and confirm the system administrator prompt. You can also open sandbox maintenance with `/setup-default-sandbox`.","locale":"en"},"4582":{"id":"/en/docs/agent-permissions-23","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"The backend prohibits some operations outright, and changing the permission mode cannot override those rules. Path policy, instance lifecycle, process ownership, and operating-system account permissions also remain in force at all times.","locale":"en"},"4583":{"id":"/en/docs/agent-permissions-24","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes","content":"With Full access selected, commands can directly modify projects, instances, or external services\nyour user account can access.","locale":"en"},"4584":{"id":"/en/docs/agent-permissions-25","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#handling-manual-approval","content":"When approval is required, an approval card replaces the ordinary input. Before approving, check each item:","locale":"en"},"4585":{"id":"/en/docs/agent-permissions-26","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#handling-manual-approval","content":"Operation type: command, file write, deletion, MCP administration, or external tool call.","locale":"en"},"4586":{"id":"/en/docs/agent-permissions-27","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#handling-manual-approval","content":"Risk level: low, medium, high, or critical.","locale":"en"},"4587":{"id":"/en/docs/agent-permissions-28","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#handling-manual-approval","content":"Operation summary and source: user request, model decision, or a particular Skill.","locale":"en"},"4588":{"id":"/en/docs/agent-permissions-29","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#handling-manual-approval","content":"Exact target: program, arguments, working directory, file path, or service identifier.","locale":"en"},"4589":{"id":"/en/docs/agent-permissions-30","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#handling-manual-approval","content":"Whether the operation is genuinely necessary to complete the current task.","locale":"en"},"4590":{"id":"/en/docs/agent-permissions-31","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#handling-manual-approval","content":"**Allow once** authorizes only the current request. Some tools also offer **Allow for this conversation**. Later calls to that tool in the same conversation then proceed without another prompt until the Agent restarts. Requests that always need a human decision offer only a one-time choice. **Deny** sends the rejection to the Agent.","locale":"en"},"4591":{"id":"/en/docs/agent-permissions-32","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#reading-an-automatic-review","content":"Automatic review displays the review state, risk assessment, evidence of user authorization, and reasoning in the tool record. It still applies only to the current call and does not authorize the entire task.","locale":"en"},"4592":{"id":"/en/docs/agent-permissions-33","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#reading-an-automatic-review","content":"After an automatic denial, expand the tool record to check the reason and target. To authorize a single retry of that action, run `/approve` and select the corresponding denied review.","locale":"en"},"4593":{"id":"/en/docs/agent-permissions-34","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#high-risk-operations","content":"Even when their targets look reasonable, manually confirm the scope and recovery method for:","locale":"en"},"4594":{"id":"/en/docs/agent-permissions-35","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#high-risk-operations","content":"Deleting, overwriting, or moving project and instance data.","locale":"en"},"4595":{"id":"/en/docs/agent-permissions-36","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#high-risk-operations","content":"Resetting Git, publishing a release, pushing code, or triggering a remote workflow.","locale":"en"},"4596":{"id":"/en/docs/agent-permissions-37","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#high-risk-operations","content":"Installing a Skill from an unknown source, running its scripts, or changing MCP configuration.","locale":"en"},"4597":{"id":"/en/docs/agent-permissions-38","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#high-risk-operations","content":"Using MCP to operate accounts, databases, messages, payments, or other external systems.","locale":"en"},"4598":{"id":"/en/docs/agent-permissions-39","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#high-risk-operations","content":"Reading or sending credentials, private data, or unreleased content.","locale":"en"},"4599":{"id":"/en/docs/agent-permissions-40","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#high-risk-operations","content":"For deletions, confirm a backup or snapshot first. For external systems, verify the account, environment, and target object. For commands, verify the working directory and complete arguments.","locale":"en"},"4600":{"id":"/en/docs/agent-permissions-41","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes-and-other-controls","content":"Plan mode still hides mutation tools; Full access does not bypass it.","locale":"en"},"4601":{"id":"/en/docs/agent-permissions-42","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes-and-other-controls","content":"MCP tools have their own **Allow**, **Ask**, and **Deny** policies, and both layers apply.","locale":"en"},"4602":{"id":"/en/docs/agent-permissions-43","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes-and-other-controls","content":"A Skill can recommend or call tools, but it does not inherit capabilities beyond the current permissions.","locale":"en"},"4603":{"id":"/en/docs/agent-permissions-44","page_id":"/en/docs/agent-permissions","tags":[],"type":"text","url":"/en/docs/agent-permissions#permission-modes-and-other-controls","content":"Memory provides context only; it grants no permission to files, commands, or external services.","locale":"en"},"4604":{"id":"/en/docs/agent-providers-models","page_id":"/en/docs/agent-providers-models","type":"page","content":"Providers and Models","breadcrumbs":["Hanafubuki Documentation","Agent"],"tags":[],"url":"/en/docs/agent-providers-models","locale":"en"},"4605":{"id":"/en/docs/agent-providers-models-0","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models","content":"Configure Agent server connections, model capabilities, and context policies.","locale":"en"},"4606":{"id":"/en/docs/agent-providers-models-1","page_id":"/en/docs/agent-providers-models","type":"heading","tags":[],"url":"/en/docs/agent-providers-models#adding-a-provider","content":"Adding a provider","locale":"en"},"4607":{"id":"/en/docs/agent-providers-models-2","page_id":"/en/docs/agent-providers-models","type":"heading","tags":[],"url":"/en/docs/agent-providers-models#choosing-the-default-model","content":"Choosing the default model","locale":"en"},"4608":{"id":"/en/docs/agent-providers-models-3","page_id":"/en/docs/agent-providers-models","type":"heading","tags":[],"url":"/en/docs/agent-providers-models#model-capabilities","content":"Model capabilities","locale":"en"},"4609":{"id":"/en/docs/agent-providers-models-4","page_id":"/en/docs/agent-providers-models","type":"heading","tags":[],"url":"/en/docs/agent-providers-models#the-current-sessions-model","content":"The current session's model","locale":"en"},"4610":{"id":"/en/docs/agent-providers-models-5","page_id":"/en/docs/agent-providers-models","type":"heading","tags":[],"url":"/en/docs/agent-providers-models#verification-and-troubleshooting","content":"Verification and troubleshooting","locale":"en"},"4611":{"id":"/en/docs/agent-providers-models-6","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models","content":"The Agent configures \"how to connect to the server\" separately from \"how to use the model.\" A provider stores the protocol, API address, and credentials; the model policy stores the default model, reasoning effort, image input, and context rules.","locale":"en"},"4612":{"id":"/en/docs/agent-providers-models-7","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Go to **Settings → Agent → Models → Providers**, or type `/providers` in chat, then add a provider.","locale":"en"},"4613":{"id":"/en/docs/agent-providers-models-8","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Setting","locale":"en"},"4614":{"id":"/en/docs/agent-providers-models-9","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Description","locale":"en"},"4615":{"id":"/en/docs/agent-providers-models-10","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Name","locale":"en"},"4616":{"id":"/en/docs/agent-providers-models-11","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Used only to distinguish the provider in the interface","locale":"en"},"4617":{"id":"/en/docs/agent-providers-models-12","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Protocol","locale":"en"},"4618":{"id":"/en/docs/agent-providers-models-13","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"OpenAI Responses, OpenAI Chat Completions, Anthropic Messages, Gemini GenerateContent, or Gemini Interactions","locale":"en"},"4619":{"id":"/en/docs/agent-providers-models-14","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"API address","locale":"en"},"4620":{"id":"/en/docs/agent-providers-models-15","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Root address of the server API; must use `http` or `https`","locale":"en"},"4621":{"id":"/en/docs/agent-providers-models-16","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"API token","locale":"en"},"4622":{"id":"/en/docs/agent-providers-models-17","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Authentication token required by the server; leave blank when not needed","locale":"en"},"4623":{"id":"/en/docs/agent-providers-models-18","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Custom headers","locale":"en"},"4624":{"id":"/en/docs/agent-providers-models-19","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Additional headers required by a gateway or compatible service","locale":"en"},"4625":{"id":"/en/docs/agent-providers-models-20","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Enabled","locale":"en"},"4626":{"id":"/en/docs/agent-providers-models-21","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"Determines whether the provider can be selected and used for model requests","locale":"en"},"4627":{"id":"/en/docs/agent-providers-models-22","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"The protocol must match the server's actual implementation. Changing the API address does not turn a Chat Completions service into a Responses service, and a compatible service may implement only part of a protocol.","locale":"en"},"4628":{"id":"/en/docs/agent-providers-models-23","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"The API token is masked by default. Use the eye button to reveal or hide it. Enter one custom\nheader per line. Use `NAME=VALUE` to add or replace a header, or leave an existing name on its own\nto keep the saved value. Hide credentials before sharing screenshots.","locale":"en"},"4629":{"id":"/en/docs/agent-providers-models-24","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#adding-a-provider","content":"After saving, use **Test connection** on the provider page to check whether the saved configuration can retrieve the model list. **List models** shows the catalog and **Make default** changes the default provider.","locale":"en"},"4630":{"id":"/en/docs/agent-providers-models-25","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#choosing-the-default-model","content":"After saving and enabling a provider, select the default provider and model in the model policy. The model list is a convenience catalog returned by the server; you can also enter a custom model ID accepted by that server.","locale":"en"},"4631":{"id":"/en/docs/agent-providers-models-26","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#choosing-the-default-model","content":"Configure reasoning effort, image input, and the context window according to the model's\ncapabilities.","locale":"en"},"4632":{"id":"/en/docs/agent-providers-models-27","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#choosing-the-default-model","content":"After saving, create a short session and send a simple question to verify the connection.","locale":"en"},"4633":{"id":"/en/docs/agent-providers-models-28","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#choosing-the-default-model","content":"You can create an idle session without a default model, but cannot send a model request. Click the model name beside the input or run `/model` to select a model for the current idle session. Existing sessions are not silently switched when global defaults change.","locale":"en"},"4634":{"id":"/en/docs/agent-providers-models-29","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"To configure one model separately, open **Models → Provider models** and add a `PROVIDER_ID/MODEL_ID` record. It can override the context window, maximum output, image support, and reasoning levels. If the service changes a model's capabilities, clear its learned facts to discard the Agent's observations while keeping your manual overrides. The action on a model affects that model. On a provider, it covers all of its models.","locale":"en"},"4635":{"id":"/en/docs/agent-providers-models-30","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"Setting","locale":"en"},"4636":{"id":"/en/docs/agent-providers-models-31","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"Recommendation","locale":"en"},"4637":{"id":"/en/docs/agent-providers-models-32","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"Reasoning effort","locale":"en"},"4638":{"id":"/en/docs/agent-providers-models-33","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"In **Default model**, choose a known level, enter a custom value, or leave it unset for the provider to decide. Supported levels depend on the model and API.","locale":"en"},"4639":{"id":"/en/docs/agent-providers-models-34","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"Image input","locale":"en"},"4640":{"id":"/en/docs/agent-providers-models-35","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"**Auto** sends images when the model supports them; **Disabled** blocks image input","locale":"en"},"4641":{"id":"/en/docs/agent-providers-models-36","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"Context window","locale":"en"},"4642":{"id":"/en/docs/agent-providers-models-37","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"Enter the number of tokens actually available to the model; when blank, the provider and runtime information are used","locale":"en"},"4643":{"id":"/en/docs/agent-providers-models-38","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"Auto compaction","locale":"en"},"4644":{"id":"/en/docs/agent-providers-models-39","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"Organizes model context near the threshold, which defaults to 80% of the window","locale":"en"},"4645":{"id":"/en/docs/agent-providers-models-40","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"Remote compaction","locale":"en"},"4646":{"id":"/en/docs/agent-providers-models-41","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"Available only for Responses providers that declare the corresponding capability","locale":"en"},"4647":{"id":"/en/docs/agent-providers-models-42","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#model-capabilities","content":"If the configured context window is too high, the server may reject a request first. If it is too low, compaction begins earlier. Compaction changes only the context sent to the model on the next turn; it does not delete messages or tool records saved in the interface.","locale":"en"},"4648":{"id":"/en/docs/agent-providers-models-43","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#the-current-sessions-model","content":"A session records its own provider, protocol, model, and reasoning effort. To change them temporarily:","locale":"en"},"4649":{"id":"/en/docs/agent-providers-models-44","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#the-current-sessions-model","content":"Wait for the current response and compaction to finish.","locale":"en"},"4650":{"id":"/en/docs/agent-providers-models-45","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#the-current-sessions-model","content":"Click the model button beside the input, or run `/model`.","locale":"en"},"4651":{"id":"/en/docs/agent-providers-models-46","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#the-current-sessions-model","content":"Select an enabled provider and model.","locale":"en"},"4652":{"id":"/en/docs/agent-providers-models-47","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#the-current-sessions-model","content":"Run `/effort` afterward if you also need to adjust reasoning effort.","locale":"en"},"4653":{"id":"/en/docs/agent-providers-models-48","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#the-current-sessions-model","content":"Changing models reapplies the effort from the model policy. The desktop `/effort` picker currently enables its preset levels and custom input for Responses sessions. For other protocols, **Default model** still lets you configure the effort requested by new sessions.","locale":"en"},"4654":{"id":"/en/docs/agent-providers-models-49","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#verification-and-troubleshooting","content":"If a test message fails, check in this order:","locale":"en"},"4655":{"id":"/en/docs/agent-providers-models-50","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#verification-and-troubleshooting","content":"Whether the provider is enabled and its protocol matches the server.","locale":"en"},"4656":{"id":"/en/docs/agent-providers-models-51","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#verification-and-troubleshooting","content":"Whether the API address includes the correct version path and contains no embedded credential.","locale":"en"},"4657":{"id":"/en/docs/agent-providers-models-52","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#verification-and-troubleshooting","content":"Whether the model ID exists and is available to the current account.","locale":"en"},"4658":{"id":"/en/docs/agent-providers-models-53","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#verification-and-troubleshooting","content":"Whether the token and custom request headers are correct.","locale":"en"},"4659":{"id":"/en/docs/agent-providers-models-54","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#verification-and-troubleshooting","content":"Whether the application proxy and server network are reachable.","locale":"en"},"4660":{"id":"/en/docs/agent-providers-models-55","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#verification-and-troubleshooting","content":"Whether the context window, image input, or remote compaction exceeds the compatible service's capabilities.","locale":"en"},"4661":{"id":"/en/docs/agent-providers-models-56","page_id":"/en/docs/agent-providers-models","tags":[],"type":"text","url":"/en/docs/agent-providers-models#verification-and-troubleshooting","content":"After a provider is disabled or deleted, historical sessions remain readable. To continue interacting with a model, explicitly choose another available model for the session. Deleting a provider also deletes its stored credentials.","locale":"en"},"4662":{"id":"/en/docs/agent-skills","page_id":"/en/docs/agent-skills","type":"page","content":"Skills","breadcrumbs":["Hanafubuki Documentation","Agent"],"tags":[],"url":"/en/docs/agent-skills","locale":"en"},"4663":{"id":"/en/docs/agent-skills-0","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills","content":"Install, enable, and select reusable Agent workflows.","locale":"en"},"4664":{"id":"/en/docs/agent-skills-1","page_id":"/en/docs/agent-skills","type":"heading","tags":[],"url":"/en/docs/agent-skills#where-skills-come-from","content":"Where Skills come from","locale":"en"},"4665":{"id":"/en/docs/agent-skills-2","page_id":"/en/docs/agent-skills","type":"heading","tags":[],"url":"/en/docs/agent-skills#installing-and-reviewing","content":"Installing and reviewing","locale":"en"},"4666":{"id":"/en/docs/agent-skills-3","page_id":"/en/docs/agent-skills","type":"heading","tags":[],"url":"/en/docs/agent-skills#enablement-and-the-current-turn","content":"Enablement and the current turn","locale":"en"},"4667":{"id":"/en/docs/agent-skills-4","page_id":"/en/docs/agent-skills","type":"heading","tags":[],"url":"/en/docs/agent-skills#selecting-a-skill-for-the-next-message","content":"Selecting a Skill for the next message","locale":"en"},"4668":{"id":"/en/docs/agent-skills-5","page_id":"/en/docs/agent-skills","type":"heading","tags":[],"url":"/en/docs/agent-skills#what-the-agent-can-do-with-skills","content":"What the Agent can do with Skills","locale":"en"},"4669":{"id":"/en/docs/agent-skills-6","page_id":"/en/docs/agent-skills","type":"heading","tags":[],"url":"/en/docs/agent-skills#the-applications-management-skill","content":"The application's management Skill","locale":"en"},"4670":{"id":"/en/docs/agent-skills-7","page_id":"/en/docs/agent-skills","type":"heading","tags":[],"url":"/en/docs/agent-skills#removing","content":"Removing","locale":"en"},"4671":{"id":"/en/docs/agent-skills-8","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills","content":"A Skill is a directory containing a `SKILL.md` whose YAML frontmatter names it and describes when to use it. Everything else in the directory — references, scripts, assets, a licence — is supporting material. That is the whole format, and it is the same one Claude and Codex read, so a package that installs there installs here.","locale":"en"},"4672":{"id":"/en/docs/agent-skills-9","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills","content":"A Skill guides the Agent through a particular task. It cannot bypass the session mode, tool policies, or permission approvals.","locale":"en"},"4673":{"id":"/en/docs/agent-skills-10","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"The Agent discovers Skills in these locations:","locale":"en"},"4674":{"id":"/en/docs/agent-skills-11","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"Authority","locale":"en"},"4675":{"id":"/en/docs/agent-skills-12","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"Where","locale":"en"},"4676":{"id":"/en/docs/agent-skills-13","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"Editable","locale":"en"},"4677":{"id":"/en/docs/agent-skills-14","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"Repo","locale":"en"},"4678":{"id":"/en/docs/agent-skills-15","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"`.agents/skills` inside a workspace root","locale":"en"},"4679":{"id":"/en/docs/agent-skills-16","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"No","locale":"en"},"4680":{"id":"/en/docs/agent-skills-17","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"User","locale":"en"},"4681":{"id":"/en/docs/agent-skills-18","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"The managed Skills root","locale":"en"},"4682":{"id":"/en/docs/agent-skills-19","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"Yes","locale":"en"},"4683":{"id":"/en/docs/agent-skills-20","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"System","locale":"en"},"4684":{"id":"/en/docs/agent-skills-21","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"Bundled with the application","locale":"en"},"4685":{"id":"/en/docs/agent-skills-22","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"No","locale":"en"},"4686":{"id":"/en/docs/agent-skills-23","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"Plugin","locale":"en"},"4687":{"id":"/en/docs/agent-skills-24","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"Skills supplied by enabled Agent packages, including those contributed by desktop extensions","locale":"en"},"4688":{"id":"/en/docs/agent-skills-25","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"No","locale":"en"},"4689":{"id":"/en/docs/agent-skills-26","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#where-skills-come-from","content":"A directory that fails to load is reported beside the catalogue and skipped, so one malformed package never costs you the rest.","locale":"en"},"4690":{"id":"/en/docs/agent-skills-27","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#installing-and-reviewing","content":"Under **Settings → Agent → Skills**, you can install a Skill from a folder, write one, duplicate one, edit its files, and remove it. Only Skills in the managed user root can be changed; a repository or bundled Skill is read-only, so duplicate it first.","locale":"en"},"4691":{"id":"/en/docs/agent-skills-28","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#installing-and-reviewing","content":"**Create or install.** Select **Add a Skill**. To create one, enter its name and purpose. For **Install a folder**, check the preview for the name, destination folder, and resource count. If that folder already exists, the action changes to **Replace**.","locale":"en"},"4692":{"id":"/en/docs/agent-skills-29","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#installing-and-reviewing","content":"**Find and edit.** Search by name, description, or directory. Open a Skill's overview to see its directory, required MCP servers, and any reason it is unavailable. The file list opens `SKILL.md` and its resources. In a user copy, you can add, save, and delete resource files. Removing `SKILL.md` requires deleting the whole Skill.","locale":"en"},"4693":{"id":"/en/docs/agent-skills-30","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#installing-and-reviewing","content":"Before installing, review:","locale":"en"},"4694":{"id":"/en/docs/agent-skills-31","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#installing-and-reviewing","content":"Whether the package name, purpose, version, and source are what you expect.","locale":"en"},"4695":{"id":"/en/docs/agent-skills-32","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#installing-and-reviewing","content":"The steps and trigger conditions declared in `SKILL.md`.","locale":"en"},"4696":{"id":"/en/docs/agent-skills-33","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#installing-and-reviewing","content":"Referenced documentation, resource files, and script contents.","locale":"en"},"4697":{"id":"/en/docs/agent-skills-34","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#installing-and-reviewing","content":"Required MCP services, transports, and external addresses.","locale":"en"},"4698":{"id":"/en/docs/agent-skills-35","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#installing-and-reviewing","content":"Whether the Agent may use the Skill implicitly when you did not name it.","locale":"en"},"4699":{"id":"/en/docs/agent-skills-36","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#installing-and-reviewing","content":"A Skill's instructions and scripts can direct the Agent to run commands, modify files, or invoke\nexternal tools. Install only trusted sources, and review changes and dependencies again after an\nupdate.","locale":"en"},"4700":{"id":"/en/docs/agent-skills-37","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#enablement-and-the-current-turn","content":"A discovered Skill is on until you turn it off. The enabled state decides whether a Skill is offered to each newly admitted user turn. A session does not retain its own catalogue: turn admission captures a fresh read-only one, and an already running turn keeps the catalogue and Skill contexts it was frozen with.","locale":"en"},"4701":{"id":"/en/docs/agent-skills-38","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#enablement-and-the-current-turn","content":"When there is a current conversation, the Skill detail also shows its status in that conversation:","locale":"en"},"4702":{"id":"/en/docs/agent-skills-39","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#enablement-and-the-current-turn","content":"**Available now** — enabled, and offered to the next turn.","locale":"en"},"4703":{"id":"/en/docs/agent-skills-40","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#enablement-and-the-current-turn","content":"**Adopted this turn** — the running turn read it and is following it.","locale":"en"},"4704":{"id":"/en/docs/agent-skills-41","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#enablement-and-the-current-turn","content":"Turning a Skill on or off takes effect from the next turn. Nothing changes a model request that is already running.","locale":"en"},"4705":{"id":"/en/docs/agent-skills-42","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#selecting-a-skill-for-the-next-message","content":"Run `/skills` to see what is available in this conversation and why an entry might be unavailable. Select an entry to toggle it for the next message. You can also type `$` followed by a name in the input and choose a match. If that mention was the entire draft and the Skill supplies a default prompt, the prompt appears in the input for you to edit before sending.","locale":"en"},"4706":{"id":"/en/docs/agent-skills-43","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#selecting-a-skill-for-the-next-message","content":"Naming a Skill explicitly in the prompt reduces ambiguity, for example:","locale":"en"},"4707":{"id":"/en/docs/agent-skills-44","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#selecting-a-skill-for-the-next-message","content":"If a Skill allows implicit invocation, its name and description appear in the model's catalogue and the Agent must use it when the task clearly matches. An explicit-only Skill stays out of that catalogue but can still be chosen by name.","locale":"en"},"4708":{"id":"/en/docs/agent-skills-45","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#what-the-agent-can-do-with-skills","content":"The Agent reads Skills through `skills_list` and `skills_read`, and can turn one on or off with `enable_skill` and `disable_skill` after you approve it. Writing, installing, and removing a Skill package uses the ordinary filesystem and command tools — a Skill directory is just a directory — which is why those actions go through the same approvals as any other file write.","locale":"en"},"4709":{"id":"/en/docs/agent-skills-46","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#what-the-agent-can-do-with-skills","content":"The bundled **Skill Creator** and **Skill Manager** Skills describe those workflows to the Agent.","locale":"en"},"4710":{"id":"/en/docs/agent-skills-47","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#the-applications-management-skill","content":"The user root also holds `hanafubuki-webui-management`, which the application installs itself: it teaches the Agent to manage your WebUI instances through the application's `hanafubuki` MCP server (MCP), which tool to use for what and how to follow a long operation. It only explains; the tools and their approvals are the server's.","locale":"en"},"4711":{"id":"/en/docs/agent-skills-48","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#the-applications-management-skill","content":"Every time the Agent starts, the application installs it again unless the installed copy is exactly the bundled one, so your edits to it are replaced. To change it, duplicate it under another name.","locale":"en"},"4712":{"id":"/en/docs/agent-skills-49","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#the-applications-management-skill","content":"Turning it off is kept: a reinstall leaves your choice alone.","locale":"en"},"4713":{"id":"/en/docs/agent-skills-50","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#the-applications-management-skill","content":"It names the `hanafubuki` server as what it needs, so it is listed as unavailable while that server is not connected.","locale":"en"},"4714":{"id":"/en/docs/agent-skills-51","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#the-applications-management-skill","content":"Other AI tools connected to the server can read the same guide as MCP resources (MCP Server).","locale":"en"},"4715":{"id":"/en/docs/agent-skills-52","page_id":"/en/docs/agent-skills","tags":[],"type":"text","url":"/en/docs/agent-skills#removing","content":"Removing a Skill deletes only the installed package. History retains the Skill context that earlier turns actually adopted, and removal never rewrites a running turn. Wait for the current task to finish before reorganizing capabilities.","locale":"en"},"4716":{"id":"/en/docs/agent-tools-terminals","page_id":"/en/docs/agent-tools-terminals","type":"page","content":"Tools and Background Terminals","breadcrumbs":["Hanafubuki Documentation","Agent"],"tags":[],"url":"/en/docs/agent-tools-terminals","locale":"en"},"4717":{"id":"/en/docs/agent-tools-terminals-0","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals","content":"Read tool calls, inspect output, and manage background commands started by the Agent.","locale":"en"},"4718":{"id":"/en/docs/agent-tools-terminals-1","page_id":"/en/docs/agent-tools-terminals","type":"heading","tags":[],"url":"/en/docs/agent-tools-terminals#reading-tool-cards","content":"Reading tool cards","locale":"en"},"4719":{"id":"/en/docs/agent-tools-terminals-2","page_id":"/en/docs/agent-tools-terminals","type":"heading","tags":[],"url":"/en/docs/agent-tools-terminals#stopping-the-current-response","content":"Stopping the current response","locale":"en"},"4720":{"id":"/en/docs/agent-tools-terminals-3","page_id":"/en/docs/agent-tools-terminals","type":"heading","tags":[],"url":"/en/docs/agent-tools-terminals#background-terminals","content":"Background terminals","locale":"en"},"4721":{"id":"/en/docs/agent-tools-terminals-4","page_id":"/en/docs/agent-tools-terminals","type":"heading","tags":[],"url":"/en/docs/agent-tools-terminals#safely-cleaning-up-background-commands","content":"Safely cleaning up background commands","locale":"en"},"4722":{"id":"/en/docs/agent-tools-terminals-5","page_id":"/en/docs/agent-tools-terminals","type":"heading","tags":[],"url":"/en/docs/agent-tools-terminals#determining-whether-a-task-is-complete","content":"Determining whether a task is complete","locale":"en"},"4723":{"id":"/en/docs/agent-tools-terminals-6","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals","content":"The Agent uses tools to read files, modify code, run commands, and invoke application functions. Every call creates a tool card in the message history. Together, the tool state and final response describe the task result.","locale":"en"},"4724":{"id":"/en/docs/agent-tools-terminals-7","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#reading-tool-cards","content":"While a tool is running, its card shows the current state and live output. Completed cards are usually collapsed to keep the session readable. Expand one to inspect:","locale":"en"},"4725":{"id":"/en/docs/agent-tools-terminals-8","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#reading-tool-cards","content":"The tool name and arguments submitted by the model.","locale":"en"},"4726":{"id":"/en/docs/agent-tools-terminals-9","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#reading-tool-cards","content":"The command, working directory, and exit status.","locale":"en"},"4727":{"id":"/en/docs/agent-tools-terminals-10","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#reading-tool-cards","content":"File patches and summaries of added, modified, or deleted files.","locale":"en"},"4728":{"id":"/en/docs/agent-tools-terminals-11","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#reading-tool-cards","content":"The automatic permission review's decision and reasoning.","locale":"en"},"4729":{"id":"/en/docs/agent-tools-terminals-12","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#reading-tool-cards","content":"Standard output, standard error, and notices of truncation or omission.","locale":"en"},"4730":{"id":"/en/docs/agent-tools-terminals-13","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#reading-tool-cards","content":"An expanded command card starts with its most recent output. Reveal earlier lines in batches, or show all retained lines at once. Scrolling up pauses automatic scrolling, so you can keep reading while the command prints more. Scroll back to the bottom to follow the output again. File reads, directory listings, and search results also expand in batches. File reads show line numbers, and search matches are grouped by file.","locale":"en"},"4731":{"id":"/en/docs/agent-tools-terminals-14","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#reading-tool-cards","content":"A tool can be running, awaiting approval, awaiting the user, awaiting cleanup, successful, failed, canceled, or interrupted. You can determine that a call has ended only after it reaches an explicit terminal state.","locale":"en"},"4732":{"id":"/en/docs/agent-tools-terminals-15","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#reading-tool-cards","content":"Both live output and persisted history have size limits. When you see a truncation marker, ask the\nAgent to use a more precise filter or read a specific section instead of assuming that omitted\ncontent does not exist.","locale":"en"},"4733":{"id":"/en/docs/agent-tools-terminals-16","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#stopping-the-current-response","content":"When the input is empty and the current response can be canceled, the primary button becomes a stop button. It cancels the current Agent response or standalone compaction.","locale":"en"},"4734":{"id":"/en/docs/agent-tools-terminals-17","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#stopping-the-current-response","content":"After you request a stop, the application must still confirm that tools and processes reached terminal states. If the interface shows that it is awaiting cleanup, do not immediately create a replacement task. Wait, or retry cleanup as directed by the error.","locale":"en"},"4735":{"id":"/en/docs/agent-tools-terminals-18","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#background-terminals","content":"A long-running command can be moved to the background and assigned a terminal session identifier. It belongs to the Agent session that created it and does not end automatically when you collapse its tool card, switch sessions, or close the Agent window.","locale":"en"},"4736":{"id":"/en/docs/agent-tools-terminals-19","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#background-terminals","content":"Command","locale":"en"},"4737":{"id":"/en/docs/agent-tools-terminals-20","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#background-terminals","content":"Purpose","locale":"en"},"4738":{"id":"/en/docs/agent-tools-terminals-21","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#background-terminals","content":"`/ps`","locale":"en"},"4739":{"id":"/en/docs/agent-tools-terminals-22","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#background-terminals","content":"List retained background terminals and their states for the current Agent session","locale":"en"},"4740":{"id":"/en/docs/agent-tools-terminals-23","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#background-terminals","content":"`/stop`","locale":"en"},"4741":{"id":"/en/docs/agent-tools-terminals-24","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#background-terminals","content":"Request that all background terminals in the current session be stopped and cleaned up","locale":"en"},"4742":{"id":"/en/docs/agent-tools-terminals-25","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#background-terminals","content":"`/stop` is not the same operation as stopping the current response. The former handles background terminals; the latter cancels the current model turn or compaction.","locale":"en"},"4743":{"id":"/en/docs/agent-tools-terminals-26","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#safely-cleaning-up-background-commands","content":"Run `/ps` to see each terminal's command, working directory, elapsed time, and recent output.\nRefresh the card to update its state. Completed commands also show an exit code when available.","locale":"en"},"4744":{"id":"/en/docs/agent-tools-terminals-27","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#safely-cleaning-up-background-commands","content":"If a service must remain running, first ask the Agent to read incremental output and verify that\nit is healthy.","locale":"en"},"4745":{"id":"/en/docs/agent-tools-terminals-28","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#safely-cleaning-up-background-commands","content":"If cleanup fails, run `/stop` again as directed by the card; do not merely delete the session.","locale":"en"},"4746":{"id":"/en/docs/agent-tools-terminals-29","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#safely-cleaning-up-background-commands","content":"Background development servers, file watchers, and interactive commands may continue occupying ports or files. Before finishing the task, explicitly state which processes remain and which have been stopped.","locale":"en"},"4747":{"id":"/en/docs/agent-tools-terminals-30","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#determining-whether-a-task-is-complete","content":"A successful tool call proves only that the individual operation succeeded, not that the whole objective is complete.","locale":"en"},"4748":{"id":"/en/docs/agent-tools-terminals-31","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#determining-whether-a-task-is-complete","content":"For a test command, inspect the exit status and failed cases instead of relying on partial output.","locale":"en"},"4749":{"id":"/en/docs/agent-tools-terminals-32","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#determining-whether-a-task-is-complete","content":"The Agent's final response should state what changed, what was verified, and what remains incomplete.","locale":"en"},"4750":{"id":"/en/docs/agent-tools-terminals-33","page_id":"/en/docs/agent-tools-terminals","tags":[],"type":"text","url":"/en/docs/agent-tools-terminals#determining-whether-a-task-is-complete","content":"If the final response claims completion while a tool is still running or awaiting cleanup, trust the backend state.","locale":"en"},"4751":{"id":"/en/docs/agent","page_id":"/en/docs/agent","type":"page","content":"Agent Quick Start","breadcrumbs":["Hanafubuki Documentation","Agent"],"tags":[],"url":"/en/docs/agent","locale":"en"},"4752":{"id":"/en/docs/agent-0","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent","content":"Configure a model and complete your first Agent session.","locale":"en"},"4753":{"id":"/en/docs/agent-1","page_id":"/en/docs/agent","type":"heading","tags":[],"url":"/en/docs/agent#first-use","content":"First use","locale":"en"},"4754":{"id":"/en/docs/agent-2","page_id":"/en/docs/agent","type":"heading","tags":[],"url":"/en/docs/agent#configure-a-provider","content":"Configure a provider","locale":"en"},"4755":{"id":"/en/docs/agent-3","page_id":"/en/docs/agent","type":"heading","tags":[],"url":"/en/docs/agent#open-agent","content":"Open Agent","locale":"en"},"4756":{"id":"/en/docs/agent-4","page_id":"/en/docs/agent","type":"heading","tags":[],"url":"/en/docs/agent#create-a-session","content":"Create a session","locale":"en"},"4757":{"id":"/en/docs/agent-5","page_id":"/en/docs/agent","type":"heading","tags":[],"url":"/en/docs/agent#choose-a-mode-and-permissions","content":"Choose a mode and permissions","locale":"en"},"4758":{"id":"/en/docs/agent-6","page_id":"/en/docs/agent","type":"heading","tags":[],"url":"/en/docs/agent#send-a-task","content":"Send a task","locale":"en"},"4759":{"id":"/en/docs/agent-7","page_id":"/en/docs/agent","type":"heading","tags":[],"url":"/en/docs/agent#a-recommended-task-format","content":"A recommended task format","locale":"en"},"4760":{"id":"/en/docs/agent-8","page_id":"/en/docs/agent","type":"heading","tags":[],"url":"/en/docs/agent#what-to-watch-during-execution","content":"What to watch during execution","locale":"en"},"4761":{"id":"/en/docs/agent-9","page_id":"/en/docs/agent","type":"heading","tags":[],"url":"/en/docs/agent#recover-agent","content":"When the assistant will not open or tools disappear","locale":"en"},"4762":{"id":"/en/docs/agent-10","page_id":"/en/docs/agent","type":"heading","tags":[],"url":"/en/docs/agent#continue-reading","content":"Continue reading","locale":"en"},"4763":{"id":"/en/docs/agent-11","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent","content":"The Agent can read project context, invoke application tools, run commands, and help modify files. What it can do depends on the current model, permission mode, MCP, Skills, and session state. Before starting, configure at least one enabled model provider.","locale":"en"},"4764":{"id":"/en/docs/agent-12","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#configure-a-provider","content":"Open **Settings → Agent** and add a provider in the model providers section. Choose the protocol actually supported by the server, enter the API address and credentials, and save.","locale":"en"},"4765":{"id":"/en/docs/agent-13","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#configure-a-provider","content":"A provider describes only the server connection. The model is selected separately in the model policy. After saving the provider, select the default provider and model.","locale":"en"},"4766":{"id":"/en/docs/agent-14","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#open-agent","content":"Click the Agent button in the title bar. Agent opens as a floating panel by default; you can also detach it into a separate window with the window controls.","locale":"en"},"4767":{"id":"/en/docs/agent-15","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#open-agent","content":"The session list is on the left. The right side displays the current session, message history, tool calls, and input in order.","locale":"en"},"4768":{"id":"/en/docs/agent-16","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#create-a-session","content":"Click **New** above the session list, or run `/new` in the input. If you have not configured a default model, you can still create a session, but must click the model button beside the input or run `/model` before sending a message.","locale":"en"},"4769":{"id":"/en/docs/agent-17","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#create-a-session","content":"A regular new conversation uses the default workspace. Create the conversation inside a project to use its selected folders. Type `/pwd` to check the current working directory. Projects and workspaces","locale":"en"},"4770":{"id":"/en/docs/agent-18","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#choose-a-mode-and-permissions","content":"**Default** mode is for direct analysis and execution. **Plan** mode is limited to investigation, questions, and solution design. The permission mode determines whether tool operations run directly, receive automatic review, or await manual approval.","locale":"en"},"4771":{"id":"/en/docs/agent-19","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#choose-a-mode-and-permissions","content":"Use `/permissions` or the permissions menu beside the input to choose this session's sandbox and approval preset.","locale":"en"},"4772":{"id":"/en/docs/agent-20","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#send-a-task","content":"State the objective, allowed scope of changes, and acceptance criteria, then press `Enter` to send. Use `Shift + Enter` for a line break. You can also attach images, reference files, or select a Skill for the current turn.","locale":"en"},"4773":{"id":"/en/docs/agent-21","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#a-recommended-task-format","content":"An easily verifiable task usually includes the objective, scope constraints, behavior that must remain unchanged, and validation commands. For releases, deletion, external messages, or account operations, also state the exact target.","locale":"en"},"4774":{"id":"/en/docs/agent-22","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#what-to-watch-during-execution","content":"Agent commentary reports its current assessment and next action.","locale":"en"},"4775":{"id":"/en/docs/agent-23","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#what-to-watch-during-execution","content":"When the model thinks before it answers, a collapsed thinking block shows \"Thinking\" with the time so far, then \"Thought for 12s\". Click it to read what the model streamed; a reopened conversation keeps it. The working line at the end of the output says what the Agent is doing (a tool, generating, waiting) and how long the turn has run, not what the model is thinking.","locale":"en"},"4776":{"id":"/en/docs/agent-24","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#what-to-watch-during-execution","content":"Tool cards show commands, file operations, approval results, and output. Expand a card to inspect details.","locale":"en"},"4777":{"id":"/en/docs/agent-25","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#what-to-watch-during-execution","content":"When the input is empty, the primary button can stop the current response. When you have entered new content, it is queued first and does not automatically interrupt the response in progress.","locale":"en"},"4778":{"id":"/en/docs/agent-26","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#what-to-watch-during-execution","content":"Long-running commands may become background terminals. Closing the Agent panel does not mean the process stopped; use `/ps` to inspect and `/stop` to clean up.","locale":"en"},"4779":{"id":"/en/docs/agent-27","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#what-to-watch-during-execution","content":"The final response and terminal tool states together indicate whether the task is complete. Do not treat \"the tool has started\" as success.","locale":"en"},"4780":{"id":"/en/docs/agent-28","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#what-to-watch-during-execution","content":"Higher permission only reduces approval steps; it does not make commands, file changes, or\nexternal actions inherently safe. Review the target, arguments, and risk notice before allowing an\noperation, then inspect the diff and test results afterward.","locale":"en"},"4781":{"id":"/en/docs/agent-29","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#recover-agent","content":"If the **assistant panel** stops working, select **Reload assistant panel** to reopen the conversation view. If the assistant process stops, its status page shows the reason and whether an automatic restart is scheduled. After repeated startup failures, **Start in safe mode** loads only core plugins. Select **Restart normally** when ready to use your previous plugin selection.","locale":"en"},"4782":{"id":"/en/docs/agent-30","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#recover-agent","content":"If chat still works but a banner reports that a plugin stopped, **Open plugins** takes you to Agent settings to investigate. If a request was interrupted by an assistant restart, check its last tool records before deciding whether to resend it.","locale":"en"},"4783":{"id":"/en/docs/agent-31","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#recover-agent","content":"When conversations cannot be restored, their files are set aside and retained. Use **Open diagnostics** to inspect the report. If **Rebuild history index** is offered, confirming stops active replies, restarts the assistant, and regenerates the index from saved conversation files.","locale":"en"},"4784":{"id":"/en/docs/agent-32","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#continue-reading","content":"<Card title=\"Providers and Models\" href=\"/docs/agent-providers-models\" description=\"Configure connections, model capabilities, and context policies.\" />","locale":"en"},"4785":{"id":"/en/docs/agent-33","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#continue-reading","content":"<Card title=\"Session Management\" href=\"/docs/agent-conversations\" description=\"Manage history, archiving, deletion, and forks.\" />","locale":"en"},"4786":{"id":"/en/docs/agent-34","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#continue-reading","content":"<Card title=\"Messages and Attachments\" href=\"/docs/agent-messages-attachments\" description=\"Reference files, add images, and steer work in progress.\" />","locale":"en"},"4787":{"id":"/en/docs/agent-35","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#continue-reading","content":"<Card title=\"Modes and Plans\" href=\"/docs/agent-modes-plans\" description=\"Understand Default mode, Plan mode, and the two kinds of plans.\" />","locale":"en"},"4788":{"id":"/en/docs/agent-36","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#continue-reading","content":"<Card title=\"Permissions and Approvals\" href=\"/docs/agent-permissions\" description=\"Review approval details and choose an appropriate permission mode.\" />","locale":"en"},"4789":{"id":"/en/docs/agent-37","page_id":"/en/docs/agent","tags":[],"type":"text","url":"/en/docs/agent#continue-reading","content":"<Card title=\"Commands and Context\" href=\"/docs/agent-commands-context\" description=\"Use slash commands, inspect usage, and compact sessions.\" />","locale":"en"},"4790":{"id":"/en/docs/extension-dev-backends","page_id":"/en/docs/extension-dev-backends","type":"page","content":"Backends","breadcrumbs":["Hanafubuki Documentation","Extension Development"],"tags":[],"url":"/en/docs/extension-dev-backends","locale":"en"},"4791":{"id":"/en/docs/extension-dev-backends-0","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends","content":"Native and Python backends, the process environment and lifecycle, the protocol in summary, the host API and its permissions, hooks, provider callbacks, and services between extensions.","locale":"en"},"4792":{"id":"/en/docs/extension-dev-backends-1","page_id":"/en/docs/extension-dev-backends","type":"heading","tags":[],"url":"/en/docs/extension-dev-backends#two-kinds-of-backend","content":"Two kinds of backend","locale":"en"},"4793":{"id":"/en/docs/extension-dev-backends-2","page_id":"/en/docs/extension-dev-backends","type":"heading","tags":[],"url":"/en/docs/extension-dev-backends#the-process-and-its-environment","content":"The process and its environment","locale":"en"},"4794":{"id":"/en/docs/extension-dev-backends-3","page_id":"/en/docs/extension-dev-backends","type":"heading","tags":[],"url":"/en/docs/extension-dev-backends#lifecycle","content":"Lifecycle","locale":"en"},"4795":{"id":"/en/docs/extension-dev-backends-4","page_id":"/en/docs/extension-dev-backends","type":"heading","tags":[],"url":"/en/docs/extension-dev-backends#faults","content":"Faults","locale":"en"},"4796":{"id":"/en/docs/extension-dev-backends-5","page_id":"/en/docs/extension-dev-backends","type":"heading","tags":[],"url":"/en/docs/extension-dev-backends#the-protocol-in-summary","content":"The protocol in summary","locale":"en"},"4797":{"id":"/en/docs/extension-dev-backends-6","page_id":"/en/docs/extension-dev-backends","type":"heading","tags":[],"url":"/en/docs/extension-dev-backends#hooks","content":"Hooks","locale":"en"},"4798":{"id":"/en/docs/extension-dev-backends-7","page_id":"/en/docs/extension-dev-backends","type":"heading","tags":[],"url":"/en/docs/extension-dev-backends#the-host-api","content":"The host API","locale":"en"},"4799":{"id":"/en/docs/extension-dev-backends-8","page_id":"/en/docs/extension-dev-backends","type":"heading","tags":[],"url":"/en/docs/extension-dev-backends#provider-callbacks","content":"Provider callbacks","locale":"en"},"4800":{"id":"/en/docs/extension-dev-backends-9","page_id":"/en/docs/extension-dev-backends","type":"heading","tags":[],"url":"/en/docs/extension-dev-backends#publishing-tools-on-the-management-mcp-endpoint","content":"Publishing tools on the management MCP endpoint","locale":"en"},"4801":{"id":"/en/docs/extension-dev-backends-10","page_id":"/en/docs/extension-dev-backends","type":"heading","tags":[],"url":"/en/docs/extension-dev-backends#services-between-extensions","content":"Services between extensions","locale":"en"},"4802":{"id":"/en/docs/extension-dev-backends-11","page_id":"/en/docs/extension-dev-backends","type":"heading","tags":[],"url":"/en/docs/extension-dev-backends#read-only-host-preferences","content":"Read-only host preferences","locale":"en"},"4803":{"id":"/en/docs/extension-dev-backends-12","page_id":"/en/docs/extension-dev-backends","type":"heading","tags":[],"url":"/en/docs/extension-dev-backends#runtime-tools-and-diagnostic-documents","content":"Runtime tools and diagnostic documents","locale":"en"},"4804":{"id":"/en/docs/extension-dev-backends-13","page_id":"/en/docs/extension-dev-backends","type":"heading","tags":[],"url":"/en/docs/extension-dev-backends#ask-a-question-from-a-background-operation","content":"Ask a question from a background operation","locale":"en"},"4805":{"id":"/en/docs/extension-dev-backends-14","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends","content":"A backend is a program an extension runs while it is on. It talks to the application over its own stdin and stdout: it can call the application's host API, and it answers the application's calls to it: hooks, the provider callbacks of instance types, panel and frame calls, and other extensions' service calls.","locale":"en"},"4806":{"id":"/en/docs/extension-dev-backends-15","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends","content":"This page covers what a backend author needs. Every method's params, result, permission, and bounds are in the Interface Reference; what each method does is in the extension backend protocol reference. To write a backend with an SDK, see SDKs.","locale":"en"},"4807":{"id":"/en/docs/extension-dev-backends-16","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#two-kinds-of-backend","content":"One executable per operating system, each path relative to the package root. Without a program for the current system, the extension shows **Can't run**. On Linux and macOS, keep the program's executable bit when you package it.","locale":"en"},"4808":{"id":"/en/docs/extension-dev-backends-17","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#two-kinds-of-backend","content":"The application waits for its managed Python and verified launcher resources to be ready, then runs `<python> <version dir>/backend.py`.","locale":"en"},"4809":{"id":"/en/docs/extension-dev-backends-18","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#two-kinds-of-backend","content":"For extensions declaring `requirements`, at startup, enable, update, rollback and Retry, the host checks the declared file against package metadata in the extension’s own directory for the current Python release (for example, `data/python-packages/cp315/`). A new directory, missing distribution or incompatible version triggers a pip install. The Task Center shows the install and lets you cancel it. Check or installation errors prevent the backend from starting and give the reason.","locale":"en"},"4810":{"id":"/en/docs/extension-dev-backends-19","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#two-kinds-of-backend","content":"Match dependencies to the managed interpreter on the user’s machine. A dependency with no compatible wheel may require a local compiler. For optional dependencies, use environment markers in the requirements file (for example, `py7zr; python_version < \"3.15\"`) and handle the missing import on other versions. The installer uses the application’s proxy and PyPI mirror settings.","locale":"en"},"4811":{"id":"/en/docs/extension-dev-backends-20","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#two-kinds-of-backend","content":"`PYTHONPATH` holds the application's Python SDK, then the directory above, so the script can `import hanafubuki_extension` directly.","locale":"en"},"4812":{"id":"/en/docs/extension-dev-backends-21","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#two-kinds-of-backend","content":"`sdWebuiAllInOne = true` (optional) puts the application's own `sd_webui_all_in_one` library between the SDK and the requirements, so the script can `import sd_webui_all_in_one` (its downloader, archive extraction and the rest). The library is the application's integration code, not a stable SDK: pin the application versions you tested against with `engines.hanafubuki`.","locale":"en"},"4813":{"id":"/en/docs/extension-dev-backends-22","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#two-kinds-of-backend","content":"`PYTHONUTF8=1`, `PYTHONUNBUFFERED=1`, `PYTHONNOUSERSITE=1`, and `PYTHONDONTWRITEBYTECODE=1` are set as well (an installed version's directory is never written to).","locale":"en"},"4814":{"id":"/en/docs/extension-dev-backends-23","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-process-and-its-environment","content":"**Working directory**: the package root. A copied install runs in `extensions/<id>/<version>/`; a development link runs in the folder the user linked. Read bundled assets relative to that root. Write persistent files under `HANAFUBUKI_EXTENSION_DATA` (also returned by `storage.path`).","locale":"en"},"4815":{"id":"/en/docs/extension-dev-backends-24","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-process-and-its-environment","content":"**Environment**: starts empty and takes only these variables from the application's environment, when they are set and are text: `PATH`, `HOME`, `USER`, `LOGNAME`, `SHELL`, `TMPDIR`, `LANG`, `LANGUAGE`, `LC_*`, `TZ`, `XDG_RUNTIME_DIR`, and on Windows `USERPROFILE`, `SYSTEMROOT`, `SYSTEMDRIVE`, `WINDIR`, `COMSPEC`, `PATHEXT`, `TEMP`, `TMP`, `APPDATA`, `LOCALAPPDATA`, `PROGRAMDATA`, `PROGRAMFILES`, `NUMBER_OF_PROCESSORS`, `PROCESSOR_ARCHITECTURE`. Plus:","locale":"en"},"4816":{"id":"/en/docs/extension-dev-backends-25","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-process-and-its-environment","content":"`HANAFUBUKI_EXTENSION_ID`: the extension's id;","locale":"en"},"4817":{"id":"/en/docs/extension-dev-backends-26","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-process-and-its-environment","content":"`HANAFUBUKI_EXTENSION_DATA`: its data directory, `extensions/<id>/data/`, kept across updates.","locale":"en"},"4818":{"id":"/en/docs/extension-dev-backends-27","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-process-and-its-environment","content":"No token, secret, or proxy setting of the application's reaches the backend.","locale":"en"},"4819":{"id":"/en/docs/extension-dev-backends-28","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-process-and-its-environment","content":"**Output**: stdout is the protocol's alone; write nothing else there. stderr goes to the extension's log, `backend.log` (rotated past 1 MiB), which `log.write` appends to as well. Users see its last 256 KiB through **View log** on the extension's card.","locale":"en"},"4820":{"id":"/en/docs/extension-dev-backends-29","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-process-and-its-environment","content":"A backend runs with the user's rights. The manifest's permissions only gate which host API methods\nit may call; a native program can still use the network and the filesystem directly. Do not rely\non permissions to confine your own code, and do not let users believe they do.","locale":"en"},"4821":{"id":"/en/docs/extension-dev-backends-30","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#lifecycle","content":"Phase","locale":"en"},"4822":{"id":"/en/docs/extension-dev-backends-31","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#lifecycle","content":"What happens","locale":"en"},"4823":{"id":"/en/docs/extension-dev-backends-32","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#lifecycle","content":"Start","locale":"en"},"4824":{"id":"/en/docs/extension-dev-backends-33","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#lifecycle","content":"When the extension is turned on, the process starts and receives `initialize` (answered within 10 s); after an update `migrate` follows if announced, then `activate` if announced. All of it within 16 s, or the start fails","locale":"en"},"4825":{"id":"/en/docs/extension-dev-backends-34","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#lifecycle","content":"Run","locale":"en"},"4826":{"id":"/en/docs/extension-dev-backends-35","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#lifecycle","content":"A `ping` every 10 s, answered within 5 s","locale":"en"},"4827":{"id":"/en/docs/extension-dev-backends-36","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#lifecycle","content":"Stop","locale":"en"},"4828":{"id":"/en/docs/extension-dev-backends-37","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#lifecycle","content":"`deactivate` if announced, then `shutdown`, at most a second each; then its stdin is closed and it has a second to exit before it is terminated. Processes it started with `process.run` stop with it","locale":"en"},"4829":{"id":"/en/docs/extension-dev-backends-38","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#lifecycle","content":"The protocol version in `initialize`'s answer must be `1`, or the start fails.","locale":"en"},"4830":{"id":"/en/docs/extension-dev-backends-39","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#faults","content":"Any of these is a fault of the backend: its process exits, its output closes, it sends what is not a protocol frame or not a JSON-RPC message, a frame larger than 4 MiB, its stdin no longer takes input, it misses a `ping`, or three calls in a row miss their bound (30 s for a call, 10 s for a hook).","locale":"en"},"4831":{"id":"/en/docs/extension-dev-backends-40","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#faults","content":"On a fault every waiting call fails, the extension becomes **Failed**, and the restart policy restarts it after 2, 10, then 30 seconds (at most 3 times in 10 minutes). A backend that ends during an orderly application shutdown is not a fault.","locale":"en"},"4832":{"id":"/en/docs/extension-dev-backends-41","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#faults","content":"**Repeated crashes**: each start counts one before it spawns; the count clears once the backend has run for 30 seconds, when it is stopped in order, or on **Retry**. At three, the extension shows **Stopped after repeated crashes** and is not started again, in this run or the next, until the user clicks **Retry**.","locale":"en"},"4833":{"id":"/en/docs/extension-dev-backends-42","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-protocol-in-summary","content":"**Transport**: JSON-RPC 2.0; the application writes to the backend's stdin, the backend to its stdout.","locale":"en"},"4834":{"id":"/en/docs/extension-dev-backends-43","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-protocol-in-summary","content":"**Framing**: as in the Language Server Protocol: header lines `Name: value`, each ending in `\\r\\n`, an empty line, then a body of exactly `Content-Length` bytes of UTF-8 JSON. `Content-Length` is required and matched without case; other headers are ignored. Headers take at most 1 KiB, a body at most 4 MiB.","locale":"en"},"4835":{"id":"/en/docs/extension-dev-backends-44","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-protocol-in-summary","content":"**Version**: protocol version `1`, carried both ways by `initialize`.","locale":"en"},"4836":{"id":"/en/docs/extension-dev-backends-45","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-protocol-in-summary","content":"**Both directions**: either side may call the other at any time; a backend handling a call may call the host API and wait for the answer. Unknown members of params are ignored and missing ones take their defaults; params that do not read fail their call with `INVALID_PARAMS`.","locale":"en"},"4837":{"id":"/en/docs/extension-dev-backends-46","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-protocol-in-summary","content":"**Concurrency**: the application answers at most 16 of one backend's calls at once; another fails with `BUSY`.","locale":"en"},"4838":{"id":"/en/docs/extension-dev-backends-47","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-protocol-in-summary","content":"**Bounds**: the application's calls to a backend (hooks aside) have a 30 s bound. A call past it fails alone; three in a row are a fault.","locale":"en"},"4839":{"id":"/en/docs/extension-dev-backends-48","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-protocol-in-summary","content":"Code","locale":"en"},"4840":{"id":"/en/docs/extension-dev-backends-49","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-protocol-in-summary","content":"Name","locale":"en"},"4841":{"id":"/en/docs/extension-dev-backends-50","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-protocol-in-summary","content":"Meaning","locale":"en"},"4842":{"id":"/en/docs/extension-dev-backends-51","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-protocol-in-summary","content":"-32700","locale":"en"},"4843":{"id":"/en/docs/extension-dev-backends-52","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-protocol-in-summary","content":"`PARSE_ERROR`","locale":"en"},"4844":{"id":"/en/docs/extension-dev-backends-53","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-protocol-in-summary","content":"JSON-RPC's","locale":"en"},"4845":{"id":"/en/docs/extension-dev-backends-54","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-protocol-in-summary","content":"-32600","locale":"en"},"4846":{"id":"/en/docs/extension-dev-backends-55","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-protocol-in-summary","content":"`INVALID_REQUEST`","locale":"en"},"4847":{"id":"/en/docs/extension-dev-backends-56","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-protocol-in-summary","content":"JSON-RPC's","locale":"en"},"4848":{"id":"/en/docs/extension-dev-backends-57","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-protocol-in-summary","content":"-32601","locale":"en"},"4849":{"id":"/en/docs/extension-dev-backends-58","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-protocol-in-summary","content":"`METHOD_NOT_FOUND`","locale":"en"},"4850":{"id":"/en/docs/extension-dev-backends-59","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-protocol-in-summary","content":"No such method","locale":"en"},"4851":{"id":"/en/docs/extension-dev-backends-60","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/extension-dev-backends#the-protocol-in-summary","content":"-32602","locale":"en"},"4852":{"id":"/en/docs/extension-dev-backends-61","page_id":"/en/docs/extension-dev-backends","tags":[],"type":"text","url":"/en/docs/e