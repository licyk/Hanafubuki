eshooting#understand-installation-stages","content":"Stage","locale":"en"},"4010":{"id":"/en/docs/webui-install-troubleshooting-12","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#understand-installation-stages","content":"What is happening","locale":"en"},"4011":{"id":"/en/docs/webui-install-troubleshooting-13","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#understand-installation-stages","content":"Installing Python","locale":"en"},"4012":{"id":"/en/docs/webui-install-troubleshooting-14","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#understand-installation-stages","content":"Downloading, extracting, and checking the instance's standalone Python","locale":"en"},"4013":{"id":"/en/docs/webui-install-troubleshooting-15","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#understand-installation-stages","content":"Installing Core","locale":"en"},"4014":{"id":"/en/docs/webui-install-troubleshooting-16","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#understand-installation-stages","content":"Downloading or restoring WebUI, then installing dependencies, models, and extension options","locale":"en"},"4015":{"id":"/en/docs/webui-install-troubleshooting-17","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#understand-installation-stages","content":"Removing Python / Core","locale":"en"},"4016":{"id":"/en/docs/webui-install-troubleshooting-18","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#understand-installation-stages","content":"Removing managed components selected during reinstallation","locale":"en"},"4017":{"id":"/en/docs/webui-install-troubleshooting-19","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#understand-installation-stages","content":"Completed","locale":"en"},"4018":{"id":"/en/docs/webui-install-troubleshooting-20","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#understand-installation-stages","content":"The instance is ready; the workspace continues by preparing services and starting WebUI","locale":"en"},"4019":{"id":"/en/docs/webui-install-troubleshooting-21","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#understand-installation-stages","content":"Failed / Canceled","locale":"en"},"4020":{"id":"/en/docs/webui-install-troubleshooting-22","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#understand-installation-stages","content":"The installation task has ended; you can inspect errors, clean up, or retry","locale":"en"},"4021":{"id":"/en/docs/webui-install-troubleshooting-23","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#understand-installation-stages","content":"The progress percentage is based on completed stages, not downloaded bytes or file count. If a stage remains at one percentage for a long time, it may simply be downloading or installing a large dependency. Expand **View log** to confirm whether output continues.","locale":"en"},"4022":{"id":"/en/docs/webui-install-troubleshooting-24","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#inspect-and-preserve-output","content":"Select **View log** to expand a read-only terminal on the current page.","locale":"en"},"4023":{"id":"/en/docs/webui-install-troubleshooting-25","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#inspect-and-preserve-output","content":"Select **Open in Task Center** to view the same task's complete state and retained output.","locale":"en"},"4024":{"id":"/en/docs/webui-install-troubleshooting-26","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#inspect-and-preserve-output","content":"Use the copy button to preserve the current log. Long-retained task output may be truncated by capacity limits.","locale":"en"},"4025":{"id":"/en/docs/webui-install-troubleshooting-27","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#inspect-and-preserve-output","content":"On failure, the log expands automatically and shows diagnostic, cleanup, and retry actions.","locale":"en"},"4026":{"id":"/en/docs/webui-install-troubleshooting-28","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#inspect-and-preserve-output","content":"Installation diagnostics may contain environment variables, local paths, command output,\ncredentials, or tokens. Extract, inspect, and redact the bundle before sharing. See Instance\nDiagnostics.","locale":"en"},"4027":{"id":"/en/docs/webui-install-troubleshooting-29","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#request-cancellation","content":"While a running task permits cancellation, select **Cancel installation**. Cancellation is a request; wait for the interface to enter a canceled or failed state instead of immediately deleting directories or exiting processes.","locale":"en"},"4028":{"id":"/en/docs/webui-install-troubleshooting-30","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#check-cleanup-state","content":"Once the child process is confirmed stopped, the interface releases ownership for this installation. If termination or inspection fails, the error retains the unresolved cleanup obligation.","locale":"en"},"4029":{"id":"/en/docs/webui-install-troubleshooting-31","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#retry-process-cleanup","content":"Use **Retry process cleanup** only when the interface displays it. This action only confirms and releases lingering process state; it does not reinstall Python or Core.","locale":"en"},"4030":{"id":"/en/docs/webui-install-troubleshooting-32","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#reinstall","content":"After cleanup completes, select **Retry installation**. The application creates a new installation operation and repeats the necessary steps based on the current instance state.","locale":"en"},"4031":{"id":"/en/docs/webui-install-troubleshooting-33","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#reinstall","content":"Do not force-end a process in the system task manager and immediately create another instance at the same path. The backend may still retain process and instance state that must be confirmed.","locale":"en"},"4032":{"id":"/en/docs/webui-install-troubleshooting-34","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#resolve-by-error-type","content":"Symptom or error","locale":"en"},"4033":{"id":"/en/docs/webui-install-troubleshooting-35","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#resolve-by-error-type","content":"Address first","locale":"en"},"4034":{"id":"/en/docs/webui-install-troubleshooting-36","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#resolve-by-error-type","content":"Installation options fail to load","locale":"en"},"4035":{"id":"/en/docs/webui-install-troubleshooting-37","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#resolve-by-error-type","content":"Select **Reload options**, then check the application runtime and management service","locale":"en"},"4036":{"id":"/en/docs/webui-install-troubleshooting-38","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#resolve-by-error-type","content":"Root is dangerous, overlaps another path, or passes through a symbolic link","locale":"en"},"4037":{"id":"/en/docs/webui-install-troubleshooting-39","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#resolve-by-error-type","content":"Choose a new dedicated instance root and retain the default Python/Core subdirectories","locale":"en"},"4038":{"id":"/en/docs/webui-install-troubleshooting-40","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#resolve-by-error-type","content":"Python download, extraction, or verification fails","locale":"en"},"4039":{"id":"/en/docs/webui-install-troubleshooting-41","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#resolve-by-error-type","content":"Check the network, proxy, mirrors, disk space, and **Settings → Runtime**","locale":"en"},"4040":{"id":"/en/docs/webui-install-troubleshooting-42","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#resolve-by-error-type","content":"Git or Core download fails","locale":"en"},"4041":{"id":"/en/docs/webui-install-troubleshooting-43","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#resolve-by-error-type","content":"Check Git status, the GitHub mirror, directory permissions, and conflicting files in the target directory","locale":"en"},"4042":{"id":"/en/docs/webui-install-troubleshooting-44","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#resolve-by-error-type","content":"PyTorch or dependency installation fails","locale":"en"},"4043":{"id":"/en/docs/webui-install-troubleshooting-45","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#resolve-by-error-type","content":"Restore **Automatic** or the type default, then confirm the GPU driver and package sources","locale":"en"},"4044":{"id":"/en/docs/webui-install-troubleshooting-46","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#resolve-by-error-type","content":"Snapshot type or platform mismatch","locale":"en"},"4045":{"id":"/en/docs/webui-install-troubleshooting-47","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#resolve-by-error-type","content":"Select the WebUI type recorded by the snapshot and restore on a compatible operating system","locale":"en"},"4046":{"id":"/en/docs/webui-install-troubleshooting-48","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#resolve-by-error-type","content":"Another installation still owns the operation","locale":"en"},"4047":{"id":"/en/docs/webui-install-troubleshooting-49","page_id":"/en/docs/webui-install-troubleshooting","tags":[],"type":"text","url":"/en/docs/webui-install-troubleshooting#resolve-by-error-type","content":"Wait for the old 